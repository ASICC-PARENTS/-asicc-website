// ASICC Firestore unified draft — 2026-11-17
// IMPORTANT: Deploy manually to Firebase Console after GitHub CI tests pass.
// Roles: general / member / special / admin
// Do not upload private child/student files until Storage rules are verified.
// ASICC member-space V2 — current staging rules; changes require review of the
// existing website's rules. Before deployment merge and test existing public
// contact, event, newsletter and legacy collections. Default is deny.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myProfileExists() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    function isActive() { return verified() && myProfileExists() && me().status == 'approved'; }
    function isAdmin() { return isActive() && me().role == 'admin'; }
    function galleryOpen() {
      return exists(/databases/$(database)/documents/siteSettings/gallery)
        && get(/databases/$(database)/documents/siteSettings/gallery).data.isOpen == true;
    }
    function galleryReady() { return galleryOpen() || isAdmin(); }
    function galleryAlbum(id) {
      return /databases/$(database)/documents/galleryAlbums/$(id);
    }
    function hasGalleryAccess() {
      return isActive() && me().role in ['member','special','admin'];
    }
    function validRole(role) { return role in ['general','member','special','admin']; }
    

function nicknamePath(key) {
  return /databases/$(database)/documents/nicknames/$(key);
}

function memberDoc(uid) {
  return /databases/$(database)/documents/members/$(uid);
}
function publicNameDoc(uid) {
  return /databases/$(database)/documents/publicNames/$(uid);
}
function nicknameValid(n, key) {
  return n is string && key is string
    && n.size() >= 2 && n.size() <= 24
    && key == n.lower() && key.size() <= 48
    && n.matches('^[\\p{Latin}\\p{Hangul}0-9]+$')
    && !key.matches('.*(asicc|admin|administrator|administrateur|administratrice|moderateur|moderatrice|official|officiel|staff|관리자|운영진|협회|공식).*');
}
function validRegistration(uid) {
  return signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly([
      'name','nickname','nicknameKey','email','role','status','consent',
      'termsVersion','termsAcceptedAt','createdAt','accountType','birthDate'
    ])
    && request.resource.data.keys().hasAll([
      'name','nickname','nicknameKey','email','role','status','consent',
      'termsVersion','termsAcceptedAt','createdAt','accountType'
    ])
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 80
    && nicknameValid(request.resource.data.nickname,request.resource.data.nicknameKey)
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.accountType in ['adult','student']
    && ((request.resource.data.accountType == 'adult' && request.resource.data.get('birthDate','') == '')
      || (request.resource.data.accountType == 'student' && validBirthDate(request.resource.data.get('birthDate',''))))
    && request.resource.data.role == 'general'
    && request.resource.data.status == 'approved'
    && request.resource.data.consent == true
    && request.resource.data.termsVersion == '2026-11'
    && request.resource.data.termsAcceptedAt == request.time
    && request.resource.data.createdAt == request.time
    && getAfter(nicknamePath(request.resource.data.nicknameKey)).data.uid == uid
    && getAfter(nicknamePath(request.resource.data.nicknameKey)).data.nickname == request.resource.data.nickname
    && getAfter(publicNameDoc(uid)).data.nickname == request.resource.data.nickname;
}
function validSelfNicknameUpdate(uid) {
  return isActive() && request.auth.uid == uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','nicknameKey'])
    && nicknameValid(request.resource.data.nickname,request.resource.data.nicknameKey)
    && request.resource.data.nicknameKey != resource.data.get('nicknameKey','')
    && getAfter(nicknamePath(request.resource.data.nicknameKey)).data.uid == uid
    && getAfter(nicknamePath(request.resource.data.nicknameKey)).data.nickname == request.resource.data.nickname
    && getAfter(publicNameDoc(uid)).data.nickname == request.resource.data.nickname
    && (resource.data.get('nicknameKey','') == ''
        || !existsAfter(nicknamePath(resource.data.nicknameKey)));
}


    // Admin editing: limit fields and preserve the immutable identity/auth fields.
    function validAdminMemberUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() && uid != request.auth.uid
        && changed.hasOnly([
          'role','status','name','nickname','nicknameKey','phone',
          'levels','children','memberKind','memberRelation','accountType','birthDate','adultAt','dmMode','dmUpdatedBy','dmUpdatedAt'
        ])
        && validRole(request.resource.data.role)
        && request.resource.data.get('accountType','') in ['','adult','student']
        && request.resource.data.get('dmMode','auto') in ['auto','on','off']
        && (!changed.hasAny(['dmUpdatedBy','dmUpdatedAt']) || (request.resource.data.dmUpdatedBy == request.auth.uid && request.resource.data.dmUpdatedAt == request.time))
        && (!changed.hasAny(['dmMode']) || (request.resource.data.dmUpdatedBy == request.auth.uid && request.resource.data.dmUpdatedAt == request.time))
        && (request.resource.data.get('birthDate','') == '' || validBirthDate(request.resource.data.birthDate))
        && (resource.data.get('birthDate','') == '' || request.resource.data.get('birthDate','') != '')
        && (request.resource.data.get('adultAt',null) == null || (request.resource.data.adultAt is timestamp && validBirthDate(request.resource.data.get('birthDate',''))))
        && (!changed.hasAny(['birthDate']) || changed.hasAny(['adultAt']) || request.resource.data.get('adultAt',null) == null)
        && request.resource.data.status in ['approved','suspended']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.get('phone','') is string
        && request.resource.data.get('phone','').size() <= 40
        && request.resource.data.get('levels',[]) is list
        && request.resource.data.get('levels',[]).size() <= 3
        && request.resource.data.get('levels',[]).hasOnly(['mat','elem','col'])
        && validChildren(request.resource.data.get('children',[]))
        && request.resource.data.get('memberKind','') in [
          '','parent','alumnus','alumni-parent','teacher','contributor'
        ]
        && request.resource.data.get('memberRelation','') is string
        && request.resource.data.get('memberRelation','').size() <= 60
        // A nickname change must atomically update the reservation and public alias.
        && (!changed.hasAny(['nickname','nicknameKey']) || (
          changed.hasAll(['nickname','nicknameKey'])
          && nicknameValid(request.resource.data.nickname,request.resource.data.nicknameKey)
          && request.resource.data.nicknameKey != resource.data.get('nicknameKey','')
          && getAfter(nicknamePath(request.resource.data.nicknameKey)).data.uid == uid
          && getAfter(nicknamePath(request.resource.data.nicknameKey)).data.nickname == request.resource.data.nickname
          && getAfter(publicNameDoc(uid)).data.nickname == request.resource.data.nickname
          && (resource.data.get('nicknameKey','') == ''
              || !existsAfter(nicknamePath(resource.data.nicknameKey)))
        ));
    }

    // Direct list-row changes are independent of unrelated profile data.
    function validAdminMessagingUpdate(uid) {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return isAdmin() && resource.data.status == 'approved'
        && resource.data.role in ['member','special','admin']
        && changed.hasOnly(['dmMode','dmUpdatedBy','dmUpdatedAt'])
        && next.get('dmMode','auto') in ['auto','on','off']
        && next.dmUpdatedBy == request.auth.uid && next.dmUpdatedAt == request.time;
    }
    match /members/{uid} {
      // Member profiles remain private; only admins can list members.
      allow get: if signedIn() && request.auth.uid == uid || isAdmin();
      allow list: if isAdmin();
      allow create: if validRegistration(uid);
      allow update: if validAdminMessagingUpdate(uid) || validSelfNicknameUpdate(uid) || validAdminMemberUpdate(uid);
      allow delete: if false;
    }

match /nicknames/{key} {
  allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
  allow list: if isAdmin();
  allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['uid','nickname','createdAt'])
    && request.resource.data.keys().hasAll(['uid','nickname','createdAt'])
    && (request.resource.data.uid == request.auth.uid || isAdmin())
    && nicknameValid(request.resource.data.nickname,key)
    && request.resource.data.createdAt == request.time
    && getAfter(memberDoc(request.resource.data.uid)).data.nicknameKey == key
    && getAfter(memberDoc(request.resource.data.uid)).data.nickname == request.resource.data.nickname
    && getAfter(publicNameDoc(request.resource.data.uid)).data.nickname == request.resource.data.nickname
    && (!exists(memberDoc(request.resource.data.uid))
        || get(memberDoc(request.resource.data.uid)).data.get('nicknameKey','') != key);
  allow update: if false;
  // An old reservation can be released only when the member changes their key.
  allow delete: if verified() && (resource.data.uid == request.auth.uid || isAdmin())
    && existsAfter(memberDoc(resource.data.uid))
    && getAfter(memberDoc(resource.data.uid)).data.get('nicknameKey','') != key;
}
// Public alias only, never exposes a real name, e-mail or student information.
match /publicNames/{uid} {
  allow get, list: if isActive();
  allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin())
    && request.resource.data.keys().hasOnly(['nickname','updatedAt','role','canReceiveDM'])
    && request.resource.data.keys().hasAll(['nickname','updatedAt','canReceiveDM'])
    && request.resource.data.updatedAt == request.time
    && request.resource.data.canReceiveDM is bool
    && request.resource.data.canReceiveDM == dmAllowedFor(getAfter(memberDoc(uid)).data)
    && request.resource.data.get('role','') == getAfter(memberDoc(uid)).data.role
    && getAfter(memberDoc(uid)).data.nickname == request.resource.data.nickname
    && getAfter(memberDoc(uid)).data.nicknameKey == request.resource.data.nickname.lower();
  allow delete: if false;
}
// Real-name correction is requested privately and confirmed by an administrator.
match /nameChangeRequests/{uid} {
  allow get: if isAdmin() || (isActive() && request.auth.uid == uid);
  allow list: if isAdmin();
  allow create: if isActive() && request.auth.uid == uid
    && !exists(/databases/$(database)/documents/nameChangeRequests/$(uid))
    && request.resource.data.keys().hasOnly(['uid','currentName','requestedName','status','createdAt'])
    && request.resource.data.keys().hasAll(['uid','currentName','requestedName','status','createdAt'])
    && request.resource.data.uid == uid
    && request.resource.data.currentName == me().name
    && request.resource.data.requestedName is string
    && request.resource.data.requestedName.size() > 0
    && request.resource.data.requestedName.size() <= 80
    && request.resource.data.status == 'pending'
    && request.resource.data.createdAt == request.time;
  allow update: if (isAdmin()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
      && request.resource.data.status in ['approved','rejected']
      && request.resource.data.reviewedBy == request.auth.uid
      && request.resource.data.reviewedAt == request.time)
    || (isActive() && request.auth.uid == uid && resource.data.status == 'rejected'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'currentName','requestedName','status','createdAt','reviewedAt','reviewedBy'])
      && request.resource.data.currentName == me().name
      && request.resource.data.requestedName is string
      && request.resource.data.requestedName.size() > 0
      && request.resource.data.requestedName.size() <= 80
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time);
  allow delete: if false;
}


function validChild(c) {
  return c is map
    && c.keys().hasOnly(['studentName','school','grade'])
    && c.keys().hasAll(['studentName','school','grade'])
    && c.studentName is string && c.studentName.size() > 0 && c.studentName.size() <= 100
    && c.school is string && c.school.size() > 0 && c.school.size() <= 100
    && c.grade is string && c.grade.size() > 0 && c.grade.size() <= 100;
}
function validChildren(a) {
  return a is list && a.size() <= 5
    && (a.size() < 1 || validChild(a[0]))
    && (a.size() < 2 || validChild(a[1]))
    && (a.size() < 3 || validChild(a[2]))
    && (a.size() < 4 || validChild(a[3]))
    && (a.size() < 5 || validChild(a[4]));
}
function validUpgrade(uid) {
      return isActive() && request.auth.uid == uid && me().role == 'general'
        && request.resource.data.uid == uid
        && request.resource.data.applicantName == me().name
        && request.resource.data.applicantEmail == request.auth.token.email
        && request.resource.data.requestedRole in ['member','special']
        && request.resource.data.kind in ['parent','alumnus','alumni-parent','teacher','contributor']
        && (request.resource.data.requestedRole == 'member' && request.resource.data.kind == 'parent'
           || request.resource.data.requestedRole == 'special' && request.resource.data.kind in ['alumnus','alumni-parent','teacher','contributor'])
        && (request.resource.data.get('startYear',null) == null || request.resource.data.startYear is int && request.resource.data.startYear >= 2000 && request.resource.data.startYear <= 2100)
        && (!(request.resource.data.kind in ['alumnus','alumni-parent']) || (request.resource.data.startYear is int && request.resource.data.schoolYear is int && request.resource.data.startYear <= request.resource.data.schoolYear))
        && (request.resource.data.get('schoolYear',null) == null || request.resource.data.schoolYear is int
            && request.resource.data.schoolYear >= 2000 && request.resource.data.schoolYear <= 2100)
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && validChildren(request.resource.data.get('children',[]))
        // Parent and alumni applications require at least one verifiable student record.
        && (!(request.resource.data.kind in ['parent','alumnus','alumni-parent'])
            || request.resource.data.get('children',[]).size() >= 1)
        && request.resource.data.get('relation','') is string
        && request.resource.data.get('relation','').size() <= 40
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }
    match /upgradeRequests/{uid} {
      allow get: if isAdmin() || verified() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'uid','applicantName','applicantEmail','requestedRole','kind','schoolYear','startYear','note','children','relation','status','createdAt'
        ]) && validUpgrade(uid);
      // A rejected applicant can submit a new request; the previous review is retained.
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time)
        || (verified() && request.auth.uid == uid && resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'requestedRole','kind','schoolYear','startYear','note','children','relation','status','createdAt'
          ]) && validUpgrade(uid));
      allow delete: if isAdmin();
    }
    // Confidential suggestions: author sees own, administrators see all.
    match /suggestions/{id} {
      allow get, list: if isAdmin() || (isActive() && resource.data.uid == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid','category','subject','body','status','createdAt'])
        && request.resource.data.keys().hasAll(['uid','category','subject','body','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['operations','school','events','question','confidential']
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
        && request.resource.data.status == 'received' && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','response','respondedBy','respondedAt'])
        && request.resource.data.status in ['received','reviewing','answered','closed']
        && request.resource.data.get('response','') is string
        && request.resource.data.get('response','').size() <= 3000
        && request.resource.data.respondedBy == request.auth.uid
        && request.resource.data.respondedAt == request.time;
      allow delete: if false;
    }
    function allowedMime(m) {
      return m in [
        'application/pdf', 'image/jpeg', 'image/png', 'image/webp',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation'
      ];
    }
    function validFileRecord(prefix,id) {
      return request.resource.data.keys().hasOnly([
          'title','filename','mime','storagePath','createdBy','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'title','filename','mime','storagePath','createdBy','createdAt'
        ])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.filename is string && request.resource.data.filename.size() > 0
        && request.resource.data.filename.size() <= 255
        && allowedMime(request.resource.data.mime)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.storagePath.matches('^' + prefix + '/' + id + '/[^/]+$');
    }
    function validAttachment(f) {
      return f is map
        && f.keys().hasOnly(['id','name','mime','size'])
        && f.keys().hasAll(['id','name','mime','size'])
        && f.id is string && f.id.matches('^[A-Za-z0-9_-]{12,128}$')
        && f.name is string && f.name.size() > 0 && f.name.size() <= 255
        && f.mime in [
          'application/pdf','image/jpeg','image/png','image/webp','text/plain',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        ]
        && f.size is int && f.size > 0 && f.size <= 20000000;
    }
    // Keep validation below Firestore's 1,000-expression limit per request.
    // A post may contain up to 8 individually validated attachments, 20MB total.
    // The private media Worker independently verifies all filenames, MIME types,
    // declared lengths and actual bytes before accepting a B2 upload.
    function validAttachments(a) {
      return a is list && a.size() <= 8
        && (a.size() == 0 || validAttachment(a[0]))
        && (a.size() <= 1 || validAttachment(a[1]))
        && (a.size() <= 2 || validAttachment(a[2]))
        && (a.size() <= 3 || validAttachment(a[3]))
        && (a.size() <= 4 || validAttachment(a[4]))
        && (a.size() <= 5 || validAttachment(a[5]))
        && (a.size() <= 6 || validAttachment(a[6]))
        && (a.size() <= 7 || validAttachment(a[7]))
        ;
    }
    function resourceCategoryAllowed(category) {
      return category is string && category.size() <= 24 && !(category in ['common','general'])
        && (category in ['kindergarten','elementary','middle','other']
          || (exists(/databases/$(database)/documents/siteSettings/resourceCategories)
            && category in get(/databases/$(database)/documents/siteSettings/resourceCategories).data.get('keys',[])));
    }
    function validLearningCreate(id) {
      return hasGalleryAccess()
        && request.resource.data.keys().hasOnly([
          'title','body','category','authorUid','status','files','bytesTotal','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'title','body','category','authorUid','status','files','bytesTotal','createdAt'
        ])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.body is string && request.resource.data.body.size() <= 10000
        && resourceCategoryAllowed(request.resource.data.category)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && validAttachments(request.resource.data.files)
        && request.resource.data.bytesTotal is int
        && request.resource.data.bytesTotal >= 0
        && request.resource.data.bytesTotal <= 20000000
        && request.resource.data.createdAt == request.time;
    }
    function validGalleryImage(f) {
      return f is map && f.keys().hasOnly(['id','mime','size'])
        && f.keys().hasAll(['id','mime','size'])
        && f.id is string && f.id.matches('^[A-Za-z0-9_-]{12,128}$')
        && f.mime in ['image/webp','image/jpeg','video/mp4','video/webm']
        && f.size is int && f.size > 0 && f.size <= 20000000
        && ((f.mime in ['image/webp','image/jpeg'] && f.size <= 1500000)
          || (f.mime in ['video/mp4','video/webm']));
    }
    function validGalleryCreate(id) {
      let a = galleryAlbum(request.resource.data.get('albumId',''));
      return hasGalleryAccess() && galleryReady()
        && request.resource.data.keys().hasOnly([
          'albumId','title','description','authorUid','status','image','createdAt',
          'mediaType','originalName','reviewReason','sortOrder'
        ])
        && request.resource.data.keys().hasAll([
          'albumId','title','description','authorUid','status','image','createdAt',
          'mediaType','originalName','reviewReason','sortOrder'
        ])
        && request.resource.data.albumId is string
        && exists(a)
        && (get(a).data.ownerUid == request.auth.uid || get(a).data.isShared == true)
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string && request.resource.data.description.size() <= 3000
        && request.resource.data.originalName is string && request.resource.data.originalName.size() <= 255
        && request.resource.data.reviewReason in ['','consent_uncertain']
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.mediaType in ['photo','video']
        && ((request.resource.data.mediaType == 'photo' && request.resource.data.image.mime in ['image/webp','image/jpeg'])
          || (request.resource.data.mediaType == 'video' && request.resource.data.image.mime in ['video/mp4','video/webm']))
        && request.resource.data.sortOrder is number
        && validGalleryImage(request.resource.data.image)
        && request.resource.data.createdAt == request.time;
    }
    function onlyPublishOwnDraft() {
      return isActive() && resource.data.get('authorUid','') == request.auth.uid
        && resource.data.get('status','') == 'draft'
        && request.resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }
    function validLearningEdit() {
      return hasGalleryAccess()
        && resource.data.get('authorUid','') == request.auth.uid
        && resource.data.get('status','') == 'published'
        && request.resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body','category','files','bytesTotal','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 10000
        && resourceCategoryAllowed(request.resource.data.category)
        && validAttachments(request.resource.data.files)
        && request.resource.data.bytesTotal is int && request.resource.data.bytesTotal >= 0 && request.resource.data.bytesTotal <= 20000000
        && request.resource.data.updatedAt == request.time;
    }
    match /learningResources/{id} {
      allow get, list: if isActive();
      allow create: if (isAdmin() && validFileRecord('learning',id)) || validLearningCreate(id);
      allow update: if (hasGalleryAccess() && onlyPublishOwnDraft()) || validLearningEdit();
      allow delete: if isAdmin() || (hasGalleryAccess() && resource.data.get('authorUid','') == request.auth.uid);
      match /comments/{commentId} {
        allow get, list: if isActive() && exists(/databases/$(database)/documents/learningResources/$(id))
          && get(/databases/$(database)/documents/learningResources/$(id)).data.get('status','') == 'published';
        allow create: if hasGalleryAccess()
          && exists(/databases/$(database)/documents/learningResources/$(id))
          && get(/databases/$(database)/documents/learningResources/$(id)).data.get('status','') == 'published'
          && validCommentCreate();
        allow update: if hasGalleryAccess()
          && exists(/databases/$(database)/documents/learningResources/$(id))
