      allow create: if request.resource.data.get('recipientUid','') is string && canSendTo(request.resource.data.recipientUid)
        && request.resource.data.keys().hasOnly([
          'senderUid','recipientUid','body','createdAt','readAt'])
        && request.resource.data.keys().hasAll([
          'senderUid','recipientUid','body','createdAt','readAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.body is string && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.readAt == null;
      allow update: if isActive() && messagingEnabled() && isDmAccount(request.auth.uid)
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && resource.data.readAt == null && request.resource.data.readAt == request.time;
      allow delete: if false;
    }
    // Anything not explicitly approved above is denied.
    match /{document=**} { allow read, write: if false; }
  }
}