        const title=el('button',item.title||tr('제목 없음','Sans titre')) as HTMLButtonElement;
        title.type='button';title.className='board-title-link';title.addEventListener('click',()=>openResource(item));
        subject.append(badge,title);
        if(item.status==='published'){const comments=el('button',tr('댓글 보기·작성','Commentaires')) as HTMLButtonElement;comments.type='button';comments.className='resource-comments-link';comments.addEventListener('click',()=>{openResource(item);by<HTMLElement>('resource-comments')?.scrollIntoView({block:'start'});});subject.append(comments);}
        const author=el('span',tr('회원','Membre'));author.className='board-author';
        void publicAuthor(item.authorUid||'').then(authorInfo=>{if(row.isConnected)displayAuthor(author,authorInfo,item.authorUid||'',uid,role,viewerDM,fr,messageUrl);});
        const date=el('span',stamp(item.createdAt));date.className='board-date';
        row.append(number,subject,author,date);list.append(row);
