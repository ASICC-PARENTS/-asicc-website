---
import Base from '../../../layouts/Base.astro';
import { href, L, type Lang } from '../../../i18n/ui';
export const getStaticPaths = () => ['ko', 'fr'].flatMap(lang => ['learning','office'].map(area => ({params:{lang,area}})));
const lang = Astro.params.lang as Lang;
const area = Astro.params.area as 'learning'|'gallery'|'office';
const titles = {
  learning: {ko:'학습자료실',fr:'Ressources pédagogiques'},
  gallery: {ko:'갤러리',fr:'Galerie'},
  office: {ko:'온라인 협회사무실',fr:'Bureau de l’association'}
};
const live = import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === 'true';
---
<Base lang={lang} rest={`membres/${area}/`} title={L(lang,titles[area])} noindex>
  <section class="wrap m-shell board-shell">
    <div class="stack gap-16" id="files-root" data-lang={lang} data-area={area} data-login-url={href(lang,'membres/login/')}>
      <a href={href(lang,'membres/')} class="small">← {L(lang,{ko:'회원공간',fr:'Espace membres'})}</a>
      <h1 class="h2">{L(lang,titles[area])}</h1>
      <p class="muted">
        {area==='learning' ? L(lang,{
          ko:'가입된 모든 회원이 자료를 열람·다운로드할 수 있습니다. 정회원·특별회원·운영진은 자료를 등록할 수 있으며, 게시글당 첨부파일 총합은 20MB까지입니다.',
          fr:'Tous les membres inscrits peuvent consulter et télécharger les ressources. Les membres, membres spéciaux et administrateurs peuvent publier, avec 20 Mo de pièces jointes par publication.'
        }) : area==='gallery' ? L(lang,{
          ko:'정회원·특별회원·운영진 전용 비공개 사진공간입니다. 사진 등록은 운영진만 가능합니다.',
          fr:'Galerie privée réservée aux membres de l’association, membres spéciaux et administrateurs. Seuls les administrateurs peuvent publier.'
        }) : L(lang,{
          ko:'운영진만 접근 가능한 비공개 문서 공간입니다.',fr:'Espace documentaire confidentiel, réservé aux administrateurs.'
        })}
      </p>
      {!live && <div class="card auth-card" role="status">{L(lang,{
        ko:'회원 인증 기능이 비활성화되어 있습니다.',fr:'L’authentification des membres est désactivée.'
      })}</div>}
      <div id="file-app" hidden={!live} class="stack gap-16">
        <p id="files-status" class="small muted" aria-live="polite" role="status">{L(lang,{ko:'회원 권한 확인 중…',fr:'Vérification des droits…'})}</p>
        <div id="files-controls" hidden class="stack gap-12">
          {area==='learning' && <>
            <div class="files-toolbar board-toolbar">
              <div class="board-search-wrap">
                <span class="board-search-icon" aria-hidden="true">⌕</span>
                <label class="sr-only" for="files-search">{L(lang,{ko:'자료 검색',fr:'Rechercher une ressource'})}</label>
                <input id="files-search" type="search" maxlength="120" placeholder={L(lang,{ko:'자료 제목·내용 검색',fr:'Rechercher un titre ou un texte'})}/>
              </div>
              <label class="sr-only" for="resource-filter">{L(lang,{ko:'학교급 필터',fr:'Filtrer par niveau scolaire'})}</label>
              <select id="resource-filter" class="sr-only" aria-label={L(lang,{ko:'학교급 필터',fr:'Niveau scolaire'})}>
                <option value="all">{L(lang,{ko:'전체',fr:'Tous'})}</option>
                <option value="kindergarten">{L(lang,{ko:'유치원',fr:'Maternelle'})}</option>
                <option value="elementary">{L(lang,{ko:'초등학교',fr:'École élémentaire'})}</option>
                <option value="middle">{L(lang,{ko:'중학교',fr:'Collège'})}</option>
                <option value="other">{L(lang,{ko:'기타',fr:'Autres'})}</option>
              </select>
              <button id="files-open-form" type="button" class="btn btn-dark" hidden>+ {L(lang,{ko:'자료 등록',fr:'Ajouter une ressource'})}</button>
            </div>
            <nav id="resource-category-tabs" class="board-category-tabs" aria-label={L(lang,{ko:'학습자료 분류',fr:'Catégories de ressources'})}>
              <button type="button" class="board-category-tab is-active" data-resource-tab="all" aria-pressed="true">{L(lang,{ko:'전체',fr:'Tout'})}</button>
              <button type="button" class="board-category-tab" data-resource-tab="kindergarten" aria-pressed="false">{L(lang,{ko:'유치원',fr:'Maternelle'})}</button>
              <button type="button" class="board-category-tab" data-resource-tab="elementary" aria-pressed="false">{L(lang,{ko:'초등학교',fr:'École élémentaire'})}</button>
              <button type="button" class="board-category-tab" data-resource-tab="middle" aria-pressed="false">{L(lang,{ko:'중학교',fr:'Collège'})}</button>
              <button type="button" class="board-category-tab" data-resource-tab="other" aria-pressed="false">{L(lang,{ko:'기타',fr:'Autres'})}</button>
            </nav>
            <label id="resource-drafts-wrap" class="small muted" hidden><input type="checkbox" id="resource-show-drafts"/> {L(lang,{ko:'미완성 초안 표시 (운영진)',fr:'Afficher les brouillons incomplets (administration)'})}</label>
            <form id="learning-form" class="card board-editor files-compose stack gap-12" hidden>
              <h2 id="resource-form-heading" class="h3">{L(lang,{ko:'새 학습자료 등록',fr:'Nouvelle ressource'})}</h2>
              <label for="resource-title">{L(lang,{ko:'제목',fr:'Titre'})}</label>
              <input id="resource-title" type="text" required maxlength="150"/>
              <label for="resource-category">{L(lang,{ko:'자료 분류',fr:'Niveau scolaire'})}</label>
              <select id="resource-category" required>
                <option value="" selected disabled>{L(lang,{ko:'자료 분류를 선택하세요',fr:'Choisissez une catégorie'})}</option>
                <option value="kindergarten">{L(lang,{ko:'유치원',fr:'Maternelle'})}</option>
                <option value="elementary">{L(lang,{ko:'초등학교',fr:'École élémentaire'})}</option>
                <option value="middle">{L(lang,{ko:'중학교',fr:'Collège'})}</option>
                <option value="other">{L(lang,{ko:'기타',fr:'Autres'})}</option>
              </select>
              <label for="resource-body">{L(lang,{ko:'내용',fr:'Contenu'})}</label>
              <div class="rich-tools" role="toolbar" aria-label={L(lang,{ko:'글 편집 도구',fr:'Outils de mise en forme'})}>
                <button type="button" data-format="bold" aria-label={L(lang,{ko:'굵게',fr:'Gras'})}><strong>B</strong></button>
                <button type="button" data-format="italic" aria-label={L(lang,{ko:'기울임',fr:'Italique'})}><em>I</em></button>
                <button type="button" data-format="underline" aria-label={L(lang,{ko:'밑줄',fr:'Souligner'})}><u>U</u></button>
                <span class="rich-separator" aria-hidden="true"></span>
                <button type="button" data-format="formatBlock" data-value="h2" aria-label={L(lang,{ko:'큰 제목',fr:'Grand titre'})}>H2</button>
                <button type="button" data-format="formatBlock" data-value="p" aria-label={L(lang,{ko:'본문',fr:'Paragraphe'})}>¶</button>
                <button type="button" data-format="insertUnorderedList" aria-label={L(lang,{ko:'글머리표',fr:'Liste à puces'})}>• ≡</button>
                <button type="button" data-format="insertOrderedList" aria-label={L(lang,{ko:'번호 목록',fr:'Liste numérotée'})}>1. ≡</button>
                <span class="rich-separator" aria-hidden="true"></span>
                <button type="button" data-format="justifyLeft" aria-label={L(lang,{ko:'왼쪽 정렬',fr:'Aligner à gauche'})}>☰</button>
                <button type="button" data-format="justifyCenter" aria-label={L(lang,{ko:'가운데 정렬',fr:'Centrer'})}>≡</button>
                <button type="button" id="resource-rich-link" aria-label={L(lang,{ko:'링크',fr:'Lien'})}>🔗</button>
                <label class="rich-color-label" aria-label={L(lang,{ko:'글자 색상',fr:'Couleur du texte'})}>◉ <input type="color" id="resource-rich-color" value="#254d49" /></label>
                <button type="button" id="resource-rich-undo" aria-label={L(lang,{ko:'실행 취소',fr:'Annuler'})}>↶</button>
                <button type="button" id="resource-rich-redo" aria-label={L(lang,{ko:'다시 실행',fr:'Rétablir'})}>↷</button>
                <span class="rich-separator" aria-hidden="true"></span>
                <button type="button" id="resource-rich-photo" hidden aria-label={L(lang,{ko:'사진 첨부',fr:'Ajouter une photo'})}>▣ {L(lang,{ko:'사진',fr:'Photo'})}</button>
                <input type="file" id="resource-rich-photo-file" accept="image/*" multiple hidden />
              </div>
              <div id="resource-body" class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label={L(lang,{ko:'학습자료 내용',fr:'Texte de la ressource'})} data-placeholder={L(lang,{ko:'내용을 입력하세요…',fr:'Écrivez votre texte…'})}></div>
              <div id="resource-photo-adjust" class="photo-adjust" hidden aria-label={L(lang,{ko:'선택한 사진 크기와 위치',fr:'Taille et position de la photo sélectionnée'})}>
                <div class="photo-adjust-row"><strong>{L(lang,{ko:'사진 편집',fr:'Modifier la photo'})}</strong><span class="small muted">{L(lang,{ko:'사진을 클릭한 뒤 조절하세요',fr:'Sélectionnez une photo pour la modifier'})}</span></div>
                <div class="photo-adjust-row"><label for="resource-photo-width">{L(lang,{ko:'크기',fr:'Taille'})}</label><input id="resource-photo-width" type="range" min="25" max="100" step="5" value="100"/><output id="resource-photo-width-display" for="resource-photo-width">100%</output></div>
                <div class="photo-adjust-row" role="group"><span>{L(lang,{ko:'위치',fr:'Position'})}</span><div class="photo-adjust-buttons"><button type="button" data-resource-photo-align="left">{L(lang,{ko:'왼쪽',fr:'Gauche'})}</button><button type="button" data-resource-photo-align="center">{L(lang,{ko:'가운데',fr:'Centre'})}</button><button type="button" data-resource-photo-align="right">{L(lang,{ko:'오른쪽',fr:'Droite'})}</button></div></div>
                <button id="resource-photo-remove" type="button" class="board-mini-btn board-mini-danger">{L(lang,{ko:'선택한 사진 제거',fr:'Retirer cette photo'})}</button>
              </div>
              <p id="resource-photo-count" class="small muted" aria-live="polite">{L(lang,{ko:'본문 사진 0 / 10장',fr:'Photos intégrées : 0 / 10'})}</p>
              <p id="resource-photo-help" class="small muted" role="status"></p>
              <p class="small muted">{L(lang,{ko:'서식 포함 10,000자 이내, 본문 사진 최대 10장. 사진은 자동 압축됩니다.',fr:'10 000 caractères maximum, 10 photos dans le texte, compressées automatiquement.'})}</p>
              <div id="resource-attachments-field" class="stack gap-8">
                <div id="resource-existing-files" class="stack gap-8" hidden>
                  <strong>{L(lang,{ko:'현재 첨부파일',fr:'Pièces jointes actuelles'})}</strong>
                  <div id="resource-existing-file-list" class="stack gap-8"></div>
                  <p class="small muted">{L(lang,{ko:'파일 제거는 수정 저장을 누른 뒤 적용됩니다. 제거를 취소할 수도 있습니다.',fr:'La suppression sera appliquée à l’enregistrement. Vous pouvez l’annuler.'})}</p>
                </div>
                <label for="resource-files">{L(lang,{ko:'추가할 첨부파일 (여러 개 선택 가능)',fr:'Ajouter des pièces jointes (sélection multiple)'})}</label>
                <input id="resource-files" type="file" multiple accept=".pdf,.docx,.xlsx,.pptx,.txt,.jpg,.jpeg,.png,.webp"/>
                <p id="resource-size" class="small muted" aria-live="polite">{L(lang,{ko:'게시글당 첨부파일 합계 최대 20MB',fr:'Maximum 20 Mo au total par publication'})}</p>
                <ul id="resource-selected-file-names" class="small muted" style="margin:0;padding-left:20px" aria-label={L(lang,{ko:'새로 선택한 파일',fr:'Fichiers sélectionnés'})}></ul>
              </div>
              <p class="small muted">{L(lang,{ko:'자료 등록을 누르면 전송이 시작됩니다. 완료될 때까지 이 화면을 닫지 마세요.',fr:'Le transfert démarre après « Publier ». Gardez cette page ouverte jusqu’à la fin.'})}</p>
              <div id="resource-upload-progress" class="stack gap-8" hidden>
                <label for="resource-progress-bar" id="resource-progress-text">{L(lang,{ko:'파일 전송 준비 중…',fr:'Préparation du transfert…'})}</label>
                <progress id="resource-progress-bar" max="100" value="0">0%</progress>
              </div>
              <p class="small muted">{L(lang,{
                ko:'PDF, Word, Excel, PowerPoint, TXT, JPG, PNG, WebP를 첨부할 수 있습니다. 한 번에 최대 8개입니다.',
                fr:'PDF, Word, Excel, PowerPoint, TXT, JPG, PNG et WebP, jusqu’à 8 fichiers.'
              })}</p>
              <div class="row gap-12" style="flex-wrap:wrap">
                <button id="resource-save" class="btn btn-dark" type="submit">{L(lang,{ko:'자료 등록',fr:'Publier'})}</button>
                <button id="resource-cancel" class="btn btn-ghost" type="button">{L(lang,{ko:'취소',fr:'Annuler'})}</button>
              </div>
            </form>
          </>}
          {area==='gallery' && <>
            <div class="files-toolbar">
              <span class="small muted">{L(lang,{ko:'회원 전용 사진 갤러리',fr:'Photos réservées aux membres'})}</span>
              <button id="gallery-open-form" type="button" class="btn btn-dark" hidden>+ {L(lang,{ko:'사진 등록',fr:'Ajouter une photo'})}</button>
            </div>
            <form id="gallery-form" class="card files-compose stack gap-12" hidden>
              <h2 class="h3">{L(lang,{ko:'갤러리에 사진 등록',fr:'Publier une photo'})}</h2>
              <label for="gallery-title">{L(lang,{ko:'사진 제목',fr:'Titre de la photo'})}</label>
              <input id="gallery-title" type="text" maxlength="150" required/>
              <label for="gallery-description">{L(lang,{ko:'설명',fr:'Description'})}</label>
              <textarea id="gallery-description" rows="3" maxlength="3000"></textarea>
              <label for="gallery-photo">{L(lang,{ko:'사진 선택',fr:'Choisir une photo'})}</label>
              <input id="gallery-photo" type="file" accept="image/jpeg,image/png,image/webp" required/>
              <p class="small muted">{L(lang,{
                ko:'사진은 비공개 저장소에 보관되며 자동으로 압축됩니다. 아동 사진은 게시 동의를 확인한 후 등록하세요.',
                fr:'Les images sont compressées et stockées en privé. Vérifiez le consentement avant de publier des photos de mineurs.'
              })}</p>
              <div class="row gap-12" style="flex-wrap:wrap">
                <button id="gallery-save" type="submit" class="btn btn-dark">{L(lang,{ko:'사진 등록',fr:'Publier la photo'})}</button>
                <button id="gallery-cancel" type="button" class="btn btn-ghost">{L(lang,{ko:'취소',fr:'Annuler'})}</button>
              </div>
            </form>
          </>}
        </div>
        {area==='learning' ? <>
          <section id="files-list-panel" class="board-list-card" aria-label={L(lang,{ko:'학습자료 목록',fr:'Liste des ressources'})}>
            <div class="board-table-head">
              <span>{L(lang,{ko:'번호',fr:'N°'})}</span>
              <span>{L(lang,{ko:'제목',fr:'Titre'})}</span>
              <span>{L(lang,{ko:'작성자',fr:'Auteur'})}</span>
              <span>{L(lang,{ko:'날짜',fr:'Date'})}</span>
            </div>
            <div id="files-list"></div>
            <p id="files-count" class="board-count" aria-live="polite"></p>
          </section>
          <article id="files-detail" class="card board-detail stack gap-16" hidden>
            <button id="files-back" type="button" class="btn btn-ghost board-back">← {L(lang,{ko:'목록으로',fr:'Retour à la liste'})}</button>
            <div id="files-detail-content" class="stack gap-12"></div>
            <section id="resource-comments" class="stack gap-12" hidden>
              <h3 class="h3">{L(lang,{ko:'댓글',fr:'Commentaires'})} <span id="resource-comment-count" class="small muted"></span></h3>
              <div id="resource-comment-list" class="stack gap-8"></div>
              <p id="resource-comment-readonly" class="small muted" hidden>{L(lang,{ko:'정회원·특별회원·운영진은 댓글을 작성할 수 있습니다.',fr:'Les membres approuvés peuvent commenter.'})}</p>
              <form id="resource-comment-form" class="stack gap-8" hidden>
                <label for="resource-comment-body">{L(lang,{ko:'댓글 작성',fr:'Ajouter un commentaire'})}</label>
                <textarea id="resource-comment-body" maxlength="2000" rows="3" required></textarea>
                <button id="resource-comment-save" class="btn btn-dark" type="submit">{L(lang,{ko:'댓글 등록',fr:'Publier le commentaire'})}</button>
              </form>
            </section>
          </article>
        </> : <div id="files-list" class="stack gap-12"></div>}
      </div>
    </div>
  </section>
  <dialog id="gallery-viewer" aria-label={L(lang,{ko:'사진 크게 보기',fr:'Agrandir la photo'})}>
    <button id="gallery-viewer-close" class="files-mini-btn" type="button">{L(lang,{ko:'닫기 ✕',fr:'Fermer ✕'})}</button>
    <img id="gallery-viewer-image" alt="" />
  </dialog>
</Base>
<style>
  .files-toolbar {display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
  .files-toolbar .board-search-wrap {flex:1 1 280px;max-width:450px}
  .files-toolbar .board-search-wrap input {width:100%;max-width:none;min-width:0}
  #resource-drafts-wrap {align-items:center;gap:8px;cursor:pointer}
  #resource-drafts-wrap:not([hidden]) {display:flex}
  :global(#files-detail-content .files-post) {border:0;background:transparent;padding:0}
  :global(#files-detail-content .files-post-body) {white-space:normal;overflow-wrap:anywhere;line-height:1.8;min-height:0}
  :global(#files-detail-content .files-post-body img) {max-width:100%;height:auto;object-fit:contain}
  :global(#files-detail-content .files-attachment) {display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:12px 14px;background:#f8faf9;border:1px solid #e1e9e4;border-radius:8px}
  :global(#files-detail-content .files-attachment span) {min-width:0;overflow-wrap:anywhere;flex:1}
  :global(#files-detail-content .files-mini-btn) {border:1px solid #d7dce0;background:#fff;color:inherit;padding:7px 12px;border-radius:8px;cursor:pointer}
  @media(max-width:650px){.files-compose{padding:18px 16px}}
  .files-toolbar select {min-width:150px;max-width:100%;padding:10px 12px;border:1px solid #d7dce0;border-radius:9px;background:#fff}
  .files-compose select {width:100%;padding:10px 12px;border:1px solid #d7dce0;border-radius:9px;background:#fff}
  .files-category-label {display:inline-block;margin:0 0 6px;padding:4px 10px;background:#eef5ef;border:1px solid #d3e6d7;border-radius:999px;font-size:.8rem;width:max-content;max-width:100%}
  .files-compose {padding:30px;max-width:none;width:100%}
  .files-compose input:not([type=file]),.files-compose textarea {width:100%}
  .files-post {padding:20px;border:1px solid #e0e6e8;border-radius:12px;background:#fff;min-width:0}
  .files-post h2,.files-gallery-tile h2 {margin:0;font-size:1.1rem;line-height:1.5;overflow-wrap:anywhere}
  .files-post-body {white-space:pre-wrap;overflow-wrap:anywhere}
  .files-attachment {display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;border:1px solid #e2e8f0;border-radius:10px;padding:10px 14px}
  .files-attachment span {overflow-wrap:anywhere;min-width:0;flex:1}
  .files-gallery-grid {display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),1fr));gap:16px}
  .files-gallery-tile {overflow:hidden;background:#fff;border:1px solid #e0e6e8;border-radius:12px}
  .files-gallery-tile img {display:block;width:100%;height:220px;object-fit:cover;cursor:zoom-in;background:#f3f5f7}
  .files-gallery-caption {padding:16px;display:grid;gap:8px}
  .files-gallery-caption p {white-space:pre-wrap;overflow-wrap:anywhere}
  .files-mini-btn {border:1px solid #d7dce0;background:white;color:inherit;padding:6px 10px;border-radius:8px;font:inherit;cursor:pointer}
  .files-mini-btn:disabled {opacity:.6;cursor:wait}
  #resource-progress-bar {display:block;width:100%;height:15px;accent-color:#427b64}
  #resource-save:disabled,#resource-cancel:disabled {opacity:.6;cursor:wait}
  #resource-rich-photo[hidden],#resource-rich-photo-file[hidden],#resource-attachments-field[hidden],#resource-existing-files[hidden] {display:none!important}
  #gallery-viewer {max-width:min(92vw,980px);border:0;border-radius:12px;padding:12px;background:#fff}
  #gallery-viewer::backdrop {background:rgba(0,0,0,.82)}
  #gallery-viewer img {display:block;max-width:85vw;max-height:78vh;object-fit:contain}
</style>
<script>
  import { getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, getIdToken } from 'firebase/auth';
  import {displayAuthor,dmAllowed,syncOwnAlias,type PublicAuthor} from '../../../scripts/members/member-access';
  import { getFirestore, doc, collection, getDoc, getDocs, query, orderBy, limit, setDoc, updateDoc, deleteDoc, writeBatch, serverTimestamp, Timestamp } from 'firebase/firestore';
