  async function removeRecord(item:Entry,button:HTMLButtonElement){
    if(!confirm(tr('이 자료를 삭제할까요? 파일도 삭제되며 복구할 수 없습니다.','Supprimer ce contenu et son fichier définitivement ?')))return;
    button.disabled=true;
    let cleanupFailed=false;
    try{
      // Check comment-read permission before deleting any stored attachment.
      // Without the live Firestore comment rule even an empty collection query fails.
      const commentDocs=area==='learning'
        ? await getDocs(query(collection(db,'learningResources',item.id,'comments'),limit(451)))
        : null;
      if(commentDocs&&commentDocs.size>450)throw Error(tr('댓글이 너무 많아 한 번에 삭제할 수 없습니다.','Trop de commentaires pour une suppression.'));
      try{
        if(item.files?.length)await media(`/api/resource?postId=${encodeURIComponent(item.id)}`,'DELETE');
        else if(item.image)await media(`/api/gallery?itemId=${encodeURIComponent(item.id)}`,'DELETE');
      }catch(error){
        // A failed upload may have created no file. Do not let its Worker error
        // prevent the author from removing the Firestore draft itself.
        if(item.status!=='draft')throw error;
        cleanupFailed=true;console.warn('Draft file cleanup failed',error);
      }
      if(area==='learning'){
        const batch=writeBatch(db);
        for(const comment of commentDocs?.docs||[])batch.delete(comment.ref);
        batch.delete(doc(db,'learningResources',item.id));await batch.commit();
        entries=entries.filter(entry=>entry.id!==item.id);
        if(selectedResourceId===item.id)backResource();render();
      }else await deleteDoc(doc(db,'galleryItems',item.id));
      note(cleanupFailed
        ?tr('미완성 초안을 삭제했습니다. 저장소에 파일이 남았을 수 있으니 운영진에게 알려 주세요.','Brouillon supprimé. Un fichier peut subsister sur le stockage : contactez les administrateurs.')
        :tr('삭제했습니다.','Contenu supprimé.'));
      if(area!=='learning')await refresh();
    }catch(error){
      console.error(error);
      const detail=error instanceof Error?error.message:'';
      const denied=(error as {code?:string})?.code==='permission-denied';
      note(denied
        ? tr('Firebase가 자료 또는 댓글 조회·삭제 권한을 거부했습니다. 실제 Firestore Rules에 학습자료 댓글 규칙이 게시되었는지 확인해 주세요.','Firebase refuse la lecture/suppression. Vérifiez les règles Firestore de commentaires publiées.')
        : `${tr('삭제할 수 없습니다. Firebase 규칙 또는 파일 서버 권한을 확인하세요.','Suppression impossible. Vérifiez les règles Firebase et les droits du serveur.')} ${detail}`.trim(),true);
    }finally{button.disabled=false;}
  }
  function contentType(file:File){const ext=file.name.split('.').pop()?.toLocaleLowerCase()||'';return MIME[ext]||'';}
  function validateFiles(selected:File[]){
    if(selected.length>MAX_FILES)throw Error(tr('파일은 한 게시글당 최대 8개까지입니다.','8 fichiers maximum par publication.'));
    let sum=0;
    for(const file of selected){
      if(!contentType(file)||!file.size||file.name.length>255)throw Error(tr('파일 종류·이름·크기를 확인해 주세요.','Vérifiez le format, le nom et la taille des fichiers.'));
      sum+=file.size;
    }
    if(sum>MAX_TOTAL)throw Error(tr('첨부파일 총합이 20MB를 초과했습니다.','Le total des fichiers dépasse 20 Mo.'));
    return sum;
  }
  by<HTMLInputElement>('resource-files')?.addEventListener('change',updateAttachmentSummary);
  let resourceSubmitting=false;
  by<HTMLFormElement>('learning-form')?.addEventListener('submit',async event=>{
    event.preventDefault();if(resourceSubmitting||!uid||!canLearningPost())return;
    const files=Array.from(by<HTMLInputElement>('resource-files')?.files||[]);
    const title=by<HTMLInputElement>('resource-title')?.value.trim()||'';
    const category=by<HTMLSelectElement>('resource-category')?.value||'';
    const body=resourceEditor?serializeEditor(resourceEditor):'';
    if(photoBusy)return note(tr('사진 전송이 끝난 후 저장해 주세요.','Attendez la fin du transfert photo.'),true);
    if(!title||title.length>150||!validCategory(category)||body.length>10000||numPhotos()>10)
      return note(tr('제목·분류·본문 길이를 확인해 주세요. (서식 포함 10,000자)','Vérifiez le titre, la catégorie et la limite de 10 000 caractères.'),true);
    if(editingResourceId){
      const existing=entries.find(e=>e.id===editingResourceId);
      if(!existing||existing.authorUid!==uid||existing.status!=='published')return note(tr('수정 권한이 없습니다.','Modification refusée.'),true);
      const kept=remainingAttachments(existing);
      const newParts:ResourcePart[]=files.map(file=>({id:crypto.randomUUID(),name:file.name,mime:contentType(file),size:file.size}));
      const manifest=[...kept,...newParts];
      const total=manifest.reduce((sum,part)=>sum+part.size,0);
      if(manifest.length>MAX_FILES||total>MAX_TOTAL)return note(tr('첨부파일은 최대 8개, 합계 20MB까지입니다.','Maximum 8 fichiers et 20 Mo au total.'),true);
      try{for(const file of files)if(!contentType(file)||!file.size||file.name.length>255)throw Error(tr('추가 파일의 종류·이름·크기를 확인해 주세요.','Vérifiez les nouveaux fichiers.'));}
      catch(error){return note(String(error),true);}
      if(newParts.length&&!api)return note(tr('파일 서버가 연결되지 않았습니다.','Serveur de fichiers indisponible.'),true);
      const changedAttachments=removedAttachmentIds.size>0||newParts.length>0;
      const save=by<HTMLButtonElement>('resource-save'),cancel=by<HTMLButtonElement>('resource-cancel');
      const progress=by<HTMLProgressElement>('resource-progress-bar'),progressText=by<HTMLElement>('resource-progress-text');
      resourceSubmitting=true;
      if(save){save.disabled=true;save.textContent=tr('저장 중…','Enregistrement…');}
      if(cancel)cancel.disabled=true;
      const uploaded:string[]=[];let metadataSaved=false;
      try{
        if(newParts.length){
          show('resource-upload-progress',true);if(progress)progress.value=0;
          const addedBytes=files.reduce((sum,file)=>sum+file.size,0);
          let completed=0;
          for(let i=0;i<files.length;i++){
            const part=newParts[i];
            await uploadResource(`/api/resource-upload?postId=${encodeURIComponent(existing.id)}&fileId=${encodeURIComponent(part.id)}`,files[i],part.mime,sent=>{
              const percent=Math.min(99,Math.floor((completed+sent)*100/addedBytes));
              if(progress)progress.value=percent;
              if(progressText)progressText.textContent=tr(`추가 파일 전송 ${i+1}/${files.length} · ${percent}%`,`Transfert ${i+1}/${files.length} · ${percent} %`);
            });
            uploaded.push(part.id);completed+=files[i].size;
          }
          if(progress)progress.value=100;
          if(progressText)progressText.textContent=tr('전송 완료 · 수정 저장 중…','Transfert terminé · Enregistrement…');
        }
        const updates:Record<string,unknown>={title,body,category,updatedAt:serverTimestamp()};
        if(changedAttachments){updates.files=manifest;updates.bytesTotal=total;}
        await updateDoc(doc(db,'learningResources',existing.id),updates);metadataSaved=true;
        const modified:Entry={...existing,title,body,category:category as SchoolCategory,
          files:changedAttachments?manifest:existing.files,bytesTotal:changedAttachments?total:existing.bytesTotal,updatedAt:Timestamp.now()};
        entries=entries.map(entry=>entry.id===existing.id?modified:entry);
        // Removed files are no longer in Firestore; delete their B2 objects now.
        // A cleanup error must not undo a successful metadata update.
        let cleanupError=false;
        for(const part of (existing.files||[]).filter(f=>removedAttachmentIds.has(f.id))){
          try{await media(`/api/resource?postId=${encodeURIComponent(existing.id)}&fileId=${encodeURIComponent(part.id)}`,'DELETE');}
          catch(error){cleanupError=true;console.warn('Removed attachment cleanup failed',error);}
        }
        closeResourceForm();render();openResource(modified);
        note(cleanupError?tr('수정은 저장됐지만 삭제된 파일의 저장소 정리는 확인이 필요합니다.','Modification enregistrée, nettoyage du stockage à vérifier.')
          :tr('수정되었습니다.','Ressource modifiée.'),cleanupError);
      }catch(error){
        console.error(error);
        // Never delete a new attachment after Firestore has already saved its metadata.
        if(!metadataSaved){
          for(const fileId of uploaded){try{await media(`/api/resource?postId=${encodeURIComponent(existing.id)}&fileId=${encodeURIComponent(fileId)}`,'DELETE');}catch(cleanup){console.warn('Unpublished attachment cleanup failed',cleanup);}}
        }
        note(metadataSaved
          ?tr('수정은 저장되었으나 화면 갱신에 실패했습니다. 새로고침해 주세요.','Modification enregistrée. Rechargez la page.')
          :`${tr('수정 실패','Échec de la modification')}: ${error instanceof Error?error.message:String(error)}`,true);
      }finally{
        resourceSubmitting=false;show('resource-upload-progress',false);
        if(save){save.disabled=false;save.textContent=tr('수정 저장','Enregistrer');}
        if(cancel)cancel.disabled=false;
      }
      return;
    }
    const save=by<HTMLButtonElement>('resource-save');
    const cancel=by<HTMLButtonElement>('resource-cancel');
    const progress=by<HTMLProgressElement>('resource-progress-bar');
    const progressText=by<HTMLElement>('resource-progress-text');
    // Title and category were validated above, before the edit branch.
    let total=0;try{total=validateFiles(files);}catch(error){return note(String(error),true);}
    if(files.length&&!api)return note(tr('비공개 파일 서버가 연결되지 않았습니다.','Le serveur de fichiers privés n’est pas configuré.'),true);
    resourceSubmitting=true;
    if(save){save.disabled=true;save.textContent=tr('전송 중…','Transfert…');}
    if(cancel)cancel.disabled=true;
    show('resource-upload-progress',files.length>0);
    if(progress)progress.value=0;
    if(files.length&&progressText)progressText.textContent=tr('파일 전송 준비 중… 0%','Préparation du transfert… 0 %');
    let draftId='',draftFileId='';
    try{
      const record=doc(collection(db,'learningResources'));
      const manifest:ResourcePart[]=files.map(f=>({id:crypto.randomUUID(),name:f.name,mime:contentType(f),size:f.size}));
      // Create a private draft first; a post becomes visible only on success.
      // Text-only posts can be published in one write; files still use a private draft.
      await setDoc(record,{title,body,category,authorUid:uid,status:files.length?'draft':'published',files:manifest,bytesTotal:total,createdAt:serverTimestamp()});
      draftId=record.id;draftFileId=manifest[0]?.id||'';
      let completed=0;
      for(let i=0;i<files.length;i++){
        const current=i;
        const updateProgress=(sent:number)=>{
          const percent=Math.min(99,Math.floor((completed+sent)*100/total));
          if(progress)progress.value=percent;
          if(progressText)progressText.textContent=tr(`파일 전송 중 ${current+1}/${files.length} · ${percent}%`,`Transfert ${current+1}/${files.length} · ${percent} %`);
        };
        updateProgress(0);
        await uploadResource(`/api/resource-upload?postId=${encodeURIComponent(record.id)}&fileId=${encodeURIComponent(manifest[i].id)}`,files[i],manifest[i].mime,updateProgress);
        completed+=files[i].size;
      }
      if(files.length){
        if(progress)progress.value=100;
        if(progressText)progressText.textContent=tr('전송 100% · 게시 완료 처리 중…','Transfert 100 % · Publication en cours…');
        await updateDoc(record,{status:'published',updatedAt:serverTimestamp()});
      }
      // Publication has been confirmed by Firestore. Show the new post immediately
      // from the data already sent, without an extra query or a manual reload.
      // The stored createdAt remains the server timestamp; this is display-only.
      const published:Entry={id:record.id,title,body,category:category as SchoolCategory,authorUid:uid,
        status:'published',files:manifest,bytesTotal:total,createdAt:Timestamp.now()};
      entries=[published,...entries.filter(item=>item.id!==record.id)].slice(0,100);
      by<HTMLFormElement>('learning-form')?.reset();resetResourceEditor();
      const search=by<HTMLInputElement>('files-search');if(search)search.value='';
      const filter=by<HTMLSelectElement>('resource-filter');if(filter)filter.value='all';
      syncResourceTabs();
      closeResourceForm();
      show('resource-upload-progress',false);
      render();
      openResource(published);
      note(files.length?tr('파일 전송과 자료 등록이 완료되었습니다.','Transfert et publication terminés.')
        :tr('자료가 등록되었습니다.','Ressource publiée.'));
    }catch(error){
      console.error('Learning resource upload failed',error);
      let cleanupFailed=false;
      if(draftId){
        // One best-effort cleanup, only when an upload failed. No retries or polling.
        try{await media(`/api/resource?postId=${encodeURIComponent(draftId)}&fileId=${encodeURIComponent(draftFileId)}`,'DELETE');}catch{}
        try{await deleteDoc(doc(db,'learningResources',draftId));}catch(e){cleanupFailed=true;console.warn('Draft could not be deleted',e);}
      }
      show('resource-upload-progress',false);
      const detail=error instanceof Error?error.message:String(error);
      const suffix=cleanupFailed
        ?tr('미완성 초안이 남았습니다. 삭제 버튼으로 지워 주세요.','Le brouillon incomplet subsiste. Supprimez-le.')
        :tr('전송 실패한 자료는 게시되지 않았습니다.','Le document non transféré n’a pas été publié.');
      const hint=detail.includes('HTTP 404')?tr(' 자료실 파일 API가 Worker에 배포되지 않은 것 같습니다. Cloudflare Worker 설정을 확인해 주세요.',' L’API fichiers semble absente du Worker déployé. Vérifiez le déploiement Cloudflare.') : '';
      note(`${tr('업로드 실패','Échec du transfert')}: ${detail}. ${suffix}${hint}`,true);
      await refresh().catch(console.error);
    }finally{
      resourceSubmitting=false;
      if(save){save.disabled=false;save.textContent=tr('자료 등록','Publier');}
      if(cancel)cancel.disabled=false;
    }
  });
  async function shrinkPhoto(file:File){
    if(file.size>20_000_000||!['image/jpeg','image/png','image/webp'].includes(file.type))throw Error('Unsupported photo');
    const bitmap=await createImageBitmap(file);
    try{
      let scale=Math.min(1,1600/Math.max(bitmap.width,bitmap.height));
      for(let attempt=0;attempt<7;attempt++){
        const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));
        const ctx=canvas.getContext('2d');if(!ctx)throw Error('Canvas unavailable');
        ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);
        const blob=await new Promise<Blob|null>(resolve=>canvas.toBlob(resolve,'image/webp',Math.max(.7,.86-attempt*.02)));
        if(blob?.type==='image/webp'&&blob.size<=1_500_000)return blob;
        scale*=.82;
      }
      throw Error('Image could not be compressed');
    }finally{bitmap.close();}
  }
  by<HTMLFormElement>('gallery-form')?.addEventListener('submit',async event=>{
    event.preventDefault();if(!uid||!isAdmin())return;
    const file=by<HTMLInputElement>('gallery-photo')?.files?.[0];
    const title=by<HTMLInputElement>('gallery-title')?.value.trim()||'';
    const description=by<HTMLTextAreaElement>('gallery-description')?.value.trim()||'';
    const save=by<HTMLButtonElement>('gallery-save');
    if(!file||!title||title.length>150||description.length>3000)return note(tr('사진과 제목을 확인해 주세요.','Vérifiez la photo et le titre.'),true);
    if(!api)return note(tr('비공개 사진 서버가 연결되지 않았습니다.','Le serveur photo privé n’est pas configuré.'),true);
    if(save)save.disabled=true;
    try{
      note(tr('사진 압축 중…','Compression de la photo…'));
      const blob=await shrinkPhoto(file);
      const refDoc=doc(collection(db,'galleryItems'));
      const id=crypto.randomUUID();
      await setDoc(refDoc,{title,description,authorUid:uid,status:'draft',image:{id,mime:'image/webp',size:blob.size},createdAt:serverTimestamp()});
      note(tr('비공개 사진 업로드 중…','Envoi de la photo privée…'));
      await media(`/api/gallery-upload?itemId=${encodeURIComponent(refDoc.id)}`,'POST',blob,'image/webp');
      await updateDoc(refDoc,{status:'published',updatedAt:serverTimestamp()});
      by<HTMLFormElement>('gallery-form')?.reset();show('gallery-form',false);show('gallery-open-form',true);
      note(tr('사진이 갤러리에 등록되었습니다.','Photo publiée.'));await refresh();
    }catch(error){console.error(error);note(tr('등록 실패. 미완성 사진 항목을 삭제하고 다시 시도해 주세요.','Échec de la publication. Supprimez le brouillon incomplet.'),true);await refresh().catch(console.error);}
    finally{if(save)save.disabled=false;}
  });
  async function loadResourceCategories(){
    try{
      const snap=await getDoc(doc(db,'siteSettings','resourceCategories'));
      const data=snap.data()?.items;
      if(!Array.isArray(data)||!data.length)return;
      const items=data.filter((x):x is {id:string;ko:string;fr:string}=>
        !!x&&typeof x.id==='string'&&!['common','general'].includes(x.id)&&/^[a-z][a-z0-9-]{1,23}$/.test(x.id)
        &&typeof x.ko==='string'&&typeof x.fr==='string').slice(0,20);
      if(!items.length)return;
      SCHOOL_CATEGORIES.splice(0,SCHOOL_CATEGORIES.length,...items.map(x=>x.id as SchoolCategory));
      for(const item of items)RESOURCE_LABELS[item.id]=fr?item.fr:item.ko;
      const filter=by<HTMLSelectElement>('resource-filter');
      const choose=by<HTMLSelectElement>('resource-category');
      const tabs=by<HTMLElement>('resource-category-tabs');
      filter?.replaceChildren();choose?.replaceChildren();tabs?.replaceChildren();
      if(filter){const all=document.createElement('option');all.value='all';all.textContent=tr('전체','Tout');filter.append(all);}
      if(choose){const prompt=document.createElement('option');prompt.value='';prompt.textContent=tr('자료 분류를 선택하세요','Choisir une catégorie');prompt.disabled=true;prompt.selected=true;choose.append(prompt);}
      if(tabs){const all=document.createElement('button');all.type='button';all.className='board-category-tab is-active';all.dataset.resourceTab='all';all.setAttribute('aria-pressed','true');all.textContent=tr('전체','Tout');tabs.append(all);}
      for(const item of items){
        const label=categoryName(item.id);
        for(const control of [filter,choose]){if(!control)continue;const o=document.createElement('option');o.value=item.id;o.textContent=label;control.append(o);}
        if(tabs){const b=document.createElement('button');b.type='button';b.className='board-category-tab';b.dataset.resourceTab=item.id;b.setAttribute('aria-pressed','false');b.textContent=label;tabs.append(b);}
      }
      tabs?.querySelectorAll<HTMLButtonElement>('[data-resource-tab]').forEach(button=>button.addEventListener('click',()=>{
        if(filter)filter.value=button.dataset.resourceTab||'all';syncResourceTabs();render();
      }));
    }catch(e){console.warn('Resource category defaults retained',e);}
  }
  by<HTMLElement>('files-search')?.addEventListener('input',render);
  by<HTMLSelectElement>('resource-filter')?.addEventListener('change',()=>{syncResourceTabs();render();});
  by<HTMLInputElement>('resource-show-drafts')?.addEventListener('change',render);
  document.querySelectorAll<HTMLButtonElement>('[data-resource-tab]').forEach(button=>button.addEventListener('click',()=>{
    const filter=by<HTMLSelectElement>('resource-filter');if(!filter)return;
    filter.value=button.dataset.resourceTab||'all';syncResourceTabs();render();
  }));
  function syncResourceTabs(){
    const value=by<HTMLSelectElement>('resource-filter')?.value||'all';
    document.querySelectorAll<HTMLButtonElement>('[data-resource-tab]').forEach(button=>{
      const active=button.dataset.resourceTab===value;
      button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active));
    });
  }
  function closeResourceForm(){
    editingResourceId='';removedAttachmentIds.clear();
    show('learning-form',false);show('files-open-form',true);
    show('resource-category-tabs',true);show('files-list-panel',true);
    show('resource-attachments-field',true);show('resource-existing-files',false);show('resource-upload-progress',false);
    const files=by<HTMLInputElement>('resource-files');if(files)files.required=false;
    const heading=by<HTMLElement>('resource-form-heading');if(heading)heading.textContent=tr('새 학습자료 등록','Nouvelle ressource');
    const save=by<HTMLButtonElement>('resource-save');if(save)save.textContent=tr('자료 등록','Publier');
    by<HTMLFormElement>('learning-form')?.reset();resetResourceEditor();updateAttachmentSummary();
    const draftWrap=by<HTMLElement>('resource-drafts-wrap');if(draftWrap)draftWrap.hidden=!isAdmin();
  }
  by<HTMLButtonElement>('files-open-form')?.addEventListener('click',()=>{
    editingResourceId='';removedAttachmentIds.clear();resetResourceEditor();
    const files=by<HTMLInputElement>('resource-files');if(files)files.required=false;
    show('resource-attachments-field',true);show('resource-existing-files',false);updateAttachmentSummary();
    show('learning-form',true);show('files-open-form',false);show('resource-category-tabs',false);
    show('files-list-panel',false);show('resource-drafts-wrap',false);
  });
  by<HTMLButtonElement>('resource-cancel')?.addEventListener('click',closeResourceForm);
  by<HTMLButtonElement>('files-back')?.addEventListener('click',backResource);
  by<HTMLButtonElement>('gallery-open-form')?.addEventListener('click',()=>{show('gallery-form',true);show('gallery-open-form',false);});
  by<HTMLButtonElement>('gallery-cancel')?.addEventListener('click',()=>{show('gallery-form',false);show('gallery-open-form',true);});
  by<HTMLButtonElement>('gallery-viewer-close')?.addEventListener('click',()=>by<HTMLDialogElement>('gallery-viewer')?.close());
  window.addEventListener('beforeunload',()=>{for(const uri of memo.values())URL.revokeObjectURL(uri);for(const uri of photoMemo.values())URL.revokeObjectURL(uri);});
  if(import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED==='true')onAuthStateChanged(auth,async user=>{
    if(!user){location.replace(root?.dataset.loginUrl||'/');return;}
    try{
      await user.reload();await getIdToken(user,true);
      if(!user.emailVerified)throw Error('Unverified');
      const snap=await getDoc(doc(db,'members',user.uid));
      if(!snap.exists()||snap.data().status!=='approved')throw Error('Inactive');
      uid=user.uid;role=String(snap.data().role||'');name=String(snap.data().nickname||'기존회원');viewerDM=dmAllowed(snap.data());aliases.set(uid,Promise.resolve({nickname:name,role,canReceiveDM:viewerDM}));void syncOwnAlias(db,uid,snap.data()).catch(console.warn);
      if(!permitted())throw Error('Role not allowed');
      show('files-controls',true);
      if(area==='learning'){
        show('files-open-form',canLearningPost());
        show('resource-drafts-wrap',isAdmin());
        await loadResourceCategories();
      }
      if(area==='gallery')show('gallery-open-form',isAdmin());
      note('');await refresh();
    }catch(error){console.error(error);note(tr('접근하거나 자료를 불러올 수 없습니다. 회원권한·Firestore 규칙을 확인해 주세요.','Accès ou chargement impossible. Vérifiez les droits et les règles Firestore.'),true);}
  });
</script>
