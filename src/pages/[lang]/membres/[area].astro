  async function media(path:string,method='GET',content?:Blob,mime?:string){
    if(!api)throw Error('Media server is not configured');
    const user=auth.currentUser;if(!user)throw Error('Signed out');
    const token=await getIdToken(user);
    const res=await fetch(api+path,{method,headers:{Authorization:`Bearer ${token}`,...(content?{'Content-Type':mime||content.type}:{})},body:content,cache:'no-store'});
    if(!res.ok){const error=await res.clone().json().catch(()=>null) as {error?:string}|null;throw Error(`HTTP ${res.status}: ${String(error?.error||'Storage error').slice(0,150)}`);}
    return res;
  }
  // Use one POST per file, with real browser-to-server byte progress.
  // 100% is shown only after the Worker confirms the file was accepted.
  async function uploadResource(path:string,file:File,mime:string,onProgress:(bytes:number)=>void){
    const user=auth.currentUser;if(!user)throw Error('Signed out');
    const token=await getIdToken(user);
    return new Promise<void>((resolve,reject)=>{
      const xhr=new XMLHttpRequest();
      xhr.open('POST',api+path);
      xhr.setRequestHeader('Authorization',`Bearer ${token}`);
      xhr.setRequestHeader('Content-Type',mime);
      xhr.upload.addEventListener('progress',event=>{
        if(event.lengthComputable)onProgress(Math.min(file.size,event.loaded));
      });
      xhr.addEventListener('load',()=>{
        if(xhr.status>=200&&xhr.status<300){onProgress(file.size);resolve();return;}
        let cause=tr('파일 서버에서 요청을 거부했습니다.','Le serveur a refusé le transfert.');
        try{const data=JSON.parse(xhr.responseText) as {error?:string};if(typeof data.error==='string')cause=data.error.slice(0,150);}catch{}
        reject(Error(`HTTP ${xhr.status}: ${cause}`));
      });
      xhr.addEventListener('error',()=>reject(Error(tr('파일 서버에 연결할 수 없습니다.','Connexion au serveur de fichiers impossible.'))));
      xhr.addEventListener('abort',()=>reject(Error(tr('전송이 중단되었습니다.','Transfert interrompu.'))));
      xhr.send(file);
    });
  }
