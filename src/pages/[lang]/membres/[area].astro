  function updateAttachmentSummary(){
    const selected=Array.from(by<HTMLInputElement>('resource-files')?.files||[]);
    const original=editingResourceId?entries.find(entry=>entry.id===editingResourceId):undefined;
    const kept=original?remainingAttachments(original):[];
    const bytes=kept.reduce((n,f)=>n+f.size,0)+selected.reduce((n,f)=>n+f.size,0);
    const target=by<HTMLElement>('resource-size');if(!target)return;
    target.textContent=`${tr('첨부파일 합계','Total des fichiers')}: ${kept.length+selected.length}${tr('개','')} · ${moneySize(bytes)} / 20 MB`;
    target.style.color=bytes>MAX_TOTAL||kept.length+selected.length>MAX_FILES?'#b42318':'';
