  async function photoSrc(key:string):Promise<string>{
    const hit=photoMemo.get(key);if(hit)return hit;
    const response=await media(`/api/photo?key=${encodeURIComponent(key)}`);
    const blob=await response.blob();if(!blob.type.startsWith('image/'))throw Error('Invalid photo data');
    const url=URL.createObjectURL(blob);photoMemo.set(key,url);return url;
  }
  async function populateResourcePhotos(node:HTMLElement){
    const images=Array.from(node.querySelectorAll<HTMLImageElement>('img[data-b2-key]'));
    await Promise.all(images.map(async img=>{
      const key=img.dataset.b2Key||'';
      if(img.src.startsWith('blob:'))return;
      img.classList.add('photo-loading');
      try{img.src=await photoSrc(key);}
      catch(error){console.error('ASICC resource photo',error);img.alt=tr('사진을 불러올 수 없습니다.','Photo indisponible.');img.classList.add('photo-error');}
      finally{img.classList.remove('photo-loading');}
