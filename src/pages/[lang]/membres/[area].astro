  async function refreshResourceComments(postId:string){
    if(area!=='learning'||selectedResourceId!==postId)return;
    const target=by<HTMLElement>('resource-comment-list');if(!target)return;
    target.replaceChildren(el('p',tr('댓글 불러오는 중…','Chargement des commentaires…')));
    try{
      const snap=await getDocs(query(collection(db,'learningResources',postId,'comments'),orderBy('createdAt','asc')));
      if(selectedResourceId!==postId)return;
      const all=snap.docs.map(d=>({id:d.id,...d.data()} as ResourceComment));
      const count=by<HTMLElement>('resource-comment-count');if(count)count.textContent=`(${all.length})`;
      target.replaceChildren();
      if(!all.length){target.append(el('p',tr('등록된 댓글이 없습니다.','Aucun commentaire.')));return;}
      const index=new Map(all.map(c=>[c.id,c])),children=new Map<string,ResourceComment[]>(),roots:ResourceComment[]=[],seen=new Set<string>();
      for(const comment of all){
        const parent=replyInfo(comment.body).parentId;
        if(parent&&parent!==comment.id&&index.has(parent)){const siblings=children.get(parent)||[];siblings.push(comment);children.set(parent,siblings);}
        else roots.push(comment);
      }
      const tree=(comment:ResourceComment,depth:number,orphan=false):HTMLElement=>{
        seen.add(comment.id);const node=el('div');node.className='board-comment-node';node.append(renderResourceComment(comment,postId,depth,orphan));
        if(depth<MAX_COMMENT_DEPTH){const replies=(children.get(comment.id)||[]).filter(c=>!seen.has(c.id));
          if(replies.length){const nested=el('div');nested.className='board-replies';for(const reply of replies)if(!seen.has(reply.id))nested.append(tree(reply,depth+1));if(nested.childElementCount)node.append(nested);}}
        return node;
      };
      for(const comment of [...roots,...all]){
        if(seen.has(comment.id))continue;const group=el('section');group.className='board-comment-group';group.append(tree(comment,1,!!replyInfo(comment.body).parentId&&!index.has(replyInfo(comment.body).parentId!)));target.append(group);
      }
    }catch(error){console.error(error);note(tr('댓글을 불러오지 못했습니다.','Impossible de charger les commentaires.'),true);}
  }
