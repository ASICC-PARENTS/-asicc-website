    if(btns.childElementCount)wrap.append(btns);
    return wrap;
  }
  async function refreshComments(postId:string){
    const list=by<HTMLElement>('comment-list');if(!list)return;
    list.replaceChildren();
    try{
      const snap=await getDocs(query(collection(db,'boardPosts',postId,'comments'),orderBy('createdAt','asc')));
      const all=snap.docs.map(d=>({id:d.id,...d.data()} as CommentData));
      const count=by<HTMLElement>('comment-count');if(count)count.textContent=`(${all.length})`;
      if(!all.length){list.append(el('p',tr('등록된 댓글이 없습니다.','Aucun commentaire.')));return;}
      const indexed=new Map(all.map(c=>[c.id,c]));
      const children=new Map<string,CommentData[]>();
      const roots:CommentData[]=[];
      const seen=new Set<string>();
      for(const c of all){
        const parentId=replyInfo(c.body).parentId;
        if(parentId&&parentId!==c.id&&indexed.has(parentId)){
          const siblings=children.get(parentId)||[];siblings.push(c);children.set(parentId,siblings);
        }else roots.push(c);
      }
      const renderTree=(comment:CommentData,depth:number,orphan=false):HTMLElement=>{
        seen.add(comment.id);
        const group=el('div');group.className='board-comment-node';
        group.append(renderComment(comment,postId,depth,orphan));
        if(depth<MAX_COMMENT_DEPTH){
          const replies=(children.get(comment.id)||[]).filter(c=>!seen.has(c.id));
          if(replies.length){
            const nest=el('div');nest.className='board-replies';
            for(const reply of replies)if(!seen.has(reply.id))nest.append(renderTree(reply,depth+1));
            if(nest.childElementCount)group.append(nest);
          }
        }
        return group;
      };
      for(const rootComment of roots){
        if(seen.has(rootComment.id))continue;
        const group=el('section');group.className='board-comment-group';
        group.append(renderTree(rootComment,1,!!replyInfo(rootComment.body).parentId));list.append(group);
      }
      // Safely display malformed/cyclic or deeper legacy replies without losing data.
      for(const comment of all){
        if(seen.has(comment.id))continue;
        const group=el('section');group.className='board-comment-group';
        group.append(renderTree(comment,1,true));list.append(group);
      }
    }catch(error){console.error(error);notify(tr('댓글을 불러오지 못했습니다.','Impossible de charger les commentaires.'),true);}
  }
  // Categories are maintained in the admin screen, without code edits.
  async function loadBoardCategories(){
    try{
      const snap=await getDoc(doc(db,'siteSettings','boardCategories'));
      const raw=snap.exists()?snap.data().items:null;
      if(!Array.isArray(raw)||!raw.length)return;
      const categories=raw.filter((x):x is {id:string;ko:string;fr:string}=>
        !!x&&typeof x.id==='string'&&/^[a-z][a-z0-9-]{1,23}$/.test(x.id)&&typeof x.ko==='string'&&typeof x.fr==='string').slice(0,20);
      if(!categories.length)return;
      categoryNames=categories.map(x=>x.id);
      categories.forEach(x=>{CATEGORY_KO[x.id]=x.ko;CATEGORY_FR[x.id]=x.fr;});
      const filter=by<HTMLSelectElement>('board-category-filter'),compose=by<HTMLSelectElement>('post-category'),tabs=by<HTMLElement>('board-category-tabs');
      if(filter){filter.replaceChildren();const all=el('option',tr('전체 분류','Toutes les catégories')) as HTMLOptionElement;all.value='all';filter.append(all);}
      compose?.replaceChildren();tabs?.replaceChildren();
      if(tabs){const all=el('button',tr('전체','Tout')) as HTMLButtonElement;all.type='button';all.dataset.boardTab='all';all.className='board-category-tab is-active';all.setAttribute('aria-pressed','true');tabs.append(all);}
      categories.forEach(x=>{
        for(const sel of [filter,compose]){if(!sel)continue;const opt=el('option',categoryLabel(x.id)) as HTMLOptionElement;opt.value=x.id;sel.append(opt);}
        if(tabs){const b=el('button',categoryLabel(x.id)) as HTMLButtonElement;b.type='button';b.dataset.boardTab=x.id;b.className='board-category-tab';b.setAttribute('aria-pressed','false');tabs.append(b);}
      });
      if(tabs&&filter){tabs.querySelectorAll<HTMLButtonElement>('[data-board-tab]').forEach(b=>b.addEventListener('click',()=>{filter.value=b.dataset.boardTab||'all';updateCategoryTabs();renderPosts();}));}
    }catch(e){console.warn('Category defaults retained',e);}
  }
  if(import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED==='true') onAuthStateChanged(auth,async user=>{
    if(!user){location.replace(root?.dataset.loginUrl||'/');return;}
    try{
      await user.reload();await getIdToken(user,true);
      if(!user.emailVerified)throw Error('verify');
      const snap=await getDoc(doc(db,'members',user.uid));
      if(!snap.exists()||snap.data().status!=='approved')throw Error('profile');
      uid=user.uid;role=snap.data().role;name=snap.data().nickname||'기존회원';viewerDM=dmAllowed(snap.data());aliases.set(uid,Promise.resolve({nickname:name,role,canReceiveDM:viewerDM}));void syncOwnAlias(db,uid,snap.data()).catch(console.warn);
      show('board-content',true);show('post-form',false);show('board-write-toggle',canWrite());notify(tr('게시판을 열었습니다.','Forum ouvert.'));
      await loadBoardCategories();await refreshPosts();
    }catch(e){console.error(e);notify(tr('접근 권한이 없습니다. 인증 후 로그인해 주세요.','Accès refusé. Vérifiez votre compte.'),true);}
  });
  by<HTMLInputElement>('board-search')?.addEventListener('input',renderPosts);
  const categorySelect=by<HTMLSelectElement>('board-category-filter');
  function updateCategoryTabs(){
    const selectedCategory=categorySelect?.value||'all';
    document.querySelectorAll<HTMLButtonElement>('[data-board-tab]').forEach(button=>{
      const active=button.dataset.boardTab===selectedCategory;
      button.classList.toggle('is-active',active);
      button.setAttribute('aria-pressed',String(active));
    });
  }
  categorySelect?.addEventListener('change',()=>{updateCategoryTabs();renderPosts();});
  document.querySelectorAll<HTMLButtonElement>('[data-board-tab]').forEach(button=>button.addEventListener('click',()=>{
    if(!categorySelect)return;
    categorySelect.value=button.dataset.boardTab||'all';
    updateCategoryTabs();
    renderPosts();
  }));
  by<HTMLButtonElement>('board-write-toggle')?.addEventListener('click',()=>showWriter());
  by<HTMLButtonElement>('post-cancel')?.addEventListener('click',()=>{
    const old=posts.find(p=>p.id===editingPostId);resetEditor();
    if(old)void openPost(old);else back();
  });
  by<HTMLButtonElement>('post-back')?.addEventListener('click',back);
  form?.addEventListener('submit',async e=>{
    e.preventDefault();if(!canWrite()||!editor||photoBusy)return;
    const plainTitle=by<HTMLInputElement>('post-title')?.value.trim()||'';
    const categoryValue=by<HTMLSelectElement>('post-category')?.value||'free';
    if(!categoryNames.includes(categoryValue as Category))return notify(tr('글 분류를 선택해 주세요.','Choisissez une catégorie.'),true);
    const title=storedTitle(categoryValue as Category,plainTitle);
    const body=serializeEditor(editor),plain=boardText(body).trim(),pics=photoKeys(editor);
    if(!plainTitle||title.length>120||(!plain&&!pics.length)||body.length>5000||numPhotos()>10)
      return notify(tr('제목·내용 또는 길이를 확인하세요. (서식 포함 5,000자)','Vérifiez le titre, le contenu et la limite de 5 000 caractères.'),true);
    const btn=by<HTMLButtonElement>('post-save');if(btn?.disabled)return;const old=btn?.textContent;if(btn){btn.disabled=true;btn.textContent=tr('저장 중…','Enregistrement…');}
    let saved=false;try{
      const editing=posts.find(p=>p.id===editingPostId);
      if(editing){
        if(!canEdit(editing.authorUid))return notify(tr('수정 권한이 없습니다.','Modification refusée.'),true);
        await updateDoc(doc(db,'boardPosts',editing.id),{title,body,updatedAt:serverTimestamp()});
      }else{
        await setDoc(doc(collection(db,'boardPosts')),{title,body,authorUid:uid,authorName:name,createdAt:serverTimestamp(),updatedAt:serverTimestamp(),deleted:false});
      }
      saved=true;const editedId=editingPostId;resetEditor();show('post-form',false);
      await refreshPosts();const result=posts.find(p=>p.id===editedId);
      if(result)await openPost(result);else back();
      notify(tr('저장되었습니다.','Message enregistré.'));
    }catch(error){console.error(error);notify(saved?tr('저장은 완료되었지만 화면 갱신에 실패했습니다.','Message enregistré, actualisation impossible.'):tr('저장에 실패했습니다.','Échec de l’enregistrement.'),true);}
    finally{if(btn){btn.disabled=false;btn.textContent=old||tr('저장','Enregistrer');}}
  });
  // Browser native editing commands are used only for trusted toolbar actions.
  document.querySelectorAll<HTMLButtonElement>('#post-form [data-format]').forEach(button=>{
    button.addEventListener('mousedown',e=>e.preventDefault());
    button.addEventListener('click',()=>{
      if(!editor)return;editor.focus();
      document.execCommand(button.dataset.format||'',false,button.dataset.value||undefined);
    });
  });
  by<HTMLButtonElement>('rich-link')?.addEventListener('click',()=>{
    if(!editor)return;
    const link=prompt(tr('연결할 링크 주소 (https://)','URL du lien (https://)'),'https://');
    if(!link)return;
    try{const url=new URL(link);if(url.protocol!=='https:'&&url.protocol!=='http:')throw Error('scheme');editor.focus();document.execCommand('createLink',false,url.href);}
    catch{notify(tr('올바른 링크 주소를 입력하세요.','URL non valide.'),true);}
  });
  by<HTMLInputElement>('rich-color')?.addEventListener('input',e=>{
    const value=(e.currentTarget as HTMLInputElement).value;editor?.focus();document.execCommand('foreColor',false,value);
  });
  by<HTMLButtonElement>('rich-undo')?.addEventListener('click',()=>{editor?.focus();document.execCommand('undo');});
  by<HTMLButtonElement>('rich-redo')?.addEventListener('click',()=>{editor?.focus();document.execCommand('redo');});
  editor?.addEventListener('paste',event=>{
    // Avoid embedded remote images, tracking pixels, HTML scripts and hidden links.
    event.preventDefault();const plain=event.clipboardData?.getData('text/plain')||'';
    document.execCommand('insertText',false,plain);
  });
  const photoButton=by<HTMLButtonElement>('rich-photo');
  if(photoApi){show('rich-photo',true);if(photoHelp)photoHelp.textContent=tr('사진을 선택하면 자동 압축 후 비공개로 업로드합니다.','Les photos sont compressées et envoyées dans le stockage privé.');}
  photoButton?.addEventListener('click',()=>{
    const selection=window.getSelection();
    photoCaret=selection?.rangeCount&&editor?.contains(selection.getRangeAt(0).commonAncestorContainer)
      ?selection.getRangeAt(0).cloneRange():null;
    by<HTMLInputElement>('rich-photo-file')?.click();
  });
  by<HTMLInputElement>('rich-photo-file')?.addEventListener('change',async event=>{
    const input=event.currentTarget as HTMLInputElement;const files=Array.from(input.files||[]);
    for(const file of files){
      if(numPhotos()>=10){
        const message=tr('사진은 게시글당 최대 10장까지 첨부할 수 있습니다.','Vous pouvez joindre au maximum 10 photos par message.');
        if(photoHelp){photoHelp.textContent=message;photoHelp.style.color='#b42318';}
        break;
      }
      try{await uploadPhoto(file);}
      catch(error){
        console.error('ASICC photo upload error',error);
        // Only show photo errors inside the editor; the global board banner stays clear.
        clearNotice();
        const reason=error instanceof Error ? error.message : tr('알 수 없는 오류','Erreur inconnue');
        if(photoHelp){
          photoHelp.textContent=tr(`사진 업로드 실패: ${file.name} (${reason})`, `Échec de l’ajout : ${file.name} (${reason})`);
          photoHelp.style.color='#b42318';
        }
        // Also display the diagnostic above the editor so it cannot be overlooked.
        // The existing back()/showWriter() paths clear this notice when leaving.
        notify(tr(`사진 업로드 실패 (${reason})`,`Échec de l’envoi de la photo (${reason})`),true);
      }
    }
    input.value='';photoCaret=null;
  });
  by<HTMLFormElement>('comment-form')?.addEventListener('submit',async e=>{
    e.preventDefault();if(!canWrite()||!selected)return;const body=by<HTMLTextAreaElement>('comment-body')?.value.trim()||'';
    if(!body||body.length>2000)return notify(tr('댓글을 확인하세요.','Vérifiez le commentaire.'),true);
    const button=(e.currentTarget as HTMLFormElement).querySelector<HTMLButtonElement>('button[type=submit]');if(button?.disabled)return;if(button)button.disabled=true;
    try{await setDoc(doc(collection(db,'boardPosts',selected.id,'comments')),{body,authorUid:uid,authorName:name,createdAt:serverTimestamp(),updatedAt:serverTimestamp(),deleted:false});by<HTMLFormElement>('comment-form')?.reset();notify(tr('댓글이 등록되었습니다.','Commentaire publié.'));await refreshComments(selected.id);}
    catch(e){console.error(e);notify(tr('댓글 등록 실패','Impossible de publier le commentaire.'),true);}finally{if(button)button.disabled=false;}
  });
</script>
