    if(meta){meta.textContent=dateLabel(post.createdAt,post.updatedAt);void publicInfo(post.authorUid).then(info=>{if(selected?.id===post.id)displayAuthor(meta,info,post.authorUid,uid,role,viewerDM,fr,messageUrl,dateLabel(post.createdAt,post.updatedAt),db,post.deleted?undefined:{kind:'board',post:post.id,comment:''});});}
    actions?.replaceChildren();
    
