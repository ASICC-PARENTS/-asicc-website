  async function reportBoardEntry(kind:'post'|'comment',postId:string,commentId?:string){
    const reason=prompt(tr('운영진에게 전달할 신고 사유를 입력해 주세요.','Motif du signalement destiné aux administrateurs :'));
    if(reason===null)return;
    const text=reason.trim();if(!text||text.length>1500)return notify(tr('신고 사유를 입력해 주세요.','Indiquez un motif.'),true);
    try{
      const request=doc(collection(db,'suggestions'));
      await setDoc(request,{
        uid,category:'confidential',subject:kind==='post'?tr('게시글 신고','Signalement de publication'):tr('댓글 신고','Signalement de commentaire'),
        body:`${kind==='post'?'게시글':'댓글'} ID: ${postId}${commentId?' / '+commentId:''}\n신고 내용: ${text}`,
        status:'received',createdAt:serverTimestamp()
      });
      if(MEMBER_NOTIFICATION_API)try{
        const token=await getIdToken(auth.currentUser!);
        const response=await fetch(MEMBER_NOTIFICATION_API+'/api/notify',{method:'POST',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},body:JSON.stringify({kind:'suggestion',id:request.id})});
        if(!response.ok)console.warn('Report email notification pending:',response.status);
      }catch(error){console.warn('Report email not connected',error);}
      notify(tr('운영진에게 신고가 접수되었습니다.','Signalement transmis aux administrateurs.'));
    }catch(error){console.error(error);notify(tr('신고 접수에 실패했습니다.','Échec du signalement.'),true);}
  }
