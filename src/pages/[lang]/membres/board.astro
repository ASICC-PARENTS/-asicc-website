---
import Base from '../../../layouts/Base.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const live = import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === 'true';
---
<Base lang={lang} rest="membres/board/" title={L(lang,{ko:'회원 소통 게시판',fr:'Forum des membres'})} noindex>
  <section class="wrap m-shell board-shell">
    <div class="stack gap-16" id="board-root" data-lang={lang} data-login-url={href(lang,'membres/login/')}>
      <a href={href(lang,'membres/')} class="small">← {L(lang,{ko:'회원공간',fr:'Espace membres'})}</a>
      <h1 class="h2">{L(lang,{ko:'회원 소통 게시판',fr:'Forum des membres'})}</h1>
      <p class="muted">{L(lang,{ko:'일반회원은 읽기, 협회회원·특별회원·운영진은 글쓰기와 댓글이 가능합니다.',fr:'Les membres généraux peuvent consulter les messages. La publication et les commentaires sont réservés aux membres de l’association, aux membres spéciaux et aux administrateurs.'})}</p>
      <details class="card" style="padding:14px"><summary>{L(lang,{ko:'게시판 이용 규칙',fr:'Règles du forum'})}</summary><p class="small muted" style="margin-top:10px">{L(lang,{ko:'비방·괴롭힘·고의적 분란 조장·허위정보·개인정보 공개·스팸을 금지합니다. 운영진은 위반 게시물을 숨기거나 삭제하고 계정의 이용 권한을 제한할 수 있습니다. 이의제기는 contact@asicc-parents.fr로 문의해 주세요.',fr:'Les attaques, le harcèlement, les provocations délibérées, les fausses informations, la divulgation de données et les spams sont interdits. La modération peut masquer ou supprimer des contenus et limiter les accès. Recours : contact@asicc-parents.fr.'})}</p></details>
      {!live && <div class="card auth-card" role="status">{L(lang,{ko:'게시판은 보안 점검 중으로 아직 공개되지 않았습니다.',fr:'Le forum est désactivé pendant les vérifications de sécurité.'})}</div>}
      <div id="board-app" hidden={!live} class="stack gap-16">
        <p id="board-status" role="status" aria-live="polite" class="small muted">{L(lang,{ko:'회원 권한 확인 중…',fr:'Vérification des autorisations…'})}</p>
        <div id="board-content" hidden class="stack gap-16">
          <div id="board-toolbar" class="board-toolbar">
            <div class="board-search-wrap">
              <label for="board-search" class="sr-only">{L(lang,{ko:'게시글 검색',fr:'Rechercher dans les messages'})}</label>
              <span class="board-search-icon" aria-hidden="true">⌕</span>
              <input id="board-search" type="search" maxlength="120" placeholder={L(lang,{ko:'제목 또는 내용 검색',fr:'Rechercher par titre ou contenu'})} />
            </div>
            <button id="board-write-toggle" type="button" class="btn btn-dark" hidden>+ {L(lang,{ko:'글쓰기',fr:'Écrire un message'})}</button>
          </div>
          <form id="post-form" class="card board-editor stack gap-12" hidden>
            <h2 class="h3">{L(lang,{ko:'새 게시글 작성',fr:'Créer un message'})}</h2>
            <label for="post-title">{L(lang,{ko:'제목',fr:'Titre'})}</label>
            <input id="post-title" name="title" maxlength="120" required />
            <label for="post-body">{L(lang,{ko:'내용',fr:'Message'})}</label>
            <div class="rich-tools" role="toolbar" aria-label={L(lang,{ko:'글 편집 도구',fr:'Outils de mise en forme'})}>
              <button type="button" data-format="bold" title="Bold" aria-label={L(lang,{ko:'굵게',fr:'Gras'})}><strong>B</strong></button>
              <button type="button" data-format="italic" title="Italic" aria-label={L(lang,{ko:'기울임',fr:'Italique'})}><em>I</em></button>
              <button type="button" data-format="underline" aria-label={L(lang,{ko:'밑줄',fr:'Souligner'})}><u>U</u></button>
              <span class="rich-separator" aria-hidden="true"></span>
              <button type="button" data-format="formatBlock" data-value="h2" aria-label={L(lang,{ko:'큰 제목',fr:'Grand titre'})}>H2</button>
              <button type="button" data-format="formatBlock" data-value="p" aria-label={L(lang,{ko:'본문',fr:'Paragraphe'})}>¶</button>
              <button type="button" data-format="insertUnorderedList" aria-label={L(lang,{ko:'글머리표',fr:'Liste à puces'})}>• ≡</button>
              <button type="button" data-format="insertOrderedList" aria-label={L(lang,{ko:'번호 목록',fr:'Liste numérotée'})}>1. ≡</button>
              <span class="rich-separator" aria-hidden="true"></span>
              <button type="button" data-format="justifyLeft" aria-label={L(lang,{ko:'왼쪽 정렬',fr:'Aligner à gauche'})}>☰</button>
              <button type="button" data-format="justifyCenter" aria-label={L(lang,{ko:'가운데 정렬',fr:'Centrer'})}>≡</button>
              <button type="button" id="rich-link" aria-label={L(lang,{ko:'링크',fr:'Lien'})}>🔗</button>
              <label class="rich-color-label" aria-label={L(lang,{ko:'글자 색상',fr:'Couleur du texte'})}>◉ <input type="color" id="rich-color" value="#254d49" /></label>
              <button type="button" id="rich-undo" aria-label={L(lang,{ko:'실행 취소',fr:'Annuler'})}>↶</button>
              <button type="button" id="rich-redo" aria-label={L(lang,{ko:'다시 실행',fr:'Rétablir'})}>↷</button>
              <span class="rich-separator" aria-hidden="true"></span>
              <button type="button" id="rich-photo" hidden aria-label={L(lang,{ko:'사진 첨부',fr:'Ajouter une photo'})}>▣ {L(lang,{ko:'사진',fr:'Photo'})}</button>
              <input type="file" id="rich-photo-file" accept="image/*" multiple hidden />
            </div>
            <div id="post-body" class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label={L(lang,{ko:'게시글 본문',fr:'Contenu du message'})} data-placeholder={L(lang,{ko:'내용을 입력하세요…',fr:'Écrivez votre message…'})}></div>
            <p id="photo-help" class="small muted" role="status">{L(lang,{ko:'사진 첨부는 비공개 저장소 연결 후 사용할 수 있습니다.',fr:'L’ajout de photos sera activé après la configuration du stockage privé.'})}</p>
            <p class="small muted">{L(lang,{ko:'최대 5,000자(서식 코드 포함), 사진 최대 6장 · 사진은 자동 압축됩니다.',fr:'5 000 caractères maximum (mise en forme incluse), 6 photos maximum, compressées automatiquement.'})}</p>
            <div class="board-editor-actions row gap-12">
              <button class="btn btn-dark" id="post-save" type="submit">{L(lang,{ko:'등록하기',fr:'Publier'})}</button>
              <button class="btn btn-ghost" id="post-cancel" type="button">{L(lang,{ko:'취소',fr:'Annuler'})}</button>
            </div>
          </form>
          <section id="board-list-panel" class="board-list-card" aria-label={L(lang,{ko:'게시글 목록',fr:'Liste des messages'})}>
            <div class="board-table-head">
              <span>{L(lang,{ko:'번호',fr:'N°'})}</span>
              <span>{L(lang,{ko:'제목',fr:'Sujet'})}</span>
              <span>{L(lang,{ko:'작성자',fr:'Auteur'})}</span>
              <span>{L(lang,{ko:'날짜',fr:'Date'})}</span>
            </div>
            <div id="board-list" class="board-list"></div>
            <p class="board-count" id="board-count" aria-live="polite"></p>
          </section>
          <article id="post-detail" class="card board-detail stack gap-16" hidden>
            <button type="button" class="btn btn-ghost board-back" id="post-back">← {L(lang,{ko:'목록으로',fr:'Retour à la liste'})}</button>
            <h2 id="detail-title" class="h3"></h2>
            <p id="detail-meta" class="small muted"></p>
            <div id="detail-body" class="board-text"></div>
            <div id="detail-actions" class="row gap-12" style="flex-wrap:wrap"></div>
            <h3 class="h3">{L(lang,{ko:'댓글',fr:'Commentaires'})}</h3>
            <div id="comment-list" class="stack gap-8"></div>
            <form id="comment-form" class="stack gap-12" hidden>
              <label for="comment-body">{L(lang,{ko:'댓글 작성',fr:'Ajouter un commentaire'})}</label>
              <textarea id="comment-body" maxlength="2000" rows="3" required></textarea>
              <button type="submit" class="btn btn-dark">{L(lang,{ko:'댓글 등록',fr:'Publier le commentaire'})}</button>
            </form>
          </article>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, getIdToken } from 'firebase/auth';
  import { getFirestore, doc, collection, getDoc, getDocs, query, orderBy, limit, setDoc, updateDoc, writeBatch, serverTimestamp } from 'firebase/firestore';
  import { firebaseConfig } from '../../../firebase-config';
  import { BOARD_PHOTO_API } from '../../../config/board-photos';
  import { renderBoardBody, setEditorBody, serializeEditor, boardText, photoKeys, insertPhoto } from '../../../scripts/board-rich';
  type BoardData = { id:string;title:string;body:string;authorUid:string;authorName:string;deleted:boolean;createdAt?:{toDate?:()=>Date};updatedAt?:unknown };
  type CommentData = { id:string;body:string;authorUid:string;authorName:string;deleted:boolean;createdAt?:{toDate?:()=>Date} };
  const root=document.getElementById('board-root') as HTMLElement|null;
  const by=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T|null;
  const fr=root?.dataset.lang==='fr';
  const tr=(ko:string,french:string)=>fr?french:ko;
  const status=by<HTMLElement>('board-status');
  const notify=(v:string,bad=false)=>{if(status){status.textContent=v;status.hidden=!v;status.style.color=bad?'#b42318':'';}};
  const clearNotice=()=>notify('');
  const el=(tag:string,text?:string)=>{const node=document.createElement(tag);if(text!==undefined)node.textContent=text;return node;};
  const stamp=(v?:{toDate?:()=>Date})=>{try{return v?.toDate?.().toLocaleDateString(fr?'fr-FR':'ko-KR')||'';}catch{return '';}};
  const app=getApps().find(a=>a.name==='asicc-website')??initializeApp(firebaseConfig,'asicc-website');
  const auth=getAuth(app), db=getFirestore(app);
  const aliases=new Map<string,Promise<string>>();
  const nicknameOf=(authorUid:string):Promise<string>=>{
    if(!authorUid)return Promise.resolve(tr('회원','Membre'));
    if(!aliases.has(authorUid))aliases.set(authorUid,getDoc(doc(db,'publicNames',authorUid)).then(snap=>
      snap.exists()&&typeof snap.data().nickname==='string'?snap.data().nickname:tr('기존 회원','Ancien membre')
    ).catch(()=>tr('기존 회원','Ancien membre')));
    return aliases.get(authorUid)!;
  };
  let uid='',name='',role='',posts:BoardData[]=[],selected:BoardData|null=null;
  let editingPostId:string|null=null, photoBusy=false;
  let photoCaret:Range|null=null;
  const photoCache=new Map<string,string>();
  const photoApi=BOARD_PHOTO_API.trim().replace(/\/$/,'');
  const editor=by<HTMLElement>('post-body');
  const form=by<HTMLFormElement>('post-form');
  const photoHelp=by<HTMLElement>('photo-help');
  async function mediaFetch(path:string,method='GET',blob?:Blob):Promise<Response>{
    if(!photoApi)throw Error('Not configured');
    const current=auth.currentUser;if(!current)throw Error('Not signed in');
    const token=await getIdToken(current);
    const response=await fetch(`${photoApi}${path}`,{method,headers:{Authorization:`Bearer ${token}`,...(blob?{'Content-Type':blob.type}:{})},body:blob,cache:'no-store'});
    if(!response.ok){
      // Keep error codes visible for diagnosis. Never include tokens or credentials.
      const data=await response.clone().json().catch(()=>null) as {error?:unknown}|null;
      const reason=typeof data?.error==='string' ? data.error.slice(0,120) : 'Request rejected';
      throw Error(`HTTP ${response.status}: ${reason}`);
    }
    return response;
  }
  async function photoSrc(key:string):Promise<string>{
    if(photoCache.has(key))return photoCache.get(key)!;
    const res=await mediaFetch(`/api/photo?key=${encodeURIComponent(key)}`);
    const blob=await res.blob();
    if(!blob.type.startsWith('image/'))throw Error('Invalid image');
    const url=URL.createObjectURL(blob);photoCache.set(key,url);return url;
  }
  async function populatePhotos(node:HTMLElement){
    const images=Array.from(node.querySelectorAll<HTMLImageElement>('img[data-b2-key]'));
    await Promise.all(images.map(async img=>{
      const key=img.dataset.b2Key||'';
      if(img.src.startsWith('blob:'))return;
      img.classList.add('photo-loading');
      try{img.src=await photoSrc(key);}
      catch {img.alt=tr('사진을 불러올 수 없습니다','Impossible de charger la photo');img.classList.add('photo-error');}
      finally {img.classList.remove('photo-loading');}
    }));
  }
  async function compressPhoto(file:File):Promise<Blob>{
    if(!file.type.startsWith('image/'))throw Error('image required');
    if(file.size>20_000_000)throw Error('Photo over 20MB');
    const bitmap=await createImageBitmap(file);
    try{
      let scale=Math.min(1,1400/Math.max(bitmap.width,bitmap.height));
      for(let attempt=0;attempt<4;attempt++){
        const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));
        const ctx=canvas.getContext('2d');if(!ctx)throw Error('Canvas unavailable');
        ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);
        const format='image/webp';
        const blob=await new Promise<Blob|null>(resolve=>canvas.toBlob(resolve,format,0.78));
        if(blob&&blob.type==='image/webp'&&blob.size<=1_500_000)return blob;
        scale*=0.75;
      }
      throw Error('Could not compress to <=1.5MB');
    }finally{bitmap.close();}
  }
  async function uploadPhoto(file:File):Promise<void>{
    if(!editor||!photoApi||!canWrite())return;
    if(photoKeys(editor).length>=6)throw Error('max 6 images');
    photoBusy=true;
    const button=by<HTMLButtonElement>('rich-photo');if(button)button.disabled=true;
    if(photoHelp)photoHelp.textContent=tr('사진 압축·업로드 중…','Compression et envoi de la photo…');
    try{
      const compressed=await compressPhoto(file);
      const res=await mediaFetch('/api/upload','POST',compressed);
      const payload=await res.json() as {key?:string};
      if(!payload.key)throw Error('Missing key');
      const url=URL.createObjectURL(compressed);photoCache.set(payload.key,url);
      insertPhoto(editor,payload.key,url,photoCaret);
      photoCaret=null;
      if(photoHelp)photoHelp.textContent=tr('사진이 첨부되었습니다. 게시글을 등록해 주세요.','Photo ajoutée. Publiez votre message.');
    }finally{photoBusy=false;if(button)button.disabled=false;}
  }
  function resetEditor(){
    editingPostId=null;form?.reset();if(editor)editor.replaceChildren();
    if(photoHelp){
      photoHelp.textContent=photoApi
        ?tr('사진을 선택하면 자동 압축 후 비공개로 업로드합니다.','Les photos sont compressées et envoyées dans le stockage privé.')
        :tr('사진 첨부는 비공개 저장소 연결 후 사용할 수 있습니다.','L’ajout de photos sera activé après la configuration du stockage privé.');
      photoHelp.style.color='';
    }
    const btn=by<HTMLButtonElement>('post-save');if(btn)btn.textContent=tr('등록하기','Publier');
  }
  function showWriter(post?:BoardData){
    if(!canWrite()||!editor)return;
    clearNotice();
    show('post-detail',false);show('board-list-panel',false);show('post-form',true);
    show('board-toolbar',false);
    resetEditor();
    if(post){editingPostId=post.id;const title=by<HTMLInputElement>('post-title');if(title)title.value=post.title;setEditorBody(editor,post.body);void populatePhotos(editor);const btn=by<HTMLButtonElement>('post-save');if(btn)btn.textContent=tr('수정 저장','Enregistrer les modifications');}
    by<HTMLInputElement>('post-title')?.focus();
  }
  window.addEventListener('beforeunload',()=>{for(const url of photoCache.values())URL.revokeObjectURL(url);});
  const canWrite=()=>['member','special','admin'].includes(role);
  // Content edits are restricted to the original author, including when the viewer is an admin.
  const canEdit=(owner:string)=>canWrite()&&owner===uid;
  // Administrators may moderate other members' posts and comments; authors may withdraw theirs.
  
const canModerate=()=>role==='admin';
const canDelete=(owner:string)=>canWrite()&&(owner===uid||role==='admin');

  const show=(id:string,on:boolean)=>{const v=by<HTMLElement>(id);if(v)v.hidden=!on;};
  async function refreshPosts(){
    const list=by<HTMLElement>('board-list');if(!list)return;
    list.replaceChildren(el('p',tr('불러오는 중…','Chargement…')));
    const snap=await getDocs(query(collection(db,'boardPosts'),orderBy('createdAt','desc'),limit(100)));
    posts=snap.docs.map(d=>({id:d.id,...d.data()} as BoardData));renderPosts();
  }
  function renderPosts(){
    const list=by<HTMLElement>('board-list');if(!list)return;list.replaceChildren();
    const search=by<HTMLInputElement>('board-search')?.value.trim().toLocaleLowerCase()||'';
    const filtered=posts.filter(p=>!p.deleted&&(!search||`${p.title} ${boardText(p.body)}`.toLocaleLowerCase().includes(search)));
    const count=by<HTMLElement>('board-count');
    if(count)count.textContent=tr(`게시글 ${filtered.length}개 · 최근 100개 기준`,` ${filtered.length} message(s) · parmi les 100 derniers`);
    if(!filtered.length){const empty=el('p',search?tr('검색 결과가 없습니다.','Aucun résultat.'):tr('아직 등록된 게시글이 없습니다.','Aucun message publié.'));empty.className='board-empty';list.append(empty);return;}
    filtered.forEach((post,index)=>{
      const row=el('div');row.className='board-row';
      const number=el('span',String(filtered.length-index));number.className='board-number';
      const title=el('button',post.title) as HTMLButtonElement;title.type='button';title.className='board-title-link';title.addEventListener('click',()=>void openPost(post));
      const author=el('span',tr('회원','Membre'));author.className='board-author';
      const date=el('span',stamp(post.createdAt));date.className='board-date';
      row.append(number,title,author,date);list.append(row);
      void nicknameOf(post.authorUid).then(nick=>{if(row.isConnected)author.textContent=nick;});
    });
  }
  async function openPost(post:BoardData){
    clearNotice();
    selected=post;show('post-detail',true);show('post-form',false);show('board-list-panel',false);show('board-toolbar',false);
    const title=by<HTMLElement>('detail-title'),body=by<HTMLElement>('detail-body'),meta=by<HTMLElement>('detail-meta'),actions=by<HTMLElement>('detail-actions');
    if(title)title.textContent=post.title;if(body){renderBoardBody(body,post.body);void populatePhotos(body);}if(meta){meta.textContent=stamp(post.createdAt);void nicknameOf(post.authorUid).then(nick=>{if(selected?.id===post.id)meta.textContent=`${nick} · ${stamp(post.createdAt)}`;});}
    actions?.replaceChildren();
    
    if(!post.deleted){
      if(canEdit(post.authorUid)){
        const edit=el('button',tr('수정','Modifier')) as HTMLButtonElement;
        edit.type='button';
        edit.className='board-mini-btn';
        edit.addEventListener('click',()=>void editPost(post));
        actions?.append(edit);
      }

      if(canModerate() && post.authorUid!==uid){
        const hide=el('button',tr('숨기기','Masquer')) as HTMLButtonElement;
        hide.type='button';
        hide.className='board-mini-btn';
        hide.addEventListener('click',()=>void hidePost(post));
        actions?.append(hide);
      }

      if(canDelete(post.authorUid)){
        const own=post.authorUid===uid;
        const del=el('button',tr(own?'삭제':'완전 삭제',own?'Supprimer':'Supprimer définitivement')) as HTMLButtonElement;
        del.type='button';
        del.className='board-mini-btn board-mini-danger';
        del.addEventListener('click',()=>void deletePost(post));
        actions?.append(del);
      }
    }

    show('comment-form',canWrite()&&!post.deleted);await refreshComments(post.id);
  }
  function back(){clearNotice();selected=null;show('post-detail',false);show('post-form',false);show('board-list-panel',true);show('board-toolbar',true);}
  async function editPost(post:BoardData){
    if(!canEdit(post.authorUid)||post.deleted)return;
    showWriter(post);
  }
  async function hidePost(post:BoardData){
    if(!canModerate()||post.deleted||!confirm(tr('게시글을 숨길까요?','Masquer ce message ?')))return;
    try{
      const batch=writeBatch(db);
      batch.set(doc(db,'hiddenPosts',post.id),{title:post.title,body:post.body,authorUid:post.authorUid,hiddenBy:uid,hiddenAt:serverTimestamp()});
      batch.update(doc(db,'boardPosts',post.id),{deleted:true,title:'[숨김 처리된 게시글]',body:'[숨김 처리된 게시글]',updatedAt:serverTimestamp()});
      await batch.commit();back();await refreshPosts();
    }
    catch(e){console.error(e);notify(tr('숨김 처리 실패','Impossible de masquer.'),true);}
  }

  const deletionReason=(own:boolean):'author_request'|'spam'|'rules_violation'|null=>{
    if(own)return 'author_request';

    const value=prompt(
      tr('완전 삭제 사유: spam 또는 rules_violation',
         'Motif : spam ou rules_violation'),
      'spam'
    );

    if(value===null)return null;

    if(value!=='spam'&&value!=='rules_violation'){
      notify(tr('삭제 사유를 확인하세요.','Motif non valide.'),true);
      return null;
    }
    return value;
  };

  async function deletePost(post:BoardData){
    if(!canDelete(post.authorUid)||post.deleted)return;

    const own=post.authorUid===uid;
    const reason=deletionReason(own);
    if(!reason)return;

    if(!confirm(tr(
      '게시글과 모든 댓글을 완전히 삭제할까요? 복구할 수 없습니다.',
      'Supprimer définitivement ce message et tous ses commentaires ?'
    )))return;

    try{
      const comments=await getDocs(
        query(collection(db,'boardPosts',post.id,'comments'),limit(451))
      );

      if(comments.size>450){
        notify(tr(
          '댓글이 너무 많아 일괄 삭제할 수 없습니다.',
          'Trop de commentaires.'
        ),true);
        return;
      }

      const batch=writeBatch(db);

      for(const comment of comments.docs){
        batch.delete(comment.ref);
      }

      batch.delete(doc(db,'boardPosts',post.id));

      batch.set(doc(db,'boardDeletionLogs',`post_${post.id}`),{
        targetType:'post',
        postId:post.id,
        commentId:'',
        authorUid:post.authorUid,
        actorUid:uid,
        reason,
        deletedAt:serverTimestamp()
      });

      await batch.commit();
      back();
      await refreshPosts();
      notify(tr('게시글이 삭제되었습니다.','Message supprimé.'));
    }catch(e){
      console.error(e);
      notify(tr('삭제에 실패했습니다.','Échec de la suppression.'),true);
    }
  }

  async function deleteComment(postId:string,c:CommentData){
    if(!canDelete(c.authorUid)||c.deleted)return;

    const own=c.authorUid===uid;
    const reason=deletionReason(own);
    if(!reason)return;

    if(!confirm(tr(
      '댓글을 완전히 삭제할까요? 복구할 수 없습니다.',
      'Supprimer définitivement ce commentaire ?'
    )))return;

    try{
      const batch=writeBatch(db);

      batch.delete(
        doc(db,'boardPosts',postId,'comments',c.id)
      );

      batch.set(
        doc(db,'boardDeletionLogs',`comment_${postId}_${c.id}`),
        {
          targetType:'comment',
          postId,
          commentId:c.id,
          authorUid:c.authorUid,
          actorUid:uid,
          reason,
          deletedAt:serverTimestamp()
        }
      );

      await batch.commit();
      await refreshComments(postId);

      notify(tr(
        '댓글이 삭제되었습니다.',
        'Commentaire supprimé.'
      ));
    }catch(e){
      console.error(e);
      notify(tr(
        '댓글 삭제에 실패했습니다.',
        'Échec de la suppression.'
      ),true);
    }
  }

  async function refreshComments(postId:string){
    const list=by<HTMLElement>('comment-list');if(!list)return;list.replaceChildren();
    try{
      const snap=await getDocs(query(collection(db,'boardPosts',postId,'comments'),orderBy('createdAt','asc'),limit(100)));
      if(snap.empty){list.append(el('p',tr('등록된 댓글이 없습니다.','Aucun commentaire.')));return;}
      for(const d of snap.docs){const c={id:d.id,...d.data()} as CommentData;
        const wrap=el('div');wrap.className='board-row stack gap-8 board-comment';
        const meta=el('p',stamp(c.createdAt));meta.className='small muted';
        void nicknameOf(c.authorUid).then(nick=>{meta.textContent=`${nick} · ${stamp(c.createdAt)}`;});
        const body=el('p',c.body);body.className='board-text';wrap.append(meta,body);
        if(!c.deleted&&(canEdit(c.authorUid)||canModerate()||canDelete(c.authorUid))){
          const btns=el('div');btns.className='board-comment-actions';
          if(canEdit(c.authorUid)){
            const edit=el('button',tr('수정','Modifier')) as HTMLButtonElement;edit.type='button';edit.className='board-mini-btn';
            edit.addEventListener('click',async()=>{
              if(!canEdit(c.authorUid))return;
              const updated=prompt(tr('댓글 수정','Modifier le commentaire'),c.body);
              if(updated===null)return;if(!updated.trim()||updated.length>2000)return notify(tr('댓글 길이를 확인하세요.','Commentaire trop long.'),true);
              try{await updateDoc(doc(db,'boardPosts',postId,'comments',c.id),{body:updated.trim(),updatedAt:serverTimestamp()});await refreshComments(postId);}catch(e){console.error(e);notify(tr('댓글 수정 실패','Échec de la modification.'),true);}
            });btns.append(edit);
          }
          if(canModerate() && c.authorUid!==uid){
            const hide=el('button',tr('숨기기','Masquer')) as HTMLButtonElement;hide.type='button';hide.className='board-mini-btn';hide.addEventListener('click',async()=>{
              if(!canModerate())return;
              if(!confirm(tr('댓글을 숨길까요?','Masquer ce commentaire ?')))return;
              try{
                const batch=writeBatch(db);
                batch.set(doc(db,'hiddenComments',`${postId}_${c.id}`),{postId,commentId:c.id,body:c.body,authorUid:c.authorUid,hiddenBy:uid,hiddenAt:serverTimestamp()});
                batch.update(doc(db,'boardPosts',postId,'comments',c.id),{body:'[숨김 처리된 댓글]',deleted:true,updatedAt:serverTimestamp()});
                await batch.commit();await refreshComments(postId);
              }catch(e){console.error(e);notify(tr('숨김 실패','Impossible de masquer.'),true);}
            });btns.append(hide);
          }
          if(canDelete(c.authorUid)){
            const del=el('button',tr('삭제','Supprimer')) as HTMLButtonElement;
            del.type='button';del.className='board-mini-btn board-mini-danger';
            del.addEventListener('click',()=>void deleteComment(postId,c));btns.append(del);
          }
          wrap.append(btns);
        }list.append(wrap);
      }
    }catch(e){console.error(e);notify(tr('댓글을 불러오지 못했습니다.','Impossible de charger les commentaires.'),true);}
  }
  if(import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED==='true') onAuthStateChanged(auth,async user=>{
    if(!user){location.replace(root?.dataset.loginUrl||'/');return;}
    try{
      await user.reload();await getIdToken(user,true);
      if(!user.emailVerified)throw Error('verify');
      const snap=await getDoc(doc(db,'members',user.uid));
      if(!snap.exists()||snap.data().status!=='approved')throw Error('profile');
      uid=user.uid;role=snap.data().role;name=snap.data().nickname||'기존회원';
      show('board-content',true);show('post-form',false);show('board-write-toggle',canWrite());notify(tr('게시판을 열었습니다.','Forum ouvert.'));
      await refreshPosts();
    }catch(e){console.error(e);notify(tr('접근 권한이 없습니다. 인증 후 로그인해 주세요.','Accès refusé. Vérifiez votre compte.'),true);}
  });
  by<HTMLInputElement>('board-search')?.addEventListener('input',renderPosts);
  by<HTMLButtonElement>('board-write-toggle')?.addEventListener('click',()=>showWriter());
  by<HTMLButtonElement>('post-cancel')?.addEventListener('click',()=>{
    const old=posts.find(p=>p.id===editingPostId);resetEditor();
    if(old)void openPost(old);else back();
  });
  by<HTMLButtonElement>('post-back')?.addEventListener('click',back);
  form?.addEventListener('submit',async e=>{
    e.preventDefault();if(!canWrite()||!editor||photoBusy)return;
    const title=by<HTMLInputElement>('post-title')?.value.trim()||'';
    const body=serializeEditor(editor),plain=boardText(body).trim(),pics=photoKeys(editor);
    if(!title||title.length>120||(!plain&&!pics.length)||body.length>5000||pics.length>6)
      return notify(tr('제목·내용 또는 길이를 확인하세요. (서식 포함 5,000자)','Vérifiez le titre, le contenu et la limite de 5 000 caractères.'),true);
    const btn=by<HTMLButtonElement>('post-save');if(btn)btn.disabled=true;
    try{
      const editing=posts.find(p=>p.id===editingPostId);
      if(editing){
        if(!canEdit(editing.authorUid))return notify(tr('수정 권한이 없습니다.','Modification refusée.'),true);
        await updateDoc(doc(db,'boardPosts',editing.id),{title,body,updatedAt:serverTimestamp()});
      }else{
        await setDoc(doc(collection(db,'boardPosts')),{title,body,authorUid:uid,authorName:name,createdAt:serverTimestamp(),updatedAt:serverTimestamp(),deleted:false});
      }
      const editedId=editingPostId;resetEditor();show('post-form',false);
      await refreshPosts();const result=posts.find(p=>p.id===editedId);
      if(result)await openPost(result);else back();
      notify(tr('저장되었습니다.','Message enregistré.'));
    }catch(error){console.error(error);notify(tr('저장에 실패했습니다.','Échec de l’enregistrement.'),true);}
    finally{if(btn)btn.disabled=false;}
  });
  // Browser native editing commands are used only for trusted toolbar actions.
  document.querySelectorAll<HTMLButtonElement>('#post-form [data-format]').forEach(button=>{
    button.addEventListener('mousedown',e=>e.preventDefault());
    button.addEventListener('click',()=>{
      if(!editor)return;editor.focus();
      document.execCommand(button.dataset.format||'',false,button.dataset.value||undefined);
    });
  });
  by<HTMLButtonElement>('rich-link')?.addEventListener('click',()=>{
    if(!editor)return;
    const link=prompt(tr('연결할 링크 주소 (https://)','URL du lien (https://)'),'https://');
    if(!link)return;
    try{const url=new URL(link);if(url.protocol!=='https:'&&url.protocol!=='http:')throw Error('scheme');editor.focus();document.execCommand('createLink',false,url.href);}
    catch{notify(tr('올바른 링크 주소를 입력하세요.','URL non valide.'),true);}
  });
  by<HTMLInputElement>('rich-color')?.addEventListener('input',e=>{
    const value=(e.currentTarget as HTMLInputElement).value;editor?.focus();document.execCommand('foreColor',false,value);
  });
  by<HTMLButtonElement>('rich-undo')?.addEventListener('click',()=>{editor?.focus();document.execCommand('undo');});
  by<HTMLButtonElement>('rich-redo')?.addEventListener('click',()=>{editor?.focus();document.execCommand('redo');});
  editor?.addEventListener('paste',event=>{
    // Avoid embedded remote images, tracking pixels, HTML scripts and hidden links.
    event.preventDefault();const plain=event.clipboardData?.getData('text/plain')||'';
    document.execCommand('insertText',false,plain);
  });
  const photoButton=by<HTMLButtonElement>('rich-photo');
  if(photoApi){show('rich-photo',true);if(photoHelp)photoHelp.textContent=tr('사진을 선택하면 자동 압축 후 비공개로 업로드합니다.','Les photos sont compressées et envoyées dans le stockage privé.');}
  photoButton?.addEventListener('click',()=>{
    const selection=window.getSelection();
    photoCaret=selection?.rangeCount&&editor?.contains(selection.getRangeAt(0).commonAncestorContainer)
      ?selection.getRangeAt(0).cloneRange():null;
    by<HTMLInputElement>('rich-photo-file')?.click();
  });
  by<HTMLInputElement>('rich-photo-file')?.addEventListener('change',async event=>{
    const input=event.currentTarget as HTMLInputElement;const files=Array.from(input.files||[]);
    for(const file of files){
      try{await uploadPhoto(file);}
      catch(error){
        console.error('ASICC photo upload error',error);
        // Only show photo errors inside the editor; the global board banner stays clear.
        clearNotice();
        const reason=error instanceof Error ? error.message : tr('알 수 없는 오류','Erreur inconnue');
        if(photoHelp){
          photoHelp.textContent=tr(`사진 업로드 실패: ${file.name} (${reason})`, `Échec de l’ajout : ${file.name} (${reason})`);
          photoHelp.style.color='#b42318';
        }
      }
    }
    input.value='';photoCaret=null;
  });
  by<HTMLFormElement>('comment-form')?.addEventListener('submit',async e=>{
    e.preventDefault();if(!canWrite()||!selected)return;const body=by<HTMLTextAreaElement>('comment-body')?.value.trim()||'';
    if(!body||body.length>2000)return notify(tr('댓글을 확인하세요.','Vérifiez le commentaire.'),true);
    try{await setDoc(doc(collection(db,'boardPosts',selected.id,'comments')),{body,authorUid:uid,authorName:name,createdAt:serverTimestamp(),updatedAt:serverTimestamp(),deleted:false});by<HTMLFormElement>('comment-form')?.reset();await refreshComments(selected.id);}
    catch(e){console.error(e);notify(tr('댓글 등록 실패','Impossible de publier le commentaire.'),true);}
  });
</script>
