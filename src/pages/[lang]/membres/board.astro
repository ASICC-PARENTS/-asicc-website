      const report=el('button',tr('신고','Signaler')) as HTMLButtonElement;
      report.type='button';report.className='board-mini-btn';
      report.addEventListener('click',()=>void reportBoardEntry('comment',postId,c.id));btns.append(report);
    }
    // A fifth-level reply has no further reply action; edits and deletion remain available.
    if(canWrite()&&!c.deleted&&depth<MAX_COMMENT_DEPTH){
      const reply=el('button',tr('답글','Répondre')) as HTMLButtonElement;
      reply.className='board-mini-btn';reply.type='button';
