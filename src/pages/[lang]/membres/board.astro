      const title=el('button',plainTitle) as HTMLButtonElement;title.type='button';title.className='board-title-link';title.addEventListener('click',()=>void openPost(post));
      subject.append(badge,title);
      const author=el('span',tr('회원','Membre'));author.className='board-author';
      const date=el('span',stamp(post.createdAt));date.className='board-date';
      row.append(number,subject,author,date);list.append(row);
      void publicInfo(post.authorUid).then(info=>{if(row.isConnected){displayAuthor(author,info,post.authorUid,uid,role,viewerDM,fr,messageUrl,'',db,post.deleted?undefined:{kind:'board',post:post.id,comment:''});}});
    });
