  const deletionReason=(own:boolean):'author_request'|'spam'|'rules_violation'|null=>{
    if(own)return 'author_request';

    const value=prompt(
      tr('완전 삭제 사유: spam 또는 rules_violation',
         'Motif : spam ou rules_violation'),
      'spam'
    );

    if(value===null)return null;

    if(value!=='spam'&&value!=='rules_violation'){
      notify(tr('삭제 사유를 확인하세요.','Motif non valide.'),true);
      return null;
    }
    return value;
  };

  async function deletePost(post:BoardData){
    if(!canDelete(post.authorUid)||post.deleted)return;

    const own=post.authorUid===uid;
    const reason=deletionReason(own);
    if(!reason)return;

    if(!confirm(tr(
      '게시글과 모든 댓글을 완전히 삭제할까요? 복구할 수 없습니다.',
      'Supprimer définitivement ce message et tous ses commentaires ?'
    )))return;

    try{
      const comments=await getDocs(
        query(collection(db,'boardPosts',post.id,'comments'),limit(451))
      );

      if(comments.size>450){
        notify(tr(
          '댓글이 너무 많아 일괄 삭제할 수 없습니다.',
          'Trop de commentaires.'
        ),true);
        return;
      }

      const batch=writeBatch(db);

      for(const comment of comments.docs){
        batch.delete(comment.ref);
      }

      batch.delete(doc(db,'boardPosts',post.id));

      batch.set(doc(db,'boardDeletionLogs',`post_${post.id}`),{
        targetType:'post',
        postId:post.id,
        commentId:'',
        authorUid:post.authorUid,
        actorUid:uid,
        reason,
        deletedAt:serverTimestamp()
      });

      await batch.commit();
      back();
      await loadBoardCategories();await refreshPosts();
      notify(tr('게시글이 삭제되었습니다.','Message supprimé.'));
    }catch(e){
      console.error(e);
      notify(tr('삭제에 실패했습니다.','Échec de la suppression.'),true);
    }
  }

  async function deleteComment(postId:string,c:CommentData){
    if(!canDelete(c.authorUid)||c.deleted)return;

    const own=c.authorUid===uid;
    const reason=deletionReason(own);
    if(!reason)return;

    if(!confirm(tr(
      replyInfo(c.body).parentId?'답글을 완전히 삭제할까요? 복구할 수 없습니다.':'댓글을 완전히 삭제할까요? 복구할 수 없습니다.',
      replyInfo(c.body).parentId?'Supprimer définitivement cette réponse ?':'Supprimer définitivement ce commentaire ?'
    )))return;

    try{
      const batch=writeBatch(db);

      batch.delete(
        doc(db,'boardPosts',postId,'comments',c.id)
      );

      batch.set(
        doc(db,'boardDeletionLogs',`comment_${postId}_${c.id}`),
        {
          targetType:'comment',
          postId,
          commentId:c.id,
          authorUid:c.authorUid,
          actorUid:uid,
          reason,
          deletedAt:serverTimestamp()
        }
      );

      await batch.commit();
      await refreshComments(postId);

      notify(tr(
        replyInfo(c.body).parentId?'답글이 삭제되었습니다.':'댓글이 삭제되었습니다.',
        replyInfo(c.body).parentId?'Réponse supprimée.':'Commentaire supprimé.'
      ));
    }catch(e){
      console.error(e);
      notify(tr(
        '댓글 삭제에 실패했습니다.',
        'Échec de la suppression.'
      ),true);
    }
  }

  function renderComment(c:CommentData,postId:string,depth:number,orphan=false):HTMLElement{
    const detail=replyInfo(c.body);
    const isReply=!!detail.parentId;
    const kind=tr(isReply?'답글':'댓글',isReply?'Réponse':'Commentaire');
    const wrap=el('div');wrap.className=`board-comment-entry${isReply?' board-reply-entry':''}`;
    wrap.dataset.depth=String(depth);
    const meta=el('div',`${kind} · ${dateLabel(c.createdAt,c.updatedAt)}`);meta.className='board-comment-meta small muted';
    void publicInfo(c.authorUid).then(info=>{if(meta.isConnected)displayAuthor(meta,info,c.authorUid,uid,role,viewerDM,fr,messageUrl,`${kind} · ${dateLabel(c.createdAt,c.updatedAt)}`,db,c.deleted?undefined:{kind:'board',post:postId,comment:c.id});});
    const body=el('p',detail.text);body.className='board-comment-text';
    if(orphan){const note=el('p',tr('연결된 상위 댓글·답글을 찾을 수 없습니다.','Le commentaire parent est introuvable.'));note.className='small muted';wrap.append(note);}
