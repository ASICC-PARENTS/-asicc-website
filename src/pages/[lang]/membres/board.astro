---
import Base from '../../../layouts/Base.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const live = import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === 'true';
---
<Base lang={lang} rest="membres/board/" title={L(lang,{ko:'회원게시판',fr:'Forum des membres'})} noindex>
  <section class="wrap m-shell board-shell">
    <div class="stack gap-16 member-ui" id="board-root" data-lang={lang} data-login-url={href(lang,'membres/login/')}>
      <a href={href(lang,'membres/')} class="small">← {L(lang,{ko:'회원공간',fr:'Espace membres'})}</a>
      <h1 class="h2">{L(lang,{ko:'회원게시판',fr:'Forum des membres'})}</h1>
      <p class="muted">{L(lang,{ko:'일반회원은 읽기, 정회원·특별회원·관리자는 글쓰기와 댓글이 가능합니다.',fr:'Les membres généraux peuvent consulter les messages. La publication et les commentaires sont réservés aux membres de l’association, aux membres spéciaux et aux administrateurs.'})}</p>
      <details class="card" style="padding:14px"><summary>{L(lang,{ko:'게시판 이용 규칙',fr:'Règles du forum'})}</summary><p class="small muted" style="margin-top:10px">{L(lang,{ko:'비방·괴롭힘·고의적 분란 조장·허위정보·개인정보 공개·스팸을 금지합니다. 운영진은 위반 게시물을 숨기거나 삭제하고 계정의 이용 권한을 제한할 수 있습니다. 이의제기는 contact@asicc-parents.fr로 문의해 주세요.',fr:'Les attaques, le harcèlement, les provocations délibérées, les fausses informations, la divulgation de données et les spams sont interdits. La modération peut masquer ou supprimer des contenus et limiter les accès. Recours : contact@asicc-parents.fr.'})}</p></details>
      {!live && <div class="card auth-card" role="status">{L(lang,{ko:'게시판은 보안 점검 중으로 아직 공개되지 않았습니다.',fr:'Le forum est désactivé pendant les vérifications de sécurité.'})}</div>}
      <div id="board-app" hidden={!live} class="stack gap-16">
        <p id="board-status" role="status" aria-live="polite" class="small muted">{L(lang,{ko:'회원 권한 확인 중…',fr:'Vérification des autorisations…'})}</p>
        <div id="board-content" hidden class="stack gap-16">
          <div id="board-toolbar" class="board-toolbar">
            <div class="board-search-wrap">
              <label for="board-search" class="sr-only">{L(lang,{ko:'게시글 검색',fr:'Rechercher dans les messages'})}</label>
              <span class="board-search-icon" aria-hidden="true">⌕</span>
              <input id="board-search" type="search" maxlength="120" placeholder={L(lang,{ko:'제목 또는 내용 검색',fr:'Rechercher par titre ou contenu'})} />
            </div>
            <label for="board-category-filter" class="sr-only">{L(lang,{ko:'분류별 보기',fr:'Filtrer par catégorie'})}</label>
            <select id="board-category-filter" class="board-category-filter sr-only" aria-label={L(lang,{ko:'게시글 분류',fr:'Catégorie des messages'})}>
              <option value="all">{L(lang,{ko:'전체 분류',fr:'Toutes les catégories'})}</option>
              <option value="free">{L(lang,{ko:'자유',fr:'Libre'})}</option>
              <option value="give">{L(lang,{ko:'무료나눔',fr:'Dons'})}</option>
              <option value="market">{L(lang,{ko:'중고거래',fr:'Occasion'})}</option>
              <option value="info">{L(lang,{ko:'정보',fr:'Informations'})}</option>
              <option value="question">{L(lang,{ko:'질문',fr:'Questions'})}</option>
            </select>
            <button id="board-write-toggle" type="button" class="btn btn-dark" hidden>+ {L(lang,{ko:'글쓰기',fr:'Écrire un message'})}</button>
          </div>
          <nav id="board-category-tabs" class="board-category-tabs" aria-label={L(lang,{ko:'분류별 게시글 보기',fr:'Parcourir les catégories'})}>
            <button class="board-category-tab is-active" type="button" data-board-tab="all" aria-pressed="true">{L(lang,{ko:'전체',fr:'Tout'})}</button>
            <button class="board-category-tab" type="button" data-board-tab="free" aria-pressed="false">{L(lang,{ko:'자유',fr:'Libre'})}</button>
            <button class="board-category-tab" type="button" data-board-tab="give" aria-pressed="false">{L(lang,{ko:'무료나눔',fr:'Dons'})}</button>
            <button class="board-category-tab" type="button" data-board-tab="market" aria-pressed="false">{L(lang,{ko:'중고거래',fr:'Occasion'})}</button>
            <button class="board-category-tab" type="button" data-board-tab="info" aria-pressed="false">{L(lang,{ko:'정보',fr:'Informations'})}</button>
            <button class="board-category-tab" type="button" data-board-tab="question" aria-pressed="false">{L(lang,{ko:'질문',fr:'Questions'})}</button>
          </nav>
          <form id="post-form" class="card board-editor stack gap-12" hidden>
            <h2 class="h3">{L(lang,{ko:'새 게시글 작성',fr:'Créer un message'})}</h2>
            <label for="post-category">{L(lang,{ko:'글 분류',fr:'Catégorie'})}</label>
            <select id="post-category" name="category" required>
              <option value="free">{L(lang,{ko:'자유',fr:'Libre'})}</option>
              <option value="give">{L(lang,{ko:'무료나눔',fr:'Don gratuit'})}</option>
              <option value="market">{L(lang,{ko:'중고거래',fr:'Vente d’occasion'})}</option>
              <option value="info">{L(lang,{ko:'정보',fr:'Information'})}</option>
              <option value="question">{L(lang,{ko:'질문',fr:'Question'})}</option>
            </select>
            <label for="post-title">{L(lang,{ko:'제목',fr:'Titre'})}</label>
            <input id="post-title" name="title" maxlength="120" required />
            <label for="post-body">{L(lang,{ko:'내용',fr:'Message'})}</label>
            <div class="rich-tools" role="toolbar" aria-label={L(lang,{ko:'글 편집 도구',fr:'Outils de mise en forme'})}>
              <button type="button" data-format="bold" title="Bold" aria-label={L(lang,{ko:'굵게',fr:'Gras'})}><strong>B</strong></button>
              <button type="button" data-format="italic" title="Italic" aria-label={L(lang,{ko:'기울임',fr:'Italique'})}><em>I</em></button>
              <button type="button" data-format="underline" aria-label={L(lang,{ko:'밑줄',fr:'Souligner'})}><u>U</u></button>
              <span class="rich-separator" aria-hidden="true"></span>
              <button type="button" data-format="formatBlock" data-value="h2" aria-label={L(lang,{ko:'큰 제목',fr:'Grand titre'})}>H2</button>
              <button type="button" data-format="formatBlock" data-value="p" aria-label={L(lang,{ko:'본문',fr:'Paragraphe'})}>¶</button>
              <button type="button" data-format="insertUnorderedList" aria-label={L(lang,{ko:'글머리표',fr:'Liste à puces'})}>• ≡</button>
              <button type="button" data-format="insertOrderedList" aria-label={L(lang,{ko:'번호 목록',fr:'Liste numérotée'})}>1. ≡</button>
              <span class="rich-separator" aria-hidden="true"></span>
              <button type="button" data-format="justifyLeft" aria-label={L(lang,{ko:'왼쪽 정렬',fr:'Aligner à gauche'})}>☰</button>
              <button type="button" data-format="justifyCenter" aria-label={L(lang,{ko:'가운데 정렬',fr:'Centrer'})}>≡</button>
              <button type="button" id="rich-link" aria-label={L(lang,{ko:'링크',fr:'Lien'})}>🔗</button>
              <label class="rich-color-label" aria-label={L(lang,{ko:'글자 색상',fr:'Couleur du texte'})}>◉ <input type="color" id="rich-color" value="#254d49" /></label>
              <button type="button" id="rich-undo" aria-label={L(lang,{ko:'실행 취소',fr:'Annuler'})}>↶</button>
              <button type="button" id="rich-redo" aria-label={L(lang,{ko:'다시 실행',fr:'Rétablir'})}>↷</button>
              <span class="rich-separator" aria-hidden="true"></span>
              <button type="button" id="rich-photo" hidden aria-label={L(lang,{ko:'사진 첨부',fr:'Ajouter une photo'})}>▣ {L(lang,{ko:'사진',fr:'Photo'})}</button>
              <input type="file" id="rich-photo-file" accept="image/*" multiple hidden />
            </div>
            <div id="post-body" class="rich-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label={L(lang,{ko:'게시글 본문',fr:'Contenu du message'})} data-placeholder={L(lang,{ko:'내용을 입력하세요…',fr:'Écrivez votre message…'})}></div>
            <div id="photo-adjust" class="photo-adjust" hidden aria-label={L(lang,{ko:'선택한 사진 크기와 위치',fr:'Taille et position de la photo sélectionnée'})}>
              <div class="photo-adjust-row">
                <strong>{L(lang,{ko:'사진 편집',fr:'Modifier la photo'})}</strong>
                <span class="small muted">{L(lang,{ko:'사진을 클릭한 뒤 조절하세요',fr:'Sélectionnez une photo pour la modifier'})}</span>
              </div>
              <div class="photo-adjust-row">
                <label for="photo-width">{L(lang,{ko:'크기',fr:'Taille'})}</label>
                <input id="photo-width" type="range" min="25" max="100" step="5" value="100" />
                <output id="photo-width-display" for="photo-width">100%</output>
              </div>
              <div class="photo-adjust-row" role="group" aria-label={L(lang,{ko:'사진 위치',fr:'Alignement de la photo'})}>
                <span>{L(lang,{ko:'위치',fr:'Position'})}</span>
                <div class="photo-adjust-buttons">
                  <button type="button" data-photo-align="left">{L(lang,{ko:'왼쪽',fr:'Gauche'})}</button>
                  <button type="button" data-photo-align="center">{L(lang,{ko:'가운데',fr:'Centre'})}</button>
                  <button type="button" data-photo-align="right">{L(lang,{ko:'오른쪽',fr:'Droite'})}</button>
                </div>
              </div>
              <button id="photo-remove" type="button" class="board-mini-btn board-mini-danger">{L(lang,{ko:'선택한 사진 제거',fr:'Retirer cette photo'})}</button>
            </div>
            <p id="photo-count" class="small muted" aria-live="polite">{L(lang,{ko:'첨부 사진 0 / 10장',fr:'Photos jointes : 0 / 10'})}</p>
            <p id="photo-help" class="small muted" role="status">{L(lang,{ko:'사진 첨부는 비공개 저장소 연결 후 사용할 수 있습니다.',fr:'L’ajout de photos sera activé après la configuration du stockage privé.'})}</p>
            <p class="small muted">{L(lang,{ko:'최대 5,000자(서식 코드 포함), 사진 최대 10장 · 고화질 자동 압축(총용량 제한 없음).',fr:'5 000 caractères maximum (mise en forme incluse), 10 photos maximum, compressées sans limite totale de taille.'})}</p>
            <div class="board-editor-actions row gap-12">
              <button class="btn btn-dark" id="post-save" type="submit">{L(lang,{ko:'등록',fr:'Publier'})}</button>
              <button class="btn btn-ghost" id="post-cancel" type="button">{L(lang,{ko:'취소',fr:'Annuler'})}</button>
            </div>
          </form>
          <section id="board-list-panel" class="board-list-card" aria-label={L(lang,{ko:'게시글 목록',fr:'Liste des messages'})}>
            <div class="board-table-head">
              <span>{L(lang,{ko:'번호',fr:'N°'})}</span>
              <span>{L(lang,{ko:'제목',fr:'Sujet'})}</span>
              <span>{L(lang,{ko:'작성자',fr:'Auteur'})}</span>
              <span>{L(lang,{ko:'날짜',fr:'Date'})}</span>
            </div>
            <div id="board-list" class="board-list"></div>
            <p class="board-count" id="board-count" aria-live="polite"></p>
          </section>
          <article id="post-detail" class="card board-detail stack gap-16" hidden>
            <button type="button" class="btn btn-ghost board-back" id="post-back">← {L(lang,{ko:'목록으로',fr:'Retour à la liste'})}</button>
            <h2 id="detail-title" class="h3"></h2>
            <p id="detail-meta" class="small muted"></p>
            <div id="detail-body" class="board-text"></div>
            <div id="detail-actions" class="row gap-12" style="flex-wrap:wrap"></div>
            <h3 class="h3">{L(lang,{ko:'댓글',fr:'Commentaires'})} <span id="comment-count" class="small muted"></span></h3>
            <div id="comment-list" class="stack gap-8"></div>
            <form id="comment-form" class="stack gap-12" hidden>
              <label for="comment-body">{L(lang,{ko:'댓글 작성',fr:'Ajouter un commentaire'})}</label>
              <textarea id="comment-body" maxlength="2000" rows="3" required></textarea>
              <button type="submit" class="btn btn-dark">{L(lang,{ko:'댓글 등록',fr:'Publier le commentaire'})}</button>
            </form>
          </article>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, getIdToken } from 'firebase/auth';
  import {displayAuthor,dmAllowed,syncOwnAlias,type PublicAuthor} from '../../../scripts/members/member-access';
  import { getFirestore, doc, collection, getDoc, getDocs, query, orderBy, limit, setDoc, updateDoc, writeBatch, serverTimestamp } from 'firebase/firestore';
  import { firebaseConfig } from '../../../firebase-config';
  import { BOARD_PHOTO_API, MEMBER_NOTIFICATION_API } from '../../../config/board-photos';
  import { renderBoardBody, setEditorBody, serializeEditor, boardText, photoKeys, insertPhoto } from '../../../scripts/board-rich';
  type TimestampLike = { toDate?:()=>Date };
  type BoardData = { id:string;title:string;body:string;authorUid:string;authorName:string;deleted:boolean;createdAt?:TimestampLike;updatedAt?:TimestampLike };
  type CommentData = { id:string;body:string;authorUid:string;authorName:string;deleted:boolean;createdAt?:TimestampLike;updatedAt?:TimestampLike };
  type Category = string;
  const CATEGORY_KO:Record<Category,string>={free:'자유',give:'무료나눔',market:'중고거래',info:'정보',question:'질문'};
  const CATEGORY_FR:Record<Category,string>={free:'Libre',give:'Don gratuit',market:'Occasion',info:'Information',question:'Question'};
  let categoryNames=Object.keys(CATEGORY_KO) as Category[];
  // Category IDs remain stable even if an administrator renames their labels.
  // This preserves the existing restrictive boardPosts Firestore schema.
  const titleInfo=(stored:string):{category:Category;title:string}=>{
    const stable=/^\[cat:([a-z][a-z0-9-]{1,23})\]\s+/.exec(stored);
    if(stable)return {category:stable[1],title:stored.slice(stable[0].length)};
    // Legacy label-based titles are still readable. No existing member migration needed.
    const legacy=/^\[([^\]\n]{1,28})\]\s+/.exec(stored);
    if(!legacy)return {category:'free',title:stored};
    const category=categoryNames.find(key=>CATEGORY_KO[key]===legacy[1])||'free';
    return {category,title:stored.slice(legacy[0].length)};
  };
  const storedTitle=(category:Category,title:string)=>`[cat:${category}] ${title}`;
  const categoryLabel=(category:Category)=>fr?(CATEGORY_FR[category]||category):(CATEGORY_KO[category]||category);
  // Reply's parent ID is encoded in body; the current comment Firestore schema has no parentId field.
  const REPLY_PREFIX=/^\[ASICC_REPLY_V1:([A-Za-z0-9]{20})\]\n/;
  const replyInfo=(body:string)=>{
    const match=REPLY_PREFIX.exec(body);
    return {parentId:match?.[1]||null,text:match?body.slice(match[0].length):body};
  };
  const replyBody=(parentId:string,text:string)=>`[ASICC_REPLY_V1:${parentId}]\n${text}`;
  // The original comment is level 1. A reply can go as deep as level 5.
  // Parent IDs stay encoded in body for compatibility with existing Firestore rules.
  const MAX_COMMENT_DEPTH=5;
  const root=document.getElementById('board-root') as HTMLElement|null;
  const by=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T|null;
  const fr=root?.dataset.lang==='fr';
  const tr=(ko:string,french:string)=>fr?french:ko;
  const status=by<HTMLElement>('board-status');
  import {toastResult} from '../../../scripts/members/toast';
  import {formatParisDate} from '../../../scripts/members/display-date';
const notify=(v:string,bad=false)=>{if(status){status.textContent=v;status.hidden=!v;status.style.color=bad?'#b42318':'';}toastResult(v,bad);};
  const clearNotice=()=>notify('');
  const el=(tag:string,text?:string)=>{const node=document.createElement(tag);if(text!==undefined)node.textContent=text;return node;};
  const stamp=(v?:TimestampLike)=>formatParisDate(v);
  const wasEdited=(created?:TimestampLike,updated?:TimestampLike)=>{
    try {return !!(created?.toDate&&updated?.toDate&&updated.toDate().getTime()-created.toDate().getTime()>1000);}catch{return false;}
  };
  const dateLabel=(created?:TimestampLike,updated?:TimestampLike)=>`${stamp(created)}${wasEdited(created,updated)?tr(' · 수정됨',' · modifié'):''}`;
  const app=getApps().find(a=>a.name==='asicc-website')??initializeApp(firebaseConfig,'asicc-website');
  const auth=getAuth(app), db=getFirestore(app);
  const aliases=new Map<string,Promise<PublicAuthor>>();
  const publicInfo=(authorUid:string):Promise<PublicAuthor>=>{
    if(!authorUid)return Promise.resolve({nickname:tr('회원','Membre'),role:'general'});
    if(!aliases.has(authorUid))aliases.set(authorUid,getDoc(doc(db,'publicNames',authorUid)).then(snap=>({
      nickname:snap.exists()&&typeof snap.data().nickname==='string'?snap.data().nickname:tr('기존 회원','Ancien membre'),
      role:snap.exists()&&typeof snap.data().role==='string'?snap.data().role:'',canReceiveDM:snap.data()?.canReceiveDM===true
    })).catch(()=>({nickname:tr('기존 회원','Ancien membre'),role:''})));
    return aliases.get(authorUid)!;
  };
  const nicknameOf=(id:string)=>publicInfo(id).then(x=>x.nickname);
  const roleName=(r:string)=>({general:tr('일반회원','Membre général'),member:tr('정회원','Membre régulier'),special:tr('특별회원','Membre spécial'),admin:tr('관리자','Administrateur')} as Record<string,string>)[r]||tr('회원','Membre');
  let viewerDM=false;const messageUrl='../messages/';
  let uid='',name='',role='',posts:BoardData[]=[],selected:BoardData|null=null;
  let editingPostId:string|null=null, photoBusy=false;
  let photoCaret:Range|null=null;
  const photoCache=new Map<string,string>();
  const photoApi=BOARD_PHOTO_API.trim().replace(/\/$/,'');
  const editor=by<HTMLElement>('post-body');
  const form=by<HTMLFormElement>('post-form');
  const photoHelp=by<HTMLElement>('photo-help');
  const photoCount=by<HTMLElement>('photo-count');
  const photoAdjust=by<HTMLElement>('photo-adjust');
  const photoWidth=by<HTMLInputElement>('photo-width');
  const photoWidthDisplay=by<HTMLOutputElement>('photo-width-display');
  let activePhoto:HTMLImageElement|null=null;
  const numPhotos=()=>editor?.querySelectorAll('img[data-b2-key]').length||0;
  function updatePhotoCounter(){if(photoCount)photoCount.textContent=tr(`첨부 사진 ${numPhotos()} / 10장`,`Photos jointes : ${numPhotos()} / 10`);}
  function clearPhotoSelection(){
    activePhoto?.classList.remove('photo-selected');
    activePhoto=null;
    if(photoAdjust)photoAdjust.hidden=true;
  }
  function updatePhotoTools(){
    if(!activePhoto)return;
    const stored=Number(activePhoto.dataset.photoWidth||100);
    const width=Number.isFinite(stored)&&stored>=25&&stored<=100?stored:100;
    if(photoWidth)photoWidth.value=String(width);
    if(photoWidthDisplay)photoWidthDisplay.textContent=`${width}%`;
    const align=activePhoto.dataset.photoAlign||'center';
    document.querySelectorAll<HTMLButtonElement>('#photo-adjust [data-photo-align]').forEach(button=>{
      const active=button.dataset.photoAlign===align;
      button.classList.toggle('is-active',active);
      button.setAttribute('aria-pressed',String(active));
    });
  }
  function selectPhoto(img:HTMLImageElement){
    if(!editor?.contains(img)||!img.dataset.b2Key)return;
    clearPhotoSelection();activePhoto=img;img.classList.add('photo-selected');
    if(photoAdjust)photoAdjust.hidden=false;
    updatePhotoTools();
  }
  editor?.addEventListener('input',updatePhotoCounter);
  editor?.addEventListener('click',event=>{
    const target=event.target;
    if(target instanceof HTMLImageElement && target.dataset.b2Key)selectPhoto(target);
    else clearPhotoSelection();
  });
  photoWidth?.addEventListener('input',()=>{
    if(!activePhoto||!editor?.contains(activePhoto))return clearPhotoSelection();
    const width=Number(photoWidth.value);
    if(!Number.isInteger(width)||width<25||width>100||width%5!==0)return;
    activePhoto.dataset.photoWidth=String(width);
    activePhoto.style.width=`${width}%`;
    if(photoWidthDisplay)photoWidthDisplay.textContent=`${width}%`;
  });
  document.querySelectorAll<HTMLButtonElement>('#photo-adjust [data-photo-align]').forEach(button=>{
    button.addEventListener('click',()=>{
      if(!activePhoto||!editor?.contains(activePhoto))return clearPhotoSelection();
      const align=button.dataset.photoAlign;
      if(!align||!['left','center','right'].includes(align))return;
      activePhoto.dataset.photoAlign=align;
      updatePhotoTools();
    });
  });
  by<HTMLButtonElement>('photo-remove')?.addEventListener('click',()=>{
    if(!activePhoto||!editor?.contains(activePhoto))return;
    const photo=activePhoto;
    const paragraph=photo.parentElement;
    clearPhotoSelection();
    if(paragraph?.tagName==='P'&&paragraph.childElementCount===1&&!paragraph.textContent?.trim())paragraph.remove();
    else photo.remove();
    updatePhotoCounter();editor.focus();
  });
  async function mediaFetch(path:string,method='GET',blob?:Blob):Promise<Response>{
    if(!photoApi)throw Error('Not configured');
    const current=auth.currentUser;if(!current)throw Error('Not signed in');
    const token=await getIdToken(current);
    const response=await fetch(`${photoApi}${path}`,{method,headers:{Authorization:`Bearer ${token}`,...(blob?{'Content-Type':blob.type}:{})},body:blob,cache:'no-store'});
    if(!response.ok){
      // Keep error codes visible for diagnosis. Never include tokens or credentials.
      const data=await response.clone().json().catch(()=>null) as {error?:unknown}|null;
      const reason=typeof data?.error==='string' ? data.error.slice(0,120) : 'Request rejected';
      throw Error(`HTTP ${response.status}: ${reason}`);
    }
    return response;
  }
  async function photoSrc(key:string):Promise<string>{
    if(photoCache.has(key))return photoCache.get(key)!;
    const res=await mediaFetch(`/api/photo?key=${encodeURIComponent(key)}`);
    const blob=await res.blob();
    if(!blob.type.startsWith('image/'))throw Error('Invalid image');
    const url=URL.createObjectURL(blob);photoCache.set(key,url);return url;
  }
  async function populatePhotos(node:HTMLElement){
    const images=Array.from(node.querySelectorAll<HTMLImageElement>('img[data-b2-key]'));
    await Promise.all(images.map(async img=>{
      const key=img.dataset.b2Key||'';
      if(img.src.startsWith('blob:'))return;
      img.classList.add('photo-loading');
      try{img.src=await photoSrc(key);}
      catch {img.alt=tr('사진을 불러올 수 없습니다','Impossible de charger la photo');img.classList.add('photo-error');}
      finally {img.classList.remove('photo-loading');}
    }));
  }
  async function compressPhoto(file:File):Promise<Blob>{
    if(!file.type.startsWith('image/'))throw Error('image required');
    if(file.size>20_000_000)throw Error('Photo over 20MB');
    const bitmap=await createImageBitmap(file);
    try{
      // Start from a higher-quality 1600px WebP; reduce only if needed for the existing 1.5MB Worker limit.
      let scale=Math.min(1,1600/Math.max(bitmap.width,bitmap.height));
      for(let attempt=0;attempt<5;attempt++){
        const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));
        const ctx=canvas.getContext('2d');if(!ctx)throw Error('Canvas unavailable');
        ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);
        const format='image/webp';
        const blob=await new Promise<Blob|null>(resolve=>canvas.toBlob(resolve,format,Math.max(.78,.86-attempt*.02)));
        if(blob&&blob.type==='image/webp'&&blob.size<=1_500_000)return blob;
        scale*=0.85;
      }
      throw Error('Could not compress to <=1.5MB');
    }finally{bitmap.close();}
  }
  async function uploadPhoto(file:File):Promise<void>{
    if(!editor||!photoApi||!canWrite())return;
    if(numPhotos()>=10)throw Error(tr('사진은 게시글당 최대 10장입니다.','10 photos maximum par message.'));
    photoBusy=true;
    const button=by<HTMLButtonElement>('rich-photo');if(button)button.disabled=true;
    if(photoHelp)photoHelp.textContent=tr('사진 압축·업로드 중…','Compression et envoi de la photo…');
    try{
      const compressed=await compressPhoto(file);
      const res=await mediaFetch('/api/upload','POST',compressed);
      const payload=await res.json() as {key?:string};
      if(!payload.key)throw Error('Missing key');
      const url=URL.createObjectURL(compressed);photoCache.set(payload.key,url);
      insertPhoto(editor,payload.key,url,photoCaret);
      const inserted=Array.from(editor.querySelectorAll<HTMLImageElement>('img[data-b2-key]'))
        .find(img=>img.dataset.b2Key===payload.key);
      if(inserted)selectPhoto(inserted);
      photoCaret=null;updatePhotoCounter();
      if(photoHelp)photoHelp.textContent=tr('사진이 첨부되었습니다. 게시글을 등록해 주세요.','Photo ajoutée. Publiez votre message.');
    }finally{photoBusy=false;if(button)button.disabled=false;}
  }
