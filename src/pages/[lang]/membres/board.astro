        textarea.placeholder=tr('답글을 입력하세요','Écrire une réponse');
        textarea.setAttribute('aria-label',tr('답글 내용','Contenu de la réponse'));
        const actions=el('div');actions.className='board-reply-form-actions';
        const submit=el('button',tr('답글 등록','Publier la réponse')) as HTMLButtonElement;
        submit.type='submit';submit.className='board-mini-btn board-mini-primary';
        const cancel=el('button',tr('취소','Annuler')) as HTMLButtonElement;
        cancel.type='button';cancel.className='board-mini-btn';cancel.addEventListener('click',()=>replyForm.remove());
        actions.append(submit,cancel);replyForm.append(textarea,actions);wrap.append(replyForm);
        textarea.focus();
        replyForm.addEventListener('submit',async event=>{
          event.preventDefault();if(!canWrite()||!selected||selected.id!==postId||depth>=MAX_COMMENT_DEPTH)return;
          const text=textarea.value.trim();const encoded=replyBody(c.id,text);
          if(!text||encoded.length>2000)return notify(tr('답글 길이가 제한을 초과했어요.','Réponse trop longue.'),true);
          submit.disabled=true;
          try{
            await setDoc(doc(collection(db,'boardPosts',postId,'comments')),{body:encoded,authorUid:uid,authorName:name,createdAt:serverTimestamp(),updatedAt:serverTimestamp(),deleted:false});
            notify(tr('답글이 등록되었습니다.','Réponse publiée.'));await refreshComments(postId);
          }catch(error){console.error(error);notify(tr('답글 등록 실패','Échec de la réponse.'),true);submit.disabled=false;}
        });
      });btns.append(reply);
    }
    if(!c.deleted&&canEdit(c.authorUid)){
      const edit=el('button',tr('수정','Modifier')) as HTMLButtonElement;
      edit.type='button';edit.className='board-mini-btn';
      edit.addEventListener('click',async()=>{
        const updated=prompt(tr(isReply?'답글 수정':'댓글 수정',isReply?'Modifier la réponse':'Modifier le commentaire'),detail.text);
        if(updated===null)return;
        const text=updated.trim(),encoded=detail.parentId?replyBody(detail.parentId,text):text;
        if(!text||encoded.length>2000)return notify(tr('글자 수를 확인하세요.','Contenu trop long.'),true);
        try{await updateDoc(doc(db,'boardPosts',postId,'comments',c.id),{body:encoded,updatedAt:serverTimestamp()});notify(tr('댓글 수정이 완료되었습니다.','Commentaire modifié.'));await refreshComments(postId);}
        catch(error){console.error(error);notify(tr('수정 실패','Échec de la modification.'),true);}
      });btns.append(edit);
    }
    if(!c.deleted&&canModerate()&&c.authorUid!==uid){
      const hide=el('button',tr('비공개','Masquer')) as HTMLButtonElement;
      hide.type='button';hide.className='board-mini-btn';
      hide.addEventListener('click',async()=>{
        if(!confirm(tr(isReply?'답글을 숨길까요?':'댓글을 숨길까요?',isReply?'Masquer cette réponse ?':'Masquer ce commentaire ?')))return;
        try{
          const batch=writeBatch(db);
          batch.set(doc(db,'hiddenComments',`${postId}_${c.id}`),{postId,commentId:c.id,body:c.body,authorUid:c.authorUid,hiddenBy:uid,hiddenAt:serverTimestamp()});
          batch.update(doc(db,'boardPosts',postId,'comments',c.id),{body:'[숨김 처리된 댓글]',deleted:true,updatedAt:serverTimestamp()});
          await batch.commit();notify(tr('숨김 처리가 완료되었습니다.','Commentaire masqué.'));await refreshComments(postId);
        }catch(error){console.error(error);notify(tr('숨김 실패','Impossible de masquer.'),true);}
      });btns.append(hide);
    }
    if(!c.deleted&&canDelete(c.authorUid)){
      const del=el('button',tr('삭제','Supprimer')) as HTMLButtonElement;
      del.type='button';del.className='board-mini-btn board-mini-danger';
      del.addEventListener('click',()=>void deleteComment(postId,c));btns.append(del);
