  function renderPosts(){
    const list=by<HTMLElement>('board-list');if(!list)return;list.replaceChildren();
    const search=by<HTMLInputElement>('board-search')?.value.trim().toLocaleLowerCase()||'';
    const categoryFilter=by<HTMLSelectElement>('board-category-filter')?.value||'all';
    const filtered=posts.filter(p=>{
      if(p.deleted)return false;
      const info=titleInfo(p.title);
      if(categoryFilter!=='all'&&info.category!==categoryFilter)return false;
      return !search||`${info.title} ${categoryLabel(info.category)} ${boardText(p.body)}`.toLocaleLowerCase().includes(search);
    });
    const count=by<HTMLElement>('board-count');
    if(count)count.textContent=tr(`게시글 ${filtered.length}개 · 최근 100개 기준`,` ${filtered.length} message(s) · parmi les 100 derniers`);
    if(!filtered.length){const empty=el('p',search?tr('검색 결과가 없습니다.','Aucun résultat.'):categoryFilter!=='all'?tr('이 분류에 등록된 게시글이 없습니다.','Aucun message dans cette catégorie.'):tr('아직 등록된 게시글이 없습니다.','Aucun message publié.'));empty.className='board-empty';list.append(empty);return;}
    filtered.forEach((post,index)=>{
      const row=el('div');row.className='board-row';
