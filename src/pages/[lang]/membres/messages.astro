---
import Base from '../../../layouts/Base.astro';
import {langPaths,href,L,type Lang} from '../../../i18n/ui';
export const getStaticPaths=langPaths;
const lang=Astro.params.lang as Lang;
const live=import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED==='true';
---
<Base lang={lang} rest="membres/messages/" title={L(lang,{ko:'회원 쪽지함',fr:'Messages privés'})} noindex>
  <section class="wrap m-shell">
    <div id="message-root" data-lang={lang} data-login-url={href(lang,'membres/login/')} class="stack gap-16" style="max-width:900px;margin:auto">
      <a href={href(lang,'membres/')} class="small">← {L(lang,{ko:'회원공간',fr:'Espace membres'})}</a>
      <h1 class="h2">{L(lang,{ko:'회원 간 쪽지',fr:'Messagerie privée'})}</h1>
      <p id="message-state" class="small muted" role="status">{L(lang,{ko:'계정 유형과 권한을 확인하는 중입니다…',fr:'Vérification du compte…'})}</p>
      {!live && <p>{L(lang,{ko:'회원 기능이 준비 중입니다.',fr:'Fonction indisponible.'})}</p>}
      <section id="message-minor" class="card" style="padding:24px" hidden>
        {L(lang,{ko:'미성년 학생 및 학생 본인 계정에는 개인정보 보호와 안전을 위해 개인 간 쪽지 기능이 활성화되지 않습니다. 협회 문의는 공식 건의·문의 페이지를 이용해 주세요.',fr:'Pour protéger les élèves, la messagerie privée est désactivée sur les comptes d’élèves. Contactez l’association par la page officielle.'})}
      </section>
      <div id="message-content" class="stack gap-16" hidden>
        <form id="message-compose" class="card stack gap-12" style="padding:22px">
          <h2 class="h3">{L(lang,{ko:'새 쪽지 보내기',fr:'Nouveau message'})}</h2>
          <label>{L(lang,{ko:'받는 사람 닉네임 검색',fr:'Rechercher un destinataire'})}<input id="message-search" type="search" maxlength="50" placeholder={L(lang,{ko:'닉네임 입력',fr:'Pseudo'})}/></label>
          <select id="message-recipient" required><option value="">{L(lang,{ko:'회원 선택',fr:'Sélectionner un membre'})}</option></select>
          <p id="message-advice" class="small muted"></p>
          <label>{L(lang,{ko:'쪽지 내용',fr:'Votre message'})}<textarea id="message-body" rows="5" maxlength="2000" required></textarea></label>
          <button type="submit" class="btn btn-dark">{L(lang,{ko:'쪽지 보내기',fr:'Envoyer'})}</button>
        </form>
        <section class="card stack gap-12" style="padding:22px">
          <h2 class="h3">{L(lang,{ko:'받은 쪽지',fr:'Messages reçus'})}</h2>
          <div id="message-inbox" class="stack gap-12"></div>
        </section>
        <section class="card stack gap-12" style="padding:22px">
          <h2 class="h3">{L(lang,{ko:'보낸 쪽지',fr:'Messages envoyés'})}</h2>
          <div id="message-sent" class="stack gap-12"></div>
        </section>
      </div>
    </div>
  </section>
</Base>
<script>import '../../../scripts/members/messages';</script>
