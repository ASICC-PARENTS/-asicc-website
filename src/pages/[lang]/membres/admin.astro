  el<HTMLButtonElement>('admin-dm-initialise')?.addEventListener('click',async()=>{
    const b=el<HTMLButtonElement>('admin-dm-initialise')!;if(busy||b.disabled)return;busy=true;b.disabled=true;b.textContent=tr('저장 중…','Enregistrement…');
