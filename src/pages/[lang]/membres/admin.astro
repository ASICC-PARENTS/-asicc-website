---
import Base from '../../../layouts/Base.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const live = import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === "true";
---
<Base lang={lang} rest="membres/admin/" title={L(lang, { ko: 'ASICC 운영진 관리', fr: 'Administration ASICC' })} noindex>
  <section class="wrap m-shell asicc-admin-page">
    <div id="asicc-admin" class="stack gap-24"
      data-lang={lang}
      data-login-url={href(lang, 'membres/login/')}
      data-member-url={href(lang, 'membres/')}>
      <div class="stack gap-12">
        <span class="m-badge" style="align-self:flex-start">{L(lang, { ko: '운영진 전용', fr: 'Accès administrateur' })}</span>
        <h1 class="h2">{L(lang, { ko: 'ASICC 회원관리', fr: 'Gestion des membres ASICC' })}</h1>
        <p class="muted">{L(lang, {
          ko: '회원 가입·승급 심사, 실명 변경 신청, 비공개 건의, 계정 이용 제한을 관리합니다.',
          fr: 'Examinez les statuts, corrections de nom, suggestions confidentielles et accès des membres.'
        })}</p>
      </div>

      {!live && <div class="card auth-card" role="status">{L(lang,{ko:"관리자 기능은 Firebase 권한 검증 전까지 비활성화됩니다.",fr:"L’administration reste désactivée jusqu’à la validation des règles Firebase."})}</div>}
      <div hidden={!live} id="admin-loading" class="card auth-card" role="status">
        {L(lang, { ko: '운영진 권한을 확인하고 있습니다…', fr: 'Vérification des droits administrateur…' })}
      </div>
      <div id="admin-denied" class="card auth-card stack gap-12" hidden>
        <p id="admin-denied-message" role="alert"></p>
        <a class="btn btn-dark" href={href(lang, 'membres/')}>{L(lang, { ko: '회원공간으로', fr: 'Retour à l’espace membres' })}</a>
      </div>

      <div id="admin-content" class="stack gap-24" hidden>
        <div class="card auth-card stack gap-12">
          <div class="row gap-16" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <div class="stack gap-8">
              <strong id="admin-who"></strong>
              <span class="small muted">{L(lang, { ko: '운영진 인증 완료', fr: 'Accès administrateur confirmé' })}</span>
            </div>
            <div class="row gap-12" style="flex-wrap:wrap">
              <a class="btn btn-ghost" href={href(lang, 'membres/')}>{L(lang, { ko: '회원공간', fr: 'Espace membres' })}</a>
              <button type="button" class="btn btn-ghost" id="admin-refresh">{L(lang, { ko: '새로고침', fr: 'Actualiser' })}</button>
            </div>
          </div>
        </div>

        <p id="admin-action-message" class="small" role="status" aria-live="polite" hidden></p>

        <section id="admin-notification" class="asicc-admin-notification stack gap-12" role="alert" aria-live="assertive" hidden>
          <div class="row gap-12" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <h2 class="h3">{L(lang,{ko:'새로운 회원 소식',fr:'Nouvelles concernant les membres'})}</h2>
            <span id="admin-notification-count" class="m-badge"></span>
          </div>
          <p id="admin-notification-summary"></p>
          <div id="admin-notification-details" class="small"></div>
          <label class="row gap-8" style="align-items:center">
            <input type="checkbox" id="admin-notification-confirm" />
            <span>{L(lang,{ko:'내용을 확인했습니다. 이 알림은 다시 표시하지 않습니다.',fr:'J’ai pris connaissance de ces informations. Ne plus afficher cette alerte.'})}</span>
          </label>
          <div class="row gap-12" style="align-items:center;flex-wrap:wrap">
            <button type="button" id="admin-notification-ack" class="btn btn-dark" disabled>{L(lang,{ko:'확인 완료',fr:'Confirmer'})}</button>
            <span id="admin-notification-error" class="small" role="status"></span>
          </div>
        </section>

        <p id="admin-notification-empty" class="asicc-admin-empty small" role="status" aria-live="polite" hidden>
          {L(lang,{ko:'새로운 회원 가입이나 탈퇴 요청이 없습니다.',fr:'Aucune nouvelle inscription ni demande de départ.'})}
        </p>

        <section class="card auth-card stack gap-16" aria-labelledby="requests-heading">
          <div class="row gap-16" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <h2 id="requests-heading" class="h3">{L(lang, { ko: '승급 승인 대기', fr: 'Demandes à examiner' })}</h2>
            <span id="admin-pending-count" class="m-badge"></span>
          </div>
          <p class="small muted">{L(lang, {
            ko: '승인 시 신청 결과와 회원 등급을 하나의 트랜잭션으로 저장합니다.',
            fr: 'Chaque approbation met à jour la demande et le statut dans une seule transaction.'
          })}</p>
          <div id="admin-requests" class="stack gap-12"></div>
        </section>

        <section class="card auth-card stack gap-16" aria-labelledby="members-heading">
          <div class="row gap-16" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <h2 id="members-heading" class="h3">{L(lang, { ko: '회원 등급 및 계정 관리', fr: 'Comptes et statuts des membres' })}</h2>
            <span id="admin-member-count" class="m-badge"></span>
          </div>
          <p class="small muted">{L(lang, {
            ko: '정식 협회회원과 특별회원은 동일한 접근권한을 갖습니다. 다른 운영진을 지정할 때는 신중하게 확인하세요.',
            fr: 'Membres et membres spéciaux ont le même accès. Vérifiez soigneusement toute nomination d’administrateur.'
          })}</p>
          <div class="asicc-admin-toolbar">
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'검색',fr:'Recherche'})}</span>
              <input id="admin-member-search" type="search" placeholder={L(lang,{ko:'실명·닉네임·이메일·학생·학교·학년·연락처',fr:'Nom, pseudo, e-mail, élève, école, téléphone'})} />
            </label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'회원 등급',fr:'Statut'})}</span>
              <select id="admin-filter-role">
                <option value="all">{L(lang,{ko:'전체',fr:'Tous'})}</option>
                <option value="general">{L(lang,{ko:'일반회원',fr:'Membre général'})}</option>
                <option value="member">{L(lang,{ko:'협회회원',fr:'Membre'})}</option>
                <option value="special">{L(lang,{ko:'특별회원',fr:'Membre spécial'})}</option>
                <option value="admin">{L(lang,{ko:'운영진',fr:'Administrateur'})}</option>
              </select>
            </label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'계정 상태',fr:'État du compte'})}</span>
              <select id="admin-filter-status">
                <option value="all">{L(lang,{ko:'전체',fr:'Tous'})}</option>
                <option value="approved">{L(lang,{ko:'활성',fr:'Actif'})}</option>
                <option value="suspended">{L(lang,{ko:'정지',fr:'Suspendu'})}</option>
                <option value="withdrawal">{L(lang,{ko:'탈퇴 요청',fr:'Départ demandé'})}</option>
              </select>
            </label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'학교급',fr:'Niveau scolaire'})}</span>
              <select id="admin-filter-school">
                <option value="all">{L(lang,{ko:'전체',fr:'Tous'})}</option>
                <option value="mat">{L(lang,{ko:'유치원',fr:'Maternelle'})}</option>
                <option value="elem">{L(lang,{ko:'초등학교',fr:'Élémentaire'})}</option>
                <option value="col">{L(lang,{ko:'중학교',fr:'Collège'})}</option>
              </select>
            </label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'가입 시작일',fr:'Inscrit après'})}</span><input id="admin-filter-from" type="date" /></label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'가입 종료일',fr:'Inscrit avant'})}</span><input id="admin-filter-to" type="date" /></label>
          </div>
          <div class="row gap-12" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <div id="admin-filter-count" class="small muted" aria-live="polite"></div>
            <div class="row gap-8" style="flex-wrap:wrap">
              <button type="button" class="btn btn-ghost btn-sm" id="admin-filter-reset">{L(lang,{ko:'필터 초기화',fr:'Réinitialiser les filtres'})}</button>
              <button type="button" class="btn btn-ghost btn-sm" id="admin-member-export">{L(lang,{ko:'현재 목록 CSV 저장',fr:'Exporter la sélection CSV'})}</button>
            </div>
          </div>
          <div id="admin-members" class="asicc-admin-table-wrap" aria-live="polite"></div>
          <div id="admin-page-controls" class="row gap-12" style="justify-content:flex-end;align-items:center;flex-wrap:wrap">
            <button type="button" id="admin-prev" class="btn btn-ghost btn-sm">{L(lang,{ko:'이전',fr:'Précédent'})}</button>
            <span id="admin-page-label" class="small muted"></span>
            <button type="button" id="admin-next" class="btn btn-ghost btn-sm">{L(lang,{ko:'다음',fr:'Suivant'})}</button>
          </div>
        </section>

        <section class="card stack gap-16" style="padding:22px" aria-labelledby="name-requests-heading">
          <h2 id="name-requests-heading" class="h3">{L(lang,{ko:'실명 변경 신청',fr:'Demandes de correction du nom'})}</h2>
          <div id="admin-name-requests" class="stack gap-12"></div>
        </section>
        <section class="card stack gap-16" style="padding:22px" aria-labelledby="suggestions-heading">
          <h2 id="suggestions-heading" class="h3">{L(lang,{ko:'협회 비공개 건의함',fr:'Boîte de suggestions privées'})}</h2>
          <div id="admin-suggestions" class="stack gap-12"></div>
        </section>
        <section class="card stack gap-12" style="padding:22px" aria-labelledby="hidden-heading">
          <h2 id="hidden-heading" class="h3">{L(lang,{ko:'숨김 글·댓글 관리 / 복구',fr:'Contenus masqués / restauration'})}</h2>
          <p class="small muted">{L(lang,{ko:'숨긴 원문은 운영진만 확인하고 복구할 수 있습니다. 기존 방식으로 숨겨 이미 덮어쓴 글은 복구되지 않습니다.',fr:'Les archives privées permettent la restauration. Les anciens textes déjà écrasés avant cette mise à jour ne sont pas récupérables.'})}</p>
          <div id="admin-hidden-list" class="stack gap-12"></div>
        </section>
        <section class="card stack gap-12" style="padding:22px" aria-labelledby="anonymize-heading">
          <h2 id="anonymize-heading" class="h3">{L(lang,{ko:'기존 게시글 실명 비공개 처리',fr:'Anonymiser les anciennes signatures'})}</h2>
          <p class="small muted">{L(lang,{ko:'예전 글·댓글의 authorName 필드에 남아 있는 실명을 ‘기존회원’으로 변경합니다. 게시글 본문은 수정하지 않습니다. 한번에 최대 100개 게시글을 점검합니다.',fr:'Remplace les anciens noms réels par « ancien membre » dans les métadonnées, sans modifier le contenu. Vérifie jusqu’à 100 messages à la fois.'})}</p>
          <button class="btn btn-ghost" type="button" id="admin-redact-legacy">{L(lang,{ko:'기존 작성자 실명 비공개 처리 실행',fr:'Anonymiser les anciens noms'})}</button>
        </section>
        <section class="card stack gap-12" style="padding:22px" aria-labelledby="deletions-heading">
          <h2 id="deletions-heading" class="h3">{L(lang,{ko:'게시판 삭제 이력',fr:'Historique de suppression'})}</h2>
          <p class="small muted">{L(lang,{ko:'삭제된 본문은 보관하지 않고 처리자·사유·시각만 조회합니다.',fr:'Les textes supprimés ne sont pas conservés ; seul le journal minimal est affiché.'})}</p>
          <div id="admin-deletion-logs" class="stack gap-8"></div>
        </section>
        <div class="card auth-card stack gap-8">
          <h2 class="h3">{L(lang, { ko: '콘텐츠 관리 안내', fr: 'Gestion du contenu' })}</h2>
          <p class="small muted">{L(lang, {
            ko: '공지·입학안내 등 공개 홈페이지 편집은 기존 CMS에서 계속합니다. 학습자료·갤러리·협회사무실의 파일 관리자 화면은 이후 연결합니다.',
            fr: 'Les pages publiques restent gérées dans le CMS existant. La gestion des fichiers privés sera ajoutée séparément.'
          })}</p>
          <a class="btn btn-ghost" href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer">{L(lang,{ko:'홈페이지 CMS 열기',fr:'Ouvrir le CMS du site'})}</a>
          <p class="small muted">{L(lang, {
            ko: '주의: 화면을 숨기는 것만으로 자료가 보호되지 않습니다. Firestore·Storage 서버 보안 규칙이 반드시 적용되어야 합니다.',
            fr: 'Attention : masquer une page ne protège pas les données. Les règles de sécurité serveur restent indispensables.'
          })}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 관리자 전용 페이지는 기본 .wrap(1200px) 및 .auth-card(520px) 제한을 해제합니다.
     일반 로그인/프로필 페이지는 이 변경의 영향을 받지 않습니다. */
  .asicc-admin-page { box-sizing:border-box; width:100%; max-width:none; margin:0 auto; padding-inline:clamp(16px,2.2vw,48px); }
  .asicc-admin-page #asicc-admin, .asicc-admin-page #admin-content { box-sizing:border-box; width:100%; min-width:0; }
  .asicc-admin-page #admin-content > .card.auth-card,
  .asicc-admin-page #admin-content > section.card.auth-card { max-width:none; width:100%; margin:0; box-sizing:border-box; padding:clamp(16px,1.8vw,28px); }
  .asicc-admin-empty { margin:0; padding:13px 17px; color:#345c4a; background:#eff7f1; border:1px solid #d5e8db; border-radius:9px; }
  :global(.asicc-admin-record) { border: 1px solid #dce0e7; border-radius: 12px; padding:16px; }
  :global(.asicc-admin-fields) { display:grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,175px),1fr)); gap:12px; align-items:end; }
  :global(.asicc-admin-actions) { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:10px; }
  :global(.asicc-admin-muted) { font-size:.88rem; color:var(--muted,#64748b); overflow-wrap:anywhere; }
  .asicc-admin-notification { border:1px solid #c09b56; border-radius:14px; padding:20px; background:rgba(250,238,216,.35); }
  .asicc-admin-notification[hidden] { display:none; }
  .asicc-admin-toolbar { display:grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,170px),1fr)); gap:12px; align-items:end; }
  .asicc-admin-toolbar input,.asicc-admin-toolbar select { width:100%; min-width:0; }
  .asicc-admin-table-wrap { max-width:100%; width:100%; overflow:auto; border:1px solid #dce0e7; border-radius:10px; }
  :global(.asicc-admin-table) { border-collapse:collapse; width:100%; min-width:1360px; font-size:.82rem; background:#fff; }
  :global(.asicc-admin-table) th,:global(.asicc-admin-table) td { padding:9px 8px; border-bottom:1px solid #e4e7ec; border-right:1px solid #f1f2f5; text-align:left; vertical-align:middle; white-space:nowrap; }
  :global(.asicc-admin-table) thead th { position:sticky; top:0; z-index:1; background:#f5f7fa; font-size:.78rem; font-weight:700; }
  :global(.asicc-admin-table) tbody tr:nth-child(even) { background:#fafbfc; }
  :global(.asicc-admin-table) tbody tr:hover { background:#eff6f3; }
  :global(.asicc-admin-table) th:first-child,:global(.asicc-admin-table) td:first-child { position:sticky; left:0; z-index:1; background:inherit; text-align:right; min-width:46px; }
  :global(.asicc-admin-table) thead th:first-child { z-index:2; background:#f5f7fa; }
  :global(.asicc-admin-table) select { width:130px; max-width:100%; padding:6px; font-size:.8rem; }
  :global(.asicc-admin-table) :global(.admin-row-action) { min-width:64px; padding:7px 10px; }
  :global(.asicc-admin-table) :global(.admin-row-action)[disabled] { opacity:.5; }
  :global(.asicc-admin-table) :global(.admin-small) { font-size:.75rem; color:#667085; }
  :global(.asicc-admin-table) :global(.admin-name) { font-weight:700; }
  :global(.asicc-admin-table) :global(.admin-students) { max-width:270px; overflow:hidden; text-overflow:ellipsis; }
  @media(max-width:720px) { .asicc-admin-notification { padding:14px; } .asicc-admin-toolbar { grid-template-columns:repeat(2,minmax(0,1fr)); } .asicc-admin-toolbar label:first-child { grid-column:1/-1; } }
</style>

<script>
  import { getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, getIdToken } from 'firebase/auth';
  import {
    getFirestore, doc, getDoc, getDocs, query, collection, where,
    limit, updateDoc, runTransaction, serverTimestamp, writeBatch, setDoc, type Timestamp,
    type DocumentData
  } from 'firebase/firestore';
  import { firebaseConfig } from '../../../firebase-config';

  type Member = { id: string; name: string; nickname?:string; email: string; phone?: string;
    levels?: string[]; role: string; status: string; createdAt?: Timestamp | number | string | null }; 
  type Withdrawal = { uid: string; name: string; email: string; status: string; requestedAt?: Timestamp | number | null };
  type Upgrade = { uid: string; applicantName: string; applicantEmail: string;
    requestedRole: 'member' | 'special'; kind: string; schoolYear?: number | null;
    note?: string; relation?:string; children?:Array<{studentName:string;school:string;grade:string}>; status: string; };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const root = el<HTMLElement>('asicc-admin');
  const fr = root?.dataset.lang === 'fr';
  const tr = (ko: string, french: string) => fr ? french : ko;
  const app = getApps().find(a => a.name === 'asicc-website')
    ?? initializeApp(firebaseConfig, 'asicc-website');
  const auth = getAuth(app);
  const db = getFirestore(app);
  let meUid = '';
  let members: Member[] = [];
  const upgradeHistory=new Map<string,Upgrade>();
  const withdrawals = new Map<string,Withdrawal>();
  let page = 1;
  const pageSize = 25;
  let sortColumn: 'createdAt' | 'name' | 'email' = 'createdAt';
  let sortAsc = false;
  let busy = false;

  const text = (id: string, value: string) => { const node = el<HTMLElement>(id); if (node) node.textContent = value; };
  const showMessage = (message: string, error = false) => {
    const node = el<HTMLElement>('admin-action-message'); if (!node) return;
    node.hidden = false; node.textContent = message;
    node.style.color = error ? '#b42318' : '#067647';
  };
  const deny = (message: string) => {
    const loading = el<HTMLElement>('admin-loading'); if (loading) loading.hidden = true;
    const denied = el<HTMLElement>('admin-denied'); if (denied) denied.hidden = false;
    text('admin-denied-message', message);
    const content = el<HTMLElement>('admin-content'); if (content) content.hidden = true;
  };
  const panel = (className: string, content: string) => {
    const node = document.createElement('div'); node.className = className;
    node.textContent = content; return node;
  };
  const actionButton = (label: string, handler: () => void): HTMLButtonElement => {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'btn btn-ghost';
    b.textContent = label; b.addEventListener('click', handler); return b;
  };
  const roleLabel = (role: string) => ({
    general: tr('일반회원', 'Membre général'),
    member: tr('협회회원', 'Membre de l’association'),
    special: tr('특별회원', 'Membre spécial'),
    admin: tr('운영진', 'Administrateur')
  } as Record<string,string>)[role] || role;
  const kindLabel = (kind: string) => ({
    parent: tr('학부모','Parent'), alumnus: tr('졸업생','Ancien élève'),
    'alumni-parent': tr('졸업생 학부모','Parent d’ancien élève'),
    teacher:tr('교사·기여자','Enseignant'),contributor:tr('특별기여자','Contributeur')
  } as Record<string,string>)[kind] || kind;
  const roleOptions = ['general','member','special','admin'];

  async function loadRequests() {
    const container = el<HTMLElement>('admin-requests'); if (!container) return;
    container.replaceChildren(panel('small muted', tr('불러오는 중…','Chargement…')));
    const snaps = await getDocs(query(collection(db,'upgradeRequests'), where('status','==','pending')));
    const requests = snaps.docs.map(s => s.data() as Upgrade);
    requests.forEach(req=>upgradeHistory.set(req.uid,req));
    text('admin-pending-count', String(requests.length));
    container.replaceChildren();
    if (!requests.length) {
      container.append(panel('small muted',tr('대기 중인 신청이 없습니다.','Aucune demande en attente.')));
      return;
    }
    for (const item of requests) {
      const card = document.createElement('article'); card.className = 'asicc-admin-record stack gap-8';
      const name = panel('',item.applicantName || tr('이름 없음','Sans nom'));
      name.style.fontWeight = '700'; card.append(name);
      card.append(panel('asicc-admin-muted', item.applicantEmail || ''));
      card.append(panel('small', tr('신청 등급: ','Statut demandé : ') + roleLabel(item.requestedRole)
        + ' · ' + kindLabel(item.kind) + (item.schoolYear ? ` · ${item.schoolYear}` : '')));
      if(item.relation)card.append(panel('small',tr('관계: ','Lien : ')+item.relation));
      if(item.children?.length)item.children.forEach(child=>card.append(panel('small',`${child.studentName||''} · ${child.school||''} · ${child.grade||''}`)));
      if (item.note) card.append(panel('asicc-admin-muted',item.note));
      const buttons = document.createElement('div'); buttons.className = 'asicc-admin-actions';
      buttons.append(
        actionButton(tr('승인','Approuver'),()=>void review(item,true)),
        actionButton(tr('거절','Refuser'),()=>void review(item,false))
      );
      card.append(buttons); container.append(card);
    }
  }

  async function review(item: Upgrade, approve: boolean) {
    if (busy) return;
    if (!['member','special'].includes(item.requestedRole)) return;
    const question = approve
      ? tr(`${item.applicantName}님의 ${roleLabel(item.requestedRole)} 승급을 승인할까요?`,
           `Approuver le statut ${roleLabel(item.requestedRole)} pour ${item.applicantName} ?`)
      : tr(`${item.applicantName}님의 신청을 거절할까요?`, `Refuser la demande de ${item.applicantName} ?`);
    if (!window.confirm(question)) return;
    busy = true;
    try {
      const requestRef = doc(db,'upgradeRequests',item.uid);
      const memberRef = doc(db,'members',item.uid);
      await runTransaction(db, async tx => {
        const requestSnap = await tx.get(requestRef);
        if (!requestSnap.exists() || requestSnap.data().status !== 'pending') throw Error('request-changed');
        const freshRole = requestSnap.data().requestedRole;
        if (!['member','special'].includes(freshRole)) throw Error('role-invalid');
        if (approve) {
          const memberSnap = await tx.get(memberRef);
          if (!memberSnap.exists() || memberSnap.data().role !== 'general'
              || memberSnap.data().status !== 'approved') throw Error('profile-changed');
          tx.update(memberRef, { role: freshRole });
        }
        tx.update(requestRef, {
          status: approve ? 'approved' : 'rejected',
          reviewedBy: meUid, reviewedAt: serverTimestamp()
        });
      });
      showMessage(approve ? tr('승급을 승인했습니다.','Demande approuvée.')
        : tr('신청을 거절했습니다.','Demande refusée.'));
      await Promise.all([loadRequests(),loadMembers(true),loadHistory(),loadWithdrawals(),loadNameRequests(),loadSuggestions(),loadDeletionLogs(),loadHiddenArchives()]);
      await loadNotifications();
    } catch (error) {
      console.error('ASICC admin review:',error);
      showMessage(tr('처리하지 못했습니다. 신청 상태와 Firebase 규칙을 확인해 주세요.',
        'Opération impossible. Vérifiez la demande et les règles Firebase.'), true);
    } finally { busy = false; }
  }

  const timestamp = (value: any): number => {
    if(value && typeof value.toMillis === 'function') return value.toMillis();
    if(typeof value === 'number') return value;
    if(typeof value === 'string') { const n=Date.parse(value); return Number.isFinite(n)?n:0; }
    return 0;
  };
  const stamp = (value: any): string => {
    const ms=timestamp(value);if(!ms)return '—';
    return new Intl.DateTimeFormat(fr?'fr-FR':'ko-KR',{
      timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit',
      hour:'2-digit',minute:'2-digit',hour12:false
    }).format(new Date(ms));
  };
  const gradeLabel = (m:Member):string => {
    const r=upgradeHistory.get(m.id);
    return (r?.children||[]).map(c=>[c.studentName,c.school,c.grade].filter(Boolean).join(' / ')).join(' · ') || '—';
  };
  const schoolLabel = (m: Member):string => {
    const r=upgradeHistory.get(m.id);
    const schoolNames = (r?.children||[]).map(c=>c.school).filter(Boolean);
    if(schoolNames.length)return [...new Set(schoolNames)].join(', ');
    return (m.levels||[]).map(l=>({mat:tr('유치원','Maternelle'),elem:tr('초등학교','Élémentaire'),col:tr('중학교','Collège')} as Record<string,string>)[l]||l).join(', ') || '—';
  };
  const memberSchoolMatches=(m:Member,level:string)=>{
    if(level==='all')return true;
    const r=upgradeHistory.get(m.id);
    const values=(r?.children||[]).map(c=>`${c.school} ${c.grade}`.toLowerCase());
    if((m.levels||[]).includes(level))return true;
    // School/grade fields come from voluntarily submitted promotion requests.
    if(level==='mat')return values.some(v=>/maternelle|^ps |^ms |^gs |école maternelle/.test(v));
    if(level==='elem')return values.some(v=>/élémentaire|elementaire|\bcp\b|\bce1\b|\bce2\b|\bcm1\b|\bcm2\b/.test(v));
    return values.some(v=>/collège|college|\b6e\b|\b5e\b|\b4e\b|\b3e\b/.test(v));
  };
  function filteredMembers():Member[] {
    const term=el<HTMLInputElement>('admin-member-search')?.value.trim().toLocaleLowerCase()||'';
    const role=el<HTMLSelectElement>('admin-filter-role')?.value||'all';
    const status=el<HTMLSelectElement>('admin-filter-status')?.value||'all';
    const school=el<HTMLSelectElement>('admin-filter-school')?.value||'all';
    const from=el<HTMLInputElement>('admin-filter-from')?.value||'';
    const to=el<HTMLInputElement>('admin-filter-to')?.value||'';
    const fromMs=from?Date.parse(from+'T00:00:00+01:00'):0;
    const toMs=to?Date.parse(to+'T23:59:59+01:00'):Infinity;
    const result=members.filter(m=>{
      if(role!=='all'&&m.role!==role)return false;
      if(status==='withdrawal') { if(withdrawals.get(m.id)?.status!=='pending')return false; }
      else if(status!=='all'&&m.status!==status)return false;
      if(!memberSchoolMatches(m,school))return false;
      const t=timestamp(m.createdAt);if(from&&(!t||t<fromMs))return false;
      if(to&&(!t||t>toMs))return false;
      const req=upgradeHistory.get(m.id);
      const hay=[m.name,m.nickname,m.email,m.phone,schoolLabel(m),gradeLabel(m),req?.kind,req?.relation]
        .filter(Boolean).join(' ').toLocaleLowerCase();
      return !term||hay.includes(term);
    });
    result.sort((a,b)=>{
      const v=sortColumn==='createdAt' ? timestamp(a.createdAt)-timestamp(b.createdAt)
        : String(a[sortColumn]||'').localeCompare(String(b[sortColumn]||''),fr?'fr':'ko');
      return sortAsc?v:-v;
    });
    return result;
  }
  function td(row:HTMLTableRowElement,value:string,cls='') {
    const cell=document.createElement('td');cell.textContent=value;if(cls)cell.className=cls;row.append(cell);return cell;
  }
  function renderMembers(){
    const container=el<HTMLElement>('admin-members');if(!container)return;
    const filtered=filteredMembers(),pages=Math.max(1,Math.ceil(filtered.length/pageSize));
    page=Math.min(page,pages);
    const current=filtered.slice((page-1)*pageSize,page*pageSize);
    const counts=el<HTMLElement>('admin-filter-count');if(counts)counts.textContent=tr(
      `전체 ${members.length}명 중 ${filtered.length}명 검색됨 (한 페이지 ${pageSize}명)`,
      `${filtered.length} sur ${members.length} membres (page de ${pageSize})`);
    const pageLabel=el<HTMLElement>('admin-page-label');if(pageLabel)pageLabel.textContent=`${page} / ${pages}`;
    const prev=el<HTMLButtonElement>('admin-prev'),next=el<HTMLButtonElement>('admin-next');
    if(prev)prev.disabled=page<=1;if(next)next.disabled=page>=pages;
    container.replaceChildren();
    if(!filtered.length){container.append(panel('small muted',tr('조건에 맞는 회원이 없습니다.','Aucun membre ne correspond aux critères.')));return;}
    const table=document.createElement('table');table.className='asicc-admin-table';
    const thead=document.createElement('thead'),head=document.createElement('tr');
    const headings:[string,string | null][]=[
      ['#',null],[tr('실명','Nom'),'name'],[tr('아이디(이메일)','Identifiant (e-mail)'),'email'],
      [tr('닉네임','Pseudo'),null],[tr('연락처','Téléphone'),null],
      [tr('가입 일시 (파리)','Inscrit le (Paris)'),'createdAt'],[tr('학교급 / 학교','Niveau / école'),null],
      [tr('학생 / 학년','Élève / classe'),null],[tr('가입 구분','Catégorie'),null],
      [tr('회원 등급','Statut'),null],[tr('계정 상태','État'),null],[tr('저장','Enregistrer'),null]
    ];
    headings.forEach(([label,key])=>{
      const th=document.createElement('th');th.scope='col';
      if(key){const button=document.createElement('button');button.type='button';button.className='admin-head-sort';
        button.style.cssText='border:0;background:transparent;color:inherit;font:inherit;cursor:pointer;text-align:left';
        button.textContent=label+(sortColumn===key?(sortAsc?' ▲':' ▼'):' ↕');
        button.title=tr('정렬','Trier');button.addEventListener('click',()=>{
          if(sortColumn===key)sortAsc=!sortAsc;else {sortColumn=key as typeof sortColumn;sortAsc=key==='name'||key==='email';}
          page=1;renderMembers();
        });th.append(button);
      }else th.textContent=label;
      head.append(th);
    });thead.append(head);table.append(thead);
    const tbody=document.createElement('tbody');
    for(let i=0;i<current.length;i++){
      const m=current[i],row=document.createElement('tr');row.dataset.uid=m.id;
      td(row,String((page-1)*pageSize+i+1));
      td(row,m.name||'—','admin-name');td(row,m.email||'—');td(row,m.nickname||'—');td(row,m.phone||'—');
      td(row,stamp(m.createdAt),'admin-small');td(row,schoolLabel(m));
      const students=td(row,gradeLabel(m),'admin-students');students.title=gradeLabel(m);
      const enrollment=upgradeHistory.get(m.id);
      td(row,enrollment ? kindLabel(enrollment.kind):'—');
      const roleCell=document.createElement('td'),roleSelect=document.createElement('select');
      roleSelect.setAttribute('aria-label',tr(`${m.name} 회원 등급`,`Statut de ${m.name}`));
      for(const r of roleOptions){const opt=document.createElement('option');opt.value=r;opt.textContent=roleLabel(r);roleSelect.append(opt);}
      roleSelect.value=m.role;roleSelect.disabled=m.id===meUid;roleCell.append(roleSelect);row.append(roleCell);
      const statusCell=document.createElement('td'),statusSelect=document.createElement('select');
      statusSelect.setAttribute('aria-label',tr(`${m.name} 계정 상태`,`État du compte de ${m.name}`));
      [['approved',tr('활성','Actif')],['suspended',tr('정지','Suspendu')]].forEach(([key,label])=>{
        const opt=document.createElement('option');opt.value=key;opt.textContent=label;statusSelect.append(opt);
      });
      statusSelect.value=m.status;statusSelect.disabled=m.id===meUid;statusCell.append(statusSelect);
      if(withdrawals.get(m.id)?.status==='pending'){
        const note=panel('admin-small',tr('탈퇴 신청 접수','Départ demandé'));
        note.style.color='#b42318';statusCell.append(note);
      }
      row.append(statusCell);
      const actionCell=document.createElement('td'),save=actionButton(tr('저장','Enregistrer'),()=>void saveMember(m,roleSelect,statusSelect));
      save.className='btn btn-ghost btn-sm admin-row-action';save.disabled=m.id===meUid;
      actionCell.append(save);row.append(actionCell);tbody.append(row);
    }
    table.append(tbody);container.append(table);
  }

  async function saveMember(member: Member, roleSelect:HTMLSelectElement,statusSelect:HTMLSelectElement){
    if(busy||member.id===meUid)return;
    const role=roleSelect.value,status=statusSelect.value;
    if(!roleOptions.includes(role)||!['approved','suspended'].includes(status))return;
    if(role===member.role&&status===member.status){showMessage(tr('변경된 내용이 없습니다.','Aucune modification.'));return;}
    const question=role==='admin'&&member.role!=='admin'
      ? tr(`주의: ${member.name}님에게 관리자 권한을 부여합니다. 계속할까요?`,
           `Attention : donner tous les droits administrateur à ${member.name} ?`)
      : tr(`${member.name}님의 회원 등급과 계정 상태를 저장할까요?`,
           `Enregistrer le statut et l’état du compte de ${member.name} ?`);
    if(!confirm(question)){roleSelect.value=member.role;statusSelect.value=member.status;return;}
    busy=true;roleSelect.disabled=true;statusSelect.disabled=true;
    try{
      await updateDoc(doc(db,'members',member.id),{role,status});
      showMessage(tr('회원 변경사항을 저장했습니다.','Modifications enregistrées.'));
      await loadMembers(true);
    }catch(error){
      console.error('ASICC member update:',error);
      showMessage(tr('회원 정보를 저장하지 못했습니다. Firebase 규칙을 확인하세요.',
        'Échec de l’enregistrement. Vérifiez les règles Firebase.'),true);
      roleSelect.value=member.role;statusSelect.value=member.status;
    }finally{busy=false;roleSelect.disabled=member.id===meUid;statusSelect.disabled=member.id===meUid;}
  }

  async function loadMembers(_reset=false){
    // Load all members before client-side filters; otherwise matching records on later pages are invisible.
    const snap=await getDocs(collection(db,'members'));
    members=snap.docs.map(s=>({id:s.id,...s.data()} as Member));
    text('admin-member-count',String(members.length));
    renderMembers();
  }
  async function loadHistory(){
    const snap=await getDocs(collection(db,'upgradeRequests'));
    upgradeHistory.clear();snap.docs.forEach(d=>upgradeHistory.set(d.id,d.data() as Upgrade));
    renderMembers();
  }
  async function loadWithdrawals(){
    try{
      const snap=await getDocs(collection(db,'memberWithdrawalRequests'));
      withdrawals.clear();snap.docs.forEach(d=>withdrawals.set(d.id,{uid:d.id,...d.data()} as Withdrawal));
      renderMembers();
    }catch(error){
      // A missing Firestore rule must not lock administrators out of the existing member list.
      console.error('ASICC withdrawals unavailable until rules update',error);
      withdrawals.clear();renderMembers();
      showMessage(tr('탈퇴 요청 목록은 보안 규칙을 반영한 뒤 사용할 수 있습니다.',
        'La liste des départs sera disponible après mise à jour des règles.'),true);
    }
  }
  async function loadNotifications(){
    const notice=el<HTMLElement>('admin-notification');if(!notice||!meUid)return;
    const empty=el<HTMLElement>('admin-notification-empty');
    if(empty)empty.hidden=true;
    try{
      const ack=await getDoc(doc(db,'adminNotificationAcks',meUid));
      // At first admin visit only the last 7 days are considered new, to avoid an old backlog.
      const since=ack.exists()?timestamp(ack.data().acknowledgedAt):(Date.now()-7*24*60*60*1000);
      const arrivals=members.filter(m=>timestamp(m.createdAt)>since);
      const exits=[...withdrawals.values()].filter(r=>r.status==='pending'&&timestamp(r.requestedAt)>since);
      if(!arrivals.length&&!exits.length){
        notice.hidden=true;
        if(empty)empty.hidden=false;
        return;
      }
      text('admin-notification-count',String(arrivals.length+exits.length));
      text('admin-notification-summary',tr(
        `새 가입 ${arrivals.length}명 · 탈퇴 요청 ${exits.length}건`,
        `${arrivals.length} nouvelle(s) inscription(s) · ${exits.length} demande(s) de départ`));
      const details=el<HTMLElement>('admin-notification-details');if(details){
        details.replaceChildren();
        const showPeople=(label:string,entries:string[])=>{
          if(!entries.length)return;
          details.append(panel('small',`${label}: ${entries.slice(0,8).join(', ')}${entries.length>8?tr(' 외',' et autres'):''}`));
        };
        showPeople(tr('가입','Inscriptions'),arrivals.map(m=>m.name||m.email||'—'));
        showPeople(tr('탈퇴 요청','Demandes de départ'),exits.map(r=>r.name||r.email||'—'));
      }
      const checkbox=el<HTMLInputElement>('admin-notification-confirm');if(checkbox)checkbox.checked=false;
      const button=el<HTMLButtonElement>('admin-notification-ack');if(button)button.disabled=true;
      text('admin-notification-error','');notice.hidden=false;
    }catch(error){
      console.error('ASICC notification read',error);
      notice.hidden=true;
      if(empty)empty.hidden=true;
      showMessage(tr('회원 알림을 조회할 수 없습니다. 새 알림이 없는 상태와는 다릅니다. Firebase 알림 규칙을 확인해 주세요.',
        'Impossible de consulter les alertes : cela ne signifie pas qu’il n’y en a aucune. Vérifiez les règles Firebase.'),true);
    }
  }
  async function acknowledgeNotifications(){
    if(!meUid||!el<HTMLInputElement>('admin-notification-confirm')?.checked)return;
    const button=el<HTMLButtonElement>('admin-notification-ack');if(button)button.disabled=true;
    try{
      // Server-side acknowledgement is keyed to the administrator, not the browser.
      await setDoc(doc(db,'adminNotificationAcks',meUid),{acknowledgedAt:serverTimestamp()});
      const notice=el<HTMLElement>('admin-notification');if(notice)notice.hidden=true;
      const empty=el<HTMLElement>('admin-notification-empty');if(empty)empty.hidden=false;
    }catch(error){
      console.error('ASICC notification acknowledgement',error);
      text('admin-notification-error',tr('확인 상태를 저장하지 못했습니다. Firebase 규칙을 확인해 주세요.',
        'Enregistrement impossible. Vérifiez les règles Firebase.'));
      if(button)button.disabled=false;
    }
  }
  function exportMembers(){
    const headings=['No','Name','Nickname','Email','Phone','Joined (Paris)','School','Students / Grades','Member category','Role','Status','Withdrawal request'];
    const cells=filteredMembers().map((m,i)=>[
      String(i+1),m.name||'',m.nickname||'',m.email||'',m.phone||'',stamp(m.createdAt),
      schoolLabel(m),gradeLabel(m),upgradeHistory.get(m.id)?.kind||'',roleLabel(m.role),
      m.status,withdrawals.get(m.id)?.status==='pending'?'pending':''
    ]);
    // Escape spreadsheet formulas from user-controlled text.
    const q=(v:string)=>'"'+String(v||'').replace(/^[\s]*[=+\-@]/,(s)=>"'"+s).replace(/"/g,'""')+'"';
    const csv='\ufeff'+[headings,...cells].map(row=>row.map(q).join(',')).join('\r\n');
    const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));
    const link=document.createElement('a');link.href=url;link.download='asicc-members-'+new Date().toISOString().slice(0,10)+'.csv';
    link.click();URL.revokeObjectURL(url);
  }
  async function loadNameRequests(){
    const target=el<HTMLElement>('admin-name-requests');if(!target)return;
    const snap=await getDocs(query(collection(db,'nameChangeRequests'),where('status','==','pending')));
    target.replaceChildren();
    if(snap.empty){target.textContent=tr('대기 중인 신청이 없습니다.','Aucune demande en attente.');return;}
    snap.docs.forEach(d=>{
      const r=d.data();const box=document.createElement('article');box.className='asicc-admin-record stack gap-8';
      box.append(panel('small',`${r.currentName||''} → ${r.requestedName||''}`));
      box.append(actionButton(tr('실명 변경 승인','Approuver'),()=>void reviewName(d.id,true)));
      box.append(actionButton(tr('거절','Refuser'),()=>void reviewName(d.id,false)));
      target.append(box);
    });
  }
  async function reviewName(uid:string,approve:boolean){
    if(busy||!confirm(approve?tr('실명 변경을 승인할까요?','Approuver la correction ?'):tr('신청을 거절할까요?','Refuser ?')))return;
    busy=true;
    try{
      const reqRef=doc(db,'nameChangeRequests',uid),memRef=doc(db,'members',uid);
      await runTransaction(db,async tx=>{
        const req=await tx.get(reqRef);if(!req.exists()||req.data().status!=='pending')throw Error('already handled');
        if(approve){const member=await tx.get(memRef);if(!member.exists())throw Error('member missing');tx.update(memRef,{name:req.data().requestedName});}
        tx.update(reqRef,{status:approve?'approved':'rejected',reviewedBy:meUid,reviewedAt:serverTimestamp()});
      });
      showMessage(approve?tr('실명을 변경했습니다.','Nom corrigé.'):tr('신청을 거절했습니다.','Demande refusée.'));
      await Promise.all([loadNameRequests(),loadMembers(true)]);
    }catch(e){console.error(e);showMessage(tr('실명 변경을 처리하지 못했습니다.','Impossible de traiter la demande.'),true);}
    finally{busy=false;}
  }
  async function loadSuggestions(){
    const target=el<HTMLElement>('admin-suggestions');if(!target)return;
    const snap=await getDocs(query(collection(db,'suggestions'),limit(100)));
    target.replaceChildren();
    if(snap.empty){target.textContent=tr('접수된 건의가 없습니다.','Aucune suggestion.');return;}
    snap.docs.forEach(d=>{
      const r=d.data();const box=document.createElement('article');box.className='asicc-admin-record stack gap-8';
      box.append(panel('',String(r.subject||'')));box.append(panel('small muted',`${r.category||''} · ${r.status||''}`));
      box.append(panel('',String(r.body||'')));
      if(r.response)box.append(panel('small',tr('답변: ','Réponse : ')+String(r.response)));
      box.append(actionButton(tr('답변·상태 변경','Répondre / changer de statut'),()=>void replySuggestion(d.id,String(r.response||''))));
      target.append(box);
    });
  }
  async function replySuggestion(id:string,previous:string){
    if(busy)return;
    const response=prompt(tr('운영진 답변 (최대 3000자)','Réponse (3000 caractères maximum)'),previous);
    if(response===null)return;if(response.length>3000){showMessage(tr('답변이 너무 깁니다.','Réponse trop longue.'),true);return;}
    busy=true;
    try{
      await updateDoc(doc(db,'suggestions',id),{response,status:'answered',respondedBy:meUid,respondedAt:serverTimestamp()});
      showMessage(tr('답변이 저장되었습니다.','Réponse enregistrée.'));await loadSuggestions();
    }catch(e){console.error(e);showMessage(tr('답변을 저장하지 못했습니다.','Impossible d’enregistrer la réponse.'),true);}
    finally{busy=false;}
  }
  async function loadHiddenArchives(){
    const target=el<HTMLElement>('admin-hidden-list');if(!target)return;
    const [posts,comments]=await Promise.all([
      getDocs(query(collection(db,'hiddenPosts'),limit(100))),
      getDocs(query(collection(db,'hiddenComments'),limit(100)))
    ]);
    target.replaceChildren();
    if(posts.empty&&comments.empty){target.textContent=tr('숨겨진 자료가 없습니다.','Aucun contenu masqué.');return;}
    posts.docs.forEach(d=>{
      const v=d.data(),box=document.createElement('article');box.className='asicc-admin-record stack gap-8';
      box.append(panel('',tr('숨김 게시글: ','Message masqué : ')+String(v.title||'')));
      const detail=document.createElement('details');const summary=document.createElement('summary');summary.textContent=tr('원문 보기','Voir le texte');
      const body=panel('',String(v.body||''));body.style.whiteSpace='pre-wrap';detail.append(summary,body);box.append(detail);
      box.append(actionButton(tr('숨김 해제·원문 복구','Restaurer le message'),()=>void restorePost(d.id,String(v.title),String(v.body))));
      target.append(box);
    });
    comments.docs.forEach(d=>{
      const v=d.data(),box=document.createElement('article');box.className='asicc-admin-record stack gap-8';
      box.append(panel('',tr('숨김 댓글','Commentaire masqué')));
      const detail=document.createElement('details'),summary=document.createElement('summary');summary.textContent=tr('원문 보기','Voir le texte');
      detail.append(summary,panel('',String(v.body||'')));box.append(detail);
      box.append(actionButton(tr('숨김 해제·원문 복구','Restaurer le commentaire'),()=>void restoreComment(d.id,String(v.postId),String(v.commentId),String(v.body))));
      target.append(box);
    });
  }
  async function restorePost(postId:string,title:string,body:string){
    if(busy||!confirm(tr('게시글을 다시 공개할까요?','Rendre ce message visible ?')))return;
    busy=true;
    try{
      const batch=writeBatch(db);
      batch.update(doc(db,'boardPosts',postId),{title,body,deleted:false,updatedAt:serverTimestamp()});
      batch.delete(doc(db,'hiddenPosts',postId));await batch.commit();
      showMessage(tr('게시글을 복구했습니다.','Message restauré.'));await loadHiddenArchives();
    }catch(e){console.error(e);showMessage(tr('복구하지 못했습니다.','Échec de la restauration.'),true);}
    finally{busy=false;}
  }
  async function restoreComment(archiveId:string,postId:string,commentId:string,body:string){
    if(busy||!confirm(tr('댓글을 다시 공개할까요?','Rendre ce commentaire visible ?')))return;
    busy=true;
    try{
      const batch=writeBatch(db);
      batch.update(doc(db,'boardPosts',postId,'comments',commentId),{body,deleted:false,updatedAt:serverTimestamp()});
      batch.delete(doc(db,'hiddenComments',archiveId));await batch.commit();
      showMessage(tr('댓글을 복구했습니다.','Commentaire restauré.'));await loadHiddenArchives();
    }catch(e){console.error(e);showMessage(tr('복구하지 못했습니다.','Échec de la restauration.'),true);}
    finally{busy=false;}
  }
  async function redactHistoricalNames(){
    if(busy||!confirm(tr('게시글·댓글에 남은 기존 실명 표시를 제거할까요? 본문은 수정하지 않습니다.','Anonymiser les anciennes signatures sans modifier les textes ?')))return;
    busy=true;
    try{
      let count=0;
      const posts=await getDocs(query(collection(db,'boardPosts'),limit(100)));
      for(const post of posts.docs){
        if(post.data().authorName!=='기존회원'){
          await updateDoc(post.ref,{authorName:'기존회원',updatedAt:serverTimestamp()});count++;
        }
        const comments=await getDocs(query(collection(db,'boardPosts',post.id,'comments'),limit(100)));
        for(const c of comments.docs){
          if(c.data().authorName!=='기존회원'){
            await updateDoc(c.ref,{authorName:'기존회원',updatedAt:serverTimestamp()});count++;
          }
        }
      }
      showMessage(tr(`${count}건의 작성자 표시를 비공개 처리했습니다. 100개 이상의 글이 있으면 추가 점검이 필요합니다.`,
        `${count} signatures anonymisées. Une vérification supplémentaire est nécessaire au-delà de 100 messages.`));
    }catch(e){console.error(e);showMessage(tr('일부 처리에 실패했습니다. 목록을 확인해 주세요.','Anonymisation partiellement impossible.'),true);}
    finally{busy=false;}
  }
  async function loadDeletionLogs(){
    const target=el<HTMLElement>('admin-deletion-logs');if(!target)return;
    const snap=await getDocs(query(collection(db,'boardDeletionLogs'),limit(100)));
    target.replaceChildren();if(snap.empty){target.textContent=tr('삭제 기록이 없습니다.','Aucune suppression.');return;}
    snap.docs.forEach(d=>{
      const r=d.data();target.append(panel('small',`${r.targetType||''} · ${r.reason||''} · ${r.actorUid||''} · ${r.deletedAt?.toDate?.().toLocaleDateString(fr?'fr-FR':'ko-KR')||''}`));
    });
  }
  if (import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === "true") onAuthStateChanged(auth, async user => {
    if(!user) {window.location.replace(root?.dataset.loginUrl || '/');return;}
    try {
      await user.reload(); await getIdToken(user,true);
      if(!user.emailVerified) {deny(tr('이메일 인증 후 로그인해 주세요.','Vérifiez votre e-mail avant de vous connecter.'));return;}
      const me=await getDoc(doc(db,'members',user.uid));
      if(!me.exists() || me.data().status!=='approved' || me.data().role!=='admin') {
        deny(tr('운영진만 접근할 수 있는 공간입니다.','Cet espace est réservé aux administrateurs.'));return;
      }
      meUid=user.uid;
      text('admin-who',me.data().name || user.email || 'Admin');
      const loading=el<HTMLElement>('admin-loading');if(loading)loading.hidden=true;
      const content=el<HTMLElement>('admin-content');if(content)content.hidden=false;
      await Promise.all([loadRequests(),loadMembers(true),loadHistory(),loadWithdrawals(),loadNameRequests(),loadSuggestions(),loadDeletionLogs(),loadHiddenArchives()]);
      await loadNotifications();
    } catch(error) {
      console.error('ASICC admin access:',error);
      deny(tr('관리자 화면을 불러올 수 없습니다. Firebase 규칙을 확인해 주세요.',
        'Impossible de charger l’administration. Vérifiez les règles Firebase.'));
    }
  });

  el<HTMLButtonElement>('admin-redact-legacy')?.addEventListener('click',()=>void redactHistoricalNames());
  el<HTMLButtonElement>('admin-refresh')?.addEventListener('click',()=>{
    if(busy)return;
    void Promise.all([loadRequests(),loadMembers(true),loadHistory(),loadWithdrawals(),loadNameRequests(),loadSuggestions(),loadDeletionLogs(),loadHiddenArchives()]).then(()=>loadNotifications()).catch(error=>{
      console.error('ASICC refresh:',error);
      showMessage(tr('새로고침 중 오류가 발생했습니다.','Erreur pendant l’actualisation.'),true);
    });
  });
  const resetPage=()=>{page=1;renderMembers();};
  el<HTMLInputElement>('admin-member-search')?.addEventListener('input',resetPage);
  ['admin-filter-role','admin-filter-status','admin-filter-school','admin-filter-from','admin-filter-to']
    .forEach(id=>el<HTMLInputElement|HTMLSelectElement>(id)?.addEventListener('change',resetPage));
  el<HTMLButtonElement>('admin-filter-reset')?.addEventListener('click',()=>{
    ['admin-member-search','admin-filter-from','admin-filter-to'].forEach(id=>{const e=el<HTMLInputElement>(id);if(e)e.value='';});
    ['admin-filter-role','admin-filter-status','admin-filter-school'].forEach(id=>{const e=el<HTMLSelectElement>(id);if(e)e.value='all';});
    resetPage();
  });
  el<HTMLButtonElement>('admin-prev')?.addEventListener('click',()=>{if(page>1){page--;renderMembers();}});
  el<HTMLButtonElement>('admin-next')?.addEventListener('click',()=>{page++;renderMembers();});
  el<HTMLButtonElement>('admin-member-export')?.addEventListener('click',exportMembers);
  el<HTMLInputElement>('admin-notification-confirm')?.addEventListener('change',e=>{
    const b=el<HTMLButtonElement>('admin-notification-ack');
    if(b)b.disabled=!(e.target as HTMLInputElement).checked;
  });
  el<HTMLButtonElement>('admin-notification-ack')?.addEventListener('click',()=>void acknowledgeNotifications());
</script>
