---
import Base from '../../../layouts/Base.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
import homeCampaigns from '../../../data/cms/home-campaigns.json';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const live = import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === "true";
---
<Base lang={lang} rest="membres/admin/" title={L(lang, { ko: 'ASICC 홈페이지 운영센터', fr: 'Centre de gestion du site ASICC' })} noindex>
  <section class="wrap m-shell asicc-admin-page">
    <div id="asicc-admin" class="stack gap-24"
      data-lang={lang}
      data-login-url={href(lang, 'membres/login/')}
      data-member-url={href(lang, 'membres/')}>
      <div class="stack gap-12">
        <span class="m-badge" style="align-self:flex-start">{L(lang, { ko: '관리자 전용', fr: 'Accès administrateur' })}</span>
        <h1 class="h2">{L(lang, { ko: '홈페이지 운영센터', fr: 'Centre de gestion du site' })}</h1>
        <p class="muted">{L(lang, {
          ko: '회원 승인·신청 처리, 게시판·메인 배너 및 홈페이지 운영 설정을 관리합니다.',
          fr: 'Gérez les membres, les demandes, les publications, les bannières et les paramètres du site.'
        })}</p>
      </div>

      {!live && <div class="card auth-card" role="status">{L(lang,{ko:"관리자 기능은 Firebase 권한 검증 전까지 비활성화됩니다.",fr:"L’administration reste désactivée jusqu’à la validation des règles Firebase."})}</div>}
      <div hidden={!live} id="admin-loading" class="card auth-card" role="status">
        {L(lang, { ko: '관리자 권한을 확인하고 있습니다…', fr: 'Vérification des droits administrateur…' })}
      </div>
      <div id="admin-denied" class="card auth-card stack gap-12" hidden>
        <p id="admin-denied-message" role="alert"></p>
        <a class="btn btn-dark" href={href(lang, 'membres/')}>{L(lang, { ko: '회원공간으로', fr: 'Retour à l’espace membres' })}</a>
      </div>

      <div id="admin-content" class="stack gap-24" hidden>
<nav class="asicc-admin-space-switch" aria-label={L(lang,{ko:'공간 선택',fr:'Choix de l’espace'})}>
  <a class="asicc-admin-space-tab" href={href(lang,'membres/')}>{L(lang,{ko:'회원공간',fr:'Espace membres'})}</a>
  <a class="asicc-admin-space-tab is-active" aria-current="page" href={href(lang,'membres/admin/')}>{L(lang,{ko:'관리자 공간',fr:'Espace administrateur'})}</a>
</nav>
<div class="card auth-card asicc-admin-space-menu">
  <a class="btn btn-dark" aria-current="page" href={href(lang,'membres/admin/')}>{L(lang,{ko:'홈페이지 운영센터',fr:'Centre de gestion du site'})}</a>
  <a class="btn btn-ghost" href={href(lang,'membres/office/')}>{L(lang,{ko:'온라인 협회 사무실',fr:'Bureau de l’association'})}</a>
  <a class="btn btn-ghost" href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer">{L(lang,{ko:'홈페이지 CMS 열기',fr:'Ouvrir le CMS'})} ↗</a>
</div>
        <section class="card auth-card asicc-admin-hub stack gap-16" aria-labelledby="asicc-admin-hub-heading">
  <div class="asicc-admin-hub-heading">
    <div>
      <h2 id="asicc-admin-hub-heading" class="h3">{L(lang,{ko:'빠른 업무 메뉴',fr:'Accès rapides'})}</h2>
      <p class="small muted">{L(lang,{ko:'아래 메뉴에서 업무를 선택하세요. 기존 관리 기능은 이 페이지 아래에 그대로 있습니다.',fr:'Choisissez une tâche ci-dessous. Les outils de gestion existants restent disponibles plus bas.'})}</p>
    </div>
  </div>
  <div class="asicc-admin-hub-group stack gap-8">
    <h3 class="asicc-admin-hub-category">{L(lang,{ko:'관리자 업무',fr:'Gestion administrative'})}</h3>
    <div class="asicc-admin-hub-grid">
      <a class="asicc-admin-hub-link" href="#ops-inbox-heading"><strong>{L(lang,{ko:'통합 처리 대기',fr:'Demandes en attente'})}</strong><span>{L(lang,{ko:'승급 · 실명 변경 · 건의',fr:'Statuts · noms · suggestions'})}</span></a>
      <a class="asicc-admin-hub-link" href="#members-heading"><strong>{L(lang,{ko:'회원관리',fr:'Gestion des membres'})}</strong><span>{L(lang,{ko:'회원 정보 · 등급 · 탈퇴',fr:'Profils · statuts · départs'})}</span></a>
      <a class="asicc-admin-hub-link" href={href(lang,'membres/gallery/')+'?view=review'}><strong>{L(lang,{ko:'사진 검토',fr:'Validation des photos'})}</strong><span>{L(lang,{ko:'검토 대기 · 승인 · 비공개',fr:'En attente · publier · masquer'})}</span></a>
      <a class="asicc-admin-hub-link" href="#admin-suggestions-panel"><strong>{L(lang,{ko:'건의·요청 관리',fr:'Suggestions et demandes'})}</strong><span>{L(lang,{ko:'통합 처리에서 확인',fr:'Examiner les demandes privées'})}</span></a>
    </div>
  </div>
  <div class="asicc-admin-hub-group stack gap-8">
    <h3 class="asicc-admin-hub-category">{L(lang,{ko:'콘텐츠 관리',fr:'Gestion des contenus'})}</h3>
    <div class="asicc-admin-hub-grid">
      <a class="asicc-admin-hub-link" href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer"><strong>{L(lang,{ko:'소식 관리 ↗',fr:'Actualités ↗'})}</strong><span>{L(lang,{ko:'공지 · 행사 · 대외활동 · 언론·기고 / CMS',fr:'Annonces · événements · relations · presse / CMS'})}</span></a>
      <a class="asicc-admin-hub-link" href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer"><strong>{L(lang,{ko:'행사 일정 관리 ↗',fr:'Calendrier ↗'})}</strong><span>{L(lang,{ko:'일정 등록 · 수정 · 삭제 / CMS',fr:'Créer · modifier · supprimer / CMS'})}</span></a>
      <a class="asicc-admin-hub-link" href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer"><strong>{L(lang,{ko:'홈페이지 CMS 전체 관리 ↗',fr:'Toutes les rubriques CMS ↗'})}</strong><span>{L(lang,{ko:'기타 홈페이지 콘텐츠 편집',fr:'Modifier les autres contenus du site'})}</span></a>
    </div>
    <p class="small muted asicc-admin-hub-note">{L(lang,{ko:'현재 소식은 CMS에서 한국어·프랑스어를 각각 작성합니다. 한 화면 동시 작성 기능은 다음 CMS 개편에서 적용합니다.',fr:'Les actualités en coréen et en français sont actuellement saisies séparément dans le CMS. La saisie conjointe sera ajoutée ultérieurement.'})}</p>
  </div>
  <div class="asicc-admin-hub-group stack gap-8">
    <h3 class="asicc-admin-hub-category">{L(lang,{ko:'홈페이지 운영',fr:'Administration du site'})}</h3>
    <div class="asicc-admin-hub-grid">
      <a class="asicc-admin-hub-link" href="#admin-board-management-heading"><strong>{L(lang,{ko:'게시판 관리',fr:'Gestion du forum'})}</strong><span>{L(lang,{ko:'게시판 분류 관리',fr:'Catégories du forum'})}</span></a>
      <a class="asicc-admin-hub-link" href={href(lang,'bazaar/admin/')}><strong>{L(lang,{ko:'온라인 바자회 관리',fr:'Gestion du bazar en ligne'})}</strong><span>{L(lang,{ko:'행사 · 상품 · 주문 · 입금',fr:'Événements · produits · commandes · paiements'})}</span></a>
      <a class="asicc-admin-hub-link" href="#admin-home-banners"><strong>{L(lang,{ko:'메인 배너 관리',fr:'Bannières d’accueil'})}</strong><span>{L(lang,{ko:'배너 1 · 배너 2',fr:'Bannière 1 · Bannière 2'})}</span></a>
      <a class="asicc-admin-hub-link" href="#operations-heading"><strong>{L(lang,{ko:'홈페이지 운영 설정',fr:'Paramètres du site'})}</strong><span>{L(lang,{ko:'갤러리 · 쪽지 · 학습자료',fr:'Galerie · messages · ressources'})}</span></a>
      <a class="asicc-admin-hub-link" href="#visits-heading"><strong>{L(lang,{ko:'방문 통계',fr:'Statistiques de visite'})}</strong><span>{L(lang,{ko:'Cloudflare · Firebase 확인',fr:'Cloudflare · Firebase'})}</span></a>
      <a class="asicc-admin-hub-link" href="#hidden-heading"><strong>{L(lang,{ko:'숨김 글·댓글 관리',fr:'Contenus masqués'})}</strong><span>{L(lang,{ko:'숨김 내용 확인 · 복구',fr:'Examiner · restaurer'})}</span></a>
    </div>
  </div>
</section>
        <div class="card auth-card stack gap-12">
          <div class="row gap-16" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <div class="stack gap-8">
              <strong id="admin-who"></strong>
              <span class="small muted">{L(lang, { ko: '관리자 인증 완료 · 본인 확인 완료', fr: 'Administrateur authentifié · Identité vérifiée' })}</span>
            </div>
            <div class="row gap-12" style="flex-wrap:wrap">
              
              <a href="#admin-home-banners" class="btn btn-ghost">{L(lang,{ko:'메인 배너 관리',fr:'Bannières d’accueil'})}</a>
              <button type="button" class="btn btn-ghost" id="admin-refresh">{L(lang, { ko: '새로고침', fr: 'Actualiser' })}</button>
            </div>
          </div>
        </div>

        <p id="admin-action-message" class="small" role="status" aria-live="polite" hidden></p>
        <div id="admin-toast" class="asicc-admin-toast" role="status" aria-live="polite" hidden>
          <span id="admin-toast-text"></span>
          <button id="admin-toast-close" type="button" aria-label={L(lang,{ko:'알림 닫기',fr:'Fermer la notification'})}>×</button>
        </div>

        <section id="admin-notification" class="asicc-admin-notification stack gap-12" role="alert" aria-live="assertive" hidden>
          <div class="row gap-12" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <h2 class="h3">{L(lang,{ko:'새로운 회원 소식',fr:'Nouvelles concernant les membres'})}</h2>
            <span id="admin-notification-count" class="m-badge"></span>
          </div>
          <p id="admin-notification-summary"></p>
          <div id="admin-notification-details" class="small"></div>
          <label class="row gap-8" style="align-items:center">
            <input type="checkbox" id="admin-notification-confirm" />
            <span>{L(lang,{ko:'내용을 확인했습니다. 이 알림은 다시 표시하지 않습니다.',fr:'J’ai pris connaissance de ces informations. Ne plus afficher cette alerte.'})}</span>
          </label>
          <div class="row gap-12" style="align-items:center;flex-wrap:wrap">
            <button type="button" id="admin-notification-ack" class="btn btn-dark" disabled>{L(lang,{ko:'확인 완료',fr:'Confirmer'})}</button>
            <span id="admin-notification-error" class="small" role="status"></span>
          </div>
        </section>

        <p id="admin-notification-empty" class="asicc-admin-empty small" role="status" aria-live="polite" hidden>
          {L(lang,{ko:'새로운 회원 가입이나 탈퇴 요청이 없습니다.',fr:'Aucune nouvelle inscription ni demande de départ.'})}
        </p>

        <section class="card auth-card stack gap-12" aria-labelledby="ops-inbox-heading">
          <h2 id="ops-inbox-heading" class="h3">{L(lang,{ko:'통합 처리 대기 요약',fr:'Résumé des demandes à traiter'})}</h2>
          <p class="small muted">{L(lang,{ko:'회원 승급·건의·사진 승인 요청을 한곳에서 확인하고 각 업무 화면으로 이동합니다.',fr:'Demandes de statut, suggestions et validation des photos.'})}</p>
          <div id="ops-inbox" class="stack gap-8"></div>
          <details id="admin-upgrade-requests" class="asicc-admin-upgrade-detail">
            <summary id="requests-heading">{L(lang,{ko:'승급 신청 확인·처리',fr:'Examiner les demandes de statut'})} <span id="admin-pending-count" class="m-badge" aria-label={L(lang,{ko:'대기 건수',fr:'Nombre en attente'})}></span></summary>
            <p class="small muted">{L(lang,{ko:'승인·거절 기능은 이곳에서 계속 사용할 수 있습니다.',fr:'Les approbations et refus restent disponibles ici.'})}</p>
            <div id="admin-requests" class="stack gap-12"></div>
          </details>
<details id="admin-name-requests-panel" class="asicc-admin-upgrade-detail">
  <summary id="name-requests-heading">{L(lang,{ko:'실명 변경 신청 확인·처리',fr:'Traiter les demandes de correction du nom'})}</summary>
  <div id="admin-name-requests" class="stack gap-12"></div>
</details>
<details id="admin-suggestions-panel" class="asicc-admin-upgrade-detail">
  <summary id="suggestions-heading">{L(lang,{ko:'비공개 건의 확인·처리',fr:'Traiter les suggestions privées'})}</summary>
  <div id="admin-suggestions" class="stack gap-12"></div>
</details>

        </section>
        <section class="card auth-card stack gap-16" aria-labelledby="members-heading">
          <div class="row gap-16" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <h2 id="members-heading" class="h3">{L(lang, { ko: '회원 등급 및 계정 관리', fr: 'Comptes et statuts des membres' })}</h2>
            <span id="admin-member-count" class="m-badge"></span>
          </div>
          <p class="small muted">{L(lang, {
            ko: '정식 정회원과 특별회원은 동일한 접근권한을 갖습니다. 다른 관리자를 지정할 때는 신중하게 확인하세요.',
            fr: 'Membres et membres spéciaux ont le même accès. Vérifiez soigneusement toute nomination d’administrateur.'
          })}</p>
          <div class="asicc-admin-toolbar">
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'검색',fr:'Recherche'})}</span>
              <input id="admin-member-search" type="search" placeholder={L(lang,{ko:'실명·닉네임·이메일·학생·학교·학년·연락처',fr:'Nom, pseudo, e-mail, élève, école, téléphone'})} />
            </label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'회원 등급',fr:'Statut'})}</span>
              <select id="admin-filter-role">
                <option value="all">{L(lang,{ko:'전체',fr:'Tous'})}</option>
                <option value="general">{L(lang,{ko:'일반회원',fr:'Membre général'})}</option>
                <option value="member">{L(lang,{ko:'정회원',fr:'Membre'})}</option>
                <option value="special">{L(lang,{ko:'특별회원',fr:'Membre spécial'})}</option>
                <option value="admin">{L(lang,{ko:'관리자',fr:'Administrateur'})}</option>
              </select>
            </label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'계정 상태',fr:'État du compte'})}</span>
              <select id="admin-filter-status">
                <option value="all">{L(lang,{ko:'전체',fr:'Tous'})}</option>
                <option value="approved">{L(lang,{ko:'활성',fr:'Actif'})}</option>
                <option value="suspended">{L(lang,{ko:'정지',fr:'Suspendu'})}</option>
                <option value="withdrawal">{L(lang,{ko:'탈퇴 요청',fr:'Départ demandé'})}</option>
              </select>
            </label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'학교급',fr:'Niveau scolaire'})}</span>
              <select id="admin-filter-school">
                <option value="all">{L(lang,{ko:'전체',fr:'Tous'})}</option>
                <option value="mat">{L(lang,{ko:'유치원',fr:'Maternelle'})}</option>
                <option value="elem">{L(lang,{ko:'초등학교',fr:'Élémentaire'})}</option>
                <option value="col">{L(lang,{ko:'중학교',fr:'Collège'})}</option>
              </select>
            </label>
            <label class="stack gap-8"><span class="small">{L(lang,{ko:'가입 시작일',fr:'Inscrit après'})}</span><input id="admin-filter-from" type="date" /></label>
          </div>
          <div class="row gap-12" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <div id="admin-filter-count" class="small muted" aria-live="polite"></div>
            <div class="row gap-8" style="flex-wrap:wrap">
              <button type="button" class="btn btn-ghost btn-sm" id="admin-filter-reset">{L(lang,{ko:'필터 초기화',fr:'Réinitialiser les filtres'})}</button>
              <button type="button" class="btn btn-ghost btn-sm" id="admin-member-export">{L(lang,{ko:'현재 목록 CSV 저장',fr:'Exporter la sélection CSV'})}</button>
            </div>
          </div>
          <div id="admin-members" class="asicc-admin-table-wrap" aria-live="polite"></div>
          <div id="admin-page-controls" class="row gap-12" style="justify-content:flex-end;align-items:center;flex-wrap:wrap">
            <button type="button" id="admin-prev" class="btn btn-ghost btn-sm">{L(lang,{ko:'이전',fr:'Précédent'})}</button>
            <span id="admin-page-label" class="small muted"></span>
            <button type="button" id="admin-next" class="btn btn-ghost btn-sm">{L(lang,{ko:'다음',fr:'Suivant'})}</button>
          </div>
          <dialog id="admin-edit-dialog" class="asicc-admin-editor" aria-labelledby="admin-edit-heading">
            <form id="admin-edit-form" class="stack gap-16">
              <h3 id="admin-edit-heading" class="h3">{L(lang,{ko:'회원 정보 수정',fr:'Modifier les informations du membre'})}</h3>
              <p id="admin-edit-email" class="small muted"></p>
              <p class="small muted">{L(lang,{ko:'로그인 아이디(이메일)는 Firebase 인증 정보와 연결되어 이 화면에서 변경하지 않습니다. 승급 신청 원본은 보존됩니다.',fr:'L’e-mail de connexion est géré par Firebase Auth et ne peut pas être modifié ici. Les demandes initiales sont conservées.'})}</p>
              <div class="asicc-admin-edit-grid">
                <label class="stack gap-8"><span>{L(lang,{ko:'실명',fr:'Nom réel'})}</span><input id="admin-edit-name" maxlength="80" required /></label>
                <label class="stack gap-8"><span>{L(lang,{ko:'닉네임',fr:'Pseudo'})}</span><input id="admin-edit-nickname" maxlength="24" minlength="2" required /></label>
                <label class="stack gap-8"><span>{L(lang,{ko:'연락처',fr:'Téléphone'})}</span><input id="admin-edit-phone" type="tel" maxlength="40" /></label>
                <label class="stack gap-8"><span>{L(lang,{ko:'계정 유형',fr:'Type de compte (messagerie)'})}</span>
                  <select id="admin-edit-account-type">
                    <option value="">{L(lang,{ko:'미확인',fr:'Non confirmé'})}</option>
                    <option value="adult">{L(lang,{ko:'성인',fr:'Adulte'})}</option>
                    <option value="student">{L(lang,{ko:'재학생·졸업·전학생 본인',fr:'Élève / ancien élève'})}</option>
                  </select>
                </label>
                <label class="stack gap-8"><span>{L(lang,{ko:'생년월일 (학생 본인)',fr:'Date de naissance (élève)'})}</span><input id="admin-edit-birth" type="date" min="1900-01-01"/><span id="admin-edit-age" class="small muted"></span></label>
                <label class="stack gap-8"><span>{L(lang,{ko:'쪽지 기능 활성화',fr:'Accès à la messagerie'})}</span><select id="admin-edit-dm-mode"><option value="auto">{L(lang,{ko:'자동 (성인 및 회원 등급 기준)',fr:'Automatique (âge et rôle)'})}</option><option value="on">{L(lang,{ko:'활성화 (ON)',fr:'Activer (ON)'})}</option><option value="off">{L(lang,{ko:'비활성화',fr:'Désactiver'})}</option></select><span id="admin-edit-dm-state" class="small muted"></span></label>
                <label class="stack gap-8"><span>{L(lang,{ko:'가입 구분',fr:'Catégorie'})}</span>
                  <select id="admin-edit-kind">
                    <option value="">{L(lang,{ko:'미설정',fr:'Non renseigné'})}</option>
                    <option value="parent">{L(lang,{ko:'재학생 학부모',fr:'Parent d’élève'})}</option>
                    <option value="alumnus">{L(lang,{ko:'졸업생',fr:'Ancien élève'})}</option>
                    <option value="alumni-parent">{L(lang,{ko:'졸업생 학부모',fr:'Parent d’ancien élève'})}</option>
                    <option value="teacher">{L(lang,{ko:'교사',fr:'Enseignant'})}</option>
                    <option value="contributor">{L(lang,{ko:'기여자',fr:'Contributeur'})}</option>
                  </select>
                </label>
                <label class="stack gap-8"><span>{L(lang,{ko:'학생과의 관계',fr:'Lien avec l’élève'})}</span><input id="admin-edit-relation" maxlength="60" placeholder={L(lang,{ko:'예: 모 / 부 / 학생',fr:'Ex. mère / père / élève'})} /></label>
              </div>
              <fieldset class="asicc-admin-school-fieldset">
                <legend>{L(lang,{ko:'학교급 (복수 선택 가능)',fr:'Niveaux scolaires (plusieurs choix possibles)'})}</legend>
                <label><input type="checkbox" name="admin-level" value="mat" /> {L(lang,{ko:'유치원',fr:'Maternelle'})}</label>
                <label><input type="checkbox" name="admin-level" value="elem" /> {L(lang,{ko:'초등학교',fr:'Élémentaire'})}</label>
                <label><input type="checkbox" name="admin-level" value="col" /> {L(lang,{ko:'중학교',fr:'Collège'})}</label>
              </fieldset>
              <div class="stack gap-8">
                <div class="row gap-12" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
                  <strong>{L(lang,{ko:'학생 / 학교 / 학년',fr:'Élèves / établissements / classes'})}</strong>
                  <button type="button" class="btn btn-ghost btn-sm" id="admin-edit-add-child">{L(lang,{ko:'+ 학생 추가 (최대 5명)',fr:'+ Ajouter un élève (5 max)'})}</button>
                </div>
                <div id="admin-edit-children" class="stack gap-8"></div>
              </div>
              <p id="admin-edit-error" class="small" role="alert" hidden></p>
              <div class="row gap-12" style="justify-content:flex-end;flex-wrap:wrap">
                <button class="btn btn-ghost" type="button" id="admin-edit-cancel">{L(lang,{ko:'취소',fr:'Annuler'})}</button>
                <button class="btn btn-dark" type="submit" id="admin-edit-save">{L(lang,{ko:'변경사항 저장',fr:'Enregistrer les modifications'})}</button>
              </div>
            </form>
          </dialog>
        </section>

        <section class="card auth-card stack gap-12" aria-labelledby="admin-board-management-heading">
          <h2 id="admin-board-management-heading" class="h3">{L(lang,{ko:'게시판 관리',fr:'Gestion du forum'})}</h2>
            <h3 class="h3">{L(lang,{ko:'게시판 분류 관리',fr:'Catégories du forum'})}</h3>
            <p class="small muted">{L(lang,{ko:'한 줄에 ID | 한국어 | Français 순서로 입력. 기존 게시물의 분류 ID는 변경하지 마세요.',fr:'Une ligne : ID | coréen | français. Ne modifiez pas les identifiants existants.'})}</p>
            <textarea id="ops-board-categories" rows="7" spellcheck="false"></textarea>
            <button id="ops-save-board-categories" type="button" class="btn btn-ghost" style="align-self:flex-start">{L(lang,{ko:'게시판 분류 저장',fr:'Enregistrer les catégories du forum'})}</button>
        </section>
        <section class="card stack gap-12" style="padding:22px" aria-labelledby="hidden-heading">
          <h2 id="hidden-heading" class="h3">{L(lang,{ko:'숨김 글·댓글 관리 / 복구',fr:'Contenus masqués / restauration'})}</h2>
          <p class="small muted">{L(lang,{ko:'숨긴 원문은 관리자만 확인하고 복구할 수 있습니다. 기존 방식으로 숨겨 이미 덮어쓴 글은 복구되지 않습니다.',fr:'Les archives privées permettent la restauration. Les anciens textes déjà écrasés avant cette mise à jour ne sont pas récupérables.'})}</p>
          <div id="admin-hidden-list" class="stack gap-12"></div>
        </section>
        <details id="admin-deletions-panel" class="card asicc-admin-deletion-section" aria-labelledby="deletions-heading">
          <summary id="deletions-heading" class="h3">{L(lang,{ko:'게시판 삭제 이력 보기',fr:'Consulter l’historique de suppression'})}</summary>
          <p class="small muted">{L(lang,{ko:'삭제된 본문은 보관하지 않고 처리자·사유·시각만 조회합니다.',fr:'Les textes supprimés ne sont pas conservés ; seul le journal minimal est affiché.'})}</p>
          <div id="admin-deletion-logs" class="stack gap-8"></div>
        </details>
        
        
        <section class="card auth-card stack gap-16" aria-labelledby="operations-heading">
          <h2 id="operations-heading" class="h3">{L(lang,{ko:'홈페이지 운영 설정',fr:'Paramètres opérationnels du site'})}</h2>
          <p class="small muted">{L(lang,{ko:'일반적인 갤러리 공개·쪽지·게시판 분류는 코드를 수정하지 않고 여기에서 변경합니다. 보안 규칙 자체는 직접 편집하지 않습니다.',fr:'Gérez les catégories, la galerie et la messagerie sans modifier le code. Les règles de sécurité restent protégées.'})}</p>
          <div class="stack gap-8" style="border:1px solid #dce0e7;border-radius:10px;padding:16px">
            <label class="row gap-12" style="align-items:center"><input type="checkbox" id="ops-gallery-open"/> <strong>{L(lang,{ko:'갤러리 회원 공개',fr:'Ouvrir la galerie aux membres'})}</strong></label>
            <p class="small muted">{L(lang,{ko:'기본은 비공개입니다. 공개하면 일반 등록된 사진과 관리자가 승인한 사진이 정회원·특별회원·관리자에게 표시됩니다. 현재 파일은 Backblaze B2에만 저장되고 Google Drive 원본 자동 보관은 실행되지 않습니다. 초상권 정책 확정 전에는 공개하지 마세요.',fr:'Fermée par défaut. Les photos directement publiées ou approuvées seront visibles aux membres autorisés. Les fichiers restent sur Backblaze B2 ; aucune sauvegarde Google Drive. Ne pas ouvrir avant la validation des règles relatives au droit à l’image.'})}</p>
            <button type="button" class="btn btn-dark" id="ops-save-gallery" style="align-self:flex-start">{L(lang,{ko:'갤러리 공개 설정 저장',fr:'Enregistrer la galerie'})}</button>
            <label class="row gap-12" style="align-items:center"><input type="checkbox" id="ops-messaging-open"/> <strong>{L(lang,{ko:'회원 쪽지 기능 전체 활성화',fr:'Activer la messagerie des membres'})}</strong></label>
            <button type="button" class="btn btn-dark" id="ops-save-toggles" style="align-self:flex-start">{L(lang,{ko:'쪽지 설정 저장',fr:'Enregistrer la messagerie'})}</button>
            <button type="button" class="btn btn-ghost" id="admin-dm-initialise" disabled style="align-self:flex-start">{L(lang,{ko:'기존 회원 쪽지 일괄 활성화 (최초 1회)',fr:'Activer la messagerie des membres existants (une seule fois)'})}</button>
            <p id="admin-dm-initialise-state" class="small muted" role="status"></p>
          </div>
          <div class="stack gap-12" style="border:1px solid #dce0e7;border-radius:10px;padding:16px">
            <h3 class="h3">{L(lang,{ko:'학습자료실 분류 관리',fr:'Catégories des ressources'})}</h3>
            <textarea id="ops-resource-categories" rows="7" spellcheck="false"></textarea>
            <button id="ops-save-resource-categories" type="button" class="btn btn-ghost" style="align-self:flex-start">{L(lang,{ko:'학습자료 분류 저장',fr:'Enregistrer les catégories des ressources'})}</button>
          </div>
          <p id="ops-status" role="status" class="small muted"></p>
          <div class="row gap-12" style="flex-wrap:wrap"><a class="btn btn-ghost" href={href(lang,'membres/gallery/')}>{L(lang,{ko:'갤러리 관리',fr:'Gérer la galerie'})}</a><a class="btn btn-ghost" href={href(lang,'membres/gallery/')+'?view=review'}>{L(lang,{ko:'검토 대기 사진',fr:'Médias à vérifier'})}</a><a class="btn btn-ghost" href={href(lang,'membres/messages/')}>{L(lang,{ko:'회원 쪽지함 열기',fr:'Messagerie'})}</a></div>
        </section>
        <section class="card auth-card stack gap-8" aria-labelledby="visits-heading">
          <h2 id="visits-heading" class="h3">{L(lang,{ko:'방문 통계',fr:'Statistiques de fréquentation'})}</h2>
          <p class="small muted">{L(lang,{ko:'비회원 포함 방문 횟수와 페이지 조회수는 Cloudflare 대시보드에서 확인합니다. 홈페이지의 회원정보 DB에는 방문 기록을 저장하지 않습니다.',fr:'Les visites (y compris anonymes) et pages vues sont consultables dans Cloudflare. Aucune activité de visite n’est enregistrée dans la base de profils.'})}</p>
          <div class="row gap-12" style="flex-wrap:wrap">
            <a class="btn btn-ghost" href="https://dash.cloudflare.com/" target="_blank" rel="noopener noreferrer">{L(lang,{ko:'Cloudflare 방문 통계 열기',fr:'Ouvrir Cloudflare Analytics'})}</a>
            <a class="btn btn-ghost" href="https://console.firebase.google.com/" target="_blank" rel="noopener noreferrer">{L(lang,{ko:'Firebase 로그인 기록 확인',fr:'Consulter les connexions Firebase'})}</a>
          </div>
          <p class="small muted">{L(lang,{ko:'개별 회원의 마지막 로그인일은 Firebase Authentication에서 확인합니다. 서버 연동 없이 이 화면에 표시하지 않습니다.',fr:'La date de dernière connexion est consultable dans Firebase Authentication. Elle n’est pas affichée ici sans serveur sécurisé.'})}</p>
        </section>

        <section class="card auth-card stack gap-16" id="admin-home-banners" aria-labelledby="admin-banners-heading">
          <div class="row gap-12" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <h2 id="admin-banners-heading" class="h3">{L(lang,{ko:'메인 홈페이지 배너 관리',fr:'Gestion des bannières d’accueil'})}</h2>
            <a href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">{L(lang,{ko:'CMS에서도 편집',fr:'Modifier dans le CMS'})} ↗</a>
          </div>
          <p class="small muted">{L(lang,{ko:'여기에서 저장하면 홈페이지에 즉시 반영됩니다. CMS에서 수정한 내용은 배포 후 기본값으로 적용됩니다. 관리자 수정값이 있으면 관리자 수정값이 우선하며, ‘CMS 기본값 복원’을 누르면 CMS 내용으로 돌아갑니다. 테스트 홈페이지와 공식 홈페이지의 관리자 수정값은 서로 분리됩니다.',fr:'Les modifications enregistrées ici sont publiées immédiatement. Le CMS définit les valeurs de base après déploiement ; une modification administrateur est prioritaire jusqu’au retour aux valeurs du CMS. Les modifications du site de test sont séparées du site public.'})}</p>
          {([['bazaar',homeCampaigns.bazaar],['admissions',homeCampaigns.admissions]] as const).map(([key,item]) => <form class="asicc-banner-form stack gap-12" data-banner-editor={key}>
            <div class="row gap-12" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
              <h3 class="h3">{key==='bazaar'?L(lang,{ko:'배너 1',fr:'Bannière 1'}):L(lang,{ko:'배너 2',fr:'Bannière 2'})}</h3>
              <span data-banner-status class="small muted">{L(lang,{ko:'CMS 기본값',fr:'Valeur du CMS'})}</span>
            </div>
            <label class="row gap-8" style="align-items:center"><input type="checkbox" name="enabled" checked={item.enabled} /> {L(lang,{ko:'메인 화면에 표시',fr:'Afficher sur la page d’accueil'})}</label>
            <div class="asicc-banner-grid">
              {([['eyebrow','상단 작은 제목','Surtitre'],['title','큰 제목','Titre'],['body','본문 설명','Description'],['status','상태 문구','État / précision'],['button','버튼 문구','Libellé du bouton']] as const).map(([field,ko,fr]) => <div class="asicc-banner-lang-pair">
                <label class="small muted">{L(lang,{ko,fr})}</label>
                <label class="stack gap-4"><span class="small">한국어</span>{field==='body' ? <textarea rows="3" name={`${field}_ko`} maxlength="600">{item[field].ko}</textarea> : <input type="text" name={`${field}_ko`} value={item[field].ko} maxlength={field==='title'?'120':field==='eyebrow'?'100':field==='status'?'100':'60'}/>}</label>
                <label class="stack gap-4"><span class="small">Français</span>{field==='body' ? <textarea rows="3" name={`${field}_fr`} maxlength="600">{item[field].fr}</textarea> : <input type="text" name={`${field}_fr`} value={item[field].fr} maxlength={field==='title'?'120':field==='eyebrow'?'100':field==='status'?'100':'60'}/>}</label>
              </div>)}
            </div>
            <label class="stack gap-6"><span>{L(lang,{ko:'바로가기 주소',fr:'Lien du bouton'})}</span>
              <input name="link" type="text" value={item.link} maxlength="500" required placeholder="news/2026-10-08-admissions/"/>
              <span class="small muted">{L(lang,{ko:'내부 공지: news/글주소/ · 바자회: bazaar/?event=행사ID · 외부 링크: https://...',fr:'Article : news/identifiant/ · bazar : bazaar/?event=identifiant · lien externe : https://...'})}</span>
            </label>
            <div class="row gap-12" style="flex-wrap:wrap;align-items:center">
              <button type="submit" class="btn btn-dark" data-banner-save>{L(lang,{ko:'저장',fr:'Enregistrer'})}</button>
              <button type="button" class="btn btn-ghost" data-banner-reset disabled>{L(lang,{ko:'CMS 기본값 복원',fr:'Restaurer le CMS'})}</button>
              <span data-banner-message class="small" role="status" aria-live="polite"></span>
            </div>
          </form>)}
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
/* ASICC administration hub: navigation only; preserves all existing tools below. */
.asicc-admin-hub {background:linear-gradient(180deg,#ffffff 0%,#fbfdfb 100%);border-color:#dfe8e2;}
.asicc-admin-hub-heading {display:flex;justify-content:space-between;align-items:center;gap:14px;}
.asicc-admin-hub-heading p {margin:6px 0 0;}
.asicc-admin-hub-category {font-size:1rem;font-weight:750;margin:0;color:#284d3c;letter-spacing:-.012em;}
.asicc-admin-hub-group {min-width:0;}
.asicc-admin-hub-grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,235px),1fr));gap:10px;}
.asicc-admin-hub-link {display:flex;flex-direction:column;gap:6px;position:relative;min-width:0;min-height:82px;box-sizing:border-box;padding:15px 34px 14px 15px;background:#fff;border:1px solid #dce5df;border-radius:11px;color:inherit;text-decoration:none;transition:border-color .15s,background-color .15s,box-shadow .15s;}
.asicc-admin-hub-link::after {content:'›';position:absolute;right:14px;top:15px;color:#527363;font-size:24px;line-height:1;}
.asicc-admin-hub-link strong {font-size:14px;font-weight:750;line-height:1.4;}
.asicc-admin-hub-link span {font-size:12.5px;line-height:1.5;color:#596e63;}
.asicc-admin-hub-link:hover {border-color:#87b19b;background:#f4faf6;box-shadow:0 3px 12px rgba(28,73,51,.06);}
.asicc-admin-hub-link:focus-visible {outline:3px solid #3f9465;outline-offset:2px;}
.asicc-admin-hub-note {margin:3px 0 0;}
@media(max-width:600px){.asicc-admin-hub-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.asicc-admin-hub-link{min-height:86px;padding:13px 24px 13px 12px;}.asicc-admin-hub-link strong{font-size:13px;}.asicc-admin-hub-link span{font-size:12px;}.asicc-admin-hub-link::after{right:9px;}}
@media(max-width:390px){.asicc-admin-hub-grid{grid-template-columns:minmax(0,1fr);}}

.asicc-admin-space-switch {display:flex;gap:8px;align-items:center;flex-wrap:wrap;border-bottom:1px solid #dce5e3;padding:0 0 12px}
.asicc-admin-space-tab {display:inline-flex;align-items:center;justify-content:center;padding:10px 16px;min-height:40px;border:1px solid #d6e1db;border-radius:9px;color:inherit;text-decoration:none;font-size:14px;font-weight:650}
.asicc-admin-space-tab.is-active {background:#e7f1ed;border-color:#9cbeb0;color:#245543;font-weight:750}
.asicc-admin-space-menu {display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  /* 관리자 전용 페이지는 기본 .wrap(1200px) 및 .auth-card(520px) 제한을 해제합니다.
     일반 로그인/프로필 페이지는 이 변경의 영향을 받지 않습니다. */
  .asicc-admin-page { box-sizing:border-box; width:100%; max-width:none; margin:0 auto; padding-inline:clamp(16px,2.2vw,48px); }
  .asicc-admin-page #asicc-admin, .asicc-admin-page #admin-content { box-sizing:border-box; width:100%; min-width:0; }
  .asicc-admin-page #admin-content > .card.auth-card,
  .asicc-admin-page #admin-content > section.card.auth-card { max-width:none; width:100%; margin:0; box-sizing:border-box; padding:clamp(16px,1.8vw,28px); }
  .asicc-admin-deletion-section {padding:22px;}
  .asicc-admin-deletion-section summary {cursor:pointer;}
  .asicc-admin-deletion-section[open] > p {margin:16px 0 12px;}
  .asicc-admin-deletion-section[open] > div {margin-top:12px;}
  .asicc-admin-toast { position:fixed; z-index:2000; right:clamp(12px,3vw,36px); top:clamp(18px,5vh,55px); max-width:min(440px,calc(100vw - 24px)); padding:15px 17px; background:#eaf6ed; border:1px solid #7fb791; color:#12512f; border-radius:12px; box-shadow:0 10px 35px rgba(0,0,0,.18); display:flex; align-items:center; gap:14px; font-weight:650; }
  .asicc-admin-toast[hidden] { display:none; }
  .asicc-admin-toast[data-error="true"] { background:#fff1f0; border-color:#e6aaa6; color:#971b1b; }
  .asicc-admin-toast button { border:none; background:transparent; color:inherit; font:inherit; font-size:1.5rem; cursor:pointer; padding:0 4px; }
  .asicc-admin-editor { border:1px solid #ddd; border-radius:14px; padding:clamp(18px,3vw,30px); width:min(900px,calc(100vw - 20px)); max-height:90vh; overflow:auto; box-sizing:border-box; }
  .asicc-admin-editor::backdrop { background:rgba(19,27,34,.55); }
  .asicc-admin-edit-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr)); gap:14px; }
  .asicc-admin-edit-grid input,.asicc-admin-edit-grid select { width:100%; box-sizing:border-box; }
  .asicc-admin-school-fieldset { border:1px solid #ddd; border-radius:8px; padding:12px; display:flex; flex-wrap:wrap; gap:14px; }
  .asicc-admin-child-row { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)) auto; gap:8px; align-items:center; }
  .asicc-admin-child-row input { box-sizing:border-box; width:100%; }
  .asicc-admin-child-row button { white-space:nowrap; }
  @media(max-width:720px) { .asicc-admin-child-row { grid-template-columns:1fr; } }
  .asicc-admin-upgrade-detail {border-top:1px solid #e4e7ec; padding-top:12px; margin-top:6px;}
  .asicc-admin-upgrade-detail summary {cursor:pointer; font-weight:700; display:flex; flex-wrap:wrap; align-items:center; gap:12px;}
  .asicc-admin-upgrade-detail[open] #admin-requests {margin-top:12px;}
  .asicc-admin-empty { margin:0; padding:13px 17px; color:#345c4a; background:#eff7f1; border:1px solid #d5e8db; border-radius:9px; }
  :global(.asicc-admin-record) { border: 1px solid #dce0e7; border-radius: 12px; padding:16px; }
  :global(.asicc-admin-fields) { display:grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,175px),1fr)); gap:12px; align-items:end; }
  :global(.asicc-admin-actions) { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:10px; }
  :global(.asicc-admin-muted) { font-size:.88rem; color:var(--muted,#64748b); overflow-wrap:anywhere; }
  .asicc-admin-notification { border:1px solid #c09b56; border-radius:14px; padding:20px; background:rgba(250,238,216,.35); }
  .asicc-banner-form { padding:20px; border:1px solid #dbe4df; border-radius:12px; background:#f9fbfa; min-width:0; }
  .asicc-banner-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px 16px; }
  .asicc-banner-lang-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
  .asicc-banner-lang-pair > .muted { grid-column:1/-1; font-weight:700; }
  .asicc-banner-form input[type="text"], .asicc-banner-form textarea { width:100%; min-width:0; box-sizing:border-box; }
  @media (max-width:950px) { .asicc-banner-grid { grid-template-columns:minmax(0,1fr); } }
  @media (max-width:520px) { .asicc-banner-lang-pair { grid-template-columns:minmax(0,1fr); } }
  .asicc-admin-notification[hidden] { display:none; }
  .asicc-admin-toolbar { display:grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,170px),1fr)); gap:12px; align-items:end; }
  .asicc-admin-toolbar input,.asicc-admin-toolbar select { width:100%; min-width:0; }
  .asicc-admin-table-wrap { max-width:100%; width:100%; overflow:auto; border:1px solid #dce0e7; border-radius:10px; }
  :global(.asicc-admin-table) { border-collapse:collapse; width:100%; min-width:1360px; font-size:.82rem; background:#fff; }
  :global(.asicc-admin-table) th,:global(.asicc-admin-table) td { padding:9px 8px; border-bottom:1px solid #e4e7ec; border-right:1px solid #f1f2f5; text-align:left; vertical-align:middle; white-space:nowrap; }
  :global(.asicc-admin-table) thead th { position:sticky; top:0; z-index:1; background:#f5f7fa; font-size:.78rem; font-weight:700; }
  :global(.asicc-admin-table) tbody tr:nth-child(even) { background:#fafbfc; }
  :global(.asicc-admin-table) tbody tr:hover { background:#eff6f3; }
  :global(.asicc-admin-table) th:first-child,:global(.asicc-admin-table) td:first-child { position:sticky; left:0; z-index:1; background:inherit; text-align:right; min-width:46px; }
  :global(.asicc-admin-table) thead th:first-child { z-index:2; background:#f5f7fa; }
  :global(.asicc-admin-table) select { width:130px; max-width:100%; padding:6px; font-size:.8rem; }
  :global(.asicc-admin-table) :global(.admin-row-action) { min-width:64px; padding:7px 10px; }
  :global(.asicc-admin-table) :global(.admin-row-action)[disabled] { opacity:.5; }
  :global(.asicc-admin-table) :global(.admin-small) { font-size:.75rem; color:#667085; }
  :global(.asicc-admin-table) :global(.admin-name) { font-weight:700; }
  :global(.asicc-admin-table) :global(.admin-students) { max-width:270px; overflow:hidden; text-overflow:ellipsis; }
  @media(max-width:720px) { .asicc-admin-notification { padding:14px; } .asicc-admin-toolbar { grid-template-columns:repeat(2,minmax(0,1fr)); } .asicc-admin-toolbar label:first-child { grid-column:1/-1; } }
</style>

<script>
  import {formatParisDate} from '../../../scripts/members/display-date';
  import { getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, getIdToken } from 'firebase/auth';
  import {
    getFirestore, doc, getDoc, getDocs, getDocsFromServer, query, collection, where,
    limit, updateDoc, runTransaction, serverTimestamp, writeBatch, setDoc, deleteDoc, getDocFromServer, Timestamp,
    type DocumentData
  } from 'firebase/firestore';
  import { firebaseConfig } from '../../../firebase-config';
  import bannerDefaults from '../../../data/cms/home-campaigns.json';
  import {dmAllowed,validBirthDate,adulthoodDate,ageOn} from '../../../scripts/members/member-access';

  type Child = {studentName:string;school:string;grade:string};
  type Member = { id: string; name: string; nickname?:string; nicknameKey?:string; email: string; phone?: string;
    levels?: string[]; children?: Child[]; memberKind?: string; memberRelation?: string; accountType?: string; birthDate?:string; adultAt?:Timestamp|null; dmMode?:string;
    role: string; status: string; createdAt?: Timestamp | number | string | null;
    withdrawnAt?: Timestamp | number | string | null }; 
  type Withdrawal = { uid: string; name: string; email: string; status: string; requestedAt?: Timestamp | number | null };
  type Upgrade = { uid: string; applicantName: string; applicantEmail: string;
    requestedRole: 'member' | 'special'; kind: string; schoolYear?: number | null;
    note?: string; relation?:string; children?:Array<{studentName:string;school:string;grade:string}>; status: string; };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const root = el<HTMLElement>('asicc-admin');
  const fr = root?.dataset.lang === 'fr';
  const tr = (ko: string, french: string) => fr ? french : ko;
  const app = getApps().find(a => a.name === 'asicc-website')
    ?? initializeApp(firebaseConfig, 'asicc-website');
  const auth = getAuth(app);
  const db = getFirestore(app);
  const bannerCollection = /^(www\.)?asicc-parents\.fr$/i.test(location.hostname)
    ? 'publicHomeBanners' : 'publicHomeBannersTest';
  let meUid = '';
  let members: Member[] = [];
  let globalDMEnabled=false;
  window.addEventListener('asicc-messaging-setting',event=>{globalDMEnabled=(event as CustomEvent<boolean>).detail===true;renderMembers();});
  const upgradeHistory=new Map<string,Upgrade>();
  const withdrawals = new Map<string,Withdrawal>();
  let page = 1;
  const pageSize = 25;
  let sortColumn: 'createdAt' | 'name' | 'email' = 'createdAt';
  let sortAsc = false;
  let busy = false;

  const text = (id: string, value: string) => { const node = el<HTMLElement>(id); if (node) node.textContent = value; };
  let toastTimeout:ReturnType<typeof setTimeout>|null=null;
  const showMessage = (message: string, error = false) => {
    const node = el<HTMLElement>('admin-action-message');
    if(node){node.hidden = false;node.textContent = message;node.style.color = error ? '#b42318' : '#067647';}
    const toast=el<HTMLElement>('admin-toast');
    if(toast){toast.hidden=false;toast.dataset.error=String(error);text('admin-toast-text',message);
      toast.setAttribute('role',error?'alert':'status');
      if(toastTimeout)clearTimeout(toastTimeout);
      toastTimeout=setTimeout(()=>{toast.hidden=true;toastTimeout=null;},8500);
    }
  };
  el<HTMLButtonElement>('admin-toast-close')?.addEventListener('click',()=>{
    const toast=el<HTMLElement>('admin-toast');if(toast)toast.hidden=true;
    if(toastTimeout)clearTimeout(toastTimeout);toastTimeout=null;
  });
  window.addEventListener('asicc-ops-toast',event=>{const d=(event as CustomEvent<{message:string;error:boolean}>).detail;showMessage(d.message,d.error);});
  const deny = (message: string) => {
    const loading = el<HTMLElement>('admin-loading'); if (loading) loading.hidden = true;
    const denied = el<HTMLElement>('admin-denied'); if (denied) denied.hidden = false;
    text('admin-denied-message', message);
    const content = el<HTMLElement>('admin-content'); if (content) content.hidden = true;
  };
  const panel = (className: string, content: string) => {
    const node = document.createElement('div'); node.className = className;
    node.textContent = content; return node;
  };
  const actionButton = (label: string, handler: () => void): HTMLButtonElement => {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'btn btn-ghost';
    b.textContent = label; b.addEventListener('click', handler); return b;
  };
  const roleLabel = (role: string) => ({
    general: tr('일반회원', 'Membre général'),
    member: tr('정회원', 'Membre de l’association'),
    special: tr('특별회원', 'Membre spécial'),
    admin: tr('관리자', 'Administrateur')
  } as Record<string,string>)[role] || role;
  const kindLabel = (kind: string) => ({
    parent: tr('학부모','Parent'), alumnus: tr('졸업생','Ancien élève'),
    'alumni-parent': tr('졸업생 학부모','Parent d’ancien élève'),
    teacher:tr('교사·기여자','Enseignant'),contributor:tr('특별기여자','Contributeur')
  } as Record<string,string>)[kind] || kind;
  const roleOptions = ['general','member','special','admin'];

  async function loadRequests() {
    const container = el<HTMLElement>('admin-requests'); if (!container) return;
    container.replaceChildren(panel('small muted', tr('불러오는 중…','Chargement…')));
    const snaps = await getDocs(query(collection(db,'upgradeRequests'), where('status','==','pending')));
    const requests = snaps.docs.map(s => s.data() as Upgrade);
    requests.forEach(req=>upgradeHistory.set(req.uid,req));
    text('admin-pending-count', String(requests.length));
    const queue=el<HTMLDetailsElement>('admin-upgrade-requests');if(queue&&requests.length)queue.open=true;
    container.replaceChildren();
    if (!requests.length) {
      container.append(panel('small muted',tr('대기 중인 신청이 없습니다.','Aucune demande en attente.')));
      return;
    }
    for (const item of requests) {
      const card = document.createElement('article'); card.className = 'asicc-admin-record stack gap-8';
      const name = panel('',item.applicantName || tr('이름 없음','Sans nom'));
      name.style.fontWeight = '700'; card.append(name);
      card.append(panel('asicc-admin-muted', item.applicantEmail || ''));
      card.append(panel('small', tr('신청 등급: ','Statut demandé : ') + roleLabel(item.requestedRole)
        + ' · ' + kindLabel(item.kind) + (item.schoolYear ? ` · ${item.schoolYear}` : '')));
      if(item.relation)card.append(panel('small',tr('관계: ','Lien : ')+item.relation));
      if(item.children?.length)item.children.forEach(child=>card.append(panel('small',`${child.studentName||''} · ${child.school||''} · ${child.grade||''}`)));
      if (item.note) card.append(panel('asicc-admin-muted',item.note));
      const buttons = document.createElement('div'); buttons.className = 'asicc-admin-actions';
      buttons.append(
        actionButton(tr('승인','Approuver'),()=>void review(item,true)),
        actionButton(tr('거절','Refuser'),()=>void review(item,false))
      );
      card.append(buttons); container.append(card);
    }
  }

  async function review(item: Upgrade, approve: boolean) {
    if (busy) return;
    if (!['member','special'].includes(item.requestedRole)) return;
    const question = approve
      ? tr(`${item.applicantName}님의 ${roleLabel(item.requestedRole)} 승급을 승인할까요?`,
           `Approuver le statut ${roleLabel(item.requestedRole)} pour ${item.applicantName} ?`)
      : tr(`${item.applicantName}님의 신청을 거절할까요?`, `Refuser la demande de ${item.applicantName} ?`);
    if (!window.confirm(question)) return;
    busy = true;
    try {
      const requestRef = doc(db,'upgradeRequests',item.uid);
      const memberRef = doc(db,'members',item.uid);
      await runTransaction(db, async tx => {
        const requestSnap = await tx.get(requestRef);
        if (!requestSnap.exists() || requestSnap.data().status !== 'pending') throw Error('request-changed');
        const freshRole = requestSnap.data().requestedRole;
        if (!['member','special'].includes(freshRole)) throw Error('role-invalid');
        if (approve) {
          const memberSnap = await tx.get(memberRef);
          if (!memberSnap.exists() || memberSnap.data().role !== 'general'
              || memberSnap.data().status !== 'approved') throw Error('profile-changed');
          tx.update(memberRef, { role: freshRole });
          if(memberSnap.data().nickname)tx.set(doc(db,'publicNames',item.uid),{nickname:memberSnap.data().nickname,role:freshRole,canReceiveDM:dmAllowed({...memberSnap.data(),role:freshRole}),updatedAt:serverTimestamp()});
        }
        tx.update(requestRef, {
          status: approve ? 'approved' : 'rejected',
          reviewedBy: meUid, reviewedAt: serverTimestamp()
        });
      });
      showMessage(approve ? tr('승급을 승인했습니다.','Demande approuvée.')
        : tr('신청을 거절했습니다.','Demande refusée.'));
      await Promise.all([loadRequests(),loadMembers(true),loadHistory(),loadWithdrawals(),loadNameRequests(),loadSuggestions(),loadHiddenArchives()]);
      await loadNotifications();
    } catch (error) {
      console.error('ASICC admin review:',error);
      showMessage(tr('처리하지 못했습니다. 신청 상태와 Firebase 규칙을 확인해 주세요.',
        'Opération impossible. Vérifiez la demande et les règles Firebase.'), true);
    } finally { busy = false; }
  }

  const timestamp = (value: any): number => {
    if(value && typeof value.toMillis === 'function') return value.toMillis();
    if(typeof value === 'number') return value;
    if(typeof value === 'string') { const n=Date.parse(value); return Number.isFinite(n)?n:0; }
    return 0;
  };
  const stamp = (value: any): string => {
    const ms=timestamp(value);if(!ms)return '—';
    return formatParisDate(new Date(ms))||'—';
  };
  const gradeLabel = (m:Member):string => {
    const r=upgradeHistory.get(m.id);
    return (m.children ?? r?.children ?? []).map(c=>[c.studentName,c.school,c.grade].filter(Boolean).join(' / ')).join(' · ') || '—';
  };
  const schoolLabel = (m: Member):string => {
    const r=upgradeHistory.get(m.id);
    const schoolNames = (m.children ?? r?.children ?? []).map(c=>c.school).filter(Boolean);
    if(schoolNames.length)return [...new Set(schoolNames)].join(', ');
    return (m.levels||[]).map(l=>({mat:tr('유치원','Maternelle'),elem:tr('초등학교','Élémentaire'),col:tr('중학교','Collège')} as Record<string,string>)[l]||l).join(', ') || '—';
  };
  const memberSchoolMatches=(m:Member,level:string)=>{
    if(level==='all')return true;
    const r=upgradeHistory.get(m.id);
    const values=(m.children ?? r?.children ?? []).map(c=>`${c.school} ${c.grade}`.toLowerCase());
    if((m.levels||[]).includes(level))return true;
    // School/grade fields come from voluntarily submitted promotion requests.
    if(level==='mat')return values.some(v=>/maternelle|^ps |^ms |^gs |école maternelle/.test(v));
    if(level==='elem')return values.some(v=>/élémentaire|elementaire|\bcp\b|\bce1\b|\bce2\b|\bcm1\b|\bcm2\b/.test(v));
    return values.some(v=>/collège|college|\b6e\b|\b5e\b|\b4e\b|\b3e\b/.test(v));
  };
  function filteredMembers():Member[] {
    const term=el<HTMLInputElement>('admin-member-search')?.value.trim().toLocaleLowerCase()||'';
    const role=el<HTMLSelectElement>('admin-filter-role')?.value||'all';
    const status=el<HTMLSelectElement>('admin-filter-status')?.value||'all';
    const school=el<HTMLSelectElement>('admin-filter-school')?.value||'all';
    const from=el<HTMLInputElement>('admin-filter-from')?.value||'';
    const fromMs=from?Date.parse(from+'T00:00:00+01:00'):0;
    const result=members.filter(m=>{
      if(role!=='all'&&m.role!==role)return false;
      if(status==='withdrawal') { if(withdrawals.get(m.id)?.status!=='pending')return false; }
      else if(status!=='all'&&m.status!==status)return false;
      if(!memberSchoolMatches(m,school))return false;
      const t=timestamp(m.createdAt);if(from&&(!t||t<fromMs))return false;
      const req=upgradeHistory.get(m.id);
      const hay=[m.name,m.nickname,m.email,m.phone,schoolLabel(m),gradeLabel(m),m.memberKind??req?.kind,m.memberRelation??req?.relation]
        .filter(Boolean).join(' ').toLocaleLowerCase();
      return !term||hay.includes(term);
    });
    result.sort((a,b)=>{
      const v=(sortColumn==='createdAt') ? timestamp(a[sortColumn])-timestamp(b[sortColumn])
        : String(a[sortColumn]||'').localeCompare(String(b[sortColumn]||''),fr?'fr':'ko');
      return sortAsc?v:-v;
    });
    return result;
  }
  function td(row:HTMLTableRowElement,value:string,cls='') {
    const cell=document.createElement('td');cell.textContent=value;if(cls)cell.className=cls;row.append(cell);return cell;
  }
  function renderMembers(){
    const container=el<HTMLElement>('admin-members');if(!container)return;
    const filtered=filteredMembers(),pages=Math.max(1,Math.ceil(filtered.length/pageSize));
    page=Math.min(page,pages);
    const current=filtered.slice((page-1)*pageSize,page*pageSize);
    const counts=el<HTMLElement>('admin-filter-count');if(counts)counts.textContent=tr(
      `전체 ${members.length}명 중 ${filtered.length}명 검색됨 (한 페이지 ${pageSize}명)`,
      `${filtered.length} sur ${members.length} membres (page de ${pageSize})`);
    const pageLabel=el<HTMLElement>('admin-page-label');if(pageLabel)pageLabel.textContent=`${page} / ${pages}`;
    const prev=el<HTMLButtonElement>('admin-prev'),next=el<HTMLButtonElement>('admin-next');
    if(prev)prev.disabled=page<=1;if(next)next.disabled=page>=pages;
    container.replaceChildren();
    if(!filtered.length){container.append(panel('small muted',tr('조건에 맞는 회원이 없습니다.','Aucun membre ne correspond aux critères.')));return;}
    const table=document.createElement('table');table.className='asicc-admin-table';
    const thead=document.createElement('thead'),head=document.createElement('tr');
    const headings:[string,string | null][]=[
      ['#',null],[tr('실명','Nom'),'name'],[tr('아이디(이메일)','Identifiant (e-mail)'),'email'],
      [tr('닉네임','Pseudo'),null],[tr('쪽지 기능','Messagerie'),null],[tr('연락처','Téléphone'),null],
      [tr('가입 일시 (파리)','Inscrit le (Paris)'),'createdAt'],
      [tr('학교급 / 학교','Niveau / école'),null],
      [tr('학생 / 학년','Élève / classe'),null],[tr('가입 구분','Catégorie'),null],
      [tr('회원 등급','Statut'),null],[tr('계정 상태','État'),null],[tr('저장','Enregistrer'),null],[tr('정보 수정','Modifier'),null]
    ];
    headings.forEach(([label,key])=>{
      const th=document.createElement('th');th.scope='col';
      if(key){const button=document.createElement('button');button.type='button';button.className='admin-head-sort';
        button.style.cssText='border:0;background:transparent;color:inherit;font:inherit;cursor:pointer;text-align:left';
        button.textContent=label+(sortColumn===key?(sortAsc?' ▲':' ▼'):' ↕');
        button.title=tr('정렬','Trier');button.addEventListener('click',()=>{
          if(sortColumn===key)sortAsc=!sortAsc;else {sortColumn=key as typeof sortColumn;sortAsc=key==='name'||key==='email';}
          page=1;renderMembers();
        });th.append(button);
      }else th.textContent=label;
      head.append(th);
    });thead.append(head);table.append(thead);
    const tbody=document.createElement('tbody');
    for(let i=0;i<current.length;i++){
      const m=current[i],row=document.createElement('tr');row.dataset.uid=m.id;
      td(row,String((page-1)*pageSize+i+1));
      td(row,m.name||'—','admin-name');td(row,m.email||'—');td(row,m.nickname||'—');renderMemberMessaging(row,m);td(row,m.phone||'—');
      td(row,stamp(m.createdAt),'admin-small');td(row,schoolLabel(m));
      const students=td(row,gradeLabel(m),'admin-students');students.title=gradeLabel(m);
      const enrollment=upgradeHistory.get(m.id);
      td(row,(m.memberKind ?? enrollment?.kind) ? kindLabel(m.memberKind ?? enrollment!.kind):'—');
      const roleCell=document.createElement('td'),roleSelect=document.createElement('select');
      roleSelect.setAttribute('aria-label',tr(`${m.name} 회원 등급`,`Statut de ${m.name}`));
      for(const r of roleOptions){const opt=document.createElement('option');opt.value=r;opt.textContent=roleLabel(r);roleSelect.append(opt);}
      roleSelect.value=m.role;roleSelect.disabled=m.id===meUid;roleCell.append(roleSelect);row.append(roleCell);
      const statusCell=document.createElement('td'),statusSelect=document.createElement('select');
      statusSelect.setAttribute('aria-label',tr(`${m.name} 계정 상태`,`État du compte de ${m.name}`));
      [['approved',tr('활성','Actif')],['suspended',tr('정지','Suspendu')]].forEach(([key,label])=>{
        const opt=document.createElement('option');opt.value=key;opt.textContent=label;statusSelect.append(opt);
      });
      statusSelect.value=m.status;statusSelect.disabled=m.id===meUid;statusCell.append(statusSelect);
      if(withdrawals.get(m.id)?.status==='pending'){
        const req=withdrawals.get(m.id)!;
        const note=panel('admin-small',tr(`탈퇴 요청일: ${stamp(req.requestedAt)}`,`Départ demandé le : ${stamp(req.requestedAt)}`));
        note.style.color='#b42318';statusCell.append(note);
      }
      if(m.withdrawnAt){
        statusCell.append(panel('admin-small',tr(`탈퇴일: ${stamp(m.withdrawnAt)}`,`Compte clôturé le : ${stamp(m.withdrawnAt)}`)));
      }
      row.append(statusCell);
      const actionCell=document.createElement('td'),save=actionButton(tr('저장','Enregistrer'),()=>void saveMember(m,roleSelect,statusSelect));
      save.className='btn btn-ghost btn-sm admin-row-action';save.disabled=m.id===meUid;
      actionCell.append(save);row.append(actionCell);
      const editCell=document.createElement('td');const edit=actionButton(tr('정보 수정','Modifier'),()=>openMemberEditor(m));
      edit.className='btn btn-ghost btn-sm admin-row-action';edit.disabled=m.id===meUid;
      editCell.append(edit);row.append(editCell);tbody.append(row);
    }
    table.append(tbody);container.append(table);
  }

  const dmRowResults=new Map<string,{text:string;error:boolean}>();
  function renderMemberMessaging(row:HTMLTableRowElement,m:Member){
    const cell=document.createElement('td');cell.className='admin-small admin-dm-cell';row.append(cell);
    const allowed=dmAllowed(m),effective=allowed&&globalDMEnabled;
    const state=panel('admin-small',effective?tr('ON · 이용 가능','ON · Disponible'):allowed?tr('OFF · 전체 설정 꺼짐','OFF · Réglage global'):tr('OFF · 이용 불가','OFF · Indisponible'));
    state.style.color=effective?'#23654b':'#667085';cell.append(state);
    const select=document.createElement('select');select.setAttribute('aria-label',tr(`${m.name} 쪽지 권한`,`Messagerie de ${m.name}`));
    for(const [value,label] of [['auto',tr('자동','Auto')],['on','ON'],['off','OFF']]){const o=document.createElement('option');o.value=value;o.textContent=label;select.append(o);}
    select.value=m.dmMode||'auto';
    const local=panel('admin-dm-result','');local.setAttribute('role','status');local.setAttribute('aria-live','polite');
    const save=actionButton(tr('저장','OK'),()=>void saveMessagingMode(m,select,save,local));save.className='btn btn-ghost admin-dm-save';
    select.disabled=m.status!=='approved'||m.role==='general';save.disabled=select.disabled;const controls=panel('admin-dm-controls','');controls.append(select,save);cell.append(controls,local);if(dmRowResults.has(m.id)){const result=dmRowResults.get(m.id)!;local.textContent=result.text;local.dataset.error=String(result.error);}
  }
  async function saveMessagingMode(member:Member,select:HTMLSelectElement,button:HTMLButtonElement,local:HTMLElement){
    const feedback=(text:string,error=false)=>{dmRowResults.set(member.id,{text,error});local.textContent=text;local.dataset.error=String(error);};
    if(busy||member.status!=='approved'||member.role==='general')return;
    const dmMode=select.value;if(!['auto','on','off'].includes(dmMode))return;
    const originalLabel=button.textContent;busy=true;select.disabled=true;button.disabled=true;button.textContent=tr('저장 중…','Enregistrement…');feedback('');
    try{
      await runTransaction(db,async tx=>{
        const ref=doc(db,'members',member.id),snap=await tx.get(ref);if(!snap.exists())throw Error('member-missing');const fresh=snap.data();
        if(fresh.status!=='approved'||fresh.role==='general'||(fresh.dmMode||'auto')!==(member.dmMode||'auto'))throw Error('profile-changed');
        const update={dmMode,dmUpdatedBy:meUid,dmUpdatedAt:serverTimestamp()};
        tx.update(ref,update);
        if(fresh.nickname&&fresh.nicknameKey===fresh.nickname.toLowerCase())tx.set(doc(db,'publicNames',member.id),{nickname:fresh.nickname,role:fresh.role,canReceiveDM:dmAllowed({...fresh,...update}),updatedAt:serverTimestamp()});
      });
      feedback(tr('저장 완료','Enregistré'));
      try{await loadMembers(true);}catch(e){console.error(e);feedback(tr('저장됨 · 새로고침 필요','Enregistré · actualisez'),true);}
    }catch(e){console.error(e);feedback(tr('저장 실패','Échec'),true);select.value=member.dmMode||'auto';}
    finally{busy=false;select.disabled=false;button.disabled=false;button.textContent=originalLabel;}
  }
  async function loadInitialisation(){
