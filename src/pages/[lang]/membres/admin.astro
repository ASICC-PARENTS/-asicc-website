    const kind=el<HTMLSelectElement>('admin-edit-kind');if(kind)kind.value=member.memberKind??upgradeHistory.get(member.id)?.kind??'';updateAgeDisplay();
    dialog.querySelectorAll<HTMLInputElement>('input[name="admin-level"]').forEach(e=>e.checked=(member.levels||[]).includes(e.value));
    const box=childBox();if(box)box.replaceChildren();
    const students=member.children??upgradeHistory.get(member.id)?.children??[];
    students.slice(0,5).forEach(c=>addChildInput({studentName:c.studentName||'',school:c.school||'',grade:c.grade||''}));
