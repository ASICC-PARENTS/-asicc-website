  function closeMemberEditor(){const dialog=el<HTMLDialogElement>('admin-edit-dialog');if(dialog?.open)dialog.close();editingMember=null;}
  async function saveMemberDetails(event:SubmitEvent){
    event.preventDefault();
    const member=editingMember;
    if(!member||busy||member.id===meUid)return;
    const val=(id:string)=>el<HTMLInputElement>(id)?.value.trim()||'';
    const name=val('admin-edit-name');const nickname=val('admin-edit-nickname').normalize('NFKC');
    const nicknameKey=nickname.toLowerCase();
    const phone=val('admin-edit-phone');const memberRelation=val('admin-edit-relation');
    const memberKind=el<HTMLSelectElement>('admin-edit-kind')?.value||'';
    const accountType=el<HTMLSelectElement>('admin-edit-account-type')?.value||'';
    const levels=[...document.querySelectorAll<HTMLInputElement>('#admin-edit-dialog input[name="admin-level"]')]
      .filter(e=>e.checked).map(e=>e.value);
    const children:Child[]=[];
    childBox()?.querySelectorAll<HTMLElement>('.asicc-admin-child-row').forEach(row=>{
      const field=(key:string)=>row.querySelector<HTMLInputElement>(`input[data-field="${key}"]`)?.value.trim()||'';
      const child={studentName:field('studentName'),school:field('school'),grade:field('grade')};
      if(child.studentName||child.school||child.grade)children.push(child);
    });
    if(!name||name.length>80){editorError(tr('실명을 1~80자로 입력해 주세요.','Le nom doit contenir 1 à 80 caractères.'));return;}
    if(!validNickname(nickname)){editorError(tr('닉네임은 한글·라틴문자·숫자 2~24자이며 운영진 사칭 표현은 사용할 수 없습니다.',
      'Le pseudo doit comporter 2 à 24 caractères valides et ne peut pas imiter l’administration.'));return;}
    if(phone.length>40||memberRelation.length>60||!['','parent','alumnus','alumni-parent','teacher','contributor'].includes(memberKind)){
      editorError(tr('연락처·가입 구분·관계 입력을 확인해 주세요.','Vérifiez téléphone, catégorie et lien.'));return;
    }
    if(children.length>5||children.some(c=>!c.studentName||!c.school||!c.grade||Object.values(c).some(v=>v.length>100))){
      editorError(tr('학생은 최대 5명이며, 입력한 학생의 이름·학교·학년을 모두 기입해 주세요.',
        'Maximum 5 élèves, avec nom, établissement et classe pour chacun.'));return;
    }
    const birthDate=el<HTMLInputElement>('admin-edit-birth')?.value||'';
    const dmMode=el<HTMLSelectElement>('admin-edit-dm-mode')?.value||'auto';
    if((accountType==='student'||birthDate)&&!validBirthDate(birthDate)){editorError(tr('생년월일을 확인해 주세요.','Vérifiez la date de naissance.'));return;}
    if(member.birthDate&&!birthDate){editorError(tr('기존 생년월일을 임의로 삭제할 수 없습니다.','La date existante ne peut pas être effacée.'));return;}
    const adultAt=validBirthDate(birthDate)?Timestamp.fromDate(adulthoodDate(birthDate)):null;
    const desired={name,phone,levels,children,memberKind,memberRelation,accountType,birthDate,adultAt,dmMode};
    const dmChanged=accountType!==(member.accountType||'')||birthDate!==(member.birthDate||'')||(adultAt?.toMillis()||0)!==(member.adultAt?.toMillis()||0)||dmMode!==(member.dmMode||'auto');
    const accessAudit=dmChanged?{dmUpdatedBy:meUid,dmUpdatedAt:serverTimestamp()}:{};
    const old={name:member.name||'',phone:member.phone||'',levels:member.levels||[],
      children:member.children??upgradeHistory.get(member.id)?.children??[],
      memberKind:member.memberKind??upgradeHistory.get(member.id)?.kind??'',
      memberRelation:member.memberRelation??upgradeHistory.get(member.id)?.relation??'',
      accountType:member.accountType||'',birthDate:member.birthDate||'',adultAt:member.adultAt||null,dmMode:member.dmMode||'auto'};
    const nicknameChanged=nicknameKey!==(member.nicknameKey||member.nickname?.toLowerCase()||'');
    if(JSON.stringify(desired)===JSON.stringify(old)&&!nicknameChanged){
      showMessage(tr('변경된 내용이 없습니다.','Aucune modification.'));closeMemberEditor();return;
    }
    if(!confirm(tr(`${member.name}님의 정보를 수정할까요?`,`Enregistrer les modifications de ${member.name} ?`)))return;
    busy=true;const button=el<HTMLButtonElement>('admin-edit-save');if(button)button.disabled=true;
    let saved=false;
    try{
      const memberRef=doc(db,'members',member.id);
      if(nicknameChanged){
        const newNickRef=doc(db,'nicknames',nicknameKey);
        const oldKey=member.nicknameKey||member.nickname?.toLowerCase()||'';
        await runTransaction(db,async tx=>{
          const [fresh,targetNick]=await Promise.all([tx.get(memberRef),tx.get(newNickRef)]);
          if(!fresh.exists())throw Error('member-missing');
          const original=fresh.data();
          if(original.nicknameKey!==member.nicknameKey||original.nickname!==member.nickname)throw Error('profile-changed');
          if(targetNick.exists())throw Error('nickname-taken');
          const update={...desired,...accessAudit,nickname,nicknameKey};
          tx.update(memberRef,update);
          tx.set(newNickRef,{uid:member.id,nickname,createdAt:serverTimestamp()});
          tx.set(doc(db,'publicNames',member.id),{nickname,role:original.role,canReceiveDM:dmAllowed({...original,...desired}),updatedAt:serverTimestamp()});
          if(oldKey&&oldKey!==nicknameKey)tx.delete(doc(db,'nicknames',oldKey));
        });
      }else{
        // Keep public DM eligibility in sync with the administrator's verified account type.
        const batch=writeBatch(db);
        batch.update(memberRef,{...desired,...accessAudit});
        batch.set(doc(db,'publicNames',member.id),{
          nickname:member.nickname,role:member.role,
          canReceiveDM:dmAllowed({...member,...desired}),updatedAt:serverTimestamp()
        });
        await batch.commit();
      }
      saved=true;
      closeMemberEditor();
      showMessage(tr('회원 정보 수정이 완료되었습니다.','Les informations du membre ont été mises à jour.'));
      try{await Promise.all([loadMembers(true),loadHistory()]);}catch(refreshError){
        console.error('ASICC profile refresh after save:',refreshError);
        showMessage(tr('회원 정보는 저장됐지만 목록 새로고침에 실패했습니다. 새로고침 버튼을 눌러 주세요.',
          'Informations enregistrées, mais actualisation impossible. Actualisez la liste.'),true);
      }
    }catch(error){
      console.error('ASICC profile editing:',error);
      if(!saved){
        editorError(tr('정보를 저장하지 못했습니다. 닉네임 중복 또는 Firebase 보안 규칙을 확인해 주세요.',
          'Enregistrement impossible. Vérifiez l’unicité du pseudo et les règles Firebase.'));
        showMessage(tr('회원 정보 수정에 실패했습니다. 저장되지 않았습니다.',
          'Échec de la modification : aucune modification enregistrée.'),true);
      }
    }finally{busy=false;if(button)button.disabled=false;}
  }

  async function saveMember(member: Member, roleSelect:HTMLSelectElement,statusSelect:HTMLSelectElement){
    if(busy||member.id===meUid)return;
    const role=roleSelect.value,status=statusSelect.value;
    if(!roleOptions.includes(role)||!['approved','suspended'].includes(status))return;
    if(role===member.role&&status===member.status){showMessage(tr('변경된 내용이 없습니다.','Aucune modification.'));return;}
    const question=role==='admin'&&member.role!=='admin'
      ? tr(`주의: ${member.name}님에게 관리자 권한을 부여합니다. 계속할까요?`,
           `Attention : donner tous les droits administrateur à ${member.name} ?`)
      : tr(`${member.name}님의 회원 등급과 계정 상태를 저장할까요?`,
           `Enregistrer le statut et l’état du compte de ${member.name} ?`);
    if(!confirm(question)){roleSelect.value=member.role;statusSelect.value=member.status;return;}
    busy=true;roleSelect.disabled=true;statusSelect.disabled=true;
    let saved=false;
    try{
      const memberBatch=writeBatch(db);
      memberBatch.update(doc(db,'members',member.id),{role,status});
      if(member.nickname)memberBatch.set(doc(db,'publicNames',member.id),{nickname:member.nickname,role,canReceiveDM:dmAllowed({...member,role,status}),updatedAt:serverTimestamp()});
      await memberBatch.commit();
      saved=true;
      showMessage(tr('회원 등급 및 계정 상태 수정이 완료되었습니다.','Le statut et l’état du compte ont été mis à jour.'));
      try{await loadMembers(true);}catch(refreshError){
        console.error('ASICC members refresh after save:',refreshError);
        showMessage(tr('저장은 완료됐지만 목록 새로고침에 실패했습니다. 새로고침 버튼을 눌러 주세요.',
          'Modifications enregistrées, mais actualisation impossible. Actualisez la liste.'),true);
      }
    }catch(error){
      console.error('ASICC member update:',error);
      if(!saved){
        showMessage(tr('회원 정보를 저장하지 못했습니다. Firebase 규칙을 확인하세요.',
          'Échec de l’enregistrement. Vérifiez les règles Firebase.'),true);
        roleSelect.value=member.role;statusSelect.value=member.status;
      }
    }finally{busy=false;roleSelect.disabled=member.id===meUid;statusSelect.disabled=member.id===meUid;}
  }

  async function loadMembers(_reset=false){
    // Load all members before client-side filters; otherwise matching records on later pages are invisible.
    const [snap,setting]=await Promise.all([getDocs(collection(db,'members')),getDoc(doc(db,'siteSettings','messaging'))]);
    globalDMEnabled=setting.data()?.enabled===true;
    members=snap.docs.map(s=>({id:s.id,...s.data()} as Member));
    text('admin-member-count',String(members.length));
    renderMembers();
    void loadInitialisation();
  }
  async function loadHistory(){
    const snap=await getDocs(collection(db,'upgradeRequests'));
    upgradeHistory.clear();snap.docs.forEach(d=>upgradeHistory.set(d.id,d.data() as Upgrade));
    renderMembers();
  }
  async function loadWithdrawals(){
