    const ageLabel=el<HTMLElement>('admin-edit-age');if(ageLabel)ageLabel.textContent=age===null?tr('생년월일 미확인','Âge non confirmé'):tr(`만 ${age}세 · ${age>=18?'성인':'미성년자'}`,`${age} ans · ${age>=18?'majeur':'mineur'}`);
    const accountType=el<HTMLSelectElement>('admin-edit-account-type')?.value||'';
    const dmMode=el<HTMLSelectElement>('admin-edit-dm-mode')?.value||'auto';
    const allowed=dmAllowed({status:editingMember?.status,role:editingMember?.role,accountType,birthDate,dmMode,memberKind:el<HTMLSelectElement>('admin-edit-kind')?.value,memberRelation:el<HTMLInputElement>('admin-edit-relation')?.value});
    const state=el<HTMLElement>('admin-edit-dm-state');if(state)state.textContent=allowed?tr('쪽지 이용 가능 (등급 제한 및 전체 설정 적용)','Messagerie autorisée selon le rôle et le réglage global'):tr('쪽지 이용 불가','Messagerie désactivée');
  }
  el<HTMLInputElement>('admin-edit-birth')?.addEventListener('change',updateAgeDisplay);
  for(const id of ['admin-edit-account-type','admin-edit-dm-mode','admin-edit-kind','admin-edit-relation'])el<HTMLElement>(id)?.addEventListener('change',updateAgeDisplay);
  const childBox=()=>el<HTMLElement>('admin-edit-children');
  function addChildInput(child:Child={studentName:'',school:'',grade:''}){
    const box=childBox();if(!box||box.children.length>=5)return;
    const row=document.createElement('div');row.className='asicc-admin-child-row';
    ([[tr('학생 실명','Nom de l’élève'),'studentName',child.studentName],
      [tr('학교','École'), 'school',child.school],
      [tr('학년','Classe'),'grade',child.grade]] as [string,string,string][]).forEach(([placeholder,key,value])=>{
      const input=document.createElement('input');input.type='text';input.maxLength=100;
      input.placeholder=placeholder;input.setAttribute('aria-label',placeholder);input.dataset.field=key;input.value=value;
      row.append(input);
    });
    const remove=actionButton(tr('삭제','Retirer'),()=>row.remove());remove.className='btn btn-ghost btn-sm';
