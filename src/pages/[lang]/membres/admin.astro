---
import Base from '../../../layouts/Base.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const live = import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === "true";
---
<Base lang={lang} rest="membres/admin/" title={L(lang, { ko: 'ASICC 운영진 관리', fr: 'Administration ASICC' })} noindex>
  <section class="wrap m-shell">
    <div id="asicc-admin" class="stack gap-24"
      data-lang={lang}
      data-login-url={href(lang, 'membres/login/')}
      data-member-url={href(lang, 'membres/')}>
      <div class="stack gap-12">
        <span class="m-badge" style="align-self:flex-start">{L(lang, { ko: '운영진 전용', fr: 'Accès administrateur' })}</span>
        <h1 class="h2">{L(lang, { ko: 'ASICC 회원관리', fr: 'Gestion des membres ASICC' })}</h1>
        <p class="muted">{L(lang, {
          ko: '회원 가입·승급 심사, 실명 변경 신청, 비공개 건의, 계정 이용 제한을 관리합니다.',
          fr: 'Examinez les statuts, corrections de nom, suggestions confidentielles et accès des membres.'
        })}</p>
      </div>

      {!live && <div class="card auth-card" role="status">{L(lang,{ko:"관리자 기능은 Firebase 권한 검증 전까지 비활성화됩니다.",fr:"L’administration reste désactivée jusqu’à la validation des règles Firebase."})}</div>}
      <div hidden={!live} id="admin-loading" class="card auth-card" role="status">
        {L(lang, { ko: '운영진 권한을 확인하고 있습니다…', fr: 'Vérification des droits administrateur…' })}
      </div>
      <div id="admin-denied" class="card auth-card stack gap-12" hidden>
        <p id="admin-denied-message" role="alert"></p>
        <a class="btn btn-dark" href={href(lang, 'membres/')}>{L(lang, { ko: '회원공간으로', fr: 'Retour à l’espace membres' })}</a>
      </div>

      <div id="admin-content" class="stack gap-24" hidden>
        <div class="card auth-card stack gap-12">
          <div class="row gap-16" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <div class="stack gap-8">
              <strong id="admin-who"></strong>
              <span class="small muted">{L(lang, { ko: '운영진 인증 완료', fr: 'Accès administrateur confirmé' })}</span>
            </div>
            <div class="row gap-12" style="flex-wrap:wrap">
              <a class="btn btn-ghost" href={href(lang, 'membres/')}>{L(lang, { ko: '회원공간', fr: 'Espace membres' })}</a>
              <button type="button" class="btn btn-ghost" id="admin-refresh">{L(lang, { ko: '새로고침', fr: 'Actualiser' })}</button>
            </div>
          </div>
        </div>

        <p id="admin-action-message" class="small" role="status" aria-live="polite" hidden></p>

        <section class="card auth-card stack gap-16" aria-labelledby="requests-heading">
          <div class="row gap-16" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <h2 id="requests-heading" class="h3">{L(lang, { ko: '승급 승인 대기', fr: 'Demandes à examiner' })}</h2>
            <span id="admin-pending-count" class="m-badge"></span>
          </div>
          <p class="small muted">{L(lang, {
            ko: '승인 시 신청 결과와 회원 등급을 하나의 트랜잭션으로 저장합니다.',
            fr: 'Chaque approbation met à jour la demande et le statut dans une seule transaction.'
          })}</p>
          <div id="admin-requests" class="stack gap-12"></div>
        </section>

        <section class="card auth-card stack gap-16" aria-labelledby="members-heading">
          <div class="row gap-16" style="justify-content:space-between;align-items:center;flex-wrap:wrap">
            <h2 id="members-heading" class="h3">{L(lang, { ko: '회원 등급 및 계정 관리', fr: 'Comptes et statuts des membres' })}</h2>
            <span id="admin-member-count" class="m-badge"></span>
          </div>
          <p class="small muted">{L(lang, {
            ko: '정식 협회회원과 특별회원은 동일한 접근권한을 갖습니다. 다른 운영진을 지정할 때는 신중하게 확인하세요.',
            fr: 'Membres et membres spéciaux ont le même accès. Vérifiez soigneusement toute nomination d’administrateur.'
          })}</p>
          <input id="admin-member-search" type="search"
            placeholder={L(lang, { ko: '실명·닉네임·이메일·학생·학교·학년 검색', fr: 'Nom, pseudo, e-mail, élève, école, classe' })}
            aria-label={L(lang, { ko: '회원 검색', fr: 'Rechercher un membre' })}/>
          <div id="admin-members" class="stack gap-12"></div>
          <button id="admin-more" class="btn btn-ghost" type="button" hidden>
            {L(lang, { ko: '회원 더 불러오기', fr: 'Charger plus de membres' })}
          </button>
        </section>

        <section class="card stack gap-16" style="padding:22px" aria-labelledby="name-requests-heading">
          <h2 id="name-requests-heading" class="h3">{L(lang,{ko:'실명 변경 신청',fr:'Demandes de correction du nom'})}</h2>
          <div id="admin-name-requests" class="stack gap-12"></div>
        </section>
        <section class="card stack gap-16" style="padding:22px" aria-labelledby="suggestions-heading">
          <h2 id="suggestions-heading" class="h3">{L(lang,{ko:'협회 비공개 건의함',fr:'Boîte de suggestions privées'})}</h2>
          <div id="admin-suggestions" class="stack gap-12"></div>
        </section>
        <section class="card stack gap-12" style="padding:22px" aria-labelledby="hidden-heading">
          <h2 id="hidden-heading" class="h3">{L(lang,{ko:'숨김 글·댓글 관리 / 복구',fr:'Contenus masqués / restauration'})}</h2>
          <p class="small muted">{L(lang,{ko:'숨긴 원문은 운영진만 확인하고 복구할 수 있습니다. 기존 방식으로 숨겨 이미 덮어쓴 글은 복구되지 않습니다.',fr:'Les archives privées permettent la restauration. Les anciens textes déjà écrasés avant cette mise à jour ne sont pas récupérables.'})}</p>
          <div id="admin-hidden-list" class="stack gap-12"></div>
        </section>
        <section class="card stack gap-12" style="padding:22px" aria-labelledby="anonymize-heading">
          <h2 id="anonymize-heading" class="h3">{L(lang,{ko:'기존 게시글 실명 비공개 처리',fr:'Anonymiser les anciennes signatures'})}</h2>
          <p class="small muted">{L(lang,{ko:'예전 글·댓글의 authorName 필드에 남아 있는 실명을 ‘기존회원’으로 변경합니다. 게시글 본문은 수정하지 않습니다. 한번에 최대 100개 게시글을 점검합니다.',fr:'Remplace les anciens noms réels par « ancien membre » dans les métadonnées, sans modifier le contenu. Vérifie jusqu’à 100 messages à la fois.'})}</p>
          <button class="btn btn-ghost" type="button" id="admin-redact-legacy">{L(lang,{ko:'기존 작성자 실명 비공개 처리 실행',fr:'Anonymiser les anciens noms'})}</button>
        </section>
        <section class="card stack gap-12" style="padding:22px" aria-labelledby="deletions-heading">
          <h2 id="deletions-heading" class="h3">{L(lang,{ko:'게시판 삭제 이력',fr:'Historique de suppression'})}</h2>
          <p class="small muted">{L(lang,{ko:'삭제된 본문은 보관하지 않고 처리자·사유·시각만 조회합니다.',fr:'Les textes supprimés ne sont pas conservés ; seul le journal minimal est affiché.'})}</p>
          <div id="admin-deletion-logs" class="stack gap-8"></div>
        </section>
        <div class="card auth-card stack gap-8">
          <h2 class="h3">{L(lang, { ko: '콘텐츠 관리 안내', fr: 'Gestion du contenu' })}</h2>
          <p class="small muted">{L(lang, {
            ko: '공지·입학안내 등 공개 홈페이지 편집은 기존 CMS에서 계속합니다. 학습자료·갤러리·협회사무실의 파일 관리자 화면은 이후 연결합니다.',
            fr: 'Les pages publiques restent gérées dans le CMS existant. La gestion des fichiers privés sera ajoutée séparément.'
          })}</p>
          <a class="btn btn-ghost" href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer">{L(lang,{ko:'홈페이지 CMS 열기',fr:'Ouvrir le CMS du site'})}</a>
          <p class="small muted">{L(lang, {
            ko: '주의: 화면을 숨기는 것만으로 자료가 보호되지 않습니다. Firestore·Storage 서버 보안 규칙이 반드시 적용되어야 합니다.',
            fr: 'Attention : masquer une page ne protège pas les données. Les règles de sécurité serveur restent indispensables.'
          })}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .asicc-admin-record { border: 1px solid #dce0e7; border-radius: 12px; padding:16px; }
  .asicc-admin-fields { display:grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,175px),1fr)); gap:12px; align-items:end; }
  .asicc-admin-actions { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:10px; }
  .asicc-admin-muted { font-size:.88rem; color:var(--muted,#64748b); overflow-wrap:anywhere; }
</style>

<script>
  import { getApps, initializeApp } from 'firebase/app';
  import { getAuth, onAuthStateChanged, getIdToken } from 'firebase/auth';
  import {
    getFirestore, doc, getDoc, getDocs, query, collection, where,
    limit, startAfter, updateDoc, runTransaction, serverTimestamp, writeBatch,
    type DocumentData, type QueryDocumentSnapshot
  } from 'firebase/firestore';
  import { firebaseConfig } from '../../../firebase-config';

  type Member = { id: string; name: string; nickname?:string; email: string; role: string; status: string };
  type Upgrade = { uid: string; applicantName: string; applicantEmail: string;
    requestedRole: 'member' | 'special'; kind: string; schoolYear?: number | null;
    note?: string; relation?:string; children?:Array<{studentName:string;school:string;grade:string}>; status: string; };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const root = el<HTMLElement>('asicc-admin');
  const fr = root?.dataset.lang === 'fr';
  const tr = (ko: string, french: string) => fr ? french : ko;
  const app = getApps().find(a => a.name === 'asicc-website')
    ?? initializeApp(firebaseConfig, 'asicc-website');
  const auth = getAuth(app);
  const db = getFirestore(app);
  let meUid = '';
  let members: Member[] = [];
  const upgradeHistory=new Map<string,Upgrade>();
  let lastMember: QueryDocumentSnapshot<DocumentData> | null = null;
  let busy = false;

  const text = (id: string, value: string) => { const node = el<HTMLElement>(id); if (node) node.textContent = value; };
  const showMessage = (message: string, error = false) => {
    const node = el<HTMLElement>('admin-action-message'); if (!node) return;
    node.hidden = false; node.textContent = message;
    node.style.color = error ? '#b42318' : '#067647';
  };
  const deny = (message: string) => {
    const loading = el<HTMLElement>('admin-loading'); if (loading) loading.hidden = true;
    const denied = el<HTMLElement>('admin-denied'); if (denied) denied.hidden = false;
    text('admin-denied-message', message);
    const content = el<HTMLElement>('admin-content'); if (content) content.hidden = true;
  };
  const panel = (className: string, content: string) => {
    const node = document.createElement('div'); node.className = className;
    node.textContent = content; return node;
  };
  const actionButton = (label: string, handler: () => void): HTMLButtonElement => {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'btn btn-ghost';
    b.textContent = label; b.addEventListener('click', handler); return b;
  };
  const roleLabel = (role: string) => ({
    general: tr('일반회원', 'Membre général'),
    member: tr('협회회원', 'Membre de l’association'),
    special: tr('특별회원', 'Membre spécial'),
    admin: tr('운영진', 'Administrateur')
  } as Record<string,string>)[role] || role;
  const kindLabel = (kind: string) => ({
    parent: tr('학부모','Parent'), alumnus: tr('졸업생','Ancien élève'),
    'alumni-parent': tr('졸업생 학부모','Parent d’ancien élève'),
    teacher:tr('교사·기여자','Enseignant'),contributor:tr('특별기여자','Contributeur')
  } as Record<string,string>)[kind] || kind;
  const roleOptions = ['general','member','special','admin'];

  async function loadRequests() {
    const container = el<HTMLElement>('admin-requests'); if (!container) return;
    container.replaceChildren(panel('small muted', tr('불러오는 중…','Chargement…')));
    const snaps = await getDocs(query(collection(db,'upgradeRequests'), where('status','==','pending')));
    const requests = snaps.docs.map(s => s.data() as Upgrade);
    requests.forEach(req=>upgradeHistory.set(req.uid,req));
    text('admin-pending-count', String(requests.length));
    container.replaceChildren();
    if (!requests.length) {
      container.append(panel('small muted',tr('대기 중인 신청이 없습니다.','Aucune demande en attente.')));
      return;
    }
    for (const item of requests) {
      const card = document.createElement('article'); card.className = 'asicc-admin-record stack gap-8';
      const name = panel('',item.applicantName || tr('이름 없음','Sans nom'));
      name.style.fontWeight = '700'; card.append(name);
      card.append(panel('asicc-admin-muted', item.applicantEmail || ''));
      card.append(panel('small', tr('신청 등급: ','Statut demandé : ') + roleLabel(item.requestedRole)
        + ' · ' + kindLabel(item.kind) + (item.schoolYear ? ` · ${item.schoolYear}` : '')));
      if(item.relation)card.append(panel('small',tr('관계: ','Lien : ')+item.relation));
      if(item.children?.length)item.children.forEach(child=>card.append(panel('small',`${child.studentName||''} · ${child.school||''} · ${child.grade||''}`)));
      if (item.note) card.append(panel('asicc-admin-muted',item.note));
      const buttons = document.createElement('div'); buttons.className = 'asicc-admin-actions';
      buttons.append(
        actionButton(tr('승인','Approuver'),()=>void review(item,true)),
        actionButton(tr('거절','Refuser'),()=>void review(item,false))
      );
      card.append(buttons); container.append(card);
    }
  }

  async function review(item: Upgrade, approve: boolean) {
    if (busy) return;
    if (!['member','special'].includes(item.requestedRole)) return;
    const question = approve
      ? tr(`${item.applicantName}님의 ${roleLabel(item.requestedRole)} 승급을 승인할까요?`,
           `Approuver le statut ${roleLabel(item.requestedRole)} pour ${item.applicantName} ?`)
      : tr(`${item.applicantName}님의 신청을 거절할까요?`, `Refuser la demande de ${item.applicantName} ?`);
    if (!window.confirm(question)) return;
    busy = true;
    try {
      const requestRef = doc(db,'upgradeRequests',item.uid);
      const memberRef = doc(db,'members',item.uid);
      await runTransaction(db, async tx => {
        const requestSnap = await tx.get(requestRef);
        if (!requestSnap.exists() || requestSnap.data().status !== 'pending') throw Error('request-changed');
        const freshRole = requestSnap.data().requestedRole;
        if (!['member','special'].includes(freshRole)) throw Error('role-invalid');
        if (approve) {
          const memberSnap = await tx.get(memberRef);
          if (!memberSnap.exists() || memberSnap.data().role !== 'general'
              || memberSnap.data().status !== 'approved') throw Error('profile-changed');
          tx.update(memberRef, { role: freshRole });
        }
        tx.update(requestRef, {
          status: approve ? 'approved' : 'rejected',
          reviewedBy: meUid, reviewedAt: serverTimestamp()
        });
      });
      showMessage(approve ? tr('승급을 승인했습니다.','Demande approuvée.')
        : tr('신청을 거절했습니다.','Demande refusée.'));
      await Promise.all([loadRequests(),loadMembers(true),loadHistory(),loadNameRequests(),loadSuggestions(),loadDeletionLogs(),loadHiddenArchives()]);
    } catch (error) {
      console.error('ASICC admin review:',error);
      showMessage(tr('처리하지 못했습니다. 신청 상태와 Firebase 규칙을 확인해 주세요.',
        'Opération impossible. Vérifiez la demande et les règles Firebase.'), true);
    } finally { busy = false; }
  }

  function renderMembers() {
    const container = el<HTMLElement>('admin-members'); if (!container) return;
    const term = el<HTMLInputElement>('admin-member-search')?.value.trim().toLowerCase() || '';
    const filtered = members.filter(m => {
      const req=upgradeHistory.get(m.id);
      const childText=(req?.children||[]).map(c=>`${c.studentName} ${c.school} ${c.grade}`).join(' ');
      return `${m.name} ${m.nickname||''} ${m.email} ${req?.kind||''} ${childText}`.toLowerCase().includes(term);
    });
    container.replaceChildren();
    if (!filtered.length) { container.append(panel('small muted', tr('일치하는 회원이 없습니다.','Aucun membre trouvé.'))); return; }
    for (const member of filtered) {
      const card = document.createElement('article'); card.className = 'asicc-admin-record stack gap-8';
      const heading = panel('', member.name || tr('이름 없음','Sans nom'));
      heading.style.fontWeight = '700'; card.append(heading);
      card.append(panel('asicc-admin-muted', `${member.nickname||tr('닉네임 미설정','Sans pseudo')} · ${member.email||''}`));
      const enrollment=upgradeHistory.get(member.id);
      if(enrollment){
        card.append(panel('small',tr('회원 구분: ','Catégorie : ')+kindLabel(enrollment.kind)+(enrollment.relation?` · ${enrollment.relation}`:'')));
        enrollment.children?.forEach(child=>card.append(panel('small',`${child.studentName||''} · ${child.school||''} · ${child.grade||''}`)));
      }
      const fields = document.createElement('div'); fields.className='asicc-admin-fields';
      const roleWrap = document.createElement('label'); roleWrap.className='stack gap-8';
      roleWrap.append(panel('small',tr('회원 등급','Statut')));
      const roleSelect = document.createElement('select');
      for (const role of roleOptions) {
        const option = document.createElement('option'); option.value=role; option.textContent=roleLabel(role);
        roleSelect.append(option);
      }
      roleSelect.value=member.role; roleSelect.disabled=member.id===meUid; roleWrap.append(roleSelect);
      const statusWrap = document.createElement('label'); statusWrap.className='stack gap-8';
      statusWrap.append(panel('small',tr('계정 상태','État du compte')));
      const statusSelect = document.createElement('select');
      for (const [key,label] of [
        ['approved',tr('활성','Actif')], ['suspended',tr('정지','Suspendu')]
      ]) { const opt=document.createElement('option');opt.value=key;opt.textContent=label;statusSelect.append(opt); }
      statusSelect.value=member.status; statusSelect.disabled=member.id===meUid; statusWrap.append(statusSelect);
      fields.append(roleWrap,statusWrap); card.append(fields);
      const actions = document.createElement('div'); actions.className='asicc-admin-actions';
      const save = actionButton(tr('변경 저장','Enregistrer'), () => void saveMember(member,roleSelect,statusSelect));
      save.disabled=member.id===meUid; actions.append(save); card.append(actions); container.append(card);
    }
  }

  async function saveMember(member: Member, roleSelect: HTMLSelectElement, statusSelect: HTMLSelectElement) {
    if (busy || member.id===meUid) return;
    const role=roleSelect.value, status=statusSelect.value;
    if (!roleOptions.includes(role) || !['approved','suspended'].includes(status)) return;
    if (role === member.role && status === member.status) return;
    const message = role==='admin' && member.role!=='admin'
      ? tr(`주의: ${member.name}님에게 전체 관리자 권한을 부여합니다. 정말 진행할까요?`,
           `Attention : vous accordez tous les droits d’administrateur à ${member.name}. Confirmer ?`)
      : tr(`${member.name}님의 회원 등급/상태를 변경할까요?`,
           `Modifier le statut/compte de ${member.name} ?`);
    if (!window.confirm(message)) return;
    busy=true;
    try {
      await updateDoc(doc(db,'members',member.id), {role,status});
      showMessage(tr('회원 정보를 변경했습니다.','Profil modifié.'));
      await loadMembers(true);
    } catch(error) {
      console.error('ASICC member update:',error);
      showMessage(tr('변경하지 못했습니다. Firebase 보안 규칙을 확인해 주세요.',
        'Modification impossible. Vérifiez les règles Firebase.'), true);
    } finally {busy=false;}
  }

  async function loadMembers(reset=false) {
    const container=el<HTMLElement>('admin-members'); if (!container) return;
    if (reset) {members=[];lastMember=null;}
    const batch=query(collection(db,'members'),
      ...(lastMember ? [startAfter(lastMember)] : []), limit(100));
    const snap=await getDocs(batch);
    lastMember=snap.docs.length ? snap.docs[snap.docs.length-1] : null;
    members.push(...snap.docs.map(s=>({id:s.id,...s.data()} as Member)));
    members.sort((a,b)=>(a.name||'').localeCompare(b.name||''));
    text('admin-member-count',String(members.length));
    const more=el<HTMLButtonElement>('admin-more'); if(more) more.hidden=snap.docs.length<100;
    renderMembers();
  }

  async function loadHistory(){
    const snap=await getDocs(collection(db,'upgradeRequests'));
    upgradeHistory.clear();snap.docs.forEach(d=>upgradeHistory.set(d.id,d.data() as Upgrade));
    renderMembers();
  }
  async function loadNameRequests(){
    const target=el<HTMLElement>('admin-name-requests');if(!target)return;
    const snap=await getDocs(query(collection(db,'nameChangeRequests'),where('status','==','pending')));
    target.replaceChildren();
    if(snap.empty){target.textContent=tr('대기 중인 신청이 없습니다.','Aucune demande en attente.');return;}
    snap.docs.forEach(d=>{
      const r=d.data();const box=document.createElement('article');box.className='asicc-admin-record stack gap-8';
      box.append(panel('small',`${r.currentName||''} → ${r.requestedName||''}`));
      box.append(actionButton(tr('실명 변경 승인','Approuver'),()=>void reviewName(d.id,true)));
      box.append(actionButton(tr('거절','Refuser'),()=>void reviewName(d.id,false)));
      target.append(box);
    });
  }
  async function reviewName(uid:string,approve:boolean){
    if(busy||!confirm(approve?tr('실명 변경을 승인할까요?','Approuver la correction ?'):tr('신청을 거절할까요?','Refuser ?')))return;
    busy=true;
    try{
      const reqRef=doc(db,'nameChangeRequests',uid),memRef=doc(db,'members',uid);
      await runTransaction(db,async tx=>{
        const req=await tx.get(reqRef);if(!req.exists()||req.data().status!=='pending')throw Error('already handled');
        if(approve){const member=await tx.get(memRef);if(!member.exists())throw Error('member missing');tx.update(memRef,{name:req.data().requestedName});}
        tx.update(reqRef,{status:approve?'approved':'rejected',reviewedBy:meUid,reviewedAt:serverTimestamp()});
      });
      showMessage(approve?tr('실명을 변경했습니다.','Nom corrigé.'):tr('신청을 거절했습니다.','Demande refusée.'));
      await Promise.all([loadNameRequests(),loadMembers(true)]);
    }catch(e){console.error(e);showMessage(tr('실명 변경을 처리하지 못했습니다.','Impossible de traiter la demande.'),true);}
    finally{busy=false;}
  }
  async function loadSuggestions(){
    const target=el<HTMLElement>('admin-suggestions');if(!target)return;
    const snap=await getDocs(query(collection(db,'suggestions'),limit(100)));
    target.replaceChildren();
    if(snap.empty){target.textContent=tr('접수된 건의가 없습니다.','Aucune suggestion.');return;}
    snap.docs.forEach(d=>{
      const r=d.data();const box=document.createElement('article');box.className='asicc-admin-record stack gap-8';
      box.append(panel('',String(r.subject||'')));box.append(panel('small muted',`${r.category||''} · ${r.status||''}`));
      box.append(panel('',String(r.body||'')));
      if(r.response)box.append(panel('small',tr('답변: ','Réponse : ')+String(r.response)));
      box.append(actionButton(tr('답변·상태 변경','Répondre / changer de statut'),()=>void replySuggestion(d.id,String(r.response||''))));
      target.append(box);
    });
  }
  async function replySuggestion(id:string,previous:string){
    if(busy)return;
    const response=prompt(tr('운영진 답변 (최대 3000자)','Réponse (3000 caractères maximum)'),previous);
    if(response===null)return;if(response.length>3000){showMessage(tr('답변이 너무 깁니다.','Réponse trop longue.'),true);return;}
    busy=true;
    try{
      await updateDoc(doc(db,'suggestions',id),{response,status:'answered',respondedBy:meUid,respondedAt:serverTimestamp()});
      showMessage(tr('답변이 저장되었습니다.','Réponse enregistrée.'));await loadSuggestions();
    }catch(e){console.error(e);showMessage(tr('답변을 저장하지 못했습니다.','Impossible d’enregistrer la réponse.'),true);}
    finally{busy=false;}
  }
  async function loadHiddenArchives(){
    const target=el<HTMLElement>('admin-hidden-list');if(!target)return;
    const [posts,comments]=await Promise.all([
      getDocs(query(collection(db,'hiddenPosts'),limit(100))),
      getDocs(query(collection(db,'hiddenComments'),limit(100)))
    ]);
    target.replaceChildren();
    if(posts.empty&&comments.empty){target.textContent=tr('숨겨진 자료가 없습니다.','Aucun contenu masqué.');return;}
    posts.docs.forEach(d=>{
      const v=d.data(),box=document.createElement('article');box.className='asicc-admin-record stack gap-8';
      box.append(panel('',tr('숨김 게시글: ','Message masqué : ')+String(v.title||'')));
      const detail=document.createElement('details');const summary=document.createElement('summary');summary.textContent=tr('원문 보기','Voir le texte');
      const body=panel('',String(v.body||''));body.style.whiteSpace='pre-wrap';detail.append(summary,body);box.append(detail);
      box.append(actionButton(tr('숨김 해제·원문 복구','Restaurer le message'),()=>void restorePost(d.id,String(v.title),String(v.body))));
      target.append(box);
    });
    comments.docs.forEach(d=>{
      const v=d.data(),box=document.createElement('article');box.className='asicc-admin-record stack gap-8';
      box.append(panel('',tr('숨김 댓글','Commentaire masqué')));
      const detail=document.createElement('details'),summary=document.createElement('summary');summary.textContent=tr('원문 보기','Voir le texte');
      detail.append(summary,panel('',String(v.body||'')));box.append(detail);
      box.append(actionButton(tr('숨김 해제·원문 복구','Restaurer le commentaire'),()=>void restoreComment(d.id,String(v.postId),String(v.commentId),String(v.body))));
      target.append(box);
    });
  }
  async function restorePost(postId:string,title:string,body:string){
    if(busy||!confirm(tr('게시글을 다시 공개할까요?','Rendre ce message visible ?')))return;
    busy=true;
    try{
      const batch=writeBatch(db);
      batch.update(doc(db,'boardPosts',postId),{title,body,deleted:false,updatedAt:serverTimestamp()});
      batch.delete(doc(db,'hiddenPosts',postId));await batch.commit();
      showMessage(tr('게시글을 복구했습니다.','Message restauré.'));await loadHiddenArchives();
    }catch(e){console.error(e);showMessage(tr('복구하지 못했습니다.','Échec de la restauration.'),true);}
    finally{busy=false;}
  }
  async function restoreComment(archiveId:string,postId:string,commentId:string,body:string){
    if(busy||!confirm(tr('댓글을 다시 공개할까요?','Rendre ce commentaire visible ?')))return;
    busy=true;
    try{
      const batch=writeBatch(db);
      batch.update(doc(db,'boardPosts',postId,'comments',commentId),{body,deleted:false,updatedAt:serverTimestamp()});
      batch.delete(doc(db,'hiddenComments',archiveId));await batch.commit();
      showMessage(tr('댓글을 복구했습니다.','Commentaire restauré.'));await loadHiddenArchives();
    }catch(e){console.error(e);showMessage(tr('복구하지 못했습니다.','Échec de la restauration.'),true);}
    finally{busy=false;}
  }
  async function redactHistoricalNames(){
    if(busy||!confirm(tr('게시글·댓글에 남은 기존 실명 표시를 제거할까요? 본문은 수정하지 않습니다.','Anonymiser les anciennes signatures sans modifier les textes ?')))return;
    busy=true;
    try{
      let count=0;
      const posts=await getDocs(query(collection(db,'boardPosts'),limit(100)));
      for(const post of posts.docs){
        if(post.data().authorName!=='기존회원'){
          await updateDoc(post.ref,{authorName:'기존회원',updatedAt:serverTimestamp()});count++;
        }
        const comments=await getDocs(query(collection(db,'boardPosts',post.id,'comments'),limit(100)));
        for(const c of comments.docs){
          if(c.data().authorName!=='기존회원'){
            await updateDoc(c.ref,{authorName:'기존회원',updatedAt:serverTimestamp()});count++;
          }
        }
      }
      showMessage(tr(`${count}건의 작성자 표시를 비공개 처리했습니다. 100개 이상의 글이 있으면 추가 점검이 필요합니다.`,
        `${count} signatures anonymisées. Une vérification supplémentaire est nécessaire au-delà de 100 messages.`));
    }catch(e){console.error(e);showMessage(tr('일부 처리에 실패했습니다. 목록을 확인해 주세요.','Anonymisation partiellement impossible.'),true);}
    finally{busy=false;}
  }
  async function loadDeletionLogs(){
    const target=el<HTMLElement>('admin-deletion-logs');if(!target)return;
    const snap=await getDocs(query(collection(db,'boardDeletionLogs'),limit(100)));
    target.replaceChildren();if(snap.empty){target.textContent=tr('삭제 기록이 없습니다.','Aucune suppression.');return;}
    snap.docs.forEach(d=>{
      const r=d.data();target.append(panel('small',`${r.targetType||''} · ${r.reason||''} · ${r.actorUid||''} · ${r.deletedAt?.toDate?.().toLocaleDateString(fr?'fr-FR':'ko-KR')||''}`));
    });
  }
  if (import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === "true") onAuthStateChanged(auth, async user => {
    if(!user) {window.location.replace(root?.dataset.loginUrl || '/');return;}
    try {
      await user.reload(); await getIdToken(user,true);
      if(!user.emailVerified) {deny(tr('이메일 인증 후 로그인해 주세요.','Vérifiez votre e-mail avant de vous connecter.'));return;}
      const me=await getDoc(doc(db,'members',user.uid));
      if(!me.exists() || me.data().status!=='approved' || me.data().role!=='admin') {
        deny(tr('운영진만 접근할 수 있는 공간입니다.','Cet espace est réservé aux administrateurs.'));return;
      }
      meUid=user.uid;
      text('admin-who',me.data().name || user.email || 'Admin');
      const loading=el<HTMLElement>('admin-loading');if(loading)loading.hidden=true;
      const content=el<HTMLElement>('admin-content');if(content)content.hidden=false;
      await Promise.all([loadRequests(),loadMembers(true),loadHistory(),loadNameRequests(),loadSuggestions(),loadDeletionLogs(),loadHiddenArchives()]);
    } catch(error) {
      console.error('ASICC admin access:',error);
      deny(tr('관리자 화면을 불러올 수 없습니다. Firebase 규칙을 확인해 주세요.',
        'Impossible de charger l’administration. Vérifiez les règles Firebase.'));
    }
  });

  el<HTMLButtonElement>('admin-redact-legacy')?.addEventListener('click',()=>void redactHistoricalNames());
  el<HTMLButtonElement>('admin-refresh')?.addEventListener('click',()=>{
    if(busy)return;
    void Promise.all([loadRequests(),loadMembers(true),loadHistory(),loadNameRequests(),loadSuggestions(),loadDeletionLogs(),loadHiddenArchives()]).catch(error=>{
      console.error('ASICC refresh:',error);
      showMessage(tr('새로고침 중 오류가 발생했습니다.','Erreur pendant l’actualisation.'),true);
    });
  });
  el<HTMLInputElement>('admin-member-search')?.addEventListener('input',renderMembers);
  el<HTMLButtonElement>('admin-more')?.addEventListener('click',()=>{
    void loadMembers().catch(error=>{
      console.error('ASICC pagination:',error);
      showMessage(tr('회원 목록을 더 불러올 수 없습니다.','Impossible de charger d’autres membres.'),true);
    });
  });
</script>
