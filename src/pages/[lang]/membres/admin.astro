  function openMemberEditor(member:Member){
    if(busy||member.id===meUid)return;
    const dialog=el<HTMLDialogElement>('admin-edit-dialog');if(!dialog)return;
    editingMember=member;
    text('admin-edit-heading',tr(`${member.name||member.email}님 정보 수정`,`Modifier : ${member.name||member.email}`));
    text('admin-edit-email',tr(`로그인 아이디: ${member.email}`,`Identifiant : ${member.email}`));
    const input=(id:string,value:string)=>{const e=el<HTMLInputElement>(id);if(e)e.value=value;};
    input('admin-edit-name',member.name||'');input('admin-edit-nickname',member.nickname||'');
    input('admin-edit-phone',member.phone||'');input('admin-edit-relation',member.memberRelation??upgradeHistory.get(member.id)?.relation??'');
    const account=el<HTMLSelectElement>('admin-edit-account-type');if(account)account.value=member.accountType||'';
    input('admin-edit-birth',member.birthDate||'');
