      const refs=snapshot.docs.filter(d=>d.data().status==='approved'&&['member','special','admin'].includes(d.data().role)).map(d=>d.ref);
      if(refs.length>400)throw Error('too-many-members');
      const marker=doc(db,'siteSettings','dmRound9');
      await runTransaction(db,async tx=>{
        const mark=await tx.get(marker);if(mark.exists())throw Error('already-initialised');
        const fresh=await Promise.all(refs.map(ref=>tx.get(ref)));
        for(const p of fresh){if(p.exists()&&p.data().status==='approved'&&['member','special','admin'].includes(p.data().role))tx.update(p.ref,{dmMode:'on',dmUpdatedBy:meUid,dmUpdatedAt:serverTimestamp()});}
        tx.set(doc(db,'siteSettings','messaging'),{enabled:true,updatedBy:meUid,updatedAt:serverTimestamp()});
        tx.set(marker,{updatedBy:meUid,updatedAt:serverTimestamp()});
      });
