      window.dispatchEvent(new CustomEvent('asicc-messaging-setting',{detail:true}));
      showMessage(tr('기존 회원 쪽지 초기화가 저장되었습니다.','Initialisation des membres enregistrée.'));
      await loadMembers(true).catch(console.warn);
    }catch(e){console.error(e);showMessage(tr('초기화하지 못했습니다. 이미 완료되었거나 Firebase 규칙을 확인해야 합니다.','Initialisation impossible ou déjà effectuée.'),true);}
    finally{busy=false;b.textContent=tr('기존 회원 쪽지 일괄 활성화 (최초 1회)','Activer la messagerie des membres existants (une seule fois)');await loadInitialisation();}
  });

  const validNickname=(value:string):boolean=>{
    const n=value.normalize('NFKC');
    if(Array.from(n).length<2||Array.from(n).length>24)return false;
    if(!/^[\p{Script=Latin}\p{Script=Hangul}0-9]+$/u.test(n))return false;
    const plain=n.normalize('NFD').toLowerCase().replace(/\p{M}/gu,'');
    return !['asicc','admin','administrator','administrateur','administratrice','moderateur','moderatrice',
      'official','officiel','staff','관리자','운영진','협회','공식']
      .some(word=>plain.includes(word.normalize('NFD')));
  };
  let editingMember:Member|null=null;
  function updateAgeDisplay(){
