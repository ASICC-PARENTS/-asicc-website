---
import Base from '../../../layouts/Base.astro';
import { langPaths,href,L,type Lang } from '../../../i18n/ui';
// Explicitly pass the locale as a build-time page prop for both routes.
export function getStaticPaths() {
  return [
    { params: { lang: 'ko' }, props: { pageLang: 'ko' } },
    { params: { lang: 'fr' }, props: { pageLang: 'fr' } }
  ];
}
const lang = Astro.props.pageLang as Lang;
const live=import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED==='true';
---
<Base lang={lang} rest="membres/upgrade/" title={L(lang,{ko:'회원 등급 승급 신청',fr:'Demande de statut'})} noindex>
<section class="wrap m-shell">
<div id="upgrade-root" class="stack gap-16" data-lang={lang} data-login-url={href(lang,'membres/login/')} style="max-width:840px;margin:auto">
<a href={href(lang,'membres/')} class="small">← {L(lang,{ko:'회원공간으로',fr:'Retour à l’espace membres'})}</a>
<h1 class="h2">{L(lang,{ko:'회원 등급 승급 신청',fr:'Demander un changement de statut'})}</h1>
<p class="muted">{L(lang,{ko:'일반회원이 정회원·특별회원 자격을 신청하는 별도 페이지입니다. 운영진이 내용을 확인하고 승인합니다.',fr:'Les membres généraux peuvent demander un statut, soumis à l’examen de l’administration.'})}</p>
{!live && <div class="card">{L(lang,{ko:'아직 이용할 수 없습니다.',fr:'Service indisponible.'})}</div>}
<p id="upgrade-status" role="status" class="small"></p>
<form id="full-upgrade-form" hidden={!live} class="card stack gap-16" style="padding:26px">
  <label for="full-role">{L(lang,{ko:'신청 등급',fr:'Statut demandé'})}</label>
  <select id="full-role" required>
    <option value="member">{L(lang,{ko:'정회원 (국제섹션 재학생 학부모)',fr:'Membre de l’association (parent d’élève)'})}</option>
    <option value="special">{L(lang,{ko:'특별회원',fr:'Membre spécial'})}</option>
  </select>
  <div id="full-special-kind" class="stack gap-8" hidden>
    <label for="full-kind">{L(lang,{ko:'특별회원 유형',fr:'Catégorie de membre spécial'})}</label>
    <select id="full-kind">
      <option value="alumnus">{L(lang,{ko:'졸업·전학생 본인',fr:'Ancien élève ou élève transféré'})}</option>
      <option value="alumni-parent">{L(lang,{ko:'졸업·전학생 학부모',fr:'Parent d’ancien élève'})}</option>
      <option value="teacher">{L(lang,{ko:'교사·교육 관계 특별기여자',fr:'Enseignant / contributeur éducatif'})}</option>
      <option value="contributor">{L(lang,{ko:'기타 운영진이 인정하는 기여자',fr:'Autre personne reconnue par l’administration'})}</option>
    </select>
  </div>
  <div class="stack gap-8">
    <label for="full-relation">{L(lang,{ko:'학생과의 관계',fr:'Lien avec l’élève'})}</label>
    <select id="full-relation"><option value="mother">{L(lang,{ko:'어머니',fr:'Mère'})}</option><option value="father">{L(lang,{ko:'아버지',fr:'Père'})}</option><option value="student">{L(lang,{ko:'학생 본인',fr:'Élève'})}</option><option value="guardian">{L(lang,{ko:'기타 보호자',fr:'Autre responsable'})}</option><option value="other">{L(lang,{ko:'해당 없음 (기여자)',fr:'Sans objet (contributeur)'})}</option></select>
  </div>
  <div class="stack gap-12">
    <div class="row gap-12" style="align-items:center;justify-content:space-between;flex-wrap:wrap"><h2 class="h3">{L(lang,{ko:'학생 정보',fr:'Informations sur l’élève'})}</h2><button type="button" id="full-add-child" class="btn btn-ghost">{L(lang,{ko:'+ 학생 추가',fr:'+ Ajouter un élève'})}</button></div>
    <p class="small muted">{L(lang,{ko:'재학 중인 학생 또는 졸업·전학한 학생의 이름, 학교, 학년을 입력해 주세요. 자녀가 여러 명이면 추가할 수 있습니다.',fr:'Indiquez le nom, l’école et la classe actuelle ou de départ. Vous pouvez ajouter plusieurs enfants.'})}</p>
    <div id="full-children" class="stack gap-12"></div>
  </div>
  <label for="full-start-year">{L(lang,{ko:'재학 시작 연도 (졸업·전학자 필수)',fr:'Année de début (obligatoire pour anciens et transférés)'})}</label>
  <input id="full-start-year" type="number" min="2000" max="2100" />
  <label for="full-year">{L(lang,{ko:'재학 종료·졸업·전학 연도 (졸업·전학자 필수)',fr:'Année de fin de scolarité (obligatoire pour anciens)'})}</label>
  <input id="full-year" type="number" min="2000" max="2100" />
  <label for="full-note">{L(lang,{ko:'운영진 심사 참고사항 (교사·기여자는 활동 내용 기입)',fr:'Informations complémentaires (contribution, établissement, etc.)'})}</label>
  <textarea id="full-note" rows="4" maxlength="500"></textarea>
  <button type="submit" class="btn btn-dark">{L(lang,{ko:'운영진에게 신청 제출',fr:'Envoyer la demande'})}</button>
</form>
</div></section>
</Base>
<style>
 .child-row {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:12px;border:1px solid #dce0e7;padding:16px;border-radius:10px;min-width:0}
 .child-row label {min-width:0;overflow-wrap:anywhere}
 .child-row input {width:100%;min-width:0}
 .child-row .child-remove {grid-column:1 / -1;justify-self:start}
</style>
<script>
  import { getApps,initializeApp } from 'firebase/app';
  import { getAuth,onAuthStateChanged,getIdToken } from 'firebase/auth';
  import { getFirestore,doc,getDoc,setDoc,updateDoc,serverTimestamp } from 'firebase/firestore';
  import { firebaseConfig } from '../../../firebase-config';
  import {BOARD_PHOTO_API} from '../../../config/board-photos';
  const root=document.querySelector<HTMLElement>('#upgrade-root');const fr=root?.dataset.lang==='fr';
  const tr=(ko:string,french:string)=>fr?french:ko;
  const say=(s:string,bad=false)=>{const p=document.querySelector<HTMLElement>('#upgrade-status');if(p){p.textContent=s;p.style.color=bad?'#b42318':'#067647';}};
  const app=getApps().find(a=>a.name==='asicc-website')??initializeApp(firebaseConfig,'asicc-website');
  const auth=getAuth(app),db=getFirestore(app);
  let uid='',profile:{name:string;email:string;role:string}|null=null;
  const container=document.querySelector<HTMLElement>('#full-children')!;
  function addChild(){
    if(container.children.length>=5)return;
    const row=document.createElement('div');row.className='child-row';
    for(const [field,title,ph] of [
      ['studentName',tr('학생 이름','Nom de l’élève'),tr('이름','Nom')],
      ['school',tr('학교명','École'),tr('학교명','École')],
      ['grade',tr('학년 (현재/졸업·전학 당시)','Classe actuelle ou de départ'),tr('예: CM2, 3ème','Ex. CM2, 3ème')]
    ]){
      const label=document.createElement('label');label.className='stack gap-8 small';label.textContent=title;
      const input=document.createElement('input');input.setAttribute('data-field',field);input.placeholder=ph;input.maxLength=100;
      label.append(input);row.append(label);
    }
    if(container.children.length>0){
      const btn=document.createElement('button');btn.type='button';btn.className='btn btn-ghost child-remove';
      btn.textContent=tr('이 학생 항목 삭제','Supprimer cette ligne élève');
      btn.setAttribute('aria-label',tr('이 학생 입력 항목 삭제','Supprimer cette fiche élève'));
      btn.addEventListener('click',()=>row.remove());row.append(btn);
    }
    container.append(row);
  }
  addChild();document.querySelector('#full-add-child')?.addEventListener('click',addChild);
  const role=document.querySelector<HTMLSelectElement>('#full-role')!;
  role.addEventListener('change',()=>{document.querySelector<HTMLElement>('#full-special-kind')!.hidden=role.value!=='special';});
  const form=document.querySelector<HTMLFormElement>('#full-upgrade-form')!;
  if(import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED==='true')onAuthStateChanged(auth,async user=>{
    if(!user){location.replace(root?.dataset.loginUrl||'/');return;}
    try{
      await user.reload();await getIdToken(user,true);if(!user.emailVerified)throw Error('verify');
      const snap=await getDoc(doc(db,'members',user.uid));if(!snap.exists()||snap.data().status!=='approved')throw Error('profile');
      uid=user.uid;profile=snap.data() as typeof profile;
      if(profile?.role!=='general'){say(tr('현재 등급에서는 승급 신청이 필요하지 않습니다.','Ce statut ne nécessite pas de demande.'));return;}
      const req=await getDoc(doc(db,'upgradeRequests',uid));
      if(req.exists()&&req.data().status!=='rejected'){
        say(req.data().status==='pending'?tr('이미 승급 심사 중입니다.','Votre demande est en cours.'):tr('기존 신청이 승인됐습니다.','Votre demande précédente a été approuvée.'));return;
      }
      form.hidden=false;say(tr('신청서를 입력해 주세요.','Remplissez le formulaire.'));
    }catch(e){console.error(e);say(tr('회원 권한 확인에 실패했습니다.','Vérification du compte impossible.'),true);}
  });
  form.addEventListener('submit',async e=>{
    e.preventDefault();if(!uid||!profile||profile.role!=='general')return;
    const children=Array.from(container.querySelectorAll<HTMLElement>('.child-row')).map(row=>({
      studentName:(row.querySelector<HTMLInputElement>('[data-field="studentName"]')?.value||'').trim(),
      school:(row.querySelector<HTMLInputElement>('[data-field="school"]')?.value||'').trim(),
      grade:(row.querySelector<HTMLInputElement>('[data-field="grade"]')?.value||'').trim()
    })).filter(x=>x.studentName||x.school||x.grade);
    if(children.some(x=>!x.studentName||!x.school||!x.grade)||children.some(x=>Object.values(x).some(v=>v.length>100))){say(tr('학생 이름·학교·학년을 모두 입력해 주세요.','Renseignez le nom, l’école et la classe de chaque élève.'),true);return;}
    const requestedRole=role.value;
    const kind=requestedRole==='member'?'parent':document.querySelector<HTMLSelectElement>('#full-kind')!.value;
    const relation=document.querySelector<HTMLSelectElement>('#full-relation')!.value;
    if((requestedRole==='member'||kind==='alumnus'||kind==='alumni-parent')&&!children.length){say(tr('학생 정보를 한 명 이상 입력해 주세요.','Ajoutez au moins un élève.'),true);return;}
    const startRaw=document.querySelector<HTMLInputElement>('#full-start-year')!.value;
    const startYear=startRaw?Number(startRaw):null;
    const yearRaw=document.querySelector<HTMLInputElement>('#full-year')!.value;
    const schoolYear=yearRaw?Number(yearRaw):null;
    if(schoolYear!==null&&(!Number.isInteger(schoolYear)||schoolYear<2000||schoolYear>2100)){say(tr('연도를 확인해 주세요.','Vérifiez l’année.'),true);return;}
    if(['alumnus','alumni-parent'].includes(kind) && (startYear===null||schoolYear===null)){say(tr('졸업·전학자의 재학 시작·종료 연도를 모두 입력해 주세요.','Les deux années de scolarité sont obligatoires.'),true);return;}
    if(startYear!==null&&(!Number.isInteger(startYear)||startYear<2000||startYear>2100||schoolYear!==null&&startYear>schoolYear)){say(tr('재학 시작·종료 연도를 확인해 주세요.','Vérifiez les années de scolarité.'),true);return;}
    const btn=form.querySelector<HTMLButtonElement>('button[type="submit"]');if(btn)btn.disabled=true;
    try{
      const ref=doc(db,'upgradeRequests',uid),snap=await getDoc(ref);
      const entry={requestedRole,kind,relation,children,schoolYear,startYear,note:document.querySelector<HTMLTextAreaElement>('#full-note')!.value.trim(),status:'pending',createdAt:serverTimestamp()};
      if(!snap.exists())await setDoc(ref,{uid,applicantName:profile.name,applicantEmail:profile.email,...entry});
      else if(snap.data().status==='rejected')await updateDoc(ref,entry);
      else throw Error('already submitted');
      form.hidden=true;say(tr('승급 신청을 접수했습니다.','Demande transmise.'));
      void fetch(BOARD_PHOTO_API.trim().replace(/\/$/,'')+'/api/notify',{method:'POST',headers:{Authorization:'Bearer '+await getIdToken(auth.currentUser!),'Content-Type':'application/json'},body:JSON.stringify({kind:'upgrade',id:uid})}).catch(console.warn);
    }catch(err){console.error(err);say(tr('신청을 저장하지 못했습니다.','Impossible d’enregistrer la demande.'),true);}
    finally{if(btn)btn.disabled=false;}
  });
</script>
