---
import Base from '../../../layouts/Base.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const live = import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED === "true";
---

<Base lang={lang} rest="membres/signup/" title={L(lang, { ko: '회원가입', fr: 'Inscription' })} noindex>
  <section class="wrap m-shell">
    <div class="card auth-card signup-panel stack gap-24" style="max-width:680px">
      <div class="stack gap-12">
        <span class="m-badge" style="align-self:flex-start">
          {L(lang, { ko: 'ASICC 회원공간', fr: 'Espace membres ASICC' })}
        </span>
        <h1 class="h2">{L(lang, { ko: '회원가입', fr: 'Créer un compte' })}</h1>
        <p class="muted">{L(lang, {
          ko: '먼저 일반회원으로 무료 가입합니다. 이메일 인증 후 학습자료실과 게시판 열람이 가능하며, 협회회원 또는 특별회원 승급을 신청할 수 있습니다.',
          fr: 'Inscrivez-vous d’abord comme membre général. Après validation de votre adresse e-mail, vous pourrez consulter les ressources pédagogiques et le forum, puis demander un statut de membre de l’association ou de membre spécial.'
        })}</p>
      </div>

      {!live && <p class="card small" role="status">{L(lang,{ko:"회원가입 시스템은 보안 점검 중입니다. 이 테스트 화면에서는 가입을 접수하지 않습니다.",fr:"Les inscriptions sont désactivées pendant les vérifications de sécurité."})}</p>}
      <form hidden={!live} id="asicc-signup" class="stack gap-16" data-lang={lang}>
        
<div class="stack gap-8">
  <label for="signup-name">
    {L(lang, { ko: '성명 (실명)', fr: 'Nom et prénom (identité réelle)' })}
  </label>
  <input id="signup-name" name="name" type="text" autocomplete="name" maxlength="80" required />
  <p class="small muted">
    {L(lang, { ko: '회원 자격 확인 및 협회 관리에 사용하며 다른 회원에게 공개하지 않습니다.', fr: 'Utilisé pour la gestion des membres, sans affichage aux autres membres.' })}
  </p>
</div>

<div class="stack gap-8">
  <label for="signup-nickname">
    {L(lang, { ko: '닉네임 (게시판 표시 이름)', fr: 'Pseudo (affiché sur le forum)' })}
  </label>
  <input id="signup-nickname" name="nickname" type="text" minlength="2" maxlength="24" required />
  <p class="small muted">
    {L(lang, { ko: '2~24자. 게시글과 댓글에 표시되는 이름입니다.', fr: 'De 2 à 24 caractères. Ce nom sera affiché sur les messages et commentaires.' })}
  </p>
</div>

        <div class="stack gap-8">
          <label for="signup-email">{L(lang, { ko: '이메일', fr: 'Adresse e-mail' })}</label>
          <input id="signup-email" name="email" type="email" autocomplete="email" maxlength="200" required />
        </div>
        <div class="stack gap-8">
          <label for="signup-password">{L(lang, { ko: '비밀번호 (8자 이상)', fr: 'Mot de passe (8 caractères minimum)' })}</label>
          <input id="signup-password" name="password" type="password" autocomplete="new-password" minlength="8" required />
        </div>
        <div class="stack gap-8">
          <label for="signup-confirm">{L(lang, { ko: '비밀번호 확인', fr: 'Confirmer le mot de passe' })}</label>
          <input id="signup-confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required />
        </div>

        <details class="card stack gap-8" style="padding:16px">
          <summary><strong>{L(lang,{ko:'회원 등급 및 이용 권한 안내',fr:'Catégories de membres et droits d’accès'})}</strong></summary>
          <ul class="small" style="margin-top:12px">
            <li>{L(lang,{ko:'일반회원: 이메일 인증 후 학습자료와 게시판 열람',fr:'Membre général : accès aux ressources et lecture du forum après vérification de l’e-mail'})}</li>
            <li>{L(lang,{ko:'협회회원: 재학생 학부모, 운영진 승인 후 게시글·댓글 작성 및 갤러리 열람',fr:'Membre de l’association : parent d’élève, publication et galerie après approbation'})}</li>
            <li>{L(lang,{ko:'특별회원: 졸업·전학생, 그 학부모, 교사·기여자 등 운영진이 인정한 회원. 협회회원과 동일한 홈페이지 이용 권한',fr:'Membre spécial : ancien élève, parent d’ancien élève, enseignant ou contributeur reconnu. Même accès aux espaces du site que les membres de l’association'})}</li>
            <li>{L(lang,{ko:'운영진: 회원 심사·관리 및 온라인 협회사무실 접근. 지정된 운영진만 권한 부여 가능',fr:'Administrateur : examen des demandes, gestion des comptes et bureau privé, sur nomination'})}</li>
          </ul>
          <p class="small muted">{L(lang,{ko:'먼저 일반회원으로 가입하고 승급은 별도 신청합니다. 홈페이지 등급과 정관상 의결권은 별개입니다.',fr:'Toute personne s’inscrit d’abord comme membre général. L’accès au site est distinct des droits statutaires de l’association.'})}</p>
        </details>
        <details class="card stack gap-8" style="padding:16px">
          <summary><strong>{L(lang,{ko:'개인정보 수집·처리 안내',fr:'Informations sur les données personnelles'})}</strong></summary>
          <div class="small stack gap-8" style="padding-top:12px">
            <p>{L(lang,{ko:'관리 주체: ASICC 학부모협회 · 문의: contact@asicc-parents.fr',fr:'Responsable : association ASICC · Contact : contact@asicc-parents.fr'})}</p>
            <p>{L(lang,{ko:'수집: 실명, 닉네임, 이메일, 계정 인증정보, 회원 등급 및 가입 확인 기록. 승급 신청 때에는 자녀의 이름·학교·학년·보호자 관계와 관련 이력을 추가로 수집합니다.',fr:'Données : nom, pseudonyme, e-mail, informations d’authentification, statut et preuve de prise de connaissance des règles ; pour les demandes de statut, nom, école, classe et lien avec l’enfant.'})}</p>
            <p>{L(lang,{ko:'목적: 계정 운영, 자격 심사, 접근권한 확인, 게시판 표시, 회원 문의 처리. 실명·이메일·자녀 정보는 일반 회원에게 공개하지 않으며, 게시글·댓글에는 닉네임을 표시합니다.',fr:'Finalités : gestion du compte, vérification des droits, affichage du pseudo sur le forum et suivi des demandes. Les autres membres ne voient pas le nom réel, l’e-mail ni les données des enfants.'})}</p>
            <p>{L(lang,{ko:'협회 운영진과 필요한 서비스 제공자가 관련 정보에 접근할 수 있습니다. 보관기간과 정보 열람·정정·삭제 등 권리는 개인정보 처리방침을 참고하세요.',fr:'Les administrateurs habilités et les prestataires nécessaires peuvent traiter ces données. Consultez la politique de confidentialité pour les durées de conservation et vos droits.'})}</p>
            <a href={`${href(lang,'legal/')}#privacy`} target="_blank" rel="noopener noreferrer">{L(lang,{ko:'개인정보 처리방침 전문 보기',fr:'Voir la politique de confidentialité'})}</a>
          </div>
        </details>
        <details class="card stack gap-8" style="padding:16px">
          <summary><strong>{L(lang,{ko:'게시판 이용 규칙 및 운영진 권한',fr:'Règles du forum et modération'})}</strong></summary>
          <div class="small stack gap-8" style="padding-top:12px">
            <p>{L(lang,{ko:'비방·모욕·괴롭힘, 고의적 분란 조장, 허위정보, 개인정보 무단 공개, 광고·스팸, 차별적 표현 등을 금지합니다. 건전한 비판과 의견 차이는 존중합니다.',fr:'Sont interdits : attaques personnelles, harcèlement, provocations délibérées, informations mensongères, divulgation de données privées, publicité indésirable et propos discriminatoires. Les critiques constructives restent permises.'})}</p>
            <p>{L(lang,{ko:'운영진은 규칙 위반 게시물을 사전 동의 없이 숨기거나 삭제할 수 있고, 위반의 정도에 따라 등급·글쓰기 권한 변경, 계정 정지 또는 홈페이지 강제 탈퇴 조치를 할 수 있습니다. 타인의 글 내용은 임의로 수정하지 않습니다.',fr:'En cas de violation, les administrateurs peuvent masquer ou supprimer des messages sans accord préalable, limiter les droits, modifier le statut, suspendre ou désactiver un compte. Ils ne réécrivent pas les messages d’autrui.'})}</p>
            <p>{L(lang,{ko:'원칙적으로 사유를 안내하고 이의제기 기회를 제공합니다. 긴급한 침해는 즉시 임시 조치할 수 있습니다. 홈페이지 계정 제한과 정관에 따른 협회 제명은 별개입니다. 이의제기: contact@asicc-parents.fr',fr:'Le membre est en principe informé des motifs et peut contester la mesure. Une restriction temporaire urgente reste possible. L’exclusion statutaire de l’association suit une procédure distincte. Recours : contact@asicc-parents.fr'})}</p>
          </div>
        </details>
        <label class="row gap-12" style="align-items:flex-start" for="signup-consent">
          <input id="signup-consent" name="consent" type="checkbox" required style="margin-top:4px" />
          <span>{L(lang,{ko:'[필수] 개인정보 처리 안내를 읽고 확인했습니다.',fr:'[Obligatoire] J’ai pris connaissance des informations sur mes données personnelles.'})}</span>
        </label>
        <label class="row gap-12" style="align-items:flex-start" for="signup-membership-rules">
          <input id="signup-membership-rules" name="membershipRules" type="checkbox" required style="margin-top:4px" />
          <span>{L(lang,{ko:'[필수] 회원 등급, 권한 변경, 계정 정지·강제 탈퇴에 관한 이용 규칙을 확인하고 동의합니다.',fr:'[Obligatoire] J’accepte les règles de statut, de limitation d’accès et de désactivation du compte.'})}</span>
        </label>
        <label class="row gap-12" style="align-items:flex-start" for="signup-forum-rules">
          <input id="signup-forum-rules" name="forumRules" type="checkbox" required style="margin-top:4px" />
          <span>{L(lang,{ko:'[필수] 게시판 이용 규칙과 운영진의 게시물 관리 권한에 동의합니다.',fr:'[Obligatoire] J’accepte les règles du forum et la modération des publications.'})}</span>
        </label>
        <p id="signup-message" aria-live="polite" role="status" class="small" hidden></p>
        <button id="signup-submit" class="btn btn-dark" type="submit">
          {L(lang, { ko: '회원가입 및 인증메일 받기', fr: 'Créer le compte et recevoir le courriel de vérification' })}
        </button>
        <div class="row gap-16" style="flex-wrap:wrap">
          <a href={href(lang, 'membres/login/')}>{L(lang, { ko: '이미 계정이 있나요? 로그인', fr: 'Déjà inscrit ? Se connecter' })}</a>
          <a href={href(lang, 'contact/')}>{L(lang, { ko: '문의하기', fr: 'Nous contacter' })}</a>
        </div>
      </form>
      <div id="signup-verification-pending" class="verification-pending stack gap-16" data-member-home={href(lang,'membres/')} hidden>
        <div class="verification-icon" aria-hidden="true">✉</div>
        <h2 class="h3">{L(lang,{ko:'이메일 인증을 완료해 주세요',fr:'Confirmez votre adresse e-mail'})}</h2>
        <p class="muted small">{L(lang,{ko:'인증 이메일의 링크를 누르면 이 화면이 자동으로 인증 상태를 확인하고 회원공간으로 이동합니다. 이 탭을 열어 두세요.',fr:'Cliquez sur le lien reçu par e-mail. Cet onglet vérifiera automatiquement la confirmation et ouvrira votre espace membre. Gardez cet onglet ouvert.'})}</p>
        <p id="signup-verification-status" role="status" aria-live="polite" class="small"></p>
        <div class="verification-actions row gap-12">
          <button id="signup-verification-check" class="btn btn-dark" type="button">{L(lang,{ko:'인증 완료 확인',fr:'Vérifier maintenant'})}</button>
          <button id="signup-verification-resend" class="btn btn-ghost" type="button">{L(lang,{ko:'인증메일 재발송',fr:'Renvoyer le courriel'})}</button>
        </div>
        <a href={href(lang,'membres/login/')} class="small">{L(lang,{ko:'다른 기기에서 인증했나요? 로그인하기',fr:'Confirmation sur un autre appareil ? Se connecter'})}</a>
      </div>
    </div>
  </section>
</Base>
<style>
.signup-panel {width:100%; min-width:0; }
#asicc-signup {width:100%; min-width:0; }
#asicc-signup > *, #asicc-signup details, #asicc-signup details > *, #asicc-signup details li { min-width:0; max-width:100%; }
#asicc-signup :is(input:not([type="checkbox"]),select,textarea) { width:100%; min-width:0; max-width:100%; }
#asicc-signup details > summary { cursor:pointer; white-space:normal; overflow-wrap:anywhere; padding:2px 0; line-height:1.6; }
#asicc-signup details ul { padding-left:1.3em; }
#asicc-signup details li + li { margin-top:9px; }
#asicc-signup label.row { display:grid; grid-template-columns:22px minmax(0,1fr); column-gap:12px; align-items:start !important; width:100%; }
#asicc-signup label.row input[type="checkbox"] { display:block; width:20px; height:20px; margin-top:3px !important; min-width:20px; }
#asicc-signup label.row span { display:block; min-width:0; overflow-wrap:anywhere; line-height:1.75; }
#asicc-signup .btn { max-width:100%; white-space:normal; overflow-wrap:anywhere; }
.verification-pending { border:1px solid #B8D8CB; border-radius:10px; background:#F2F9F5; padding:22px; min-width:0; }
.verification-pending p { overflow-wrap:anywhere; }
.verification-icon {font-size:30px; line-height:1; }
.verification-actions .btn { white-space:normal; }
@media(max-width:600px) { .signup-panel {padding:20px 16px;} .verification-pending {padding:16px;} .verification-actions .btn {width:100%;} }
</style>

<script>
  import { getApps, initializeApp } from 'firebase/app';
  import { getAuth, createUserWithEmailAndPassword, sendEmailVerification, onAuthStateChanged, getIdToken, deleteUser } from 'firebase/auth';
  import { getFirestore, doc, writeBatch, serverTimestamp } from 'firebase/firestore';
  import { firebaseConfig } from '../../../firebase-config';

  const form = document.querySelector<HTMLFormElement>('#asicc-signup');
  const message = document.querySelector<HTMLElement>('#signup-message');
  const submit = document.querySelector<HTMLButtonElement>('#signup-submit');
  const isFr = form?.dataset.lang === 'fr';
  const label = (ko:string, fr:string) => isFr ? fr : ko;
  const show = (text:string, error=false) => {
    if(!message)return;
    message.hidden=false; message.textContent=text;
    message.style.color=error?'#b42318':'#067647';
  };
  const pending = document.querySelector<HTMLElement>('#signup-verification-pending');
  const pendingStatus = document.querySelector<HTMLElement>('#signup-verification-status');
  const checkButton = document.querySelector<HTMLButtonElement>('#signup-verification-check');
  const resendButton = document.querySelector<HTMLButtonElement>('#signup-verification-resend');
  const app = getApps().find(a=>a.name==='asicc-website')??initializeApp(firebaseConfig,'asicc-website');
  const auth = getAuth(app),db=getFirestore(app);
  auth.languageCode=isFr?'fr':'ko';
  let registrationInProgress = false;
  let checkInProgress = false;
  let pollTimer:ReturnType<typeof setInterval>|undefined;
  let pollAttempts = 0;
  const pendingMessage=(s:string,bad=false)=>{
    if(pendingStatus){pendingStatus.textContent=s;pendingStatus.style.color=bad?'#b42318':'#25694e';}
  };
  const pausePolling=()=>{if(pollTimer!==undefined){clearInterval(pollTimer);pollTimer=undefined;}};
  async function checkVerification(manual=false){
    const user=auth.currentUser;
    if(!user||checkInProgress)return;
    checkInProgress=true;
    if(manual&&checkButton)checkButton.disabled=true;
    try{
      await user.reload();
      await getIdToken(user,true); // Firestore rules require refreshed email_verified claims.
      if(user.emailVerified){
        pausePolling();
        pendingMessage(label('인증 완료! 회원공간으로 이동합니다.','Adresse confirmée ! Ouverture de votre espace membre…'));
        location.assign(pending?.dataset.memberHome||'/');
      } else if(manual){
        pendingMessage(label('인증 전입니다. 메일 속 링크를 눌러 주세요.','En attente : ouvrez le lien reçu par e-mail.'));
      }
    }catch(err){
      console.error('ASICC email verification refresh error:',err);
      if(manual)pendingMessage(label('인증 확인에 실패했습니다. 잠시 후 다시 시도해 주세요.','Échec de la vérification. Réessayez dans un instant.'),true);
    }finally{checkInProgress=false;if(checkButton)checkButton.disabled=false;}
  }
  function watchVerification(){
    if(pollTimer!==undefined)return;
    // Poll only while the tab is visible, and stop after ~4 minutes to limit requests.
    pollAttempts=0;
    pollTimer=setInterval(()=>{
      if(document.visibilityState!=='visible')return;
      if(++pollAttempts>30){pausePolling();return;}
      void checkVerification();
    },8000);
  }
  function displayPending(){
    if(form)form.hidden=true;
    if(pending)pending.hidden=false;
    pendingMessage(label('인증 메일을 확인 중입니다. 받은편지함과 스팸함을 확인해 주세요.','En attente de confirmation. Vérifiez la boîte de réception et les indésirables.'));
    watchVerification();
  }
  if(import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED==='true'){
    onAuthStateChanged(auth,user=>{
      if(registrationInProgress||!user)return;
      if(user.emailVerified){void checkVerification();}
      else displayPending();
    });
    window.addEventListener('focus',()=>{if(!pending?.hidden)void checkVerification();});
    document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&!pending?.hidden)void checkVerification();});
    checkButton?.addEventListener('click',()=>void checkVerification(true));
    resendButton?.addEventListener('click',async()=>{
      const user=auth.currentUser;
      if(!user)return pendingMessage(label('다시 로그인해 주세요.','Reconnectez-vous.'),true);
      resendButton.disabled=true;
      try{await sendEmailVerification(user);pendingMessage(label('인증 메일을 다시 보냈습니다.','Un nouveau courriel a été envoyé.'));watchVerification();}
      catch(err){console.error(err);pendingMessage(label('재발송에 실패했습니다. 잠시 후 다시 시도해 주세요.','Impossible de renvoyer le courriel. Réessayez plus tard.'),true);}
      finally{resendButton.disabled=false;}
    });
  }

  const nicknameOkay = (n:string) => {
    if(Array.from(n).length<2 || Array.from(n).length>24) return false;
    if(!/^[\p{Script=Latin}\p{Script=Hangul}0-9]+$/u.test(n))return false;
    const plain=n.normalize('NFD').toLowerCase().replace(/\p{M}/gu,'');
    const reserved=['asicc','admin','administrator','administrateur','administratrice','moderateur','moderatrice','official','officiel','staff','관리자','운영진','협회','공식'];
    return !reserved.some(x=>plain.includes(x.normalize('NFD')));
  };

  if(import.meta.env.PUBLIC_ASICC_MEMBERS_ENABLED==='true' && form && submit){
    form.addEventListener('submit',async event=>{
      event.preventDefault();
      const data=new FormData(form);
      const name=String(data.get('name')??'').trim();
      const nickname=String(data.get('nickname')??'').trim().normalize('NFKC');
      const email=String(data.get('email')??'').trim().toLowerCase();
      const password=String(data.get('password')??'');
      const confirm=String(data.get('confirm')??'');
      if(!name||name.length>80||!nicknameOkay(nickname)||!email||password.length<8){
        show(label('실명, 닉네임(한글·라틴문자·숫자 2~24자)과 비밀번호를 확인해 주세요. 운영진을 사칭하는 닉네임은 허용되지 않습니다.','Vérifiez le nom, le pseudo (2 à 24 lettres coréennes/latines ou chiffres) et le mot de passe. Les pseudos réservés sont interdits.'),true);return;
      }
      if(password!==confirm){show(label('비밀번호가 일치하지 않습니다.','Les mots de passe ne correspondent pas.'),true);return;}
      if(data.get('consent')!=='on'||data.get('membershipRules')!=='on'||data.get('forumRules')!=='on'){
        show(label('필수 확인 항목 세 가지를 모두 선택해 주세요.','Veuillez cocher les trois cases obligatoires.'),true);return;
      }
      submit.disabled=true;
      registrationInProgress=true;
      show(label('가입 정보를 저장하고 있습니다…','Enregistrement du compte…'));
      let createdUser:import('firebase/auth').User|null=null;
      try{
        const credential=await createUserWithEmailAndPassword(auth,email,password);
        createdUser=credential.user;
        const nicknameKey=nickname.toLowerCase();
        const batch=writeBatch(db);
        batch.set(doc(db,'members',createdUser.uid),{
          name,nickname,nicknameKey,email,role:'general',status:'approved',
          consent:true,termsVersion:'2026-11',termsAcceptedAt:serverTimestamp(),createdAt:serverTimestamp()
        });
        batch.set(doc(db,'nicknames',nicknameKey),{uid:createdUser.uid,nickname,createdAt:serverTimestamp()});
        batch.set(doc(db,'publicNames',createdUser.uid),{nickname,updatedAt:serverTimestamp()});
        try{await batch.commit();}
        catch(e){
          console.error('ASICC profile/nickname reservation error:',e);
          let cleaned=false;
          try{await deleteUser(createdUser);cleaned=true;}catch(cleanError){console.error('Could not clean up incomplete Firebase Auth user',cleanError);}
          show(cleaned
            ? label('닉네임이 이미 사용 중이거나 계정 저장에 실패했습니다. 다른 닉네임으로 다시 시도해 주세요.','Ce pseudo est peut-être déjà utilisé ou le profil n’a pas pu être enregistré. Essayez un autre pseudo.')
            : label('회원정보 저장에 실패했고 계정 정리도 완료되지 않았습니다. 같은 이메일로 재가입하지 말고 협회에 문의해 주세요.','Le profil n’a pas pu être enregistré et le compte n’a pas pu être annulé. Contactez l’association sans recommencer.'),true);
          return;
        }
        try{
          await sendEmailVerification(createdUser);
          displayPending();
        }catch(e){
          console.error('ASICC verification email error',e);
          displayPending();
          pendingMessage(label('계정은 생성됐지만 메일 발송에 실패했습니다. 아래 재발송 버튼을 눌러 주세요.','Compte créé, mais l’envoi du courriel a échoué. Cliquez ci-dessous pour le renvoyer.'),true);
        }
        form.reset();
      }catch(e:unknown){
        console.error('ASICC signup failure',e);
        const code=(e as {code?:string})?.code;
        const pairs:Record<string,[string,string]>={
          'auth/email-already-in-use':['이미 가입된 이메일입니다. 로그인 또는 비밀번호 찾기를 이용해 주세요.','Cette adresse est déjà utilisée. Connectez-vous ou réinitialisez le mot de passe.'],
          'auth/invalid-email':['이메일 주소를 확인해 주세요.','Vérifiez l’adresse e-mail.'],
          'auth/weak-password':['비밀번호를 더 강하게 설정해 주세요.','Choisissez un mot de passe plus fort.'],
          'auth/too-many-requests':['요청이 많습니다. 나중에 다시 시도해 주세요.','Trop de demandes. Réessayez ultérieurement.']
        };
        const pair=code&&pairs[code];
        show(pair?label(pair[0],pair[1]):label('가입하지 못했습니다. 입력값과 연결을 확인하거나 협회에 문의해 주세요.','Inscription impossible. Vérifiez les données et la connexion ou contactez l’association.'),true);
      }finally{
        registrationInProgress=false;
        submit.disabled=false;
      }
    });
  }
</script>
