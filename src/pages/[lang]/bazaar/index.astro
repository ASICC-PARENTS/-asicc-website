---
import BuyerNotice from '../../../lib/bazaar/BuyerNotice.astro';
import BuyerTerms from '../../../lib/bazaar/BuyerTerms.astro';
import '../../../lib/bazaar/buyer.css';
import Base from '../../../layouts/Base.astro';
import { langPaths, L, href, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} rest="bazaar/" title={L(lang,{ko:'ASICC 온라인 바자회',fr:'Boutique solidaire ASICC'})} noindex>
<div id="bz" class="bz-wrap buyer-wrap" data-lang={lang} data-order-url={href(lang,'bazaar/commande/')}>
  <header id="bz-hero" hidden></header>
  <p id="bz-load-status" class="bz-note" role="status">{L(lang,{ko:'행사 상태를 확인하고 있습니다…',fr:'Vérification de l’état de la vente…'})}</p>
  <div id="bz-end-notice" class="bz-end-notice" hidden role="status" aria-live="polite">
    <h2 id="bz-end-title">{L(lang,{ko:'종료된 행사입니다.',fr:'Cette vente est terminée.'})}</h2>
    <p id="bz-end-detail">{L(lang,{ko:'바자회에 관심을 가져주셔서 감사합니다. 다음 행사를 기다려 주세요.',fr:'Merci pour votre intérêt. À bientôt pour une prochaine vente !'})}</p>
  </div>
  <div id="bz-prep-notice" class="bz-end-notice" hidden role="status">
    <h2>{L(lang,{ko:'바자회를 준비하고 있습니다.',fr:'La vente est en préparation.'})}</h2>
  </div>
  <div id="bz-shop" hidden>
  <div id="bz-status" role="status" class="bz-note">{L(lang,{ko:'상품 목록을 불러오는 중입니다…',fr:'Chargement des produits…'})}</div>
  <BuyerNotice lang={lang} />
  <section class="buyer-section" aria-labelledby="bz-products-h"><h2 id="bz-products-h">{L(lang,{ko:'상품 목록',fr:'Nos produits'})}</h2><div id="bz-products"></div></section>
  <section class="buyer-section bz-basket" aria-labelledby="bz-cart-title"><h2 id="bz-cart-title">{L(lang,{ko:'장바구니',fr:'Votre panier'})}</h2><div id="bz-cart"></div>
    <div class="buyer-total"><span>{L(lang,{ko:'합계',fr:'Total'})}</span><strong id="bz-total">0,00 €</strong></div>
    <div id="bz-checkout" hidden>
      <h3>{L(lang,{ko:'주문자 정보',fr:'Coordonnées de commande'})}</h3>
      <form id="bz-form">
        <label>{L(lang,{ko:'성함',fr:'Nom et prénom'})}<input name="name" autocomplete="name" maxlength="100" required/></label>
        <label>{L(lang,{ko:'휴대전화',fr:'Téléphone'})}<input name="phone" type="tel" autocomplete="tel" maxlength="40" required/></label>
        <label>{L(lang,{ko:'이메일',fr:'Adresse e-mail'})}<input name="email" type="email" autocomplete="email" maxlength="200" required/></label>
        <label>{L(lang,{ko:'판매자에게 전달할 사항 (선택)',fr:'Informations complémentaires pour le retrait (facultatif)'})}<textarea name="pickupNote" maxlength="500" rows="4"></textarea></label>
        <p class="buyer-hint">{L(lang,{ko:'기한 안에 송금하고 송금 완료를 알려 주세요. 송금 신고 또는 입금 확인 후에는 온라인에서 직접 취소할 수 없습니다.',fr:'Effectuez et signalez votre virement avant la date limite. Après le signalement ou la confirmation du paiement, l’annulation en ligne n’est plus possible.'})}</p>
        <BuyerTerms lang={lang}><div id="bz-payment-rules"></div></BuyerTerms>
        <label class="bz-consent"><input type="checkbox" name="consent" required/> {L(lang,{ko:'주문 변경·취소·환불 및 상품 수령 안내를 확인했으며, 주문 처리와 연락을 위한 개인정보 이용에 동의합니다.',fr:'J’ai lu les conditions de modification, d’annulation, de remboursement et de retrait. J’accepte l’utilisation de mes données pour traiter ma commande et me contacter.'})}</label>
        <div class="buyer-actions"><button id="bz-send" class="buyer-btn" type="submit">{L(lang,{ko:'주문 접수하기',fr:'Envoyer ma commande'})}</button></div>
        <p class="buyer-hint buyer-end">{L(lang,{ko:'주문 접수 후 송금 계좌가 안내됩니다. 입금 확인 후 주문이 확정됩니다.',fr:'Les coordonnées bancaires seront affichées après l’envoi. La commande sera confirmée après réception du paiement.'})}</p>
      </form>
    </div>
    <div class="buyer-actions"><button id="bz-toggle" class="buyer-btn" type="button" hidden>{L(lang,{ko:'주문서 작성하기',fr:'Remplir le formulaire de commande'})}</button></div>
  </section>
  </div>
  <section id="bz-receipt" class="buyer-section" aria-live="polite" tabindex="-1" hidden></section>
  <div id="bz-order-feedback" class="bz-note" hidden>
    <p id="bz-order-message" role="status"></p>
    <button id="bz-order-retry" class="bz-btn" type="button" hidden></button>
  </div>
  <p class="bz-contact">{L(lang,{ko:'문의',fr:'Contact'})}: <a href="mailto:contact@asicc-parents.fr">contact@asicc-parents.fr</a></p>
</div>
</Base>

<script>
import {formatParisPaymentDeadline,formatParisPickupRange,paymentGuidance,transferIdentification} from '../../../../firebase-functions-bazaar/bazaar/payment-window.mjs';
import {orderIntakeState} from '../../../../firebase-functions-bazaar/bazaar/order-intake.mjs';
import "../../../lib/bazaar/shop-view.css";
import {bindStorageLabels,changeCartQuantity,quantityCap,renderShopEvent,renderShopProducts,preserveShopDisclosures} from "../../../lib/bazaar/shop-view";
import {getShop,createOrder,eFormat,h,orderRequestId,parisDeadline} from '../../../lib/bazaar/api';
const root=document.querySelector<HTMLElement>('#bz')!;
const lang=root.dataset.lang==='fr'?'fr':'ko';
const t=(ko:string,fr:string)=>lang==='fr'?fr:ko;
bindStorageLabels(root);
const requestedEvent=new URLSearchParams(location.search).get('event')||'';
if(requestedEvent)document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach(link=>{
 const url=new URL(link.href);
 if(requestedEvent)url.searchParams.set('event',requestedEvent);
 link.href=url.href;
});
type OrderRequest = {
  eventId:string, consent:boolean, lang:string, name:FormDataEntryValue|null, phone:FormDataEntryValue|null,
  email:FormDataEntryValue|null, pickupNote:FormDataEntryValue|null, items:{id:string,qty:number,priceCents:number}[], requestId:string
};
let pendingOrder:OrderRequest|undefined;
let products:any[]=[],event:any={},cart:Record<string,number>={},serverOffset=0,submitted=false,submitting=false;
const $=(s:string)=>root.querySelector<HTMLElement>(s)!;
const button=(action:string,id:string,label:string,disabled=false)=>`<button data-action="${action}" data-id="${h(id)}" ${disabled?'disabled':''}>${h(label)}</button>`;
const intakeState=()=>orderIntakeState(event,Date.now()+serverOffset);
const isClosed=()=>intakeState()!=='open';
let renderedHero='';
function render(){
  if(submitted)return;
  // Manual event closure changes the public page to a simple notice.
  // These checks only control the visitor UI; no URL or server is blocked.
  const ended=event.status==='closed';
  $('#bz-load-status').hidden=true;
  $('#bz-end-notice').hidden=!ended;
  $('#bz-prep-notice').hidden=ended||event.status==='published';
  $('#bz-shop').hidden=event.status!=='published';
  $('#bz-hero').hidden=event.status!=='published';
  if(event.status!=='published'){
    $('#bz-products').replaceChildren();
    $('#bz-cart').replaceChildren();
    $('#bz-checkout').hidden=true;
    return;
  }
  const closed=isClosed();
  const transferDeadline=parisDeadline(event.transferCutoff,lang);
  const [paymentHeading,...paymentNotes]=paymentGuidance(lang,event.paymentHours);
  const hours=event.paymentHours??24;
  $('#bz-transfer-heading').textContent=t('주문 후 '+hours+'시간 이내 송금','Paiement par virement sous '+hours+' heures');
  $('#bz-transfer-window').textContent=t('주문 완료 후 '+hours+'시간 이내에 송금해 주세요. 단, 행사 전체 송금 마감이 더 빠른 경우에는 해당 마감 시간이 적용됩니다.','Veuillez effectuer votre virement dans les '+hours+' heures suivant votre commande. Si la date limite générale de paiement du bazar intervient plus tôt, cette dernière s’applique.');
  $('#bz-payment-rules').innerHTML='<h4>'+h(paymentHeading)+'</h4>'+
    paymentNotes.concat(transferIdentification(lang)).map(line=>'<p>'+h(line)+'</p>').join('');
  $('#bz-status').textContent=intakeState()==='unavailable'?t('계좌 등록 및 상품 확인 후 주문을 시작합니다.','La boutique sera ouverte après validation des produits et du compte bancaire.')
    :intakeState()==='scheduled'?t('아직 주문 접수가 시작되지 않았습니다.','Les commandes ne sont pas encore ouvertes.')
    :closed?(Date.now()+serverOffset<Date.parse(event.transferCutoff)
      ?t(`주문 접수가 마감되었습니다. 행사 전체 송금 마감은 ${transferDeadline}입니다. 기존 주문의 개인별 송금 기한은 주문 조회에서 확인해 주세요.`,`Les commandes sont closes. La date limite générale de paiement est le ${transferDeadline}. Vérifiez votre échéance personnelle dans le suivi de commande.`)
      :t('주문 및 송금 기간이 종료되었습니다. 입금 상태는 주문 조회에서 확인해 주세요.','Les commandes et les virements sont clos. Consultez le suivi pour connaître l’état du paiement.'))
    :t('주문 접수 중 · 회원가입 없이 주문 가능','Commandes ouvertes · Sans inscription');
  $('#bz-status').classList.toggle('is-open',!closed);
  $('#bz-notice-summary').textContent=t('주문 후 '+hours+'시간 이내 송금 · 직접 수령','Paiement par virement sous '+hours+' heures · Retrait sur place');
  const heroMarkup=renderShopEvent(event,lang,{logoUrl:import.meta.env.BASE_URL+'bazaar-email-wordmark.png'});
  if(heroMarkup!==renderedHero){
    preserveShopDisclosures($('#bz-hero'),()=>{$('#bz-hero').innerHTML=heroMarkup;});
    renderedHero=heroMarkup;
  }
  $('#bz-products').innerHTML=renderShopProducts(products,lang,{
    quantity:p=>Math.min(quantityCap(p.stockRemaining),cart[p.id]||0),
    price:eFormat,
    controls:(p,qty,sold)=>'<div class="bz-qty">'+button('dec',p.id,'−',closed||sold||qty<=0)+'<span>'+qty+'</span>'+
      button('inc',p.id,'+',closed||sold||qty>=quantityCap(p.stockRemaining))+'</div>'
  });
  renderCart();
}
function renderCart(){
  const closed=isClosed();
  const lines=Object.entries(cart).map(([id,qty])=>({p:products.find(p=>p.id===id),id,qty})).filter(x=>x.p&&x.qty>0);
  const total=lines.reduce((s,x)=>s+x.p.priceCents*x.qty,0);
  $('#bz-cart').innerHTML=lines.length?lines.map(x=>`<div class="bz-cart-row"><span>${h(lang==='fr'?x.p.titleFr:x.p.titleKo)}</span><div>${button('cartdec',x.id,'−',closed)}<strong>${x.qty}</strong>${button('cartinc',x.id,'+',closed||x.qty>=quantityCap(x.p.stockRemaining))}<span class="buyer-cart-price">${eFormat(x.p.priceCents*x.qty)}</span>${button('remove',x.id,'×',closed)}</div></div>`).join(''):`<p>${t('장바구니가 비어 있습니다.','Votre panier est vide.')}</p>`;
  $('#bz-total').textContent=eFormat(total);
  $('#bz-toggle').hidden=!lines.length||closed||submitted||!$('#bz-checkout').hidden;
  if(!submitting&&!pendingOrder)submit.disabled=!lines.length||closed;
  if(closed)$('#bz-checkout').hidden=true;
}
root.addEventListener('click',async ev=>{
  const target=(ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');if(!target||submitted||submitting||pendingOrder||isClosed())return;
  const id=target.dataset.id!,p=products.find(x=>x.id===id);if(!p)return;
  const a=target.dataset.action!;
  if(a==='inc'||a==='cartinc')changeCartQuantity(cart,id,1,p.stockRemaining);
  if(a==='dec'||a==='cartdec')changeCartQuantity(cart,id,-1,p.stockRemaining);
  if(a==='remove')delete cart[id];
  render();
});
$('#bz-toggle').addEventListener('click',()=>{if(isClosed())return;$('#bz-checkout').hidden=false;$('#bz-toggle').hidden=true;$('#bz-checkout').scrollIntoView({behavior:'smooth'});});
const form=$('#bz-form') as HTMLFormElement;
const submit=$('#bz-send') as HTMLButtonElement;
const retry=$('#bz-order-retry') as HTMLButtonElement;
const submitLabel=submit.textContent;
const retryLabel=t('주문 접수 확인 및 재시도','Vérifier et réessayer cette commande');
retry.textContent=retryLabel;
function showOrderError(error:any) {
  const {code,status,details}=error??{};
  const uncertain=!!pendingOrder&&(!status||status>=500||status===408);
  if(!uncertain)pendingOrder=undefined;
  let message=t('입력 정보와 장바구니를 확인한 뒤 다시 시도해 주세요.','Vérifiez vos coordonnées et votre panier, puis réessayez.');
  if(uncertain){
    message=code==='functions/checkout-busy'
      ?t('주문이 몰리고 있습니다. 잠시 후 아래 버튼으로 같은 주문을 다시 시도해 주세요.','De nombreuses commandes arrivent en même temps. Réessayez cette même commande dans un instant.')
      :t('주문 접수 여부를 확인하지 못했습니다. 아래 버튼으로 같은 주문의 접수 여부를 확인하고 필요한 경우 다시 접수해 주세요.',
        'La confirmation n’a pas pu être affichée. Utilisez le bouton ci-dessous pour vérifier cette même commande et la renvoyer si nécessaire.');
  }else if(details?.reason==='stock'&&Number.isInteger(details.available)){
    const product=products.find(item=>item.id===details.productId);
    const name=product?(lang==='fr'?product.titleFr:product.titleKo):t('상품','Produit');
    message=details.available===0?t(`${name} 품절입니다. 장바구니를 확인해 주세요.`,`${name} est épuisé. Vérifiez votre panier.`)
      :t(`${name}은 현재 ${details.available}개까지 주문할 수 있습니다.`,`Vous pouvez commander jusqu’à ${details.available} unité(s) de ${name}.`);
    if(product){product.stockRemaining=details.available;render();}
  }else if(status===429){
    message=t('짧은 시간에 주문 요청이 많습니다. 잠시 후 다시 시도해 주세요.','Trop de demandes en peu de temps. Veuillez réessayer dans un instant.');
  }else if(details?.reason==='order-intake'){
    message=t('현재 신규 주문을 접수하지 않습니다. 기존 주문은 주문 조회 링크에서 확인할 수 있습니다.',
      'La prise de nouvelles commandes est fermée. Vos commandes déjà passées restent accessibles depuis leur lien de suivi.');
    void refresh();
  }else if(status===412){
    message=t('상품 가격, 판매 상태 또는 주문 마감 시간이 변경되었습니다. 장바구니를 다시 확인해 주세요.',
      'Le prix, la disponibilité ou la date de clôture a changé. Vérifiez à nouveau votre panier.');
    void refresh();
  }
  $('#bz-order-message').textContent=message;
  $('#bz-order-feedback').hidden=false;
  retry.hidden=!uncertain;
  $('#bz-order-feedback').scrollIntoView({behavior:'smooth',block:'nearest'});
}
async function sendOrder(){
  if(submitted||submitting||(!pendingOrder&&(isClosed()||!Object.values(cart).some(qty=>qty>0))))return;
  submitting=true;
  form.setAttribute('aria-busy','true');
  retry.disabled=true;retry.textContent=t('확인 중…','Vérification…');
  submit.disabled=true;submit.textContent=t('접수 중…','Envoi…');
  try{
    if(!pendingOrder){
      const fd=new FormData(form);
      const items=products.filter(p=>cart[p.id]>0).map(p=>({id:p.id,qty:cart[p.id],priceCents:p.priceCents}));
      const request={eventId:event.eventId,consent:fd.has('consent'),lang,
        name:fd.get('name'),phone:fd.get('phone'),email:fd.get('email'),pickupNote:fd.get('pickupNote'),items};
      pendingOrder={...request, requestId:await orderRequestId(request.eventId,request)};
    }
    const result=await createOrder(pendingOrder);
    if(!result?.id||!result?.token)throw new Error('Order result missing');
    pendingOrder=undefined;
    submitted=true;$('#bz-checkout').hidden=true;$('#bz-toggle').hidden=true;
    $('#bz-order-feedback').hidden=true;
    const link=`${root.dataset.orderUrl}?id=${encodeURIComponent(result.id)}#token=${encodeURIComponent(result.token)}`;
    $('#bz-shop').hidden=true;
    $('#bz-hero').hidden=true;
    const receipt=$('#bz-receipt');
    receipt.hidden=false;
    const paymentLink=`${root.dataset.orderUrl}?id=${encodeURIComponent(result.id)}&payment=1#token=${encodeURIComponent(result.token)}`;
    const mailMessage={
      sent:t('주문 내역과 주문 조회 링크를 이메일로 보내드렸습니다.','Le récapitulatif et le lien de suivi ont été envoyés par e-mail.'),
      capture:t('실제 이메일은 발송되지 않았습니다. 아래 주문 조회 링크를 저장해 주세요.','Aucun e-mail réel n’a été envoyé. Conservez le lien de suivi ci-dessous.'),
      pending:t('주문 확인 이메일이 발송 대기 중입니다.','L’e-mail de confirmation est en attente d’envoi.'),
      off:t('이 주문의 확인 이메일은 발송되지 않습니다.','Aucun e-mail de confirmation ne sera envoyé pour cette commande.'),
      failed:t('주문 확인 이메일을 발송하지 못했습니다.','L’e-mail de confirmation n’a pas pu être envoyé.'),
      unknown:t('주문 확인 이메일의 발송 상태를 확인할 수 없습니다.','L’état d’envoi de l’e-mail de confirmation est indisponible.'),
    };
    const status=result.receiptMailStatus as keyof typeof mailMessage;
    receipt.innerHTML=`<h1>${t('주문이 정상적으로 접수되었습니다.','Votre commande a bien été enregistrée.')}</h1>
      <p class="buyer-hint">${mailMessage[status]||mailMessage.unknown}</p>
      <dl class="buyer-facts"><div><dt>${t('주문번호','Référence')}</dt><dd>${h(result.orderRef)}</dd></div>
      <div><dt>${t('주문 금액','Montant de la commande')}</dt><dd><strong>${eFormat(result.totalCents)}</strong></dd></div>
      <div><dt>${t('송금 마감','Date limite de virement')}</dt><dd>${h(formatParisPaymentDeadline(result.transferCutoff,lang))}</dd></div>
      ${result.pickupAt?`<div><dt>${t('상품 수령','Retrait des commandes')}</dt><dd>${h(formatParisPickupRange(result.pickupAt,result.pickupEndAt,lang))}</dd></div>`:''}
      ${result.pickupPlace?`<div><dt>${t('수령 장소','Lieu du retrait')}</dt><dd>${h(result.pickupPlace)}</dd></div>`:''}</dl>
      <div class="buyer-actions"><a class="buyer-link" href="${h(link)}" rel="noreferrer">${t('주문 조회 링크','Lien de suivi de la commande')}</a>
      <a class="buyer-btn" href="${h(paymentLink)}" rel="noreferrer">${t('송금 정보 보기','Voir les coordonnées bancaires')}</a></div>`;
    receipt.focus();
    receipt.scrollIntoView({block:'start'});
  }catch(error){showOrderError(error);}
  finally{
    submitting=false;form.removeAttribute('aria-busy');
    retry.disabled=false;retry.textContent=retryLabel;submit.disabled=submitted||!!pendingOrder;submit.textContent=submitLabel;
  }
}
form.addEventListener('submit',ev=>{ev.preventDefault();void sendOrder();});
retry.addEventListener('click',()=>void sendOrder());
const eventPicker=document.createElement('nav');
eventPicker.className='buyer-section';
eventPicker.hidden=true;
eventPicker.setAttribute('aria-label',t('진행 중인 행사 선택','Choisir un bazar en cours'));
$('#bz-hero').before(eventPicker);
let reading=false;
async function refresh(){
 if(reading)return;
 reading=true;
 try{
  const result=await getShop(requestedEvent);
  serverOffset=Date.parse(result.serverNow)-Date.now();
  if(event.eventId&&event.eventId!==result.event.eventId&&!submitting&&!submitted){
   cart={};
   pendingOrder=undefined;
  }
  if((submitting||submitted)&&event.eventId!==result.event.eventId)return;
  event=result.event;
  const choices=result.eventChoices??[];
  eventPicker.hidden=choices.length<2;
  eventPicker.replaceChildren(...choices.map((choice:{eventId:string,nameKo:string,nameFr:string})=>{
   const link=document.createElement('a');
   link.href='?event='+encodeURIComponent(choice.eventId);
   link.textContent=t(choice.nameKo,choice.nameFr);
   return link;
  }).flatMap((link:HTMLAnchorElement,index:number)=>index?[document.createTextNode(' · '),link]:[link]));
  products=result.products;
  render();
 }catch(error){
  console.error(error);
  if(!event.status){
   $('#bz-load-status').hidden=false;
   $('#bz-load-status').textContent=t('행사 상태를 불러올 수 없습니다. 잠시 후 다시 확인해 주세요.','Impossible de charger la vente. Veuillez réessayer dans un instant.');
  }
 }finally{reading=false;}
}
void refresh();
let lastPhase='closed';
setInterval(()=>{
 const phase=intakeState();
 if(event.status&&phase!==lastPhase){lastPhase=phase;render();}
},1000);
const refreshVisible=()=>{if(!document.hidden&&event.status!=='closed')void refresh();};
setInterval(refreshVisible,60000);
document.addEventListener('visibilitychange',refreshVisible);
</script>
