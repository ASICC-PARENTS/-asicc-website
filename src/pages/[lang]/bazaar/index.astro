---
import {orderTerms} from '../../../../firebase-functions-bazaar/bazaar/order-terms.mjs';
import Base from '../../../layouts/Base.astro';
import { langPaths, L, href, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} rest="bazaar/" title={L(lang,{ko:'ASICC 온라인 바자회',fr:'Boutique solidaire ASICC'})} noindex>
<div id="bz" class="bz-wrap" data-lang={lang} data-order-url={href(lang,'bazaar/commande/')}>
  <header id="bz-hero" hidden></header>
  <p id="bz-load-status" class="bz-note" role="status">{L(lang,{ko:'행사 상태를 확인하고 있습니다…',fr:'Vérification de l’état de la vente…'})}</p>
  <div id="bz-end-notice" class="bz-end-notice" hidden role="status" aria-live="polite">
    <h2 id="bz-end-title">{L(lang,{ko:'종료된 행사입니다.',fr:'Cette vente est terminée.'})}</h2>
    <p id="bz-end-detail">{L(lang,{ko:'바자회에 관심을 가져주셔서 감사합니다. 다음 행사를 기다려 주세요.',fr:'Merci pour votre intérêt. À bientôt pour une prochaine vente !'})}</p>
  </div>
  <div id="bz-prep-notice" class="bz-end-notice" hidden role="status">
    <h2>{L(lang,{ko:'바자회를 준비하고 있습니다.',fr:'La vente est en préparation.'})}</h2>
  </div>
  <div id="bz-shop" hidden>
  <div id="bz-status" role="status" class="bz-note">{L(lang,{ko:'상품 목록을 불러오는 중입니다…',fr:'Chargement des produits…'})}</div>
  <p>{orderTerms[lang].lines[0]}</p>
  <section aria-labelledby="bz-products-h"><h2 id="bz-products-h">{L(lang,{ko:'상품 목록',fr:'Nos produits'})}</h2><div id="bz-products"></div></section>
  <section class="bz-basket" aria-labelledby="bz-cart-title"><h2 id="bz-cart-title">{L(lang,{ko:'장바구니',fr:'Votre panier'})}</h2><div id="bz-cart"></div>
    <div class="bz-total"><span>{L(lang,{ko:'합계',fr:'Total'})}</span><strong id="bz-total">0,00 €</strong></div>
    <div id="bz-checkout" hidden>
      <h3>{L(lang,{ko:'주문자 정보',fr:'Coordonnées de commande'})}</h3>
      <form id="bz-form">
        <label>{L(lang,{ko:'성함',fr:'Nom et prénom'})}<input name="name" autocomplete="name" maxlength="100" required/></label>
        <label>{L(lang,{ko:'휴대전화',fr:'Téléphone'})}<input name="phone" autocomplete="tel" maxlength="40" required/></label>
        <label>{L(lang,{ko:'이메일',fr:'Adresse e-mail'})}<input name="email" type="email" autocomplete="email" maxlength="200" required/></label>
        <label>{L(lang,{ko:'판매자에게 전달할 사항 (선택)',fr:'Informations complémentaires pour le retrait (facultatif)'})}<textarea name="pickupNote" maxlength="500" rows="4"></textarea></label>
        <section id="bz-terms"><h4>{orderTerms[lang].title}</h4>{orderTerms[lang].lines.map(line=><p>{line}</p>)}</section>
        <label class="bz-consent"><input type="checkbox" name="consent" required/> {L(lang,{ko:'주문 변경·취소·환불 안내를 확인했으며, 주문 처리와 연락을 위한 개인정보 이용에 동의합니다.',fr:'J’ai lu les conditions de modification, d’annulation et de remboursement et j’accepte l’utilisation de mes données pour le traitement de la commande.'})}</label>
        <button id="bz-send" class="bz-btn" type="submit">{L(lang,{ko:'주문 확정 및 송금 안내 받기',fr:'Valider ma commande et recevoir les coordonnées bancaires'})}</button>
        <small>{L(lang,{ko:'계좌이체는 주문 접수 후 별도로 진행하며, 입금 확인 후 주문이 확정됩니다.',fr:'Le paiement se fait par virement après validation. La commande est confirmée après réception du paiement.'})}</small>
      </form>
    </div>
    <button id="bz-toggle" class="bz-btn" hidden>{L(lang,{ko:'주문하기',fr:'Commander'})}</button>
    <div id="bz-receipt" hidden></div>
  </section>
  </div>
  <div id="bz-order-feedback" class="bz-note" hidden>
    <p id="bz-order-message" role="status"></p>
    <button id="bz-order-retry" class="bz-btn" type="button" hidden></button>
  </div>
  <p class="bz-contact">{L(lang,{ko:'문의',fr:'Contact'})}: <a href="mailto:contact@asicc-parents.fr">contact@asicc-parents.fr</a></p>
</div>
</Base>
<style is:global>
/* Static HTML is initially non-interactive; never show products before an event check. */
#bz [hidden]{display:none!important}
.bz-end-notice{margin:24px 0;padding:34px 28px;text-align:center;background:#fff7f5;border:1px solid #efdcd6;border-radius:16px}
.bz-end-notice h2{color:#73283d;margin:0 0 12px;font-size:clamp(24px,3.3vw,32px)}
.bz-end-notice p{margin:0;line-height:1.8}
.bz-hero #bz-intro{white-space:pre-line}
.bz-wrap{max-width:1120px;margin:0 auto;padding:32px 14px 90px;color:#352d2a}.bz-hero{background:linear-gradient(120deg,#5e2132,#8c3144);color:white;padding:34px;border-radius:19px}.bz-hero span{font-size:13px;letter-spacing:.04em;opacity:.9}.bz-hero h1{color:white;margin:10px 0 12px;font-size:clamp(28px,4vw,42px)}.bz-hero p{max-width:780px;margin:0;line-height:1.7}.bz-info{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:16px 0 35px}.bz-info>div{background:#fff9f6;border:1px solid #ecdcd8;border-radius:12px;padding:16px}.bz-info strong{color:#6e293a}.bz-info p{margin:5px 0 0;line-height:1.6;font-size:14px}.bz-wrap h2{font-size:25px;margin:28px 0 16px}.bz-note{border-radius:9px;background:#fff4e4;color:#664823;padding:13px 16px;margin-bottom:24px}.bz-row{position:relative;display:grid;grid-template-columns:165px minmax(0,1fr) 200px;gap:20px;align-items:center;border:1px solid #e8e1de;border-radius:16px;padding:20px;margin-bottom:16px;background:#fff;overflow:hidden}.bz-row.bz-sold{background:#f3f3f3;filter:grayscale(.65)}.bz-sold-mark{position:absolute;top:45%;left:22%;width:65%;text-align:center;transform:rotate(-16deg);color:#dc1531;font-size:clamp(30px,5vw,65px);font-weight:900;letter-spacing:.09em;text-shadow:2px 2px white;pointer-events:none;z-index:2}.bz-photo{width:165px;height:155px;object-fit:contain;background:#f9f6f4;border-radius:12px}.bz-placeholder{display:grid;place-items:center;font-size:45px}.bz-desc h3{font-size:20px;margin:0 0 8px;color:#362621}.bz-desc p{white-space:pre-line;line-height:1.75;margin:8px 0;color:#5e554f}.bz-storage{font-size:12px;background:#edf4f7;padding:3px 9px;border-radius:30px;display:inline-block}.bz-qty{display:flex;align-items:center;gap:10px;margin:12px 0}.bz-qty button{width:36px;height:36px;min-width:36px;border:1px solid #cdb9b4;background:white;border-radius:8px;cursor:pointer}.bz-qty span{min-width:20px;text-align:center}.bz-price{font-size:24px;font-weight:750;color:#6d2437}.bz-stock{font-size:12px;color:#96644f}.bz-btn{padding:12px 16px;border:0;background:#812e43;color:#fff;border-radius:9px;font-weight:750;cursor:pointer}.bz-btn:disabled,.bz-qty button:disabled{opacity:.45;cursor:not-allowed}.bz-basket{border:2px solid #ead6d3;border-radius:18px;background:#fffafa;padding:24px;margin-top:32px}.bz-basket h2{margin:0 0 16px}.bz-cart-row{display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid #ebdfdd;padding:13px 0}.bz-cart-row>div:last-child{display:flex;gap:12px;align-items:center}.bz-cart-row button{border:1px solid #d7c9c5;background:white;border-radius:6px;cursor:pointer}.bz-total{display:flex;justify-content:space-between;align-items:center;padding:16px 0;font-size:23px}.bz-total strong{color:#86263e}.bz-basket label{display:flex;flex-direction:column;gap:6px;font-weight:650;margin:12px 0}.bz-basket input:not([type=checkbox]),.bz-basket textarea{font:inherit;padding:11px;border:1px solid #ccc;border-radius:8px;width:100%;max-width:520px}.bz-basket .bz-consent{flex-direction:row;align-items:flex-start;font-size:13px;font-weight:400}.bz-contact{margin-top:20px;font-size:14px}.bz-receipt{background:#edf6ee;padding:18px;border-radius:12px}.bz-copy{display:inline-flex;gap:5px;align-items:center;background:white;border:1px solid #ccacb6;border-radius:6px;padding:5px 10px;cursor:pointer}.bz-err{background:#ffeded;color:#9d2424;padding:12px;border-radius:8px;margin:12px 0}
@media(max-width:780px){.bz-row{grid-template-columns:115px 1fr;gap:14px;padding:13px}.bz-photo{width:115px;height:125px}.bz-actions{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap}.bz-actions .bz-btn{min-width:140px}.bz-info{grid-template-columns:1fr}.bz-basket{padding:15px}.bz-cart-row{align-items:flex-start}.bz-hero{padding:24px}}

.bz-product-sheet{overflow-x:auto;border:1px solid #e8e1de;border-radius:12px;background:#fff}.bz-product-table{width:100%;min-width:610px;border-collapse:collapse;text-align:left;table-layout:fixed}.bz-product-table th{background:#faf1ee;color:#6d2437;font-size:13px;padding:10px 12px;border-bottom:1px solid #e8d7d2;white-space:nowrap}.bz-product-table th:nth-child(1){width:86px}.bz-product-table th:nth-child(3){width:100px}.bz-product-table th:nth-child(4){width:118px}.bz-product-table th:nth-child(5){width:112px}.bz-product-table td{padding:10px 12px;vertical-align:middle;border-bottom:1px solid #eee5e1}.bz-product-table tr:last-child td{border-bottom:0}.bz-product-table .bz-photo{display:block;width:62px;height:62px;object-fit:contain;border-radius:7px}.bz-product-table .bz-placeholder{display:grid;place-items:center;font-size:25px}.bz-product-table .bz-desc h3{font-size:16px;margin:0 0 3px;overflow-wrap:anywhere}.bz-product-table .bz-desc p{font-size:13px;line-height:1.4;margin:4px 0;overflow-wrap:anywhere}.bz-product-table .bz-price{font-size:17px;white-space:nowrap}.bz-product-table .bz-qty{gap:5px;margin:0}.bz-product-table .bz-qty button{width:27px;height:30px;min-width:27px}.bz-product-table .bz-btn{padding:9px 10px;font-size:13px;white-space:nowrap}.bz-product-table .bz-sold{background:#f5f5f5}.bz-sold-label{display:inline-block;color:#9d2424;margin-left:8px;font-size:12px}.bz-product-table .bz-stock{display:inline-block;margin-right:4px}@media(max-width:780px){.bz-product-table{min-width:560px}.bz-product-table td,.bz-product-table th{padding:8px}.bz-product-table th:nth-child(1){width:73px}.bz-product-table th:nth-child(3){width:84px}.bz-product-table th:nth-child(4){width:108px}.bz-product-table th:nth-child(5){width:90px}.bz-product-table .bz-photo{width:55px;height:55px}}
</style>
<script>
import "../../../lib/bazaar/shop-view.css";
import {bindStorageLabels,renderShopEvent,renderShopProducts} from "../../../lib/bazaar/shop-view";
import {getShop,createOrder,eFormat,h,orderRequestId,parisDeadline} from '../../../lib/bazaar/api';
const root=document.querySelector<HTMLElement>('#bz')!;
const lang=root.dataset.lang==='fr'?'fr':'ko';
const t=(ko:string,fr:string)=>lang==='fr'?fr:ko;
bindStorageLabels(root);
const requestedEvent=new URLSearchParams(location.search).get('event')||'';
if(requestedEvent)document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach(link=>{
 const url=new URL(link.href);
 url.searchParams.set('event',requestedEvent);
 link.href=url.href;
});
type OrderRequest = {
  eventId:string, consent:boolean, lang:string, name:FormDataEntryValue|null, phone:FormDataEntryValue|null,
  email:FormDataEntryValue|null, pickupNote:FormDataEntryValue|null, items:{id:string,qty:number,priceCents:number}[], requestId:string
};
let pendingOrder:OrderRequest|undefined;
let products:any[]=[],event:any={},cart:Record<string,number>={},selected:Record<string,number>={},serverOffset=0,submitted=false,submitting=false;
const $=(s:string)=>root.querySelector<HTMLElement>(s)!;
const button=(action:string,id:string,label:string,disabled=false)=>`<button data-action="${action}" data-id="${h(id)}" ${disabled?'disabled':''}>${h(label)}</button>`;
function isReady(){return /^FR[0-9A-Z]{25}$/.test(String(event.iban||'').replaceAll(' ',''));}
function isEarly(){return !!event.orderStartsAt&&(Date.now()+serverOffset)<Date.parse(event.orderStartsAt);}
function isClosed(){return isEarly()|| event.status!=='published'||!isReady()||!!event.finalizedAt||(Date.now()+serverOffset)>=Date.parse(event.orderCutoff||'1970-01-01');}
function render(){
  // Manual event closure changes the public page to a simple notice.
  // These checks only control the visitor UI; no URL or server is blocked.
  const ended=event.status==='closed';
  $('#bz-load-status').hidden=true;
  $('#bz-end-notice').hidden=!ended;
  $('#bz-prep-notice').hidden=ended||event.status==='published';
  $('#bz-shop').hidden=event.status!=='published';
  $('#bz-hero').hidden=event.status!=='published';
  if(event.status!=='published'){
    $('#bz-products').replaceChildren();
    $('#bz-cart').replaceChildren();
    $('#bz-checkout').hidden=true;
    return;
  }
  const closed=isClosed();
  const transferDeadline=parisDeadline(event.transferCutoff,lang);
  $('#bz-status').textContent=!isReady()?t('계좌 등록 및 상품 확인 후 주문을 시작합니다.','La boutique sera ouverte après validation des produits et du compte bancaire.')
    :isEarly()?t('아직 주문 접수가 시작되지 않았습니다.','Les commandes ne sont pas encore ouvertes.')
    :closed?(Date.now()+serverOffset<Date.parse(event.transferCutoff)
      ?t(`주문 접수가 마감되었습니다. 기존 주문은 ${transferDeadline}까지 송금해 주세요.`,`Les commandes sont closes. Pour une commande déjà passée, effectuez le virement au plus tard le ${transferDeadline}.`)
      :t('주문 및 송금 기간이 종료되었습니다. 입금 확인 후 확정 메일을 보내드립니다.','Les commandes et les virements sont clos. Un e-mail de confirmation suivra la vérification.'))
    :t('주문 접수 중 · 회원가입 없이 주문 가능','Commandes ouvertes · Sans inscription');
  $('#bz-hero').innerHTML=renderShopEvent(event,lang);
  $('#bz-products').innerHTML=renderShopProducts(products,lang,{
    quantity:p=>p.stockRemaining===0?0:Math.min(p.stockRemaining??100,selected[p.id]||1),
    price:eFormat,
    controls:(p,qty,sold)=>'<div class="bz-qty">'+button('dec',p.id,'−',closed||sold||qty<=1)+'<span>'+qty+'</span>'+
      button('inc',p.id,'+',closed||sold||qty>=(p.stockRemaining??100))+'</div>'+
      '<button type="button" class="bz-btn" data-action="add" data-id="'+h(p.id)+'" '+(closed||sold?'disabled':'')+'>'+t('담기','Ajouter')+'</button>'
  });
  renderCart();
}
function renderCart(){
  const closed=isClosed();
  const lines=Object.entries(cart).map(([id,qty])=>({p:products.find(p=>p.id===id),id,qty})).filter(x=>x.p&&x.qty>0);
  const total=lines.reduce((s,x)=>s+x.p.priceCents*x.qty,0);
  $('#bz-cart').innerHTML=lines.length?lines.map(x=>`<div class="bz-cart-row"><span>${h(lang==='fr'?x.p.titleFr:x.p.titleKo)}</span><div>${button('cartdec',x.id,'−',closed)}<strong>${x.qty}</strong>${button('cartinc',x.id,'+',closed)}<span>${eFormat(x.p.priceCents*x.qty)}</span>${button('remove',x.id,'×',closed)}</div></div>`).join(''):`<p>${t('장바구니가 비어 있습니다.','Votre panier est vide.')}</p>`;
  $('#bz-total').textContent=eFormat(total);
  ($('#bz-toggle') as HTMLButtonElement).hidden=!lines.length||closed||submitted;
  if(closed)$('#bz-checkout').hidden=true;
}
root.addEventListener('click',async ev=>{
  const target=(ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');if(!target||submitted||submitting||pendingOrder||isClosed())return;
  const id=target.dataset.id!,p=products.find(x=>x.id===id);if(!p)return;
  const a=target.dataset.action!;
  if(a==='inc')selected[id]=Math.min(100,p.stockRemaining??100,(selected[id]||1)+1);
  if(a==='dec')selected[id]=Math.max(1,(selected[id]||1)-1);
  if(a==='add')cart[id]=Math.min(100,(cart[id]||0)+(selected[id]||1));
  if(a==='cartinc')cart[id]=Math.min(100,(cart[id]||0)+1);
  if(a==='cartdec')cart[id]=Math.max(0,(cart[id]||0)-1);
  if(a==='remove')delete cart[id];
  // Actual stock is checked again atomically when the order is submitted.
  if(p.stockRemaining!=null&&cart[id]>p.stockRemaining)cart[id]=p.stockRemaining;
  render();
});
$('#bz-toggle').addEventListener('click',()=>{if(isClosed())return;$('#bz-checkout').hidden=false;$('#bz-toggle').hidden=true;$('#bz-checkout').scrollIntoView({behavior:'smooth'});});
const form=$('#bz-form') as HTMLFormElement;
const submit=$('#bz-send') as HTMLButtonElement;
const retry=$('#bz-order-retry') as HTMLButtonElement;
const submitLabel=submit.textContent;
const retryLabel=t('주문 접수 확인 및 재시도','Vérifier et réessayer cette commande');
retry.textContent=retryLabel;
function showOrderError(error:any) {
  const {code,status,details}=error??{};
  const uncertain=!!pendingOrder&&(!status||status>=500||status===408);
  if(!uncertain)pendingOrder=undefined;
  let message=t('입력 정보와 장바구니를 확인한 뒤 다시 시도해 주세요.','Vérifiez vos coordonnées et votre panier, puis réessayez.');
  if(uncertain){
    message=code==='functions/checkout-busy'
      ?t('주문이 몰리고 있습니다. 잠시 후 아래 버튼으로 같은 주문을 다시 시도해 주세요.','De nombreuses commandes arrivent en même temps. Réessayez cette même commande dans un instant.')
      :t('주문 접수 여부를 확인하지 못했습니다. 아래 버튼으로 같은 주문의 접수 여부를 확인하고 필요한 경우 다시 접수해 주세요.',
        'La confirmation n’a pas pu être affichée. Utilisez le bouton ci-dessous pour vérifier cette même commande et la renvoyer si nécessaire.');
  }else if(details?.reason==='stock'&&Number.isInteger(details.available)){
    const product=products.find(item=>item.id===details.productId);
    const name=product?(lang==='fr'?product.titleFr:product.titleKo):t('상품','Produit');
    message=details.available===0?t(`${name} 품절입니다. 장바구니를 확인해 주세요.`,`${name} est épuisé. Vérifiez votre panier.`)
      :t(`${name}은 현재 ${details.available}개까지 주문할 수 있습니다.`,`Vous pouvez commander jusqu’à ${details.available} unité(s) de ${name}.`);
    if(product){product.stockRemaining=details.available;render();}
  }else if(status===429){
    message=t('짧은 시간에 주문 요청이 많습니다. 잠시 후 다시 시도해 주세요.','Trop de demandes en peu de temps. Veuillez réessayer dans un instant.');
  }else if(status===412){
    message=t('상품 가격, 판매 상태 또는 주문 마감 시간이 변경되었습니다. 장바구니를 다시 확인해 주세요.',
      'Le prix, la disponibilité ou la date de clôture a changé. Vérifiez à nouveau votre panier.');
    void refresh();
  }
  $('#bz-order-message').textContent=message;
  $('#bz-order-feedback').hidden=false;
  retry.hidden=!uncertain;
  $('#bz-order-feedback').scrollIntoView({behavior:'smooth',block:'nearest'});
}
async function sendOrder(){
  if(submitted||submitting||(!pendingOrder&&isClosed()))return;
  submitting=true;
  form.setAttribute('aria-busy','true');
  retry.disabled=true;retry.textContent=t('확인 중…','Vérification…');
  submit.disabled=true;submit.textContent=t('접수 중…','Envoi…');
  try{
    if(!pendingOrder){
      const fd=new FormData(form);
      const items=products.filter(p=>cart[p.id]>0).map(p=>({id:p.id,qty:cart[p.id],priceCents:p.priceCents}));
      const request={eventId:event.eventId,consent:fd.has('consent'),lang,
        name:fd.get('name'),phone:fd.get('phone'),email:fd.get('email'),pickupNote:fd.get('pickupNote'),items};
      pendingOrder={...request, requestId:await orderRequestId(request.eventId,request)};
    }
    const result=await createOrder(pendingOrder);
    if(!result?.id||!result?.token)throw new Error('Order result missing');
    pendingOrder=undefined;
    submitted=true;$('#bz-checkout').hidden=true;$('#bz-toggle').hidden=true;
    $('#bz-order-feedback').hidden=true;
    const link=`${root.dataset.orderUrl}?id=${encodeURIComponent(result.id)}#token=${encodeURIComponent(result.token)}`;
    if($('#bz-shop').hidden)$('#bz-shop').after($('#bz-receipt'));
    $('#bz-receipt').hidden=false;
    $('#bz-receipt').innerHTML=`<div class="bz-receipt"><h3>${t('주문이 접수되었습니다','Votre commande a été enregistrée')}</h3><p>${t('주문번호','Référence')}: <strong>${h(result.orderRef)}</strong></p><p>${t('총 금액','Montant')}: <strong>${eFormat(result.totalCents)}</strong></p><p>${t('수취인','Bénéficiaire')}: ${h(result.beneficiary)}</p><p>IBAN: <strong>${h(result.iban)}</strong> <button class="bz-copy" data-copy="${h(result.iban)}">${t('복사','Copier')}</button></p><p>${t('송금 시 메모','Référence du virement')}: <strong>${h(result.orderRef)}</strong> <button class="bz-copy" data-copy="${h(result.orderRef)}">${t('복사','Copier')}</button></p><p>${t('송금 기한','Date limite du virement')}: <strong>${h(parisDeadline(result.transferCutoff,lang))}</strong></p><p>${t('주문 접수 메일을 발송합니다. 이메일이 도착하지 않으면 아래 주문 확인 링크를 꼭 저장해 주세요.','Un e-mail récapitulatif sera envoyé. Conservez le lien de suivi ci-dessous.')}</p><a href="${h(link)}" rel="noreferrer">${t('송금 완료 신고 / 주문 확인','Signaler le virement / Voir la commande')}</a></div>`;
    $('#bz-receipt').scrollIntoView({behavior:'smooth'});
  }catch(error){showOrderError(error);}
  finally{
    submitting=false;form.removeAttribute('aria-busy');
    retry.disabled=false;retry.textContent=retryLabel;submit.disabled=submitted||!!pendingOrder;submit.textContent=submitLabel;
  }
}
form.addEventListener('submit',ev=>{ev.preventDefault();void sendOrder();});
retry.addEventListener('click',()=>void sendOrder());
$('#bz-receipt').addEventListener('click',ev=>{const el=(ev.target as HTMLElement).closest<HTMLElement>('[data-copy]');if(el)navigator.clipboard.writeText(el.dataset.copy||'');});
let reading=false;
async function refresh(){
 if(reading)return;
 reading=true;
 try{
  const result=await getShop(requestedEvent||(event.status==='published'?event.eventId:'')||'');
  serverOffset=Date.parse(result.serverNow)-Date.now();
  event=result.event;
  products=result.products;
  render();
 }catch(error){
  console.error(error);
  if(!event.status){
   $('#bz-load-status').hidden=false;
   $('#bz-load-status').textContent=t('행사 상태를 불러올 수 없습니다. 잠시 후 다시 확인해 주세요.','Impossible de charger la vente. Veuillez réessayer dans un instant.');
  }
 }finally{reading=false;}
}
void refresh();
let lastPhase=true;
setInterval(()=>{
 const phase=isClosed();
 if(event.status&&phase!==lastPhase){lastPhase=phase;render();}
},1000);
const refreshVisible=()=>{if(!document.hidden&&event.status!=='closed')void refresh();};
setInterval(refreshVisible,60000);
document.addEventListener('visibilitychange',refreshVisible);
</script>
