---
import Base from '../../../../layouts/Base.astro';
import { langPaths, L, href, type Lang } from '../../../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} rest="bazaar/admin/legacy/" title="ASICC · 바자회 관리자" noindex>
<div id="ba" class="ba-wrap">
  <header class="ba-top"><div><p>ASICC · ONLINE OFFICE</p><h1>온라인 바자회 관리</h1></div><a href={href(lang,'membres/admin/')}>홈페이지 운영센터</a></header>
  <p id="ba-status" role="status">관리자 권한을 확인하고 있습니다…</p>
  <div id="ba-content" hidden>
    <div id="ba-seed" hidden class="ba-danger-zone"><p>초기 상품 목록이 비어 있습니다. 최초 1회 상품 15개와 바자회 일정을 생성하세요.</p><button id="ba-seed-btn" class="ba-primary">초기 상품 15개 등록</button></div>
    <section class="ba-block ba-eventbar">
      <label for="ba-event-filter"><strong>바자회 선택</strong></label>
      <select id="ba-event-filter" aria-label="지난 바자회를 포함한 행사 선택"><option value="">현재 바자회</option></select>
      <button id="ba-new-event" type="button" class="ba-primary">+ 새 바자회 만들기</button>
      <select id="ba-draft-filter" aria-label="임시저장 바자회 불러오기"><option value="">임시저장 불러오기…</option></select>
      <span id="ba-event-state" class="ba-badge">—</span>
    </section>
    <div id="ba-dashboard-view">
    <section class="ba-block" id="ba-public-links" hidden>
      <p class="ba-help">행사 <strong id="ba-event-id">—</strong> · 배너 1 또는 배너 2의 링크 칸에 이 주소를 입력하면 홈페이지 언어에 맞게 열립니다.</p>
      <div class="ba-preview">
        <code id="ba-banner-link"></code>
        <button type="button" id="ba-copy-public-link">배너 링크 복사</button>
        <a id="ba-public-preview" href={href(lang,'bazaar/')} data-base={href(lang,'bazaar/')} target="_blank" rel="noopener noreferrer">공개 페이지 미리보기 ↗</a>
        <span id="ba-link-message" class="ba-help" role="status"></span>
      </div>
    </section>
    <section id="ba-end-event-panel" class="ba-block ba-event-end" hidden>
      <div><h2>행사 종료</h2><p class="ba-help">종료하면 배너나 저장된 링크로 접속하는 방문객에게 ‘종료된 행사입니다.’만 표시됩니다. 새 주문은 받지 않으며, 기존 주문·입금 확인과 행사 기록은 그대로 남습니다.</p></div>
      <button id="ba-end-event" type="button" class="ba-danger">행사 종료</button>
    </section>
    <section class="ba-block">
      <h2>주문 현황</h2>
      <div class="ba-kpis" id="ba-kpis"></div>
      <div class="ba-toolbar"><label>주문 검색 <input id="ba-query" placeholder="성함 · 주문번호 · 이메일 · 전화" /></label><button id="ba-export">CSV 내려받기</button><button id="ba-refresh">새로고침</button></div>
      <div class="ba-table-wrap"><table><thead><tr><th>주문번호</th><th>주문자</th><th>전화</th><th>이메일</th><th>상품 내역</th><th>총액</th><th>송금 완료</th><th>입금 확인</th></tr></thead><tbody id="ba-orders"></tbody></table></div>
      <div class="ba-danger-zone"><p>월요일 은행 내역과 대조한 뒤에만 누르세요. 미입금 주문 전체가 취소되고 고객에게 취소 안내가 전송됩니다.</p><button id="ba-finalize" class="ba-danger">최종 입금 확인 종료 · 미입금 일괄 취소</button></div>
    </section>
    <section class="ba-block">
      <h2>상품별 수량·금액 · 업체별 집계</h2><div class="ba-table-wrap"><table><thead><tr><th>공급업체</th><th>상품</th><th>주문 수량</th><th>주문 판매액</th><th>입금확인 수량</th><th>입금확인 판매액</th><th>예상 발주 박스</th><th>박스 TTC</th></tr></thead><tbody id="ba-summary"></tbody></table></div>
    </section>
    <section id="ba-history-products" class="ba-block" hidden>
      <h2>당시 판매상품 정보 · 읽기 전용</h2>
      <p class="ba-help">해당 바자회 종료 시 보존한 상품명, 사진, 설명, 판매가격, 박스 구성 및 매입원가입니다. 현재 상품 정보 수정의 영향을 받지 않습니다.</p>
      <div id="ba-history-list"></div>
    </section>
    <section id="ba-product-section" class="ba-block">
      <h2>상품 순서 및 상품관리</h2><p class="ba-help">현재 바자회 판매상품을 관리합니다. 다음 바자회는 상단의 ‘+ 새 바자회 만들기’에서 선택·편집하고, 미발행 상태로 임시저장할 수 있습니다.</p><button id="ba-new-product" class="ba-primary" type="button">+ 새 상품 추가</button>
      <div class="ba-grid"><div id="ba-product-list"></div><div id="ba-product-form"><p>왼쪽 상품을 선택해 주세요.</p></div></div>
    </section>
    <section id="ba-event-section" class="ba-block">
      <h2>바자회 안내 페이지 · 일정 · 송금 계좌</h2>
      <p class="ba-help">아래 한국어·프랑스어 안내문은 바자회 페이지 상단에 표시됩니다.</p><form id="ba-event-form" class="ba-fields">
        <label>주문 마감 (프랑스 현지시간)<input name="orderCutoff" type="datetime-local" required/></label>
        <label>송금 마감 (프랑스 현지시간)<input name="transferCutoff" type="datetime-local" required/></label>
        <label>협회 계좌 IBAN<input name="iban" placeholder="FR…"/></label>
        <label>수취인 명의<input name="beneficiary"/></label>
        <label>공개 페이지 안내문 (한국어)<textarea name="introKo" rows="5" maxlength="1000"></textarea></label>
        <label>Texte de la page publique (français)<textarea name="introFr" rows="5" maxlength="1000"></textarea></label>
        <label>픽업 안내 (한국어)<input name="pickupKo"/></label>
        <label>Retrait (français)<input name="pickupFr"/></label>
        <button type="submit" class="ba-primary">일정·계좌 저장</button>
      </form></section>
    </div>
    <section id="ba-draft-view" class="ba-block" hidden>
      <div class="ba-draft-heading"><div><p class="ba-help">새 바자회 · 독립된 편집 화면</p><h2 id="ba-draft-title">새 바자회 편집</h2><p class="ba-help">초안을 수정해도 공개 중인 행사와 지난 행사 기록은 바뀌지 않습니다.</p></div><button id="ba-exit-draft" type="button">← 행사 목록으로</button></div>
      <form id="ba-draft-event-form" class="ba-fields">
        <label>행사명 (한국어)<input name="nameKo" required/></label><label>Nom de la vente (français)<input name="nameFr" required/></label>
        <label>주문 마감 (프랑스시간)<input type="datetime-local" name="orderCutoff"/></label>
        <label>송금 마감 (프랑스시간)<input type="datetime-local" name="transferCutoff"/></label>
        <label>협회 IBAN<input name="iban" placeholder="FR…"/></label>
        <label>수취인<input name="beneficiary"/></label>
        <label>바자회 안내 (한국어)<textarea name="introKo" rows="3"></textarea></label>
        <label>Texte de la page publique (français)<textarea name="introFr" rows="5" maxlength="1000"></textarea></label>
        <label>픽업 안내 (한국어)<input name="pickupKo"/></label>
        <label>Retrait (français)<input name="pickupFr"/></label>
      </form>
      <div class="ba-draft-heading ba-draft-sub"><div><h2>이번 바자회 상품 선택·편집</h2><p class="ba-help">판매할 상품을 체크하고, 상품명·설명·사진주소·매입가·판매가·박스당 수량을 이번 행사에 맞게 수정하세요.</p></div><button id="ba-draft-new-product" type="button">+ 새 상품 등록</button></div>
      <div class="ba-grid"><div id="ba-draft-products"></div><div id="ba-draft-product-form"><p class="ba-help">왼쪽 상품의 '상세 편집'을 누르세요.</p></div></div>
      <div class="ba-draft-actions"><button id="ba-draft-save" class="ba-primary" type="button">임시저장</button><button id="ba-draft-publish" type="button" class="ba-primary">발행 (Publish)</button><button id="ba-draft-delete" type="button" class="ba-danger">임시저장 지우기</button></div>
      <p id="ba-draft-info" role="status" class="ba-help">임시저장 상태에서는 고객에게 노출되지 않습니다. 발행할 때 계좌·일정·상품가격 등을 다시 확인합니다.</p>
    </section>
  </div>
</div>
</Base>
<style is:global>
#ba [hidden]{display:none!important}
.ba-wrap{max-width:1350px;margin:0 auto;padding:25px 15px 80px;color:#2c2928}.ba-top{display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:1px solid #e9dada;margin-bottom:20px}.ba-top p{font-size:12px;color:#87344d}.ba-top h1{font-size:30px}.ba-wrap a{color:#8f2c46}.ba-block{border:1px solid #e4dfdc;background:#fff;border-radius:13px;padding:22px;margin:20px 0}.ba-block h2{font-size:22px;margin:0 0 14px}.ba-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.ba-kpi{padding:18px;border:1px solid #eee0dc;background:#fff7f5;border-radius:10px}.ba-kpi p{color:#745b5c;margin:0;font-size:13px}.ba-kpi strong{display:block;margin-top:8px;font-size:25px;color:#642c3c;white-space:nowrap}.ba-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin:22px 0 13px}.ba-toolbar input{margin-left:6px}.ba-wrap input:not([type=checkbox]),.ba-wrap textarea,.ba-wrap select{padding:9px;border:1px solid #c7c4c1;border-radius:7px;font:inherit;max-width:100%}.ba-wrap button{padding:8px 12px;background:white;border:1px solid #ccc;border-radius:7px;cursor:pointer;color:#382b2e}.ba-wrap .ba-primary{background:#822c43;color:white;border:0;padding:12px 16px}.ba-wrap .ba-danger{color:white;background:#ae2d33;border:0}.ba-table-wrap{overflow:auto}.ba-wrap table{border-collapse:collapse;width:100%;font-size:13px}.ba-wrap th,.ba-wrap td{text-align:left;padding:10px 8px;border-bottom:1px solid #eee;white-space:nowrap}.ba-wrap th{background:#faf3f1;color:#60414a}.ba-wrap details{white-space:normal;min-width:170px}.ba-wrap summary{cursor:pointer;color:#7d2840}.ba-danger-zone{margin-top:30px;background:#fff4f4;padding:15px;border-radius:9px;font-size:13px}.ba-help{font-size:13px;color:#6e6360}.ba-grid{display:grid;grid-template-columns:minmax(220px,1fr) minmax(380px,1.35fr);gap:20px}.ba-product{display:flex;justify-content:space-between;gap:7px;align-items:center;padding:9px;border-bottom:1px solid #eee}.ba-product.selected{background:#fff3ee}.ba-product button{font-size:12px}.ba-product-title{flex:1;white-space:normal!important;text-align:left}.ba-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.ba-fields label{display:flex;flex-direction:column;gap:6px;font-size:13px}.ba-fields label input,.ba-fields textarea{width:100%}.ba-fields label:has(textarea){grid-column:1/-1}.ba-fields button{justify-self:start}.ba-hint{color:#7c615e;font-size:12px;line-height:1.6}.ba-badge{display:inline-block;background:#e8f0ec;color:#2e644b;border-radius:20px;padding:2px 8px;font-size:12px}.ba-red{color:#b52c2c;font-weight:bold}

.ba-event-end{display:flex;justify-content:space-between;align-items:center;gap:20px;background:#fff9f6}.ba-event-end .ba-danger{flex-shrink:0;padding:12px 18px}.ba-preview{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-bottom:12px}.ba-eventbar{display:flex;align-items:center;flex-wrap:wrap;gap:12px}.ba-eventbar select{min-width:180px;flex:1}.ba-draft-heading{display:flex;justify-content:space-between;align-items:center;gap:12px}.ba-draft-sub{border-top:1px solid #eae2df;margin-top:20px;padding-top:18px;margin-bottom:10px}.ba-draft-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-end;border-top:1px solid #eae2df;margin-top:20px;padding-top:20px}.ba-draft-product{display:grid;grid-template-columns:auto 38px 38px 1fr auto;align-items:center;gap:4px;padding:8px 3px;border-bottom:1px solid #eee}.ba-draft-product button{padding:6px}.ba-draft-product small{font-size:12px;color:#736666}.ba-history-notice{padding:10px;border:1px solid #e2d6d2;background:#faf8f4;border-radius:8px;font-size:13px;margin-top:10px}
@media(max-width:800px){#ba-product-form,#ba-draft-product-form{scroll-margin-top:90px}.ba-kpis{grid-template-columns:repeat(2,1fr)}.ba-grid{grid-template-columns:1fr}.ba-fields{grid-template-columns:1fr}.ba-kpi strong{font-size:18px}}
</style>
<script>
import {onAuthStateChanged} from 'firebase/auth';
import {bazaarAuth,adminAction,eFormat,h} from '../../../../lib/bazaar/api';
const $=(selector:string)=>document.querySelector<HTMLElement>(selector)!;
let products:any[]=[],orders:any[]=[],event:any={},selectedId:string|null=null;
let selectedEventId:string|null=null,readOnly=false,isCurrent=false,eventList:any[]=[],draftList:any[]=[],draft:any=null,draftSelectedId:string|null=null,draftDirty=false;
const newProductId=()=>`custom-${crypto.randomUUID().replaceAll('-','')}`;
const smallScreen=()=>matchMedia('(max-width: 800px)').matches;
function focusEditor(selector:string){
 if(!smallScreen())return;
 const form=$(selector);
 const field=form.querySelector<HTMLInputElement>('input[name="titleKo"]');
 field?.focus({preventScroll:true});
 form.scrollIntoView({block:'start',behavior:'instant'});
}
function returnToProduct(container:string,id:string,attribute:string){
 const parent=$(container);
 const button=Array.from(parent.querySelectorAll<HTMLButtonElement>(`[data-${attribute}]`))
  .find(item=>item.getAttribute(`data-${attribute}`)===id);
 if(button){button.focus({preventScroll:true});button.scrollIntoView({block:'center',behavior:'instant'});}
 else parent.scrollIntoView({block:'start'});
}
async function storeEventPhoto(item:any,eventId:string,file?:File,previous?:any,draftVersion?:string){
 if(!file&&!item.imageUrl)return {imageUrl:'',photoPath:''};
 const sameSource=!file&&previous?.imageUrl===item.imageUrl;
 const sourcePath=sameSource?previous?.photoPath:'';
 if(sourcePath?.startsWith(`bazaar-photos/${eventId}/${item.id}/`)){
  return {imageUrl:item.imageUrl,photoPath:sourcePath};
 }
 let content:string|undefined;
 if(!sourcePath){
  let blob:Blob;
  try{
   if(file)blob=file;
   else{
    if(!/^https:\/\//i.test(item.imageUrl))throw Error('invalid');
    const response=await fetch(item.imageUrl,{credentials:'omit',signal:AbortSignal.timeout(15000)});
    if(!response.ok)throw Error('unavailable');
    blob=await response.blob();
   }
  }catch{
   throw Error(`‘${item.titleKo}’ 사진을 복사할 수 없습니다. 상품 편집에서 원본 사진 파일을 선택해 주세요.`);
  }
  if(!blob.size||blob.size>4*1024*1024)throw Error('사진은 4MB 이하로 선택해 주세요.');
  content=await new Promise<string>((resolve,reject)=>{
   const reader=new FileReader();
   reader.onload=()=>resolve(String(reader.result).split(',')[1]);
   reader.onerror=()=>reject(Error('사진 파일을 읽지 못했습니다.'));
   reader.readAsDataURL(blob);
  });
 }
 return adminAction({op:'storePhoto',eventId,id:item.id,sourcePath,content,draft:draftVersion!==undefined,updatedAt:draftVersion});
}
const eventName=(x:any)=>`${x.nameKo||x.id} (${x.status==='closed'?'종료':x.status==='published'?'발행됨':'준비 중'})`;
const draftInfo=(txt:string)=>{$('#ba-draft-info').textContent=txt;};
const productDraft=()=>({id:'__new__',titleKo:'',titleFr:'',descriptionKo:'',descriptionFr:'',supplier:'K커머셜',retailCents:null,packQty:1,boxPriceTtcCents:0,boxPriceHtCents:null,plannedBoxes:null,limitMode:'unlimited',manualLimit:null,storage:'ambient',imageUrl:'',visible:false,soldQty:0,archivedAt:null});
const stamp=(value:string)=>value?new Date(value).toLocaleString('fr-FR',{timeZone:'Europe/Paris'}):'—';
const localTime=(d:string)=>{
 if(!d||!Number.isFinite(Date.parse(d)))return '';
 const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date(d));
 const o=Object.fromEntries(parts.map(x=>[x.type,x.value]));return `${o.year}-${o.month}-${o.day}T${o.hour}:${o.minute}`;
};
// Convert Europe/Paris date-time input to UTC regardless of host timezone.
function parisToIso(local:string){
 const [date,time]=local.split('T'),[y,m,d]=date.split('-').map(Number),[hh,mm]=time.split(':').map(Number);
 const approx=Date.UTC(y,m-1,d,hh,mm);
 const formatter=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'});
 const parts=Object.fromEntries(formatter.formatToParts(new Date(approx)).map(p=>[p.type,p.value]));
 const localRendered=Date.UTC(Number(parts.year),Number(parts.month)-1,Number(parts.day),Number(parts.hour),Number(parts.minute));
 return new Date(approx-(localRendered-approx)).toISOString();
}
const getActive=()=>orders.filter(o=>!o.canceledAt);
const notify=(msg:string)=>{$('#ba-status').textContent=msg;};
let loadVersion=0;
async function load(){const version=++loadVersion;try{const [r,listing]=await Promise.all([adminAction({op:'dashboard',eventId:selectedEventId||undefined}),adminAction({op:'listEvents'})]);if(version!==loadVersion)return;products=r.products;orders=r.orders;event=r.event;readOnly=r.readOnly;isCurrent=r.isCurrent;eventList=listing.events||[];draftList=listing.drafts||[];$('#ba-content').hidden=false;notify('관리자 연결 완료 · '+stamp(new Date().toISOString()));renderEventSelector();render();}catch(e:any){if(version===loadVersion){$('#ba-content').hidden=true;notify(e?.message||'불러오기 실패');}}}
function renderEventSelector(){
 const filter=$('#ba-event-filter') as HTMLSelectElement, draftFilter=$('#ba-draft-filter') as HTMLSelectElement;
 const current=(eventList.find(x=>x.id===selectedEventId)||eventList.find(x=>x.id===event.eventId))?.id||event.eventId;
 filter.innerHTML=eventList.map(x=>`<option value="${h(x.id)}">${h(eventName(x))}</option>`).join('');filter.value=current;
 draftFilter.innerHTML='<option value="">임시저장 불러오기…</option>'+draftList.map(x=>`<option value="${h(x.id)}">${h(x.nameKo)}</option>`).join('');
}
function render(){
 $('#ba-seed').hidden=products.length!==0||readOnly;
 $('#ba-event-id').textContent=event.eventId||'미설정';
 $('#ba-public-links').hidden=event.status!=='published'&&event.status!=='closed';
 const preview=$('#ba-public-preview') as HTMLAnchorElement;
 const search=new URLSearchParams({event:event.eventId||''});
 preview.href=`${preview.dataset.base}?${search}`;
 $('#ba-banner-link').textContent=`bazaar/?${search}`;
 $('#ba-link-message').textContent='';
 $('#ba-event-state').textContent=readOnly?'완료된 행사 · 읽기 전용':event.status==='closed'?'행사 종료 · 방문객에게 종료 안내':event.status==='published'?'발행됨 · 진행 중':'준비 중';
  $('#ba-end-event-panel').hidden=readOnly||event.status!=='published';
 $('#ba-product-section').hidden=readOnly;$('#ba-event-section').hidden=readOnly;$('#ba-history-products').hidden=!readOnly;if(readOnly)renderHistoryProducts();
 $('#ba-finalize').closest('.ba-danger-zone')!.hidden=!isCurrent||!['published','closed'].includes(event.status)||!!event.reconciledAt||(!!event.finalizedAt&&!event.reconciliationStartedAt);
 const active=getActive(),sum=(xs:any[])=>xs.reduce((v,o)=>v+o.totalCents,0),confirmed=active.filter(o=>o.bankConfirmedAt),reported=active.filter(o=>o.transferReportedAt);
 const total=sum(active),actual=sum(confirmed);
