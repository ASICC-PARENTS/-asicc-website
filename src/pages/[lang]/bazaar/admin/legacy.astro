 $('#ba-draft-product-edit').addEventListener('submit',async ev=>{
  ev.preventDefault();const fd=new FormData(ev.target as HTMLFormElement);
  const money=(field:string)=>{const v=String(fd.get(field)||'').trim();return v?Math.round(Number(v)*100):null;};
  const qty=(field:string)=>{const v=String(fd.get(field)||'').trim();return v?Number(v):null;};
  const supplier=String(fd.get('supplier'));
  const boxHt=money('boxHt');const boxTtc=supplier==='K커머셜'&&boxHt!=null?Math.round(boxHt*1.055):money('boxTtc');
  const item={...p,titleKo:String(fd.get('titleKo')||''),titleFr:String(fd.get('titleFr')||''),supplier,retailCents:money('retail'),packQty:qty('packQty'),boxPriceTtcCents:boxTtc,boxPriceHtCents:supplier==='K커머셜'?boxHt:null,plannedBoxes:qty('plannedBoxes'),limitMode:String(fd.get('limitMode')),manualLimit:qty('manualLimit'),storage:String(fd.get('storage')),imageUrl:String(fd.get('imageUrl')||''),descriptionKo:String(fd.get('descriptionKo')||''),descriptionFr:String(fd.get('descriptionFr')||''),included:true};
  try{
   if(creating)item.id=newProductId();
   const file=fd.get('photo');
   if(file instanceof File&&file.size){
    Object.assign(item,await storeEventPhoto(item,openDraftId,file,p,draft.updatedAt));
   }else if(item.imageUrl!==p.imageUrl){
    (item as any).photoPath='';
   }
   if(draft?.id!==openDraftId)return;
   if(creating)draft.items.push(item);
   else draft.items[draft.items.findIndex((x:any)=>x.id===p.id)]=item;
   draftSelectedId=item.id;
   draftInfo('상품 변경이 초안에 적용됐습니다. 임시저장 또는 발행하세요.');
   draftDirty=true;renderDraftProducts();
   if(smallScreen())returnToProduct('#ba-draft-products',item.id,'draft-edit');
  }catch(e:any){alert(e?.message||'상품 변경 실패');}
 });
}
let draftSavePending=false;
async function saveDraft(){
 if(draftSavePending)throw Error('임시저장이 진행 중입니다.');
 draftSavePending=true;
 const current=draft;
 const view=$('#ba-draft-view');
 view.inert=true;
 try{
  captureDraftEvent();
  const items=[];
  for(const item of current.items){
   const photo=await storeEventPhoto(item,current.id,undefined,item,current.updatedAt);
   items.push({...item,...photo});
  }
  const result=await adminAction({op:'saveDraft',id:current.id,event:current.event,items,updatedAt:current.updatedAt});
  current.items=items;current.updatedAt=result.updatedAt;draftDirty=false;
  await refreshEventsOnly();
  draftInfo('임시저장 완료 · 고객에게는 아직 공개되지 않았습니다.');
 }finally{view.inert=false;draftSavePending=false;}
}
$('#ba-draft-save').addEventListener('click',async()=>{try{await saveDraft();}catch(e:any){alert(e?.message||'임시저장 실패');}});
$('#ba-draft-publish').addEventListener('click',async()=>{
 if(!confirm('이 바자회를 발행할까요? 고객 주문 화면에 판매상품과 일정이 적용됩니다. 기존 행사 기록은 보존됩니다.'))return;
 try{await saveDraft();const r=await adminAction({op:'publishDraft',id:draft.id,updatedAt:draft.updatedAt});draft=null;draftDirty=false;selectedEventId=r.eventId;$('#ba-draft-view').hidden=true;$('#ba-dashboard-view').hidden=false;await load();notify('바자회 발행 완료 · 주문 마감 시각 이후에는 새 주문을 받지 않습니다.');}catch(e:any){alert(e?.message||'발행 실패');}
});
$('#ba-draft-delete').addEventListener('click',async()=>{
 if(!confirm('미발행 임시저장을 삭제할까요? 이 초안에서 수정한 내용이 사라집니다.'))return;
 if(prompt('삭제하려면 "임시저장 삭제"를 입력하세요.')!=='임시저장 삭제')return;
 try{await adminAction({op:'deleteDraft',id:draft.id,confirm:true});draft=null;draftDirty=false;$('#ba-draft-view').hidden=true;$('#ba-dashboard-view').hidden=false;await refreshEventsOnly();notify('임시저장 삭제 완료 · 기존 행사/상품/주문 기록은 그대로입니다.');}catch(e:any){alert(e?.message||'초안 삭제 실패');}
});
$('#ba-draft-new-product').addEventListener('click',()=>{draftSelectedId='__new__';renderDraftProductForm();focusEditor('#ba-draft-product-form');});
$('#ba-exit-draft').addEventListener('click',closeDraft);
$('#ba-draft-event-form').addEventListener('input',()=>{draftDirty=true;});
$('#ba-draft-event-form').addEventListener('submit',ev=>ev.preventDefault());
$('#ba-event-filter').addEventListener('change',async ev=>{if(draft)return;selectedEventId=(ev.target as HTMLSelectElement).value||null;await load();});
$('#ba-draft-filter').addEventListener('change',async ev=>{const id=(ev.target as HTMLSelectElement).value;if(!id)return;try{const r=await adminAction({op:'getDraft',id});await openDraft(r.draft);}catch(e:any){alert(e?.message||'초안 열기 실패');}});
$('#ba-seed-btn').addEventListener('click',async()=>{
 if(!confirm('초기 15개 상품을 최초 1회 등록하시겠습니까?'))return;
 try{await adminAction({op:'seed'});await load();}catch(e:any){alert(e?.message||'초기화 실패');}
});
$('#ba-query').addEventListener('input',renderOrders);
$('#ba-refresh').addEventListener('click',load);
$('#ba-export').addEventListener('click',()=>{
 const rows=[['주문번호','성함','전화','이메일','품목','금액(유로)','송금신고','입금확인','취소'],...orders.map(o=>[o.orderRef,o.name,o.phone,o.email,o.items.map((i:any)=>`${i.titleKo}×${i.qty}`).join(' / '),(o.totalCents/100).toFixed(2),o.transferReportedAt?'Y':'N',o.bankConfirmedAt?'Y':'N',o.canceledAt?'Y':'N'])];
 const csv='\uFEFF'+rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(';')).join('\r\n');const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='ASICC_bazaar_orders.csv';a.click();URL.revokeObjectURL(url);
});
$('#ba-finalize').addEventListener('click',async()=>{
 if(!confirm('월요일 최종 은행 대조를 완료했나요? 미입금 주문은 취소되며 취소 메일이 발송됩니다. 되돌리기 어렵습니다.'))return;
 if(prompt('계속하려면 "최종 확인"이라고 입력하세요.')!=='최종 확인')return;
 try{const r=await adminAction({op:'finalizeUnpaid',confirm:true,eventId:event.eventId});alert(`${r.canceled}개 주문이 취소되었습니다.`);await load();}catch(e:any){alert(e?.message||'처리 실패');}
});
onAuthStateChanged(bazaarAuth,async user=>{
 ++loadVersion;
 $('#ba-content').hidden=true;products=[];orders=[];
 if(!user){notify('ASICC 홈페이지에서 운영진 계정으로 로그인한 뒤 이 페이지를 다시 열어 주세요.');return;}
 try{await user.reload();await user.getIdToken(true);if(bazaarAuth.currentUser?.uid===user.uid)await load();}catch(e:any){notify(e?.message||'관리자 확인 오류');}
});
</script>
