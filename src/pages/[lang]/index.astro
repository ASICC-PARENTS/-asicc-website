---
// 홈: 길게 내려가는 소개형 대신, 한 화면에서 주요 정보를 찾는 포털형 구성
import pageCopy from '../../data/cms/pages/index.json';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { langPaths, href, L, formatDate, type Lang } from '../../i18n/ui';
import { LEVELS, EVENTS } from '../../data/site';
import { CATS } from '../../data/news';
import cmsCopy from '../../data/site-copy.json';
import cmsTiles from '../../data/cms/home-tiles.json';
import HomeCampaigns from '../../components/HomeCampaigns.astro';
import HomePopup from '../../components/HomePopup.astro';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const loc = lang === 'ko' ? 'ko-KR' : 'fr-FR';

const news = (await getCollection('news', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const upcoming = [...EVENTS].filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date)).slice(0, 5);

const ICONS: Record<string, string> = {
  admission: '<path d="M3 9l9-5 9 5-9 5-9-5z"/><path d="M7 11v5c3 2 7 2 10 0v-5"/>',
  guide: '<path d="M4 5h7a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4z"/><path d="M20 5h-7v14a2 2 0 0 1 2-2h5z"/>',
  events: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/>',
  members: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  about: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c.8-3.5 3.2-5 6-5s5.2 1.5 6 5M15 15c2.6 0 4.6 1.3 5.5 4"/>',
  contact: '<path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/>',
};
const TILES = cmsTiles.map((x) => ({ k:x.k, path:x.path, t:{ko:x.title_ko,fr:x.title_fr}, s:{ko:x.desc_ko,fr:x.desc_fr} }));
const icon = (k: string) => `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[k]}</svg>`;
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="">
  <section class="intro">
    <div class="wrap intro-in">
      <div class="intro-copy">
        <span class="hero-kicker">SECTION INTERNATIONALE CORÉENNE · COURBEVOIE</span>
        <h1>{lang === 'ko' ? cmsCopy.home_headline_ko : cmsCopy.home_headline_fr}</h1>
        <p>{lang === 'ko' ? cmsCopy.home_intro_ko : cmsCopy.home_intro_fr}</p>
      </div>
      <nav class="intro-schools" aria-label={pageText(lang, 'item_001')}>
        {LEVELS.map((lv) => (
          <a class="intro-school" href={href(lang, `section/#${lv.id}`)}>
            <span class="lv">{L(lang, lv.name)}</span>
            <b>{lv.school}</b>
            <span>{lv.address.replace(', 92400 Courbevoie', '')} · {L(lang, lv.hours).split(' (')[0].split(',')[0]}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <HomeCampaigns lang={lang} />
  <HomePopup lang={lang} />

  <section class="wrap portal" aria-label={pageText(lang, 'item_002')}>
    <nav class="tiles" aria-label={pageText(lang, 'item_003')}>
      {TILES.map((x) => (
        <a class="tile" href={href(lang, x.path)}>
          <span class="tile-ic" set:html={icon(x.k)} />
          <span class="stack"><b>{L(lang, x.t)}</b><span>{L(lang, x.s)}</span></span>
        </a>
      ))}
    </nav>

    <div class="panel">
      <div class="panel-head"><h2>{pageText(lang, 'item_004')}</h2><a href={href(lang, 'news/')}>{pageText(lang, 'item_005')} →</a></div>
      <ul class="plist">
        {news.map((n) => {
          const c = CATS[n.data.category];
          return (
            <li><a href={href(lang, `news/${n.id.split('/')[1]}/`)}>
              <span class="row gap-8"><span class={`pill ${c.pill}`}>{c[lang]}</span><time class="tiny">{formatDate(lang, n.data.date)}</time></span>
              <b>{n.data.title}</b>
            </a></li>
          );
        })}
      </ul>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>{pageText(lang, 'item_006')}</h2><a href={href(lang, 'events/')}>{pageText(lang, 'item_007')} →</a></div>
      <ul class="plist">
        {upcoming.length === 0 && <li><span class="tiny">{pageText(lang, 'item_008')}</span></li>}
        {upcoming.map((e) => {
          const d = new Date(e.date);
          return (
            <li class="ev">
              <span class="datebox sm"><b>{d.getDate()}</b><span>{d.toLocaleDateString(loc, { month: 'short' })}</span></span>
              <span class="stack" style="gap:2px"><b>{L(lang, e.title)}</b><span class="tiny">{L(lang, e.place)}{e.tentative && <> · {pageText(lang, 'item_009')}</>}</span></span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

</Base>
