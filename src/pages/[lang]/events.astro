---
import Base from '../../layouts/Base.astro';
import pageCopy from '../../data/cms/pages/events.json';
import PageHero from '../../components/PageHero.astro';
import { langPaths, L, type Lang } from '../../i18n/ui';
import { EVENTS, ANNUAL } from '../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const loc = lang === 'ko' ? 'ko-KR' : 'fr-FR';
const KIND = {
  info: { ko: '입학', fr: 'Admissions', pill: 'pill-accent' },
  asso: { ko: '협회', fr: 'Association', pill: 'pill-navy' },
  school: { ko: '학교 행사', fr: 'École', pill: 'pill-olive' },
} as const;
const byMonth = new Map<string, typeof EVENTS>();
for (const e of [...EVENTS].sort((a, b) => a.date.localeCompare(b.date))) {
  const k = new Date(e.date).toLocaleDateString(loc, { year: 'numeric', month: 'long' });
  byMonth.set(k, [...(byMonth.get(k) ?? []), e]);
}
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="events/" title={pageText(lang, 'item_001')}>
  <PageHero lang={lang} eyebrow={pageText(lang, 'item_002')}
    title={pageText(lang, 'item_003')}
    intro={pageText(lang, 'item_004')}>
    <p class="small muted" style="margin-top:12px">{pageText(lang, 'item_005')}</p>
  </PageHero>
  <section class="wrap sec" style="max-width:880px">
    {[...byMonth.entries()].map(([month, list]) => (
      <>
        <h2 class="month">{month}</h2>
        {list.map((e) => {
          const d = new Date(e.date);
          return (
            <article class="card event">
              <div class="datebox"><b>{d.getDate()}</b><span>{d.toLocaleDateString(loc, { weekday: 'short' })}</span></div>
              <div class="info">
                <div class="row gap-8"><span class={`pill ${KIND[e.kind].pill}`}>{KIND[e.kind][lang]}</span>{e.tentative && <span class="pill pill-warn">{pageText(lang, 'item_006')}</span>}</div>
                <h3 class="h3" style="font-size:17px">{L(lang, e.title)}</h3>
                <span class="tiny"><span>{L(lang, e.place)}</span>{e.time && <span>{L(lang, e.time)}</span>}</span>
                {e.desc && <p class="small muted">{L(lang, e.desc)}</p>}
              </div>
            </article>
          );
        })}
      </>
    ))}
    <h2 class="h2" style="margin-top:56px">{pageText(lang, 'item_007')}</h2>
    <p class="muted" style="margin:8px 0 20px">{pageText(lang, 'item_008')}</p>
    <div class="table-wrap" id="events-annual">
      <table>
        <thead><tr><th style="width:28%">{pageText(lang, 'item_009')}</th><th>{pageText(lang, 'item_010')}</th></tr></thead>
        <tbody>{ANNUAL.map((a) => <tr><td><b>{L(lang, a.when)}</b></td><td>{a.items.map((i) => <div>{L(lang, i)}</div>)}</td></tr>)}</tbody>
      </table>
    </div>
  </section>
</Base>
