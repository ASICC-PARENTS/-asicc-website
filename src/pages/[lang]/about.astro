---
import Base from '../../layouts/Base.astro';
import cmsToc from '../../data/cms/toc-about.json';
import pageCopy from '../../data/cms/pages/about.json';
import PageHero from '../../components/PageHero.astro';
import { langPaths, href, L, type Lang } from '../../i18n/ui';
import { BUREAU, HISTORY, PARTNERS, AXES } from '../../data/site';
import cmsCopy from '../../data/site-copy.json';
import cmsLetter from '../../data/cms/about-letter.json';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
// 공개 여부 전환: true로 바꾸면 세 섹션과 목차가 다시 나타납니다.
const SHOW_EXTENDED_ABOUT = cmsCopy.show_extended_about;
const toc = cmsToc.map((x) => [x.id, { ko:x.ko, fr:x.fr }] as const);
const name = (b: (typeof BUREAU)[number]) => (lang === 'fr' && b.latin ? b.latin : b.name);
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="about/" title={pageText(lang, 'item_001')}>
  <PageHero lang={lang} eyebrow={pageText(lang, 'item_002')}
    title={lang === 'ko' ? cmsCopy.about_title_ko : cmsCopy.about_title_fr}
    intro={lang === 'ko' ? cmsCopy.about_intro_ko : cmsCopy.about_intro_fr} />

  <div class="wrap sec with-aside">
    <aside><nav class="toc" aria-label={pageText(lang, 'item_003')}>{toc.slice(0, SHOW_EXTENDED_ABOUT ? 7 : 4).map(([id, l]) => <a href={`#${id}`}>{L(lang, l)}</a>)}</nav></aside>
    <div class="content stack" style="gap:72px">

      <section id="greeting" class="doc-section">
        <h2 class="h2">{L(lang, toc[0][1])}</h2>
        <div class="letter">
          {cmsLetter[lang].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p class="sign">{cmsLetter[lang].signature}</p>
        </div>
      </section>

      <section id="mission" class="doc-section">
        <h2 class="h2">{L(lang, toc[1][1])}</h2>
        <p>{pageText(lang, 'item_004')}</p>
        <div class="callout">{pageText(lang, 'item_005')}</div>
      </section>

      <section id="axes" class="doc-section">
        <h2 class="h2">{L(lang, toc[2][1])}</h2>
        <p>{pageText(lang, 'item_006')}</p>
        <div class="grid g-2">
          {AXES.map((x) => (
            <article class="card axis" style={`border-top:3px solid ${x.color}`}>
              <span class="tag" style={`color:${x.color}`}>{L(lang, x.tag)}</span>
              <h3>{L(lang, x.title)}</h3>
              <p>{L(lang, x.text)}</p>
              <ul>{x.items.map((i) => <li>{L(lang, i)}</li>)}</ul>
              <p class="tiny" style="margin-top:4px"><b style="color:var(--ink-2)">{pageText(lang, 'item_007')}</b> · {L(lang, x.result)}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="history" class="doc-section">
        <h2 class="h2">{L(lang, toc[3][1])}</h2>
        <ol class="history">
          {HISTORY.map((h) => <li><time>{L(lang, h.date)}</time><b>{L(lang, h.title)}</b><p style="font-size:15.5px;line-height:1.8;color:var(--ink-2)">{L(lang, h.text)}</p></li>)}
        </ol>
      </section>

      {SHOW_EXTENDED_ABOUT && (
      <section id="bureau" class="doc-section">
        <h2 class="h2">{L(lang, toc[4][1])}</h2>
        <p>{pageText(lang, 'item_008')}</p>
        <h3>{pageText(lang, 'item_009')}</h3>
        <div class="grid g-4">
          {BUREAU.slice(0, 4).map((b) => <div class="card card-pad stack gap-8"><span class="tiny">{L(lang, b.role)}</span><b style="font-size:18px">{name(b)}</b></div>)}
        </div>
        <h3>{pageText(lang, 'item_010')}</h3>
        <div class="grid g-3">
          {BUREAU.slice(4).map((b) => <div class="card card-pad stack gap-8"><span class="tiny">{L(lang, b.role)}</span><b style="font-size:18px">{name(b)}</b></div>)}
        </div>
      </section>
      )}

      {SHOW_EXTENDED_ABOUT && (
      <section id="structure" class="doc-section">
        <h2 class="h2">{L(lang, toc[5][1])}</h2>
        <p>{pageText(lang, 'item_011')}</p>
        <div class="grid g-2">
          <div class="stack gap-12">
            <h3>{pageText(lang, 'item_012')}</h3>
            {PARTNERS.filter((p) => p.side === 'kr').map((p) => <a class="card card-link card-pad stack gap-8" href={p.href} rel="noopener" target="_blank"><b style="font-size:16.5px">{L(lang, p.name)} ↗</b><span class="tiny">{L(lang, p.role)}</span></a>)}
          </div>
          <div class="stack gap-12">
            <h3>{pageText(lang, 'item_013')}</h3>
            {PARTNERS.filter((p) => p.side === 'fr').map((p) => <a class="card card-link card-pad stack gap-8" href={p.href} rel="noopener" target="_blank"><b style="font-size:16.5px">{L(lang, p.name)} ↗</b><span class="tiny">{L(lang, p.role)}</span></a>)}
          </div>
        </div>
      </section>
      )}

      {SHOW_EXTENDED_ABOUT && (
      <section id="statuts" class="doc-section">
        <h2 class="h2">{L(lang, toc[6][1])}</h2>
        <ul class="bullets">
          <li>{pageText(lang, 'item_014')}</li>
          <li>{pageText(lang, 'item_015')}</li>
          <li>{pageText(lang, 'item_016')}</li>
          <li>{pageText(lang, 'item_017')}</li>
          <li>{pageText(lang, 'item_018')}</li>
          <li>{pageText(lang, 'item_019')}</li>
        </ul>
        <div class="row gap-12">
          <a class="btn btn-ghost" href={href(lang, 'membres/')}>{pageText(lang, 'item_020')}</a>
        </div>
      </section>
      )}
    </div>
  </div>
</Base>
