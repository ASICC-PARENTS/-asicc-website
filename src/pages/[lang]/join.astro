---
import Base from '../../layouts/Base.astro';
import pageCopy from '../../data/cms/pages/join.json';
import PageHero from '../../components/PageHero.astro';
import { langPaths, href, L, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="join/" title={pageText(lang, 'item_001')}>
  <PageHero lang={lang} eyebrow={pageText(lang, 'item_002')}
    title={pageText(lang, 'item_003')}
    intro={pageText(lang, 'item_004')} />

  <section class="wrap sec">
    <div class="grid g-2">
      <article class="card card-pad stack gap-12" id="account">
        <span class="pill pill-navy" style="align-self:flex-start">1</span>
        <h2 class="h3">{pageText(lang, 'item_005')}</h2>
        <p class="muted small">{pageText(lang, 'item_006')}</p>
        <ol class="small muted" style="padding-left:1.2em">
          <li>{pageText(lang, 'item_007')}</li>
          <li>{pageText(lang, 'item_008')}</li>
          <li>{pageText(lang, 'item_009')}</li>
        </ol>
        <span class="pill pill-gray" style="align-self:flex-start">{pageText(lang, 'item_010')}</span>
      </article>

      <article class="card card-pad stack gap-12" id="cotisation">
        <span class="pill pill-navy" style="align-self:flex-start">2</span>
        <h2 class="h3">{pageText(lang, 'item_011')}</h2>
        
        <p class="muted small">{pageText(lang, 'item_012')}</p>
        <span class="pill pill-gray" style="align-self:flex-start">{pageText(lang, 'item_013')}</span>
        <span class="tiny">{pageText(lang, 'item_014')}</span>
      </article>

      <article class="card card-pad stack gap-12" id="volunteer">
        <span class="pill pill-navy" style="align-self:flex-start">3</span>
        <h2 class="h3">{pageText(lang, 'item_015')}</h2>
        <p class="muted small">{pageText(lang, 'item_016')}</p>
        <div class="checks small">
          {[{ ko: '회의록 정리', fr: 'Comptes rendus' }, { ko: '홍보·SNS', fr: 'Communication' }, { ko: '행사 준비', fr: 'Événements' }, { ko: '번역(한·불)', fr: 'Traduction' }, { ko: '관계기관 연락', fr: 'Relations institutionnelles' }, { ko: '웹사이트', fr: 'Site web' }].map((x) => <span class="pill pill-gray">{L(lang, x)}</span>)}
        </div>
        <a class="btn btn-ghost" style="align-self:flex-start" href="mailto:contact@asicc-parents.fr?subject=ASICC%20-%20B%C3%A9n%C3%A9volat">{pageText(lang, 'item_017')}</a>
      </article>

      <article class="card card-pad stack gap-12" id="partners">
        <span class="pill pill-navy" style="align-self:flex-start">4</span>
        <h2 class="h3">{pageText(lang, 'item_018')}</h2>
        <p class="muted small">{pageText(lang, 'item_019')}</p>
        <a class="btn btn-ghost" style="align-self:flex-start" href="mailto:contact@asicc-parents.fr?subject=ASICC%20-%20Partenariat">{pageText(lang, 'item_020')}</a>
      </article>
    </div>
  </section>

  <section class="band" id="newsletter">
    <div class="wrap sec split">
      <div class="side">
        <span class="eyebrow">{pageText(lang, 'item_021')}</span>
        <h2 class="h2">{pageText(lang, 'item_022')}</h2>
        <p class="lead">{pageText(lang, 'item_023')}</p>
      </div>
      <form class="main card card-pad form" data-public-form="subscribers" novalidate>
        <label class="field">{pageText(lang, 'item_024')}<input name="email" type="email" autocomplete="email" required></label>
        <label class="field">{pageText(lang, 'item_025')}
          <select name="lang"><option value="ko" selected={lang === 'ko'}>한국어</option><option value="fr" selected={lang === 'fr'}>Français</option><option value="both">한국어 + Français</option></select>
        </label>
        <label class="check full"><input type="checkbox" name="consent" required>{pageText(lang, 'item_026')}</label>
        <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="full row gap-16"><button class="btn btn-dark" type="submit">{pageText(lang, 'item_027')}</button><span class="err" data-form-msg role="status"></span></div>
      </form>
    </div>
  </section>
  <script>import '../../scripts/public-forms';</script>
</Base>
