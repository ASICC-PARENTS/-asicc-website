---
import cmsCopy from '../../data/site-copy.json';
import pageCopy from '../../data/cms/pages/contact.json';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { langPaths, L, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const TYPES = [
  ['admission', { ko: '입학 문의', fr: 'Admissions' }],
  ['asso', { ko: '협회 활동', fr: 'Vie de l’association' }],
  ['volunteer', { ko: '실무진 참여', fr: 'Bénévolat' }],
  ['partner', { ko: '협력·후원 제안', fr: 'Partenariat' }],
  ['press', { ko: '언론·기관', fr: 'Presse, institutions' }],
  ['other', { ko: '기타', fr: 'Autre' }],
] as const;
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="contact/" title={pageText(lang, 'item_001')}>
  <PageHero lang={lang} eyebrow={pageText(lang, 'item_002')}
    title={pageText(lang, 'item_003')}
    intro={pageText(lang, 'item_004')} />
  <section class="wrap sec split">
    <div class="side">
      <h2 class="h3">{pageText(lang, 'item_005')}</h2>
      <div class="card card-pad stack gap-8 small">
        <div class="kv"><span class="muted">E-mail</span><a href={`mailto:${cmsCopy.contact_email}`}>{cmsCopy.contact_email}</a></div>
        <a class="btn btn-accent" href={`mailto:${cmsCopy.contact_email}`} style="align-self:flex-start">{pageText(lang, 'item_006')}</a>

        
      </div>
      
    </div>
  
<form class="main card card-pad form" action="https://formspree.io/f/xdeggdyr" method="POST">
  
      <label class="field">{pageText(lang, 'item_007')}<input name="name" autocomplete="name" required></label>
      <label class="field">{pageText(lang, 'item_008')}<input name="email" type="email" autocomplete="email" required></label>
      <label class="field">{pageText(lang, 'item_009')}
        <select name="type" id="ctype">{TYPES.map(([v, l]) => <option value={v}>{L(lang, l)}</option>)}</select>
      </label>
      <label class="field">{pageText(lang, 'item_010')}
        <select name="level"><option value="">{pageText(lang, 'item_011')}</option><option value="mat">{pageText(lang, 'item_012')}</option><option value="elem">{pageText(lang, 'item_013')}</option><option value="col">{pageText(lang, 'item_014')}</option></select>
      </label>
      <label class="field full">{pageText(lang, 'item_015')}<textarea name="message" rows="6" required></textarea></label>
      <label class="check full"><input type="checkbox" name="consent" required>{pageText(lang, 'item_016')}</label>
      <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="full row gap-16"><button class="btn btn-dark" type="submit">{pageText(lang, 'item_017')}</button><span class="err" data-form-msg role="status"></span></div>
    </form>
  </section>
  <!-- Newsletter subscription is temporarily hidden. Restore from Git history if needed. -->
  <script>
    const t = new URLSearchParams(location.search).get('type');
    const s = document.getElementById('ctype') as HTMLSelectElement;
    if (t && [...s.options].some((o) => o.value === t)) s.value = t;
  </script>
</Base>
