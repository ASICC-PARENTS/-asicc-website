---
import cmsCopy from '../../data/site-copy.json';
import pageCopy from '../../data/cms/pages/legal.json';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { langPaths, L, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const ko = lang === 'ko';
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="legal/" title={pageText(lang, 'item_001')}>
  <PageHero lang={lang} eyebrow={pageText(lang, 'item_002')}
    title={pageText(lang, 'item_003')}
    intro={pageText(lang, 'item_004')} />
  <div class="wrap sec">
    <div class="prose">
      <h2 id="mentions">{ko ? '사이트 운영자' : 'Éditeur du site'}</h2>
      <ul>
        <li>Association de la Section Internationale Coréenne à Courbevoie (ASICC), {ko ? '1901년 법에 따른 비영리 협회, 2026년 4월 28일 신고' : 'association loi 1901 déclarée le 28 avril 2026'}</li>
        <li>{ko ? '소재지' : 'Siège'} : <span class="placeholder">[adresse]</span> · RNA : <span class="placeholder">[W92…]</span></li>
        <li>{ko ? '발행 책임자' : 'Directrice de la publication'} : {ko ? '협회장' : 'la présidente de l’association'}</li>
        <li>{ko ? '연락처' : 'Contact'} : <a href={`mailto:${cmsCopy.contact_email}`}>{cmsCopy.contact_email}</a></li>
      </ul>
      <h2>{ko ? '호스팅' : 'Hébergement'}</h2>
      <p>GitHub Pages · GitHub, Inc. (publication des pages statiques).</p>

      <h2 id="privacy">{ko ? '개인정보 처리방침' : 'Politique de confidentialité'}</h2>
      <p class="notice notice-warn">{ko ? 'ASICC 회원 서비스 시험 운영 안내: 아래 내용은 실제 구현 기능을 반영한 검토 초안입니다. 공개 전 협회가 보관 기간, 법적 근거, 수탁사·처리 리전 및 책임자 연락처를 최종 확인해야 합니다.' : 'Service membres en test : cette notice est un projet à valider. Avant la mise en service, l’association doit confirmer les durées, bases légales, prestataires, régions de traitement et responsables.'}</p>
      <h3>{ko ? '처리 책임자·문의' : 'Responsable et contact'}</h3>
      <p>Association de la Section Internationale Coréenne à Courbevoie (ASICC) · <a href={`mailto:${cmsCopy.contact_email}`}>{cmsCopy.contact_email}</a></p>
      <h3>{ko ? '회원정보 및 처리 목적' : 'Données et finalités'}</h3>
      <ul>
        <li>{ko ? '회원 계정: 실명, 닉네임, 이메일, Firebase 인증 식별자 및 이메일 인증 상태, 회원 등급·계정 상태, 약관 확인 기록. 회원 확인·접근통제·계정관리에 필요합니다.' : 'Compte : nom réel, pseudonyme, e-mail, identifiant d’authentification Firebase, vérification de l’e-mail, statut du compte et trace des règles acceptées. Finalités : gestion du compte et contrôle d’accès.'}</li>
        <li>{ko ? '승급 신청: 학생 이름, 학교·학년, 졸업·전학 정보, 신청자와 학생의 관계, 기여 내용 및 승인 기록. 운영진이 자격 확인에 사용합니다.' : 'Demandes de statut : nom, école, classe, scolarité antérieure de l’élève, lien de parenté, contribution et décision. Utilisées pour examiner l’éligibilité.'}</li>
        <li>{ko ? '게시판: 닉네임, 글·댓글 내용 및 작성 시각, 필요시 삭제 처리 기록. 실명과 학생정보를 공개하지 않도록 설계합니다.' : 'Forum : pseudonyme, messages, commentaires, dates et journal minimal des suppressions. Le nom réel et les informations des enfants ne sont pas destinés à être publics.'}</li>
        <li>{ko ? '비공개 건의: 신청자 계정 ID, 건의 내용, 처리 상태 및 답변. 운영진과 신청자 본인만 열람합니다.' : 'Suggestions privées : identifiant du membre, message, suivi et réponse, visibles par l’auteur et les administrateurs.'}</li>
      </ul>
      <h3>{ko ? '열람 범위 및 서비스 제공자' : 'Destinataires et prestataires'}</h3>
      <p>{ko ? '실명·이메일·학생 정보는 권한이 부여된 운영진과 계정 소유자만 조회하도록 구성합니다. 게시판에 노출되는 작성자 이름은 닉네임입니다. 서비스 운영에는 Google Firebase Authentication 및 Cloud Firestore 등이 사용됩니다. 데이터의 실제 저장 지역과 국외 이전 여부는 협회가 별도로 확인하여 고지해야 합니다.' : 'Les données nominatives et scolaires sont limitées au titulaire du compte et aux administrateurs habilités ; seul le pseudonyme est affiché sur le forum. Le service utilise notamment Google Firebase Authentication et Cloud Firestore. Les régions de traitement et transferts doivent être confirmés et documentés.'}</p>
      <h3>{ko ? '보관 기간·회원 권리' : 'Durées et droits des personnes'}</h3>
      <p>{ko ? '회원정보의 구체적인 보관 기간과 탈퇴 후 삭제·예외 보존 기준은 협회가 확정해야 합니다. 정보 주체는 열람·정정·삭제 등 관련 법령에 따른 권리를 협회 이메일로 요청할 수 있고, 프랑스 CNIL에 민원을 제기할 수 있습니다. 현재 홈페이지의 「내 정보 관리」에서는 닉네임 변경 및 실명 변경 신청을 지원하며, 계정 탈퇴·완전 삭제 요청은 협회에 문의해야 합니다.' : 'Les durées de conservation et les procédures de suppression après départ doivent être arrêtées par l’association. Les personnes peuvent demander accès, rectification, effacement et exercer les droits prévus par la loi par e-mail, ainsi que saisir la CNIL. « Mon profil » permet de modifier le pseudo et de demander une rectification du nom ; la suppression du compte se demande actuellement à l’association.'}</p>
      <h3>{ko ? '아동 이미지' : 'Images des enfants'}</h3>
      <p>{ko ? '사진·영상·음성 공개는 본 회원가입 확인과 별개입니다. 촬영·이용 목적, 범위, 기간을 설명한 별도의 동의를 확인한 뒤 게시해야 합니다.' : 'La publication des photos, vidéos et voix des mineurs exige un accord spécifique, distinct des règles d’inscription, précisant les usages et les durées.'}</p>
      <h3>{ko ? '쿠키 및 로그인' : 'Cookies et session'}</h3>
      <p>{ko ? '인증 상태를 유지하기 위한 브라우저 저장 공간과 언어 선택 기능을 사용합니다. 광고용 쿠키 사용 여부 등 상세 기술 정보는 서비스 개통 전 최종 확인합니다.' : 'Le site utilise les mécanismes nécessaires à la session et à la langue. L’usage éventuel de cookies non essentiels doit être vérifié avant ouverture.'}</p>
    </div>
  </div>
</Base>
