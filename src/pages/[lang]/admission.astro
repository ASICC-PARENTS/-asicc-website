---
import Base from '../../layouts/Base.astro';
import cmsToc from '../../data/cms/toc-admission.json';
import pageCopy from '../../data/cms/pages/admission.json';
import PageHero from '../../components/PageHero.astro';
import { langPaths, href, L, type Lang } from '../../i18n/ui';
import { FAQ, PROFILES, EXPECTED, CAMPAIGN, WAVE2, ADMISSION_NOTES, ADMISSION_CONTACTS, NEXT_YEAR } from '../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const toc = cmsToc.map((x) => [x.id, { ko:x.ko, fr:x.fr }] as const);
const ENTRIES = [
  { lv: { ko: '유치원 (PS·MS·GS)', fr: 'Maternelle (PS, MS, GS)' }, when: { ko: '유치원 입학 예정 학년도 전년도 11월~12월', fr: 'Novembre–décembre précédant la rentrée' }, how: { ko: '교육청 정기 모집(1차). 빈자리가 있으면 MS·GS 중간 학년 입학도 심사합니다.', fr: 'Campagne académique ; entrée en MS ou GS selon les places.' } },
  { lv: { ko: '초등학교 (CP~CM2)', fr: 'Élémentaire (CP à CM2)' }, when: { ko: 'GS 재학 중 11월~12월 (CP 진입)', fr: 'En GS, novembre–décembre (entrée au CP)' }, how: { ko: '유치원 국제섹션 재학생도 초등학교 진학 시 별도의 지원 절차를 거칩니다. 중간 학년 입학은 모집 가능 인원과 학생 평가 결과 등을 고려하여 결정됩니다.', fr: 'Les élèves de SI maternelle candidatent à nouveau ; entrée en cours de cycle selon les places.' } },
  { lv: { ko: '중학교 (6e~3e)', fr: 'Collège (6e à 3e)' }, when: { ko: 'CM2 재학 중 2월 (6e 진입)', fr: 'En CM2 (entrée en 6e)' }, how: { ko: '중학교용 지원서가 교육청 누리집에 별도로 게시됩니다. 일정은 학교에 확인합니다.', fr: 'Dossier spécifique publié par l’académie ; calendrier auprès du collège.' } },
];
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="admission/" title={pageText(lang, 'item_001')}>
  <PageHero lang={lang} eyebrow={pageText(lang, 'item_002')}
    title={L(lang, { ko: `${NEXT_YEAR.ko} 한국어 국제섹션 입학 안내`, fr: `Admissions, ${NEXT_YEAR.fr}` })}
    intro={pageText(lang, 'item_003')}>
    <div class="row gap-12" style="margin-top:6px">
      <a class="btn btn-accent" href="https://www.ac-versailles.fr/si92" rel="noopener">{pageText(lang, 'item_004')} ↗</a>
      <a class="btn btn-light" href="#session">{pageText(lang, 'item_005')}</a>
    </div>
  </PageHero>

  <div class="wrap sec with-aside">
    <aside><nav class="toc" aria-label={pageText(lang, 'item_006')}>{toc.map(([id, l]) => <a href={`#${id}`}>{L(lang, l)}</a>)}</nav></aside>
    <div class="content stack" style="gap:72px">

      <section id="first" class="doc-section">
        <h2 class="h2">{L(lang, toc[0][1])}</h2>
        <p>{pageText(lang, 'item_007')}</p>
        <div class="grid g-3">
          <div class="card feature"><span class="eyebrow">01</span><h3 class="h3" style="font-size:17px">{pageText(lang, 'item_008')}</h3><p>{pageText(lang, 'item_009')} <a href={href(lang, 'section/')}>{pageText(lang, 'item_010')} →</a></p></div>
          <div class="card feature"><span class="eyebrow">02</span><h3 class="h3" style="font-size:17px">{pageText(lang, 'item_011')}</h3><p>{pageText(lang, 'item_012')}</p></div>
          <div class="card feature"><span class="eyebrow">03</span><h3 class="h3" style="font-size:17px">{pageText(lang, 'item_013')}</h3><p>{pageText(lang, 'item_014')}</p></div>
        </div>
      </section>

      <section id="who" class="doc-section">
        <h2 class="h2">{L(lang, toc[1][1])}</h2>
        <p>{pageText(lang, 'item_015')}</p>
        <div class="grid g-3">
          {PROFILES.map((p) => <div class="card feature"><h3 class="h3" style="font-size:17px">{L(lang, p.title)}</h3><p>{L(lang, p.text)}</p></div>)}
        </div>
        <h3>{pageText(lang, 'item_016')}</h3>
        <p>{pageText(lang, 'item_017')}</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>{pageText(lang, 'item_018')}</th><th>{pageText(lang, 'item_019')}</th></tr></thead>
            <tbody>{EXPECTED.map((e) => <tr><td>{L(lang, e.when)}</td><td><b>{L(lang, e.level)}</b></td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section id="commitment" class="doc-section">
        <h2 class="h2">{L(lang, toc[2][1])}</h2>
        <p>{pageText(lang, 'item_020')}</p>
        <ul class="bullets">
          <li>{pageText(lang, 'item_021')}</li>
          <li>{pageText(lang, 'item_022')}</li>
          <li>{pageText(lang, 'item_023')}</li>
          <li>{pageText(lang, 'item_024')}</li>
        </ul>
      </section>

      <section id="steps" class="doc-section">
        <h2 class="h2">{L(lang, toc[3][1])}</h2>
        <h3>{pageText(lang, 'item_025')}</h3>
        <ol class="timeline-h">
          {CAMPAIGN.map((c, i) => <li><span class="when">{L(lang, c.when)}</span><b>{L(lang, c.what)}</b><span>{L(lang, c.detail)}</span></li>)}
        </ol>
        <h3>{pageText(lang, 'item_026')}</h3>
        <p>{L(lang, WAVE2)}</p>
        <div class="callout">{pageText(lang, 'item_027')}</div>
      </section>

      <section id="entries" class="doc-section">
        <h2 class="h2">{L(lang, toc[4][1])}</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>{pageText(lang, 'item_028')}</th><th>{pageText(lang, 'item_029')}</th><th>{pageText(lang, 'item_030')}</th></tr></thead>
            <tbody>{ENTRIES.map((e) => <tr><td><b>{L(lang, e.lv)}</b></td><td>{L(lang, e.when)}</td><td>{L(lang, e.how)}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section id="notes" class="doc-section">
        <h2 class="h2">{L(lang, toc[5][1])}</h2>
        <ul class="bullets">{ADMISSION_NOTES.map((n) => <li>{L(lang, n)}</li>)}</ul>
      </section>

      <section id="contacts" class="doc-section">
        <h2 class="h2">{L(lang, toc[6][1])}</h2>
        <div class="card card-pad">
          {ADMISSION_CONTACTS.map((c) => <div class="kv"><span class="muted">{L(lang, c.label)}</span>{c.href ? <a href={c.href} rel="noopener">{c.value}</a> : <span>{c.value}</span>}</div>)}
        </div>
        <div class="callout jjok">{pageText(lang, 'item_031')}</div>
      </section>

      <section id="session" class="doc-section">
        <h2 class="h2">{L(lang, toc[7][1])}</h2>
        <p>{L(lang,{ko:'2026년 12월 4일(금) 저녁 8시 온라인 입학설명회에 참가하실 수 있습니다.',fr:'Inscrivez-vous à la réunion d’information en ligne du vendredi 4 décembre 2026 à 20 h.'})}</p>
        <a class="btn btn-dark" href={href(lang,'admission/session/')}>{L(lang,{ko:'온라인 입학설명회 참가 신청',fr:'S’inscrire à la réunion d’information'})} →</a>
      </section>

      <section id="faq" class="doc-section">
        <h2 class="h2">{L(lang, toc[8][1])}</h2>
        <div class="faq">
          {FAQ.map((f) => <details><summary>{L(lang, f.q)}</summary><div class="ans">{L(lang, f.a)}</div></details>)}
        </div>
        <p class="small muted">{pageText(lang, 'item_042')} <a href={href(lang, 'contact/')}>{pageText(lang, 'item_043')}</a></p>
      </section>
    </div>
  </div>
  <script>import '../../scripts/public-forms';</script>
</Base>
