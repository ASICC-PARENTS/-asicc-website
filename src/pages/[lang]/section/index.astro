---
import Base from '../../../layouts/Base.astro';
import cmsToc from '../../../data/cms/toc-section-index.json';
import pageCopy from '../../../data/cms/pages/section-index.json';
import PageHero from '../../../components/PageHero.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
import { LEVELS } from '../../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const toc = cmsToc.map((x) => [x.id, { ko:x.ko, fr:x.fr }] as const);
const CYCLES = [
  { c: { ko: '1단계 (cycle 1)', fr: 'Cycle 1' }, n: { ko: '첫 배움', fr: 'Apprentissages premiers' }, g: 'PS · MS · GS', age: '3–5', si: { ko: '유치원 섹션 (Théophile Gautier) · 주 4회', fr: 'SI maternelle (Théophile Gautier), 4 séances par semaine' }, on: true },
  { c: { ko: '2단계 (cycle 2)', fr: 'Cycle 2' }, n: { ko: '기초 학습', fr: 'Apprentissages fondamentaux' }, g: 'CP · CE1 · CE2', age: '6–8', si: { ko: '초등 섹션 (Armand Silvestre) · 주 4회: 문학, 음악, 세계 탐구', fr: 'SI élémentaire (Armand Silvestre), 4 séances par semaine : littérature, musique, questionner le monde' }, on: true },
  { c: { ko: '3단계 (cycle 3)', fr: 'Cycle 3' }, n: { ko: '다지기', fr: 'Consolidation' }, g: 'CM1 · CM2 · 6e', age: '9–11', si: { ko: 'CM1·CM2: 초등 섹션 (문학, 음악, 역사·지리) / 6e: 중학 섹션 (Les Bruyères)', fr: 'CM1–CM2 : littérature, musique, histoire-géographie ; 6e : collège Les Bruyères' }, on: true },
  { c: { ko: '4단계 (cycle 4)', fr: 'Cycle 4' }, n: { ko: '심화', fr: 'Approfondissements' }, g: '5e · 4e · 3e', age: '12–14', si: { ko: '중학 섹션 (Les Bruyères) · 3e 말 DNB 국제 옵션', fr: 'Collège Les Bruyères ; DNB option internationale en fin de 3e' }, on: true },
  { c: { ko: '고등학교', fr: 'Lycée' }, n: { ko: '바칼로레아 준비', fr: 'Vers le baccalauréat' }, g: '2nde · 1re · Terminale', age: '15–17', si: { ko: '한국어 섹션은 현재 중학교까지 운영', fr: 'Section coréenne actuellement ouverte jusqu’au collège' }, on: false },
];
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="section/" title={pageText(lang, 'item_001')}>
  <PageHero lang={lang} eyebrow={pageText(lang, 'item_002')}
    title={pageText(lang, 'item_003')}
    intro={pageText(lang, 'item_004')} />

  <div class="wrap sec with-aside">
    <aside><nav class="toc" aria-label={pageText(lang, 'item_005')}>{toc.map(([id, l]) => <a href={id === 'guide' ? href(lang, 'section/guide/') : `#${id}`}>{L(lang, l)}</a>)}</nav></aside>
    <div class="content stack" style="gap:72px">

      <section id="overview" class="doc-section">
        <h2 class="h2">{L(lang, toc[0][1])}</h2>
        <p>{pageText(lang, 'item_006')}</p>
        <p>{pageText(lang, 'item_007')}</p>
        <div class="callout">{pageText(lang, 'item_008')}</div>
      </section>

      <section id="system" class="doc-section">
        <h2 class="h2">{L(lang, toc[1][1])}</h2>
        <p>{pageText(lang, 'item_009')}</p>
        <div class="table-wrap">
          <table class="cycle-table">
            <thead><tr><th>{pageText(lang, 'item_010')}</th><th>{pageText(lang, 'item_011')}</th><th>{pageText(lang, 'item_012')}</th><th>{pageText(lang, 'item_013')}</th></tr></thead>
            <tbody>
              {CYCLES.map((r) => (
                <tr class={r.on ? 'si-row' : ''}>
                  <td><b>{L(lang, r.c)}</b><br><span class="tiny">{L(lang, r.n)}</span></td>
                  <td>{r.g}</td><td>{r.age}</td><td>{L(lang, r.si)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tiny">{pageText(lang, 'item_014')} <a href={href(lang, 'section/guide/#grades')}>{pageText(lang, 'item_015')} →</a></p>
      </section>

      <section id="integration" class="doc-section">
        <h2 class="h2">{L(lang, toc[2][1])}</h2>
        <h3>{pageText(lang, 'item_016')}</h3>
        <p>{pageText(lang, 'item_017')}</p>
        <h3>{pageText(lang, 'item_018')}</h3>
        <p>{pageText(lang, 'item_019')}</p>
        <h3>{pageText(lang, 'item_020')}</h3>
        <p>{pageText(lang, 'item_021')}</p>
        <div class="callout jjok">{pageText(lang, 'item_022')}</div>
      </section>

      <section id="schools" class="doc-section">
        <h2 class="h2">{L(lang, toc[3][1])}</h2>
        <p>{pageText(lang, 'item_023')}</p>
        {LEVELS.map((lv) => (
          <article id={lv.id} class="card school-card" style="scroll-margin-top:96px">
            <div class="head">
              <div class="stack" style="gap:2px"><span class="eyebrow">{lv.code}</span><h3 style="font-family:var(--serif);font-size:22px">{L(lang, lv.name)} · {lv.school}</h3></div>
              <span class="tiny">{lv.address}</span>
            </div>
            <div class="body">
              <div><h4>{pageText(lang, 'item_024')}</h4><p>{L(lang, lv.hours)}</p></div>
              <div><h4>{pageText(lang, 'item_025')}</h4><ul>{lv.subjects.map((s) => <li>{L(lang, s)}</li>)}</ul></div>
              <div><h4>{pageText(lang, 'item_026')}</h4><p>{L(lang, lv.desc)}</p></div>
              <div><h4>{pageText(lang, 'item_027')}</h4><p>{L(lang, lv.id === 'col'
                ? { ko: '초등 CM2 말에 다시 지원합니다. 지원서는 교육청 누리집에 별도로 올라오며, 세부 사항은 학교에 문의합니다.', fr: 'Nouvelle candidature en fin de CM2 ; dossier spécifique sur le site de l’académie.' }
                : lv.id === 'elem'
                ? { ko: '유치원 GS 말(CP 진입)에 다시 지원합니다. 유치원 섹션 재학이 입학을 보장하지 않습니다.', fr: 'Nouvelle candidature en fin de GS ; la scolarité en SI maternelle ne garantit pas l’admission.' }
                : { ko: '교육청 1차 모집(11월~12월 중순 원서 접수)으로 지원합니다.', fr: 'Candidature lors de la campagne de novembre à mi-décembre.' })}</p></div>
            </div>
          </article>
        ))}
        <a class="link-arrow" href={href(lang, 'admission/')}>{pageText(lang, 'item_028')}</a>
        <div class="callout jjok">{pageText(lang, 'item_029')}</div>
      </section>

      <section id="diplomas" class="doc-section">
        <h2 class="h2">{L(lang, toc[4][1])}</h2>
        <ul class="bullets">
          <li>{pageText(lang, 'item_030')}</li>
          <li>{pageText(lang, 'item_031')}</li>
          <li>{pageText(lang, 'item_032')}</li>
          <li>{pageText(lang, 'item_033')}</li>
        </ul>
      </section>

      <section id="organisation" class="doc-section">
        <h2 class="h2">{L(lang, toc[5][1])}</h2>
        <p>{pageText(lang, 'item_034')}</p>
        <p>{pageText(lang, 'item_035')}</p>
        <a class="link-arrow" href={href(lang, 'about/#structure')}>{pageText(lang, 'item_036')}</a>
      </section>

      <section id="guide" class="doc-section">
        <h2 class="h2">{L(lang, toc[6][1])}</h2>
        <p>{pageText(lang, 'item_037')}</p>
        <a class="btn btn-accent" style="align-self:flex-start" href={href(lang, 'section/guide/')}>{pageText(lang, 'item_038')} →</a>
      </section>
    </div>
  </div>
</Base>
