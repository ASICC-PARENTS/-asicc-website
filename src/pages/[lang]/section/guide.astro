---
import Base from '../../../layouts/Base.astro';
import cmsToc from '../../../data/cms/toc-section-guide.json';
import pageCopy from '../../../data/cms/pages/section-guide.json';
import PageHero from '../../../components/PageHero.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
import { GRADES } from '../../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const toc = cmsToc.map((x) => [x.id, { ko:x.ko, fr:x.fr }] as const);
const GLOSSARY = [
  ['Inspection (IEN)', { ko: '장학관. 유치원·초등학교 교육을 관리·감독하는 교육청 소속 담당자', fr: 'Inspecteur de l’Éducation nationale, chargé du 1er degré' }],
  ['DASEN', { ko: '도 교육국장. 국제섹션 입학 위원회를 주재', fr: 'Directeur académique des services de l’Éducation nationale' }],
  ['Directeur, directrice', { ko: '유치원·초등학교 교장', fr: 'Direction d’école' }],
  ['Principal(e), CPE', { ko: '중학교 교장 / 생활지도 교사', fr: 'Chef d’établissement / conseiller principal d’éducation' }],
  ['Conseil d’école', { ko: '학교 운영위원회 (유치원·초등, 연 3회)', fr: 'Instance de l’école, trois fois par an' }],
  ['Conseil d’administration', { ko: '중학교 운영위원회', fr: 'Instance du collège' }],
  ['Conseil de classe', { ko: '중학교 학급 평가 회의 (학기 말)', fr: 'Réunion trimestrielle de l’équipe pédagogique' }],
  ['LSU', { ko: '학생 통합 기록부 (livret scolaire unique)', fr: 'Livret scolaire unique' }],
  ['ENT, Pronote', { ko: '중학교 온라인 학교 시스템 (성적, 숙제, 공지)', fr: 'Espace numérique de travail' }],
  ['Dérogation', { ko: '학구 예외 허가', fr: 'Autorisation hors secteur' }],
  ['Quotient familial', { ko: '가정 소득 등급. 급식·방과후 요금 산정 기준', fr: 'Base de calcul des tarifs municipaux' }],
] as const;
const pageText = (lang: 'ko' | 'fr', key: keyof typeof pageCopy) => pageCopy[key][lang];

---
<Base lang={lang} rest="section/guide/" title={pageText(lang, 'item_001')}>
  <PageHero lang={lang} crumb={{ label: pageText(lang, 'item_002'), path: 'section/' }}
    eyebrow={pageText(lang, 'item_003')}
    title={pageText(lang, 'item_004')}
    intro={pageText(lang, 'item_005')} />

  <div class="wrap sec with-aside">
    <aside><nav class="toc" aria-label={pageText(lang, 'item_006')}>{toc.map(([id, l]) => <a href={`#${id}`}>{L(lang, l)}</a>)}</nav></aside>
    <div class="content stack" style="gap:72px">

      <section id="grades" class="doc-section">
        <h2 class="h2">{L(lang, toc[0][1])}</h2>
        <p>{pageText(lang, 'item_007')}</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>{pageText(lang, 'item_008')}</th><th>{pageText(lang, 'item_009')}</th><th>{pageText(lang, 'item_010')}</th><th>{pageText(lang, 'item_011')}</th></tr></thead>
            <tbody>{GRADES.map((g) => <tr><td>{g.age}</td><td><b>{g.fr}</b></td><td>{g.ko}</td><td>{L(lang, g.level)}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <section id="enrolment" class="doc-section">
        <h2 class="h2">{L(lang, toc[1][1])}</h2>
        <p>{pageText(lang, 'item_012')}</p>
        <ul class="bullets">
          <li>{pageText(lang, 'item_013')}</li>
          <li>{pageText(lang, 'item_014')}</li>
          <li>{pageText(lang, 'item_015')}</li>
        </ul>
      </section>

      <section id="calendar" class="doc-section">
        <h2 class="h2">{L(lang, toc[2][1])}</h2>
        <p>{pageText(lang, 'item_016')}</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>{pageText(lang, 'item_017')}</th><th>{pageText(lang, 'item_018')}</th></tr></thead>
            <tbody>
              <tr><td>{pageText(lang, 'item_019')}</td><td>{pageText(lang, 'item_020')}</td></tr>
              <tr><td>{pageText(lang, 'item_021')}</td><td>{pageText(lang, 'item_022')}</td></tr>
              <tr><td>{pageText(lang, 'item_023')}</td><td>{pageText(lang, 'item_024')}</td></tr>
              <tr><td>{pageText(lang, 'item_025')}</td><td>{pageText(lang, 'item_026')}</td></tr>
              <tr><td>{pageText(lang, 'item_027')}</td><td>{pageText(lang, 'item_028')}</td></tr>
            </tbody>
          </table>
        </div>
        <p>{pageText(lang, 'item_029')} <a href="https://www.education.gouv.fr/calendrier-scolaire-100148" rel="noopener">education.gouv.fr ↗</a></p>
      </section>

      <section id="day" class="doc-section">
        <h2 class="h2">{L(lang, toc[3][1])}</h2>
        <p>{pageText(lang, 'item_030')}</p>
        <p>{pageText(lang, 'item_031')}</p>
        <h3>{pageText(lang, 'item_032')}</h3>
        <p>{pageText(lang, 'item_033')}</p>
      </section>

      <section id="services" class="doc-section">
        <h2 class="h2">{L(lang, toc[4][1])}</h2>
        <div class="grid g-2">
          <div class="card feature"><h3 class="h3">{pageText(lang, 'item_034')}</h3><p>{pageText(lang, 'item_035')}</p></div>
          <div class="card feature"><h3 class="h3">{pageText(lang, 'item_036')}</h3><p>{pageText(lang, 'item_037')}</p></div>
          <div class="card feature"><h3 class="h3">{pageText(lang, 'item_038')}</h3><p>{pageText(lang, 'item_039')}</p></div>
          <div class="card feature"><h3 class="h3">{pageText(lang, 'item_040')}</h3><p>{pageText(lang, 'item_041')}</p></div>
        </div>
      </section>

      <section id="evaluation" class="doc-section">
        <h2 class="h2">{L(lang, toc[5][1])}</h2>
        <ul class="bullets">
          <li>{pageText(lang, 'item_042')}</li>
          <li>{pageText(lang, 'item_043')}</li>
          <li>{pageText(lang, 'item_044')}</li>
          <li>{pageText(lang, 'item_045')}</li>
        </ul>
        <p>{pageText(lang, 'item_046')}</p>
      </section>

      <section id="college" class="doc-section">
        <h2 class="h2">{L(lang, toc[6][1])}</h2>
        <p>{pageText(lang, 'item_047')}</p>
        <ul class="bullets">
          <li>{pageText(lang, 'item_048')}</li>
          <li>{pageText(lang, 'item_049')}</li>
          <li>{pageText(lang, 'item_050')}</li>
          <li>{pageText(lang, 'item_051')} <a href={href(lang, 'section/#diplomas')}>{pageText(lang, 'item_052')} →</a></li>
        </ul>
      </section>

      <section id="communication" class="doc-section">
        <h2 class="h2">{L(lang, toc[7][1])}</h2>
        <ul class="bullets">
          <li>{pageText(lang, 'item_053')}</li>
          <li>{pageText(lang, 'item_054')}</li>
          <li>{pageText(lang, 'item_055')}</li>
          <li>{pageText(lang, 'item_056')}</li>
        </ul>
      </section>

      <section id="parents" class="doc-section">
        <h2 class="h2">{L(lang, toc[8][1])}</h2>
        <p>{pageText(lang, 'item_057')}</p>
        <p>{pageText(lang, 'item_058')}</p>
      </section>

      <section id="glossary" class="doc-section">
        <h2 class="h2">{L(lang, toc[9][1])}</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>{pageText(lang, 'item_059')}</th><th>{pageText(lang, 'item_060')}</th></tr></thead>
            <tbody>{GLOSSARY.map(([k, v]) => <tr><td><b>{k}</b></td><td>{L(lang, v)}</td></tr>)}</tbody>
          </table>
        </div>
        <p>{pageText(lang, 'item_061')} <a href={href(lang, 'contact/')}>{pageText(lang, 'item_062')} →</a></p>
      </section>
    </div>
  </div>
</Base>
