---
import './style.css';
import { href, L, type Lang } from '../../../i18n/ui';
interface Props {lang:Lang; screen:string}
const {lang,screen}=Astro.props;
const admin=href(lang,'bazaar/admin/');
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/bazaar-export/';
---
<!doctype html>
<html lang={lang}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>{L(lang,{ko:'ASICC · 온라인 바자회 관리',fr:'ASICC · Gestion du bazar en ligne'})}</title></head>
<body data-page={screen}>
<div id="approved-admin" data-page={screen} data-lang={lang} data-base={admin} data-login={href(lang,'membres/login/')}>
<div class="site">
<header><a class="brand" href={admin} style="color:inherit;text-decoration:none"><span class="brand-mark">한</span> ASICC</a><div class="tagline"><a href={href(lang)} style="color:inherit">{L(lang,{ko:'홈페이지로',fr:'Accueil'})}</a> · <a href={href(lang,'membres/admin/')} style="color:inherit">{L(lang,{ko:'홈페이지 운영센터',fr:'Centre d’administration'})}</a> · {L(lang,{ko:'운영진 전용',fr:'Réservé à l’administration'})}{(import.meta.env.DEV || import.meta.env.PUBLIC_ASICC_INTEGRATION_TEST === 'true') && <small style="display:block">TEST UI · 2026-11-25 R9.1</small>}</div></header>
<main>
<div class="topline">
<div><p class="eyebrow">BAZAAR MANAGEMENT</p><h1>{L(lang,{ko:'온라인 바자회 관리',fr:'Gestion du bazar en ligne'})}</h1><p class="muted small">{L(lang,{ko:'행사 현황을 확인하고 필요한 업무를 선택하세요.',fr:'Consultez les événements et choisissez une action.'})}</p></div>
<div class="actions" id="admin-actions" hidden><a class="btn neutral" href={href(lang,'membres/admin/')}>{L(lang,{ko:'운영센터로 돌아가기',fr:'Retour au centre d’administration'})}</a></div>
</div>
<div id="app"><p role="status">{L(lang,{ko:'운영진 권한을 확인하는 중입니다.',fr:'Vérification des droits d’administration…'})}</p></div>
</main></div>
<div class="modal-wrap" id="modal" hidden><div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
<div class="modal-h"><div><h3 id="modal-title"></h3><p id="modal-caption" class="muted small"></p></div><button class="btn neutral" id="modal-close">{L(lang,{ko:'닫기',fr:'Fermer'})} ×</button></div>
<div class="modal-b" id="modal-body"></div><div class="modal-f" id="modal-foot"></div></div></div>
</div>
<script is:inline src={base+'xlsx.js'}></script>
{screen==='settlement'&&<script is:inline src={base+'pdf.js'}></script>}
<script>import './app.js';</script>
</body></html>
