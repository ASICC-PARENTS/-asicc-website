---
import './style.css';
import { href, type Lang } from '../../../i18n/ui';
interface Props {lang:Lang; screen:string}
const {lang,screen}=Astro.props;
const admin=href(lang,'bazaar/admin/');
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/bazaar-export/';
---
<!doctype html>
<html lang={lang}>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>ASICC · 온라인 바자회 관리</title></head>
<body data-page={screen}>
<div id="approved-admin" data-page={screen} data-base={admin} data-login={href(lang,'membres/login/')}>
<div class="site">
<header><a class="brand" href={admin} style="color:inherit;text-decoration:none"><span class="brand-mark">한</span> ASICC</a><div class="tagline">운영진 전용</div></header>
<main>
<div class="topline">
<div><p class="eyebrow">BAZAAR MANAGEMENT</p><h1>온라인 바자회 관리</h1><p class="muted small">행사 현황을 확인하고 필요한 업무를 선택하세요.</p></div>
<div class="actions" id="admin-actions" hidden><button class="btn neutral" id="global-past">↶ 지난 바자회 보기</button><button class="btn primary" id="global-new">＋ 새 바자회 만들기</button></div>
</div>
<div id="app"><p role="status">운영진 권한을 확인하는 중입니다.</p></div>
</main></div>
<div class="modal-wrap" id="modal" hidden><div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
<div class="modal-h"><div><h3 id="modal-title"></h3><p id="modal-caption" class="muted small"></p></div><button class="btn neutral" id="modal-close">닫기 ×</button></div>
<div class="modal-b" id="modal-body"></div><div class="modal-f" id="modal-foot"></div></div></div>
</div>
{screen==='settlement'&&<><script is:inline src={base+'xlsx.js'}></script><script is:inline src={base+'pdf.js'}></script></>}
<script>import './app.js';</script>
</body></html>
