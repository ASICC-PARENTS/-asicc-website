---
import { L, href, type Lang } from '../i18n/ui';
import campaigns from '../data/cms/home-campaigns.json';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { bazaar, admissions, donation } = campaigns;
// Static, CMS-controlled fallbacks are visible even before Firebase loads.
// Administrators may temporarily override the two editorial banners in Firestore.
const editorial = [
  { id: 'bazaar', data: bazaar, className: 'bazaar-banner', decoration: '🎁' },
  { id: 'admissions', data: admissions, className: 'admissions-banner', decoration: '📚' },
];
const editorialHref = (v: string) => v.startsWith('https://') ? v : href(lang,v);
const donationReady = (v: string) => /^https:\/\/www\.helloasso\.com\//i.test(v);
---
<section class="wrap home-campaigns" aria-label={L(lang,{ko:'ASICC 공지와 후원 안내',fr:'Actualités et soutien à l’ASICC'})}>
  <div class="editorial-banners">
    {editorial.map(({id,data,className,decoration}) => <article class={`campaign-banner ${className}`} data-editorial-banner={id} hidden={!data.enabled}>
      <div class="campaign-content">
        <span class="campaign-kicker" data-field="eyebrow">{L(lang,data.eyebrow)}</span>
        <h2 data-field="title">{L(lang,data.title)}</h2>
        <p data-field="body">{L(lang,data.body)}</p>
        <span class="campaign-state" data-status-wrap><span aria-hidden="true">●</span> <span data-field="status">{L(lang,data.status)}</span></span>
        <a data-field="link" class="btn campaign-link" href={editorialHref(data.link)} target={data.link.startsWith('https://')?'_blank':undefined} rel={data.link.startsWith('https://')?'noopener noreferrer':undefined}>
          <span data-field="button">{L(lang,data.button)}</span> <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="campaign-decoration" aria-hidden="true">{decoration}</div>
    </article>)}
  </div>
  {donation.enabled && <article class="campaign-banner support-banner">
    <div class="campaign-content">
      <span class="campaign-kicker">{L(lang,donation.eyebrow)}</span>
      <h2>{L(lang,donation.title)}</h2>
      <p>{L(lang,donation.body)}</p>
      <div class="support-actions">
        {donationReady(donation.membershipUrl) && <a class="btn support-fee-button" href={donation.membershipUrl} target="_blank" rel="noopener noreferrer">{L(lang,{ko:'연회비 납부하기',fr:'Payer la cotisation'})} ↗</a>}
        {donationReady(donation.donationUrl) && <a class="btn btn-dark support-donate-button" href={donation.donationUrl} target="_blank" rel="noopener noreferrer">{L(lang,{ko:'자유 후원하기',fr:'Faire un don libre'})} ↗</a>}
      </div>
      <div class="bank-transfer">
        <strong>{L(lang,donation.bankLabel)}</strong>
        <span class="bank-holder">{donation.bankName}</span>
        <code>{donation.iban}</code>
      </div>
    </div>
  </article>}
</section>
<script>
  import { getApps, initializeApp } from 'firebase/app';
  import { getFirestore, doc, onSnapshot } from 'firebase/firestore';
  import { firebaseConfig } from '../firebase-config';
  import { BASE } from '../config';
  // Public read only: never download member records or require a login on the home page.
  const app = getApps().find(a => a.name === 'asicc-website') ?? initializeApp(firebaseConfig,'asicc-website');
  const db = getFirestore(app);
  // Keep pre-publication tests from changing the public homepage immediately.
  const bannerCollection = /^(www\.)?asicc-parents\.fr$/i.test(location.hostname)
    ? 'publicHomeBanners' : 'publicHomeBannersTest';
  const validLink = (link: unknown): link is string => typeof link === 'string'
    && link.length <= 500 && (/^news\/[a-z0-9/_-]+\/$/.test(link) || /^https:\/\/[^\s]+$/.test(link));
  for (const key of ['bazaar','admissions'] as const) {
    const banner = document.querySelector<HTMLElement>(`[data-editorial-banner="${key}"]`);
    if (!banner) continue;
    onSnapshot(doc(db,bannerCollection,key), snap => {
      // Removing the admin override falls back to the bundled CMS values after reload.
      if (!snap.exists()) { if (banner.dataset.override === 'true') window.location.reload(); return; }
      const item=snap.data();
      if (!validLink(item.link) || typeof item.enabled !== 'boolean') return;
      const lang = location.pathname.startsWith(BASE+'fr/') ? 'fr' : 'ko';
      for (const field of ['eyebrow','title','body','button','status'] as const) {
        const value=item[`${field}_${lang}`];
        const node=banner.querySelector<HTMLElement>(`[data-field="${field}"]`);
        if(typeof value!=='string' || !node) return;
        node.textContent=value;
      }
      const link=banner.querySelector<HTMLAnchorElement>('[data-field="link"]');
      if (link) {
        link.href = item.link.startsWith('https://') ? item.link : `${BASE}${lang}/${item.link}`;
        if (item.link.startsWith('https://')) { link.target='_blank';link.rel='noopener noreferrer'; }
        else {link.removeAttribute('target');link.removeAttribute('rel');}
      }
      const state=banner.querySelector<HTMLElement>('[data-status-wrap]');
      if(state)state.hidden=!item[`status_${lang}`];
      banner.hidden = !item.enabled;
      banner.dataset.override='true';
    }, () => {/* Static CMS fallback remains available before rules are published. */});
  }
</script>
<style>
/* Keep the existing vertical position. The three banners share one CSS grid row
   so they always have equal height; content can expand the row when translated. */
.home-campaigns { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; padding-top:24px; align-items:stretch; }
.editorial-banners { display:contents; }
.campaign-banner { position:relative; display:flex; min-width:0; min-height:286px; border-radius:12px; padding:16px 17px; overflow:hidden; box-sizing:border-box; }
.campaign-banner[hidden],.campaign-state[hidden] { display:none; }
.campaign-content { position:relative; z-index:1; display:flex; flex-direction:column; align-items:flex-start; gap:8px; min-width:0; width:100%; }
.campaign-kicker { font-family:var(--strong); font-size:11px; font-weight:700; letter-spacing:.045em; line-height:1.45; }
.campaign-banner h2 { font-family:var(--serif); font-size:clamp(17px,1.65vw,20px); line-height:1.35; overflow-wrap:anywhere; }
.campaign-banner p { font-size:14px; line-height:1.55; max-width:52ch; overflow-wrap:anywhere; }
.bazaar-banner { background:linear-gradient(115deg,#FFF2DF,#FFE1C9); border:1px solid #EAB58C; color:#57351F; }
.bazaar-banner .campaign-kicker { color:#95401D; }
.admissions-banner { background:linear-gradient(115deg,#EEF6FF,#DDEBFA); border:1px solid #A8C7E5; color:#29435B; }
.admissions-banner .campaign-kicker { color:#194F81; background:#D1E4F8; border:1px solid #ACCEE9; padding:3px 7px; border-radius:999px; letter-spacing:0; }
.campaign-decoration { position:absolute; right:10px; bottom:11px; font-size:32px; transform:rotate(-8deg); opacity:.27; line-height:1; pointer-events:none; }
.campaign-state { display:inline-flex; gap:6px; align-items:center; max-width:100%; padding:5px 9px; border-radius:999px; font-size:12px; line-height:1.45; background:rgba(255,255,255,.84); border:1px solid rgba(0,0,0,.10); font-weight:650; overflow-wrap:anywhere; }
.campaign-state > span:first-child { color:#C57946; font-size:8px; }
.campaign-link { margin-top:auto; width:fit-content; min-height:36px; padding:8px 11px; font-size:12px; line-height:1.25; border:1px solid transparent; border-radius:8px; font-weight:700; text-decoration:none; }
.bazaar-banner .campaign-link { background:#B94D30; border-color:#B94D30; color:#fff; }
.bazaar-banner .campaign-link:hover { background:#963B22; border-color:#963B22; color:#fff; }
.admissions-banner .campaign-link { background:#285F98; border-color:#285F98; color:#fff; }
.admissions-banner .campaign-link:hover { background:#1B4978; border-color:#1B4978; color:#fff; }
.admissions-banner .campaign-state { background:#F9FCFF; border-color:#B8D3EB; color:#234E79; }
.campaign-link:focus-visible { outline:3px solid #1B4978; outline-offset:3px; }
.support-banner { background:#EBF4F0; border:1px solid #BFD6CD; color:#204C40; }
.support-banner .campaign-kicker { color:#3D7964; }
.support-banner p { color:#345F50; }
.support-actions { display:flex; flex-wrap:wrap; gap:7px; width:100%; margin-top:4px; }
.support-actions a { min-width:0; min-height:36px; flex:0 1 auto; display:flex; justify-content:center; align-items:center; text-align:center; font-size:11px; line-height:1.3; padding:8px 10px; border-radius:8px; text-decoration:none; overflow-wrap:anywhere; }
.support-actions .support-fee-button { color:#fff; background:#34465C; border:1px solid #34465C; font-weight:700; }
.support-actions .support-fee-button:hover { background:#223246; border-color:#223246; color:#fff; }
.support-actions .support-donate-button { background:#28614F; border:1px solid #28614F; color:#fff; font-weight:700; }
.support-actions .support-donate-button:hover { background:#1C4A3C; border-color:#1C4A3C; color:#fff; }
.support-actions a:focus-visible { outline:3px solid #204C40; outline-offset:3px; }
/* Keep the bank account visible, not in a popover or disclosure. */
.bank-transfer { display:flex; flex-wrap:wrap; gap:4px 8px; align-items:baseline; width:100%; border-top:1px solid #CADFD7; margin-top:auto; padding-top:11px; font-size:14px; }
.bank-transfer strong { font-weight:700; flex:1 0 100%; }
.bank-holder { font-size:14px; font-weight:650; overflow-wrap:anywhere; }
.bank-transfer code { display:block; width:100%; font-size:16px; font-weight:700; line-height:1.5; font-family:ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:-.035em; word-break:break-word; overflow-wrap:anywhere; user-select:all; }
@media(max-width:740px) { .home-campaigns { grid-template-columns:minmax(0,1fr); gap:12px; } .campaign-banner { min-height:210px; padding:19px; } .campaign-banner h2 { font-size:21px; } .campaign-banner p { font-size:14px; } .campaign-decoration { opacity:.18; } .support-banner { min-height:245px; } .support-actions a { font-size:13px; } .bank-transfer code { font-size:16px; } }
@media(max-width:400px) { .campaign-banner { padding:17px; } .support-actions { grid-template-columns:1fr; } }
</style>
