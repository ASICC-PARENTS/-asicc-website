---
import { L, href, type Lang } from '../i18n/ui';
const {lang}=Astro.props as {lang:Lang};
---
<dialog id="home-popup" class="home-popup" data-lang={lang} data-home={href(lang,'')} aria-labelledby="home-popup-title">
  <div class="popup-inner">
    <button type="button" class="popup-close" aria-label={L(lang,{ko:'닫기',fr:'Fermer'})}>×</button>
    <span class="popup-kicker">ASICC</span>
    <h2 id="home-popup-title"></h2>
    <div class="popup-products">
      <figure hidden><img alt="" referrerpolicy="no-referrer"/><figcaption></figcaption></figure>
      <figure hidden><img alt="" referrerpolicy="no-referrer"/><figcaption></figcaption></figure>
    </div>
    <p class="popup-body"></p>
    <p class="popup-test" hidden>{L(lang,{ko:'테스트 홈페이지 · 실제 송금 금지',fr:'Site de test · Aucun virement réel'})}</p>
    <a class="popup-cta"></a>
    <div class="popup-bottom"><button type="button" data-popup-today>{L(lang,{ko:'오늘 하루 보지 않기',fr:'Ne plus afficher aujourd’hui'})}</button><button type="button" data-popup-dismiss>{L(lang,{ko:'닫기',fr:'Fermer'})}</button></div>
  </div>
</dialog>
<script>
  import {getHomePopup,bazaarTestMode} from '../lib/bazaar/api';
  const popup=document.querySelector<HTMLDialogElement>('#home-popup');
  if(popup){
    const day=()=>new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
    let key='';
    const close=()=>popup.close();
    popup.querySelector('.popup-close')?.addEventListener('click',close);
    popup.querySelector('[data-popup-dismiss]')?.addEventListener('click',close);
    popup.querySelector('[data-popup-today]')?.addEventListener('click',()=>{try{localStorage.setItem(key,day());}catch{}close();});
    popup.addEventListener('click',e=>{if(e.target===popup)close();});
    popup.addEventListener('close',()=>{document.body.classList.remove('asicc-popup-open');});
    const start=async()=>{
      try{
        const {popup:p}=await getHomePopup();if(!p)return;
        key='asicc-home-popup:'+p.identity+':'+p.revision;
        try{if(localStorage.getItem(key)===day())return;}catch{}
        const lang=popup.dataset.lang==='fr'?'Fr':'Ko';
        popup.querySelector('h2')!.textContent=p['title'+lang];
        popup.querySelector('.popup-body')!.textContent=p['body'+lang];
        const link=popup.querySelector<HTMLAnchorElement>('.popup-cta')!;
        const target=new URL(p.link,popup.dataset.home?new URL(popup.dataset.home,location.origin):location.href);
        if(target.protocol!=='https:'&&target.origin!==location.origin)return;
        // Prevent a test campaign from routing visitors to the live ordering site.
        if(bazaarTestMode&&/^(www\.)?asicc-parents\.fr$/i.test(target.hostname))return;
        link.href=target.href;link.textContent=p['button'+lang]+' →';
        link.addEventListener('click',close);
        popup.querySelector<HTMLElement>('.popup-test')!.hidden=!bazaarTestMode;
        const figures=popup.querySelectorAll<HTMLElement>('figure');
        figures.forEach((figure,index)=>{
          const n=index+1,src=p['image'+n];if(!src)return;
          const img=figure.querySelector('img')!,caption=p['caption'+n+lang]||'';
          img.alt=caption;figure.querySelector('figcaption')!.textContent=caption;
          img.addEventListener('error',()=>{figure.hidden=true;},{once:true});
          img.src=src;figure.hidden=false;
        });
        popup.showModal();document.body.classList.add('asicc-popup-open');
      }catch{/* A failed popup request must never block the homepage. */}
    };
    void start();
  }
</script>
<style>
  .home-popup{border:0;padding:0;border-radius:20px;width:min(472px,calc(100% - 28px));max-height:calc(100dvh - 28px);overflow:auto;background:#fff;color:#26394a;box-shadow:0 22px 72px #101b3050;margin:auto;box-sizing:border-box;}
  .home-popup::backdrop{background:rgba(20,32,43,.62)}
  :global(body.asicc-popup-open){overflow:hidden}
  .popup-inner{position:relative;padding:30px 26px 18px;text-align:center;border-top:4px solid #d9ad40;background:linear-gradient(180deg,#fffcf6 0,#fff 38%);}
  .popup-close{position:absolute;top:10px;right:12px;background:#fff;border:1px solid #e5e8eb;border-radius:50%;font-size:24px;line-height:1;color:#526474;cursor:pointer;width:36px;height:36px;display:grid;place-items:center}
  .popup-close:hover{background:#f2f5f7;color:#08254d}
  .popup-kicker{display:inline-block;font-size:13px;font-weight:800;color:#08254d;letter-spacing:.18em;padding:0 0 6px;border-bottom:1px solid #d9ad40}
  .home-popup h2{font-size:clamp(22px,4.8vw,28px);font-weight:750;line-height:1.35;letter-spacing:-.02em;margin:14px auto 20px;color:#08254d;max-width:100%;text-wrap:balance}
  .popup-products{display:flex;justify-content:center;align-items:stretch;gap:12px;margin-bottom:20px;min-width:0}
  .popup-products figure{display:flex;flex-direction:column;align-items:center;flex:1 1 0;min-width:0;margin:0;background:#fff;border:1px solid #e8dfd3;border-radius:13px;padding:12px 9px 10px;box-shadow:0 3px 12px #533a1810}
  .popup-products figure[hidden]{display:none}
  .popup-products img{display:block;width:100%;height:170px;object-fit:contain}
  .home-popup figcaption{font-size:13px;font-weight:700;line-height:1.5;margin-top:10px;color:#26394a;width:100%}
  .home-popup .popup-body{font-size:15px;line-height:1.75;margin:0 auto 18px;color:#475569;max-width:36ch;text-wrap:pretty}
  .home-popup .popup-test{color:#925228;font-size:12px;line-height:1.5;margin:0 0 12px}
  .home-popup .popup-cta{display:block;border-radius:10px;background:#9f422b;color:#fff!important;font-weight:750;font-size:15px;line-height:1.5;text-decoration:none;padding:13px 16px;box-shadow:0 4px 10px #9f422b20;white-space:normal}
  .popup-cta:hover{background:#843420}
  .popup-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px 12px;margin-top:14px;padding-top:10px;border-top:1px solid #eef0f2}
  .home-popup .popup-bottom button{font-size:12px;line-height:1.5;color:#526474;background:transparent;border:0;padding:8px 2px;cursor:pointer;min-width:0;max-width:100%;white-space:normal}
  .popup-bottom button:hover{text-decoration:underline;text-underline-offset:3px}
  .home-popup :is(h2,p,figcaption,a,button){word-break:keep-all;overflow-wrap:break-word;hyphens:none;}
  .home-popup :is(a,button):focus-visible{outline:3px solid #b38d35;outline-offset:3px}
  @media(max-width:420px){.home-popup{width:calc(100% - 24px);max-height:calc(100dvh - 24px);border-radius:16px}.popup-inner{padding:24px 15px 13px}.home-popup h2{margin:12px auto 16px}.popup-products{gap:9px;margin-bottom:16px}.popup-products figure{padding:8px 6px}.popup-products img{height:130px}.home-popup figcaption{font-size:12px}.home-popup .popup-body{font-size:14px;margin-bottom:15px}.home-popup .popup-cta{font-size:14px}}
  @media(max-width:340px){.popup-inner{padding-inline:12px}.popup-products img{height:108px}.popup-bottom{justify-content:center}}
</style>
