---
import forms from '../data/admin-forms.json';
import { href, L, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ko = lang === 'ko';
const rows = [...forms].sort((a,b) => b.createdAt.localeCompare(a.createdAt));
const preview = import.meta.env.PUBLIC_ASICC_INTEGRATION_TEST === 'true' || import.meta.env.PUBLIC_ASICC_ADMISSIONS_PREVIEW === 'true' || import.meta.env.PUBLIC_ASICC_BAZAAR_TEST === 'true' || import.meta.env.PUBLIC_ASICC_BAZAAR_EMULATOR === 'true';
---
<section id="forms-list" class="stack gap-12" aria-label={ko?'설문·신청 목록':'Liste des enquêtes et formulaires'}>
  <div class="forms-heading">
    <p class="small muted">{ko ? '제목을 선택하면 응답 관리 화면으로 이동합니다.' : 'Sélectionnez un titre pour gérer les réponses.'}</p>
    <span class="small muted forms-count">{ko ? '총 ' + rows.length + '건' : rows.length + ' formulaires'}</span>
  </div>
  <div class="forms-table-wrap" tabindex="0" role="region" aria-label={ko?'설문 목록 표':'Tableau des formulaires'}>
    <table class="forms-table">
      <thead>
        <tr>
          <th scope="col">{ko ? '제목' : 'Titre'}</th>
          <th scope="col">{ko ? '유형' : 'Type'}</th>
          <th scope="col">{ko ? '생성일' : 'Création'}</th>
          <th scope="col">{ko ? '자료 보관 기한' : 'Conservation des données'}</th>
          <th scope="col">{ko ? '공개 링크' : 'Liens publics'}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(item => {
          const external = 'url' in item.admin && item.admin.url;
          const adminHref = external || href(lang, item.admin.path!);
          const koHref = 'path' in item.public ? href('ko', item.public.path!) : item.public.ko;
          const frHref = 'path' in item.public ? href('fr', item.public.path!) : item.public.fr;
          const retainedUntil = 'until' in item.retention ? item.retention.until : undefined;
          const retentionPeriod = 'period' in item.retention ? item.retention.period?.[lang] : undefined;
          return (
            <tr>
              <td class="forms-title">
                {preview && external ? <span title={ko?'운영 조사 링크 · 테스트에서 비활성화':'Lien de production désactivé en test'}>{item.title[lang]}</span> :
                  <a href={adminHref} title={item.description[lang]} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{item.title[lang]} <span aria-hidden="true">{external ? '↗' : '›'}</span></a>}
              </td>
              <td class="forms-type">{item.type[lang]}</td>
              <td class="forms-date"><time datetime={item.createdAt}>{item.createdAt}</time>
                {item.createdAtBasis==='deployment-confirmed' && <span class="date-note">{ko?' (배포 확인일)':' (déploiement confirmé)'}</span>}
              </td>
              <td class="forms-retention">{retainedUntil ? <time datetime={retainedUntil}>{retainedUntil}</time> :
                retentionPeriod ? <>{retentionPeriod}<span class="date-note"> ({item.retention.note?.[lang]})</span></> :
                <span class="muted">{ko?'미확인':'Non confirmée'}</span>}
              </td>
              <td class="forms-public">
                {preview && external ? <span class="small muted">—</span> : <div class="forms-links">
                  <a href={koHref} target="_blank" rel="noopener noreferrer" aria-label={item.title[lang] + ' · 한국어'}>한국어</a>
                  <span aria-hidden="true">|</span>
                  <a href={frHref} target="_blank" rel="noopener noreferrer" aria-label={item.title[lang] + ' · Français'}>FR</a>
                </div>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="small muted">{L(lang,{ko:'기존 응답 데이터는 각 양식의 관리 화면에서 확인할 수 있습니다. 보관 기한은 각 양식의 기존 안내를 표시합니다.',fr:'Les réponses restent accessibles dans l’administration de chaque formulaire. La conservation reprend les durées indiquées dans chaque formulaire.'})}</p>
</section>
<style>
  #forms-list{min-width:0}
  .forms-heading{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .forms-heading p{margin:0}
  .forms-count{white-space:nowrap;flex-shrink:0}
  .forms-table-wrap{border:1px solid #cbd5cf;border-radius:4px;overflow-x:auto;min-width:0;width:100%;max-width:100%;-webkit-overflow-scrolling:touch}
  .forms-table{border-collapse:collapse;width:100%;min-width:780px;font-size:13px;table-layout:auto}
  .forms-table th{background:#e7ede9;text-align:left;font-weight:700;white-space:nowrap;color:#30483c}
  .forms-table th,.forms-table td{padding:10px 12px;border-right:1px solid #d4ddd7;border-bottom:1px solid #d4ddd7;vertical-align:middle;line-height:1.45}
  .forms-table th:last-child,.forms-table td:last-child{border-right:0}
  .forms-table tbody tr:last-child td{border-bottom:0}
  .forms-table tbody tr:nth-child(even){background:#f8faf8}
  .forms-table tbody tr:hover{background:#eef6ef}
  .forms-title{min-width:225px;max-width:420px}
  .forms-title>a{color:#24523e;font-weight:650;text-decoration:underline;text-underline-offset:3px}
  .forms-title>a:hover{color:#102e1c}
  .forms-date,.forms-type,.forms-public,.forms-retention{white-space:nowrap;font-variant-numeric:tabular-nums}
  .date-note{font-size:11px;color:#69756e}
  .forms-links{display:flex;align-items:center;gap:7px;white-space:nowrap}
  .forms-links>a{font-weight:600;text-decoration:underline;text-underline-offset:3px;color:#24523e}
  .forms-links>span{color:#a2afa7}
  @media(max-width:650px){
    .forms-table th,.forms-table td{padding:9px 10px}
    .forms-table{font-size:12px}
    .forms-title{min-width:220px}
  }
</style>
